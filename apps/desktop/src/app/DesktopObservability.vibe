  const currentSize = try Ref.make(try refreshFileSize(fileSystem, input.filePath));
  const mutex = try Semaphore.make(1);

  const pruneOverflowBackups = effect {
    const entries = fileSystem.readDirectory(directory) catch () => [];
    for (const entry of entries) {
      if (!entry.startsWith(`${baseName}.`)) continue;
      const suffix = Number(entry.slice(baseName.length + 1));
      if (!Number.isInteger(suffix) || suffix <= maxFiles) continue;
      try (fileSystem.remove(path.join(directory, entry), { force: true }) |> Effect.ignore(%));
    }
