import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Path from "effect/Path"

import * as ElectronApp from "../electron/ElectronApp.vibe"
import * as DesktopAssets from "./DesktopAssets.vibe"
import * as DesktopEnvironment from "./DesktopEnvironment.vibe"
import * as DesktopUserData from "./DesktopUserData.vibe"

const COMMIT_HASH_PATTERN = /^[0-9a-f]{7,40}$/i
const COMMIT_HASH_DISPLAY_LENGTH = 12

const AppPackageMetadata = Schema.Struct({
  t3codeCommitHash: Schema.optional(Schema.String),
})
const decodeAppPackageMetadata = Schema.decodeEffect(Schema.fromJsonString(AppPackageMetadata))

export service DesktopAppIdentity: {
  readonly resolveUserDataPath: string!DesktopUserData.DesktopUserDataInitializationError;
  readonly configure: void!!;
} {
  static readonly key = "@t3tools/desktop/app/DesktopAppIdentity"
}

const normalizeCommitHash = (value: string): Option.Option<string> => {
  const trimmed = value.trim()
  return COMMIT_HASH_PATTERN.test(trimmed)
    ? Option.some(trimmed.slice(0, COMMIT_HASH_DISPLAY_LENGTH).toLowerCase())
    : Option.none()
}

/** @public */
export const make = effect {
  const assets = try DesktopAssets.DesktopAssets
  const electronApp = try ElectronApp.ElectronApp
  const environment = try DesktopEnvironment.DesktopEnvironment
  const fileSystem = try FileSystem.FileSystem
  const userDataContext = try Effect.context<FileSystem.FileSystem | Path.Path>()
  const commitHashCache = try Ref.make<Option.Option<Option.Option<string>>>(Option.none())

  const resolveEmbeddedCommitHash = effect {
    const packageJsonPath = environment.path.join(environment.appRoot, "package.json")
    const raw = try (fileSystem.readFileString(packageJsonPath) |> Effect.option(%))
    return do {
      const $optionSubject = raw
      const $optionHandlers: {
        onNone: () => Option.Option<string>!never!never
        onSome: (value: string) => Option.Option<string>!never!never
      } = {
        onNone: () => Effect.succeed(Option.none<string>()),
        onSome: (value) =>
          decodeAppPackageMetadata(value)
          |> Effect.map(
            %,
            (parsed) => Option.flatMap(Option.fromNullishOr(parsed.t3codeCommitHash), normalizeCommitHash),
          )
          |> Effect.orElseSucceed(%, () => Option.none<string>()),
      }
      const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
      match ($optionSubject) {
        when Option.Some(let $optionValue): try $optionSome($optionValue);
        default: try $optionNone();
      }
    }
  }

  const resolveAboutCommitHash = effect {
    const cached = try Ref.get(commitHashCache)
    if (Option.isSome(cached)) {
      return cached.value
    }

    const override = Option.flatMap(environment.commitHashOverride, normalizeCommitHash)
    if (Option.isSome(override)) {
      try Ref.set(commitHashCache, Option.some(override))
      return override
    }

    if (!environment.isPackaged) {
      const empty = Option.none<string>()
      try Ref.set(commitHashCache, Option.some(empty))
      return empty
    }

    const commitHash = try resolveEmbeddedCommitHash
    try Ref.set(commitHashCache, Option.some(commitHash))
    return commitHash
  }

  const userDataPath = DesktopUserData.resolveUserDataPath(environment)
    |> Effect.provide(%, userDataContext)

  const configure = effect {
    const commitHash = try resolveAboutCommitHash
    // Electron strips spaces but keeps parentheses in its User-Agent token, breaking Turnstile in preview sessions.
    try electronApp.setName(
      `${environment.branding.baseName} ${environment.branding.stageLabel}`,
    )
    try electronApp.setAboutPanelOptions({
      applicationName: environment.displayName,
      applicationVersion: environment.appVersion,
      version: Option.getOrElse(commitHash, () => "unknown"),
    })

    if (environment.platform === "win32") {
      try electronApp.setAppUserModelId(environment.appUserModelId)
    }

    // Packaged bundles carry their icon in Info.plist; setting it again overwrites the user's custom icon.
    if (environment.platform === "darwin" && !environment.isPackaged) {
      const iconPaths = try assets.iconPaths
      {
        const $optionSubject = iconPaths.png
        const $optionHandlers: { onNone: () => void!never!never; onSome: (iconPath: string) => void!! } = {
          onNone: () => Effect.void,
          onSome: electronApp.setDockIcon,
        }
        const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
        match ($optionSubject) {
          when Option.Some(let $optionValue): try $optionSome($optionValue);
          default: try $optionNone();
        }
      }
    }
  } |> withSpan(%, "desktop.appIdentity.configure")

  return DesktopAppIdentity.of({
    resolveUserDataPath: userDataPath,
    configure,
  })
}

export const layer = Layer.effect(DesktopAppIdentity, make)
