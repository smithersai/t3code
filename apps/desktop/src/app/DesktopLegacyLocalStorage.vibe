import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Option from "effect/Option"
import * as Path from "effect/Path"

import * as ElectronProtocol from "../electron/ElectronProtocol.vibe"
import { readChromiumLocalStorage } from "./chromiumLocalStorage.ts"
import * as DesktopEnvironment from "./DesktopEnvironment.vibe"

/** Reads the V1 profile without opening it in Chromium, even while V1 runs. */
export service DesktopLegacyLocalStorage: {
  readonly load: (userDataPath: string) => void!!;
  readonly take: Effect.Effect<Option.Option<Readonly<Record<string, string>>>>;
  readonly complete: void!!;
} {
  static readonly key = "@t3tools/desktop/app/DesktopLegacyLocalStorage"
}

const MARKER_FILE_NAME = "v1-local-storage-imported"
const V1_PROFILE_NAMES = ["T3 Code (Alpha)", "t3code"]

const make = Effect.gen(function*() {
  const environment = yield* DesktopEnvironment.DesktopEnvironment
  const fs = yield* FileSystem.FileSystem
  const path = yield* Path.Path
  const items = yield* Ref.make(Option.none<Readonly<Record<string, string>>>())
  const markerPath = yield* Ref.make(Option.none<string>())

  /** Newest file mtime in a directory; appending to a log leaves the directory's own mtime alone. */
  const newestFileMtime = Effect.fn("DesktopLegacyLocalStorage.newestFileMtime")(
    function*(directory: string) {
      let newest = 0
      for (const name of yield* fs.readDirectory(directory)) {
        const info = yield* fs.stat(path.join(directory, name)) |> Effect.option(%)
        if (Option.isNone(info)) continue
        const mtime = Option.match(info.value.mtime, {
          onNone: () => 0,
          onSome: (date) => date.getTime(),
        })
        newest = Math.max(newest, mtime)
      }
      return newest
    },
    (effect, _directory) => effect |> Effect.option(%),
  )

  const findV1LocalStorage = effect {
    let newest: { readonly directory: string; readonly mtime: number } | null = null
    for (const name of V1_PROFILE_NAMES) {
      const directory = path.join(environment.appDataDirectory, name, "Local Storage", "leveldb")
      const mtime = try newestFileMtime(directory)
      if (Option.isNone(mtime)) continue
      if (newest === null || mtime.value > newest.mtime) newest = { directory, mtime: mtime.value }
    }
    return newest?.directory ?? null
  }

  const writeMarker = effect {
    const marker = try Ref.get(markerPath)
    if (Option.isNone(marker)) return
    fs
      .writeFileString(marker.value, "") catch effect (error) =>
        try Effect.logWarning("Could not record the V1 Local Storage import", error)
  }

  const load = effect (userDataPath: string) =>
    try withSpan(
      effect {
        if (environment.isDevelopment) return
        const marker = path.join(userDataPath, MARKER_FILE_NAME)
        if ((fs.exists(marker) catch () => true)) return
        try Ref.set(markerPath, Option.some(marker))
        const directory = try findV1LocalStorage
        if (directory === null) return try writeMarker
        const origin = ElectronProtocol.getDesktopUrl(false).replace(/\/$/, "")
        const read = try (readChromiumLocalStorage(directory, origin)
          |> Effect.provideService(%, FileSystem.FileSystem, fs)
          |> Effect.provideService(%, Path.Path, path)
          |> Effect.tapError(
            %,
            (error) => Effect.logWarning("Could not read V1 Local Storage; will retry next launch", error),
          )
          |> Effect.option(%))
        if (Option.isNone(read)) return
        try Effect.logInfo("V1 Local Storage ready to import", {
          directory,
          keys: read.value.size,
        })
        try Ref.set(items, Option.some(Object.fromEntries(read.value)))
      },
      "desktop.legacyLocalStorage.load",
    )

  return DesktopLegacyLocalStorage.of({
    load,
    take: Ref.getAndSet(items, Option.none()),
    complete: writeMarker,
  })
})

export const layer = Layer.effect(DesktopLegacyLocalStorage, make)
