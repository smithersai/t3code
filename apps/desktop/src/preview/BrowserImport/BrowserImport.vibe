import type {
  BrowserImportInput,
  BrowserImportResult,
  BrowserImportSource,
  BrowserImportUnavailableReason,
} from "@t3tools/contracts"
import { BrowserImportFailureReason } from "@t3tools/contracts"
import * as Context from "effect/Context"
import type { Session } from "electron"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"
import { ChildProcessSpawner } from "effect/process"

import * as HostProcess from "@t3tools/shared/HostProcess"

import * as BrowserSession from "../BrowserSession.vibe"
import { ChromiumCookieReadError, readChromiumCookies } from "./ChromiumCookies.vibe"
import type { CookieReadResult } from "./CookieDatabase.vibe"
import { FirefoxCookieReadError, readFirefoxCookies } from "./FirefoxCookies.vibe"
import { readSafariCookies, safariAccessDenied, SafariCookieReadError } from "./SafariCookies.vibe"
import {
  BROWSER_IMPORT_SOURCES,
  resolveCookieDatabase,
  isSourceInstalled,
  isSourceRunning,
  listSourceProfiles,
  sourcePathContext,
  type BrowserImportPathContext,
  type BrowserImportSourceDefinition,
} from "./Sources.vibe"

export class BrowserImportFailedError extends Schema.TaggedError<BrowserImportFailedError>()(
  "BrowserImportFailedError",
  {
    sourceId: Schema.String,
    reason: BrowserImportFailureReason,
    cause: Schema.optional(Schema.Defect()),
  },
) {
  // IPC preserves only the message; the renderer needs its reason token for user-facing copy.
  override get message(): string {
    return `Importing cookies from ${this.sourceId} failed: ${this.reason}.`
  }
}

const BrowserCookieWriteErrorCauseField: Schema.Defect = Schema.Defect()
export schema error BrowserCookieWriteError {
  readonly url: string
  readonly name: string
  cause: BrowserCookieWriteErrorCauseField
  override get message(): string {
    return `Could not write imported cookie ${this.name} for ${this.url}.`
  }
}

export service BrowserImport: {
  readonly listSources: ReadonlyArray<BrowserImportSource>!!;
  readonly importCookies: (input: {
    readonly input: BrowserImportInput;
    readonly scope: string;
    readonly persistent: boolean;
    readonly namespace?: BrowserSession.BrowserSessionPartitionNamespace;
  }) => BrowserImportResult!BrowserImportFailedError;
} {
  static readonly key = "@t3tools/desktop/preview/BrowserImport/BrowserImport"
}

const unavailableReason = effect (
  definition: BrowserImportSourceDefinition,
  context: BrowserImportPathContext,
): (BrowserImportUnavailableReason | undefined)!never!(FileSystem.FileSystem | ChildProcessSpawner.ChildProcessSpawner) =>
  try withSpan(
    (effect (): (BrowserImportUnavailableReason | undefined)!never!(FileSystem.FileSystem | ChildProcessSpawner.ChildProcessSpawner) => {
      if (!definition.platforms.includes(context.platform)) return "unsupportedPlatform"
      if (!(try isSourceInstalled(definition, context))) return "notInstalled"
      if (try isSourceRunning(definition, context)) return "browserRunning"
      // TCC permits stat without Full Disk Access, so a listed Safari jar may still be unreadable.
      if (definition.engine === "safari") {
        const jar = try resolveCookieDatabase(definition, context, ".")
        if (jar !== undefined && (try safariAccessDenied(jar))) return "needsFullDiskAccess"
      }
      return undefined
    })(),
    "BrowserImport.unavailableReason",
  )

const cookieHost = (url: string): string => {
  try {
    return new URL(url).hostname
  } catch {
    return url
  }
}

export const writeCookies = effect (
  session: { readonly cookies: Pick<Session["cookies"], "set" | "flushStore"> },
  read: CookieReadResult,
) =>
  try withSpan(
    effect {
      let imported = 0
      let skipped = read.undecryptable
      const skippedDomains = new Set(read.undecryptableHosts)
      for (const cookie of read.cookies) {
        const written = (Effect.tryPromise({
          try: () =>
            session.cookies.set({
              url: cookie.url,
              name: cookie.name,
              value: cookie.value,
              // Electron widens any supplied domain; omit it for host-only cookies.
              ...(cookie.domain === undefined ? {} : { domain: cookie.domain }),
              path: cookie.path,
              secure: cookie.secure,
              httpOnly: cookie.httpOnly,
              sameSite: cookie.sameSite,
              ...(cookie.expirationDate === undefined ? {} : { expirationDate: cookie.expirationDate }),
            }),
          catch: (cause) => new BrowserCookieWriteError({ url: cookie.url, name: cookie.name, cause }),
        })
          |> Effect.as(%, true)
          |> Effect.tapError(%, (error) => Effect.logDebug(error.message, { cause: error.cause }))) catch (e) => match (e) {
            when { _tag: "BrowserCookieWriteError" }: false;
          }
        if (written) {
          imported += 1
        } else {
          skipped += 1
          skippedDomains.add(cookieHost(cookie.url))
        }
      }
      // Cookie writes settle in memory; flush to disk before reporting a durable import.
      if (imported > 0) {
        try (Effect.tryPromise(() => session.cookies.flushStore())
          |> Effect.tapError(
            %,
            (error) => Effect.logWarning("Imported cookies could not be flushed to disk", { cause: error.cause }),
          )
          |> Effect.ignore(%))
      }
      return { imported, skipped, skippedDomains: [...skippedDomains].slice(0, 20) }
    },
    "BrowserImport.writeCookies",
  )

/** @public */
export const make = effect {
  const browserSession = try BrowserSession.BrowserSession
  const platform = try HostProcess.Platform
  const executablePath = try HostProcess.ExecutablePath
  const platformServices = try Effect.context<
    FileSystem.FileSystem | Path.Path | ChildProcessSpawner.ChildProcessSpawner
  >()
  const pathContext = try sourcePathContext

  const listSources: ReadonlyArray<BrowserImportSource>!! = Effect.forEach(
    BROWSER_IMPORT_SOURCES,
    effect (definition) => {
      const unavailable = try unavailableReason(definition, pathContext)
      return {
        id: definition.id,
        name: definition.name,
        profiles: unavailable === undefined ? try listSourceProfiles(definition, pathContext) : [],
        ...(unavailable === undefined ? {} : { unavailable }),
      } satisfies BrowserImportSource
    },
  ) |> Effect.provide(%, platformServices)

  const importCookies = effect (
    input: {
      readonly input: BrowserImportInput
      readonly scope: string
      readonly persistent: boolean
      readonly namespace?: BrowserSession.BrowserSessionPartitionNamespace
    },
  ) =>
    try withSpan(
      effect {
        const definition = BROWSER_IMPORT_SOURCES.find(
          (candidate) => candidate.id === input.input.sourceId,
        )
        if (!definition) {
          throw new BrowserImportFailedError({
            sourceId: input.input.sourceId,
            reason: "unknownSource",
          })
        }

        const blocked = try effect {
          provide platformServices {
            return try unavailableReason(definition, pathContext)
          }
        }
        if (blocked !== undefined) {
          throw new BrowserImportFailedError({ sourceId: definition.id, reason: blocked })
        }

        if (platform === "darwin" && definition.engine === "chromium") {
          // macOS attributes Keychain prompts and ACL grants to the executable, which differs in dev and packaged builds.
          try Effect.logInfo("Reading browser cookie key from the keychain", {
            sourceId: definition.id,
            executablePath,
          })
        }

        // IPC profile paths must match the source's listing to prevent traversal outside browser user-data.
        const sourceProfiles = try effect {
          provide platformServices {
            return try listSourceProfiles(definition, pathContext)
          }
        }
        const requestedProfile = sourceProfiles.find(
          (profile) => profile.directory === input.input.sourceProfileDirectory,
        )
        if (requestedProfile === undefined) {
          throw new BrowserImportFailedError({
            sourceId: definition.id,
            reason: "unknownSourceProfile",
          })
        }

        // Re-resolve listed paths because Chromium jars may be under Network/.
        const databasePath = try effect {
          provide platformServices {
            return try resolveCookieDatabase(
              definition,
              pathContext,
              requestedProfile.directory,
            )
          }
        }
        if (databasePath === undefined) {
          throw new BrowserImportFailedError({ sourceId: definition.id, reason: "readFailed" })
        }

        const userDataDirectory = definition.userDataDirectory(pathContext)
        const read:
          CookieReadResult!(ChromiumCookieReadError | FirefoxCookieReadError | SafariCookieReadError)!(FileSystem.FileSystem | Path.Path | Scope.Scope | ChildProcessSpawner.ChildProcessSpawner) =
            definition.engine === "safari"
              ? (readSafariCookies(databasePath)
                |> Effect.map(%, (cookies) => ({ cookies, undecryptable: 0, undecryptableHosts: [] })))
              : definition.engine === "firefox"
              ? (readFirefoxCookies(databasePath)
                |> Effect.map(%, (cookies) => ({ cookies, undecryptable: 0, undecryptableHosts: [] })))
              : readChromiumCookies({
                cookieDatabasePath: databasePath,
                keychainService: definition.keychainService,
                keychainAccount: definition.keychainAccount,
                linuxSecretApplication: definition.linuxSecretApplication,
                ...(platform === "win32" && userDataDirectory !== undefined
                  ? {
                    windowsLocalStatePath: pathContext.path.join(userDataDirectory, "Local State"),
                  }
                  : {}),
                platform,
              })

        const result = (read
          |> Effect.scoped(%)
          |> Effect.provide(%, platformServices)) catch effect (cause) => match (cause) {
            when { _tag: "ChromiumCookieReadError" }: throw new BrowserImportFailedError({
              sourceId: definition.id,
              reason: cause.reason,
              cause,
            });
            when { _tag: "FirefoxCookieReadError" }: throw new BrowserImportFailedError({
              sourceId: definition.id,
              reason: "readFailed",
              cause,
            });
            when { _tag: "SafariCookieReadError" }: throw new BrowserImportFailedError({
              sourceId: definition.id,
              reason: cause.reason,
              cause,
            });
          }

        const session = browserSession
          .getSession(input.scope, input.persistent, input.namespace) catch effect (cause) => {
            throw new BrowserImportFailedError({
              sourceId: definition.id,
              reason: "sessionUnavailable",
              cause,
            })
          }

        // Chromium serializes writes; a rejected cookie should not prevent the others.
        return try writeCookies(session, result)
      },
      "BrowserImport.importCookies",
    )

  return BrowserImport.of({ listSources, importCookies })
}

export const layer = Layer.effect(BrowserImport, make)
