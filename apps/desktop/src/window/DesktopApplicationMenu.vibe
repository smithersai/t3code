import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import * as Schema from "effect/Schema";

import type * as Electron from "electron";

import { makeComponentLogger } from "../app/DesktopObservability.ts";
import * as ElectronDialog from "../electron/ElectronDialog.ts";
import * as ElectronMenu from "../electron/ElectronMenu.ts";
import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
import * as DesktopUpdates from "../updates/DesktopUpdates.ts";
import * as DesktopWindow from "./DesktopWindow.ts";

const DesktopApplicationMenuActionErrorCauseField: Schema.Defect = Schema.Defect()
export schema error DesktopApplicationMenuActionError {
  readonly action: string
  cause: DesktopApplicationMenuActionErrorCauseField
  override get message(): string {
    return `Desktop menu action "${this.action}" failed.`;
  }
}

export service DesktopApplicationMenu: {
  readonly configure: void!!;
} { static readonly key = "@t3tools/desktop/window/DesktopApplicationMenu" }

type DesktopApplicationMenuRuntimeServices =
  | DesktopUpdates.DesktopUpdates
  | DesktopWindow.DesktopWindow
  | ElectronDialog.ElectronDialog;

const { logInfo: logUpdaterInfo } = makeComponentLogger("desktop-updater");

const { logError: logMenuError } = makeComponentLogger("desktop-menu");

const dispatchMenuAction = effect (
  action: string,
): void!DesktopWindow.DesktopWindowError!DesktopWindow.DesktopWindow => try withSpan((effect (): void!DesktopWindow.DesktopWindowError!DesktopWindow.DesktopWindow => {
  const desktopWindow = try DesktopWindow.DesktopWindow;
  try desktopWindow.dispatchMenuAction(action, {
    reveal: action !== "paste-as-text",
  });
})(), "desktop.menu.dispatchMenuAction");

const zoomMainWindow = effect (
  direction: DesktopWindow.MainWindowZoomDirection,
): void!!DesktopWindow.DesktopWindow => try withSpan((effect (): void!!DesktopWindow.DesktopWindow => {
  const desktopWindow = try DesktopWindow.DesktopWindow;
  try desktopWindow.zoomMain(direction);
})(), "desktop.menu.zoomMainWindow");

const runMainContentsCommand = effect (
  command: DesktopWindow.MainWindowContentsCommand,
): void!!DesktopWindow.DesktopWindow => try withSpan((effect (): void!!DesktopWindow.DesktopWindow => {
  const desktopWindow = try DesktopWindow.DesktopWindow;
  try desktopWindow.runMainContentsCommand(command);
})(), "desktop.menu.runMainContentsCommand");

const checkForUpdatesFromMenu = effect {
  const updates = try DesktopUpdates.DesktopUpdates;
  const electronDialog = try ElectronDialog.ElectronDialog;
  const result = try updates.check("menu");
  const updateState = result.state;

  if (updateState.status === "up-to-date") {
    try electronDialog.showMessageBox({
      type: "info",
      title: "You're up to date!",
      message: `T3 Code ${updateState.currentVersion} is currently the newest version available.`,
      buttons: ["OK"],
    });
  } else if (updateState.status === "error") {
    try electronDialog.showMessageBox({
      type: "warning",
      title: "Update check failed",
      message: "Could not check for updates.",
      detail: updateState.message ?? "An unknown error occurred. Please try again later.",
      buttons: ["OK"],
    });
  }
} |> Effect.withSpan(%, "desktop.menu.checkForUpdates");

const handleCheckForUpdatesMenuClick = effect {
  const updates = try DesktopUpdates.DesktopUpdates;
  const electronDialog = try ElectronDialog.ElectronDialog;
  const disabledReason = try updates.disabledReason;
  if (Option.isSome(disabledReason)) {
    try logUpdaterInfo("manual update check requested, but updates are disabled", {
      disabledReason: disabledReason.value,
    });
    try electronDialog.showMessageBox({
      type: "info",
      title: "Updates unavailable",
      message: "Automatic updates are not available right now.",
      detail: disabledReason.value,
      buttons: ["OK"],
    });
    return;
  }

  // Opening a window before backend confirmation can strand it on failed auth bootstrap.
  const desktopWindow = try DesktopWindow.DesktopWindow;
  try desktopWindow.activate;
  try checkForUpdatesFromMenu;
} |> Effect.withSpan(%, "desktop.menu.handleCheckForUpdatesClick");

/** @public */
export const make = effect {
  const electronMenu = try ElectronMenu.ElectronMenu;
  const environment = try DesktopEnvironment.DesktopEnvironment;
  const context = try Effect.context<DesktopApplicationMenuRuntimeServices>();
  const runPromise = Effect.runPromiseWith(context);

  const runMenuEffect = <E>(
    action: string,
    effect: void!E!DesktopApplicationMenuRuntimeServices,
  ) => {
    void runPromise(
      effect
        |> Effect.annotateLogs({ action })(%)
        |> withSpan(%, "desktop.menu.action")
        |> Effect.catchCause(%, (cause) => {
          const error = new DesktopApplicationMenuActionError({ action, cause });
          return logMenuError(error.message, { error });
        }),
    );
  };

  const configure = effect {
    const checkForUpdatesClick = () => {
      runMenuEffect("check-for-updates", handleCheckForUpdatesMenuClick);
    };
    const settingsClick = () => {
      runMenuEffect("open-settings", dispatchMenuAction("open-settings"));
    };
    // Chromium and the renderer already handle this chord; injecting another paste duplicates text.
    const pasteAsTextClick = (
      _item: Electron.MenuItem,
      _window: Electron.BaseWindow | undefined,
      event: Electron.KeyboardEvent,
    ) => {
      if (event.triggeredByAccelerator === true) return;
      runMenuEffect("paste-as-text", dispatchMenuAction("paste-as-text"));
    };
    const zoomClick = (direction: DesktopWindow.MainWindowZoomDirection) => () => {
      runMenuEffect(`zoom-${direction}`, zoomMainWindow(direction));
    };
    const mainContentsClick = (command: DesktopWindow.MainWindowContentsCommand) => () => {
      runMenuEffect(command, runMainContentsCommand(command));
    };
    const template: Electron.MenuItemConstructorOptions[] = [];

    if (environment.platform === "darwin") {
      template.push({
        label: environment.displayName,
        submenu: [
          { role: "about", label: `About ${environment.displayName}` },
          {
            label: "Check for Updates...",
            click: checkForUpdatesClick,
          },
          { type: "separator" },
          {
            label: "Settings...",
            accelerator: "CmdOrCtrl+,",
            click: settingsClick,
          },
          { type: "separator" },
          { role: "services" },
          { type: "separator" },
          { role: "hide", label: `Hide ${environment.displayName}` },
          { role: "hideOthers" },
          { role: "unhide" },
          { type: "separator" },
          { role: "quit", label: `Quit ${environment.displayName}` },
        ],
      });
    }

    template.push(
      {
        label: "File",
        submenu: [
          ...(environment.platform === "darwin"
            ? []
            : [
                {
                  label: "Settings...",
                  accelerator: "CmdOrCtrl+,",
                  click: settingsClick,
                },
                { type: "separator" as const },
              ]),
          // Cmd/Ctrl+W belongs to the renderer's tab close; it must never close the window.
          environment.platform === "darwin"
            ? { label: "Close Window", click: (_item, window) => window?.close() }
            : { role: "quit" },
        ],
      },
      {
        label: "Edit",
        submenu: [
          { role: "undo" },
          { role: "redo" },
          { type: "separator" },
          { role: "cut" },
          { role: "copy" },
          { role: "paste" },
          {
            label: "Paste as Text",
            accelerator: "CmdOrCtrl+Shift+V",
            click: pasteAsTextClick,
          },
          { role: "delete" },
          { type: "separator" },
          { role: "selectAll" },
          ...(environment.platform === "darwin"
            ? [
                { type: "separator" as const },
                {
                  label: "Speech",
                  submenu: [{ role: "startSpeaking" as const }, { role: "stopSpeaking" as const }],
                },
              ]
            : []),
        ],
      },
      {
        label: "View",
        submenu: [
          /* Native reload/DevTools/zoom roles target focused guests; these commands must target the app. */
          { label: "Reload", accelerator: "CmdOrCtrl+R", click: mainContentsClick("reload") },
          {
            label: "Force Reload",
            accelerator: "Shift+CmdOrCtrl+R",
            click: mainContentsClick("forceReload"),
          },
          {
            label: "Toggle Developer Tools",
            accelerator: environment.platform === "darwin" ? "Alt+Command+I" : "Ctrl+Shift+I",
            click: mainContentsClick("toggleDevTools"),
          },
          { type: "separator" },
          { label: "Actual Size", accelerator: "CmdOrCtrl+0", click: zoomClick("reset") },
          { label: "Zoom In", accelerator: "CmdOrCtrl+=", click: zoomClick("in") },
          {
            label: "Zoom In",
            accelerator: "CmdOrCtrl+Plus",
            visible: false,
            click: zoomClick("in"),
          },
          ...(environment.platform === "darwin"
            ? [
                {
                  label: "Zoom In",
                  accelerator: "CmdOrCtrl+Shift+=",
                  visible: false,
                  click: zoomClick("in"),
                },
              ]
            : []),
          { label: "Zoom Out", accelerator: "CmdOrCtrl+-", click: zoomClick("out") },
          // Keypad codes do not match number-row accelerators.
          {
            label: "Actual Size",
            accelerator: "CmdOrCtrl+num0",
            visible: false,
            click: zoomClick("reset"),
          },
          {
            label: "Zoom In",
            accelerator: "CmdOrCtrl+numadd",
            visible: false,
            click: zoomClick("in"),
          },
          {
            label: "Zoom Out",
            accelerator: "CmdOrCtrl+numsub",
            visible: false,
            click: zoomClick("out"),
          },
          { type: "separator" },
          { role: "togglefullscreen" },
        ],
      },
      {
        // Electron's default Window submenu adds a Ctrl+W close role off macOS.
        role: "windowMenu",
        submenu: [
          { role: "minimize" },
          { role: "zoom" },
          ...(environment.platform === "darwin"
            ? [{ type: "separator" as const }, { role: "front" as const }]
            : []),
        ],
      },
      {
        role: "help",
        submenu: [
          {
            label: "Check for Updates...",
            click: checkForUpdatesClick,
          },
        ],
      },
    );

    try electronMenu.setApplicationMenu(template);
  } |> withSpan(%, "desktop.menu.configure");

  return DesktopApplicationMenu.of({
    configure,
  });
};

export const layer = Layer.effect(DesktopApplicationMenu, make);
