  export const $NodeFSP_mkdir: typeof NodeFSP.mkdir =
    ((...args: Parameters<typeof NodeFSP.mkdir>) => NodeFSP.mkdir(...args)) as typeof NodeFSP.mkdir
  export const $NodeFSP_mkdtemp: typeof NodeFSP.mkdtemp =
    ((...args: Parameters<typeof NodeFSP.mkdtemp>) => NodeFSP.mkdtemp(...args)) as typeof NodeFSP.mkdtemp
  export const $NodeFSP_writeFile: typeof NodeFSP.writeFile =
    ((...args: Parameters<typeof NodeFSP.writeFile>) => NodeFSP.writeFile(...args)) as typeof NodeFSP.writeFile
  export const $NodeFSP_rename: typeof NodeFSP.rename =
    ((...args: Parameters<typeof NodeFSP.rename>) => NodeFSP.rename(...args)) as typeof NodeFSP.rename
  export const $NodeOS_tmpdir: typeof NodeOS.tmpdir =
    ((...args: Parameters<typeof NodeOS.tmpdir>) => NodeOS.tmpdir(...args)) as typeof NodeOS.tmpdir
  export const $NodeURL_pathToFileURL: typeof NodeURL.pathToFileURL =
    ((...args: Parameters<typeof NodeURL.pathToFileURL>) =>
