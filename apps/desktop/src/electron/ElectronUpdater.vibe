import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"
import * as Scope from "effect/Scope"

import { autoUpdater } from "electron-updater"

type AutoUpdater = typeof autoUpdater

export type ElectronUpdaterFeedUrl = Parameters<AutoUpdater["setFeedURL"]>[0]

const ElectronUpdaterCheckForUpdatesErrorChannelField = Schema.NullOr(Schema.String)
const ElectronUpdaterCheckForUpdatesErrorCauseField = Schema.Defect()
export schema error ElectronUpdaterCheckForUpdatesError {
  channel: ElectronUpdaterCheckForUpdatesErrorChannelField
  cause: ElectronUpdaterCheckForUpdatesErrorCauseField
  override get message(): string {
    return `Electron updater failed to check for updates on channel ${this.channel ?? "default"}.`
  }
}

const ElectronUpdaterDownloadUpdateErrorChannelField = Schema.NullOr(Schema.String)
const ElectronUpdaterDownloadUpdateErrorCauseField = Schema.Defect()
export schema error ElectronUpdaterDownloadUpdateError {
  channel: ElectronUpdaterDownloadUpdateErrorChannelField
  cause: ElectronUpdaterDownloadUpdateErrorCauseField
  override get message(): string {
    return `Electron updater failed to download the update on channel ${this.channel ?? "default"}.`
  }
}

const ElectronUpdaterQuitAndInstallErrorChannelField = Schema.NullOr(Schema.String)
const ElectronUpdaterQuitAndInstallErrorCauseField = Schema.Defect()
export schema error ElectronUpdaterQuitAndInstallError {
  channel: ElectronUpdaterQuitAndInstallErrorChannelField
  isSilent: boolean
  isForceRunAfter: boolean
  cause: ElectronUpdaterQuitAndInstallErrorCauseField
  override get message(): string {
    return `Electron updater failed to quit and install the update on channel ${
      this.channel ?? "default"
    } (silent: ${this.isSilent}, force run after: ${this.isForceRunAfter}).`
  }
}

export schema ElectronUpdaterError =
  | ElectronUpdaterCheckForUpdatesError
  | ElectronUpdaterDownloadUpdateError
  | ElectronUpdaterQuitAndInstallError

export service ElectronUpdater {
  static readonly key = "@t3tools/desktop/electron/ElectronUpdater"
  setFeedURL: (options: ElectronUpdaterFeedUrl) => void!!
  setAutoDownload: (value: boolean) => void!!
  setAutoInstallOnAppQuit: (value: boolean) => void!!
  setChannel: (channel: string) => void!!
  setAllowPrerelease: (value: boolean) => void!!
  allowDowngrade: boolean!!
  setAllowDowngrade: (value: boolean) => void!!
  setFullChangelog: (value: boolean) => void!!
  setDisableDifferentialDownload: (value: boolean) => void!!
  checkForUpdates: void!ElectronUpdaterCheckForUpdatesError
  downloadUpdate: void!ElectronUpdaterDownloadUpdateError
  quitAndInstall: (options: {
    readonly isSilent: boolean
    readonly isForceRunAfter: boolean
  }) => void!ElectronUpdaterQuitAndInstallError
  on: <Args extends ReadonlyArray<unknown>>(
    eventName: string,
    listener: (...args: Args) => void,
  ) => void!never!Scope.Scope
}

/** @public */
export const make = ElectronUpdater.of({
  setFeedURL: Effect.fn("ElectronUpdater.setFeedURL")(function(options) {
    return Effect.suspend(() => {
      autoUpdater.setFeedURL(options)
      return Effect.void
    })
  }),
  setAutoDownload: Effect.fn("ElectronUpdater.setAutoDownload")(function(value) {
    return Effect.suspend(() => {
      autoUpdater.autoDownload = value
      return Effect.void
    })
  }),
  setAutoInstallOnAppQuit: Effect.fn("ElectronUpdater.setAutoInstallOnAppQuit")(function(value) {
    return Effect.suspend(() => {
      autoUpdater.autoInstallOnAppQuit = value
      return Effect.void
    })
  }),
  setChannel: Effect.fn("ElectronUpdater.setChannel")(function(channel) {
    return Effect.suspend(() => {
      autoUpdater.channel = channel
      return Effect.void
    })
  }),
  setAllowPrerelease: Effect.fn("ElectronUpdater.setAllowPrerelease")(function(value) {
    return Effect.suspend(() => {
      autoUpdater.allowPrerelease = value
      return Effect.void
    })
  }),
  allowDowngrade: effect {
    return autoUpdater.allowDowngrade
  },
  setAllowDowngrade: Effect.fn("ElectronUpdater.setAllowDowngrade")(function(value) {
    return Effect.suspend(() => {
      autoUpdater.allowDowngrade = value
      return Effect.void
    })
  }),
  setFullChangelog: Effect.fn("ElectronUpdater.setFullChangelog")(function(value) {
    return Effect.suspend(() => {
      autoUpdater.fullChangelog = value
      return Effect.void
    })
  }),
  setDisableDifferentialDownload: Effect.fn("ElectronUpdater.setDisableDifferentialDownload")(
    function(value) {
      return Effect.suspend(() => {
        autoUpdater.disableDifferentialDownload = value
        return Effect.void
      })
    },
  ),
  checkForUpdates: Effect.suspend(() => {
    const channel = autoUpdater.channel
    return Effect.tryPromise({
      try: () => autoUpdater.checkForUpdates(),
      catch: (cause) => new ElectronUpdaterCheckForUpdatesError({ channel, cause }),
    }) |> Effect.asVoid(%)
  }),
  downloadUpdate: Effect.suspend(() => {
    const channel = autoUpdater.channel
    return Effect.tryPromise({
      try: () => autoUpdater.downloadUpdate(),
      catch: (cause) => new ElectronUpdaterDownloadUpdateError({ channel, cause }),
    }) |> Effect.asVoid(%)
  }),
  quitAndInstall: Effect.fn("ElectronUpdater.quitAndInstall")(function({
    isSilent,
    isForceRunAfter,
  }) {
    return Effect.suspend(() => {
      const channel = autoUpdater.channel
      return Effect.try({
        try: () => autoUpdater.quitAndInstall(isSilent, isForceRunAfter),
        catch: (cause) =>
          new ElectronUpdaterQuitAndInstallError({
            channel,
            isSilent,
            isForceRunAfter,
            cause,
          }),
      })
    })
  }),
  on: Effect.fn("ElectronUpdater.on")(function(eventName, listener) {
    const eventTarget = autoUpdater as unknown as {
      on: (eventName: string, listener: (...args: Array<unknown>) => void) => void
      removeListener: (eventName: string, listener: (...args: Array<unknown>) => void) => void
    }
    const untypedListener = listener as unknown as (...args: Array<unknown>) => void
    return Effect.acquireRelease(
      effect {
        eventTarget.on(eventName, untypedListener)
      },
      effect () => {
        eventTarget.removeListener(eventName, untypedListener)
      },
    ) |> Effect.asVoid(%)
  }),
})

export const layer = Layer.succeed(ElectronUpdater, make)
