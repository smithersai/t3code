import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Option from "effect/Option"
import * as Schema from "effect/Schema"

import * as Electron from "electron"

const ElectronDialogPickFolderErrorOwnerWindowIdField: Schema.NullOr<Schema.Number> = Schema.NullOr(Schema.Number)
const ElectronDialogPickFolderErrorDefaultPathField: Schema.NullOr<Schema.String> = Schema.NullOr(Schema.String)
const ElectronDialogPickFolderErrorCauseField: Schema.Defect = Schema.Defect()
export schema error ElectronDialogPickFolderError {
  ownerWindowId: ElectronDialogPickFolderErrorOwnerWindowIdField
  defaultPath: ElectronDialogPickFolderErrorDefaultPathField
  cause: ElectronDialogPickFolderErrorCauseField
  override get message(): string {
    const owner = this.ownerWindowId === null ? "the application" : `window ${this.ownerWindowId}`
    const defaultPath = this.defaultPath === null ? "no default path" : this.defaultPath
    return `Failed to open the Electron folder picker for ${owner} with ${defaultPath}.`
  }
}

const ElectronDialogPickFilesErrorOwnerWindowIdField: Schema.NullOr<Schema.Number> = Schema.NullOr(Schema.Number)
const ElectronDialogPickFilesErrorDefaultPathField: Schema.NullOr<Schema.String> = Schema.NullOr(Schema.String)
const ElectronDialogPickFilesErrorCauseField: Schema.Defect = Schema.Defect()
export schema error ElectronDialogPickFilesError {
  ownerWindowId: ElectronDialogPickFilesErrorOwnerWindowIdField
  defaultPath: ElectronDialogPickFilesErrorDefaultPathField
  cause: ElectronDialogPickFilesErrorCauseField
  override get message(): string {
    const owner = this.ownerWindowId === null ? "the application" : `window ${this.ownerWindowId}`
    const defaultPath = this.defaultPath === null ? "no default path" : this.defaultPath
    return `Failed to open the Electron file picker for ${owner} with ${defaultPath}.`
  }
}

const ElectronDialogShowMessageBoxErrorTypeField: Schema.NullOr<
  Schema.Literals<readonly ["none", "info", "error", "question", "warning"]>
> = Schema.NullOr(Schema.Literals(["none", "info", "error", "question", "warning"]))
const ElectronDialogShowMessageBoxErrorTitleLengthField: Schema.NullOr<Schema.Number> = Schema.NullOr(Schema.Number)
const ElectronDialogShowMessageBoxErrorDetailLengthField: Schema.NullOr<Schema.Number> = Schema.NullOr(Schema.Number)
const ElectronDialogShowMessageBoxErrorCauseField: Schema.Defect = Schema.Defect()
export schema error ElectronDialogShowMessageBoxError {
  type: ElectronDialogShowMessageBoxErrorTypeField
  titleLength: ElectronDialogShowMessageBoxErrorTitleLengthField
  readonly messageLength: number
  detailLength: ElectronDialogShowMessageBoxErrorDetailLengthField
  readonly buttonCount: number
  cause: ElectronDialogShowMessageBoxErrorCauseField
  override get message(): string {
    const type = this.type === null ? "untyped" : this.type
    return `Failed to show the Electron ${type} message box with ${this.buttonCount} buttons.`
  }
}

const ElectronDialogShowErrorBoxErrorCauseField: Schema.Defect = Schema.Defect()
export schema error ElectronDialogShowErrorBoxError {
  readonly titleLength: number
  readonly contentLength: number
  cause: ElectronDialogShowErrorBoxErrorCauseField
  override get message(): string {
    return `Failed to show the Electron error box with a ${this.titleLength}-character title and ${this.contentLength}-character content.`
  }
}

export schema ElectronDialogError =
  | ElectronDialogPickFolderError
  | ElectronDialogPickFilesError
  | ElectronDialogShowMessageBoxError
  | ElectronDialogShowErrorBoxError

export interface ElectronDialogPickFolderInput {
  readonly owner: Option.Option<Electron.BrowserWindow>
  readonly defaultPath: Option.Option<string>
}

export interface ElectronDialogPickFilesInput {
  readonly owner: Option.Option<Electron.BrowserWindow>
  readonly defaultPath: Option.Option<string>
  readonly filters: readonly Electron.FileFilter[]
  readonly multiple: boolean
}

export service ElectronDialog: {
    readonly pickFolder: (
      input: ElectronDialogPickFolderInput,
    ) => Effect.Effect<Option.Option<string>, ElectronDialogPickFolderError>;
    readonly pickFiles: (
      input: ElectronDialogPickFilesInput,
    ) => readonly string[]!ElectronDialogPickFilesError;
    /** Pass `owner` to attach the box to that window so it cannot fall behind it. */
    readonly showMessageBox: (
      options: Electron.MessageBoxOptions,
      owner?: Electron.BrowserWindow,
    ) => Electron.MessageBoxReturnValue!ElectronDialogShowMessageBoxError;
    readonly showErrorBox: (title: string, content: string) => void!!;
  } {
  static readonly key = "@t3tools/desktop/electron/ElectronDialog"
}

/** @public */
export const make = ElectronDialog.of({
  pickFolder: effect (input): Option.Option<string>!ElectronDialogPickFolderError!never =>
    try withSpan(
      (effect (): Option.Option<string>!ElectronDialogPickFolderError!never => {
        const ownerWindowId = do {
          const $optionSubject = input.owner
          const $optionHandlers: { onNone: () => null; onSome: (owner: Electron.BrowserWindow) => number } = {
            onNone: () => null,
            onSome: (owner) => owner.id,
          }
          const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
          match ($optionSubject) {
            when Option.Some(let $optionValue): $optionSome($optionValue);
            default: $optionNone();
          }
        }
        const defaultPath = Option.getOrNull(input.defaultPath)
        const openDialogOptions: Electron.OpenDialogOptions = do {
          const $optionSubject = input.defaultPath
          const $optionHandlers: {
            onNone: () => { properties: ("createDirectory" | "openDirectory")[] }
            onSome: (
              defaultPath: string,
            ) => { properties: ("createDirectory" | "openDirectory")[]; defaultPath: string }
          } = {
            onNone: () => ({
              properties: ["openDirectory", "createDirectory"],
            }),
            onSome: (defaultPath) => ({
              properties: ["openDirectory", "createDirectory"],
              defaultPath,
            }),
          }
          const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
          match ($optionSubject) {
            when Option.Some(let $optionValue): $optionSome($optionValue);
            default: $optionNone();
          }
        }
        const result = try Effect.tryPromise({
          try: () =>
            Option.match(input.owner, {
              onNone: () => Electron.dialog.showOpenDialog(openDialogOptions),
              onSome: (owner) => Electron.dialog.showOpenDialog(owner, openDialogOptions),
            }),
          catch: (cause) =>
            new ElectronDialogPickFolderError({
              ownerWindowId,
              defaultPath,
              cause,
            }),
        })

        if (result.canceled) {
          return Option.none()
        }
        return Option.fromNullishOr(result.filePaths[0])
      })(),
      "desktop.electron.dialog.pickFolder",
    ),
  pickFiles: effect (input): readonly string[]!ElectronDialogPickFilesError!never =>
    try withSpan(
      (effect (): readonly string[]!ElectronDialogPickFilesError!never => {
        const ownerWindowId = do {
          const $optionSubject = input.owner
          const $optionHandlers: { onNone: () => null; onSome: (owner: Electron.BrowserWindow) => number } = {
            onNone: () => null,
            onSome: (owner) => owner.id,
          }
          const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
          match ($optionSubject) {
            when Option.Some(let $optionValue): $optionSome($optionValue);
            default: $optionNone();
          }
        }
        const defaultPath = Option.getOrNull(input.defaultPath)
        const openDialogOptions: Electron.OpenDialogOptions = {
          properties: input.multiple ? ["openFile", "multiSelections"] : ["openFile"],
          filters: [...input.filters],
          ...(defaultPath === null ? {} : { defaultPath }),
        }
        const result = try Effect.tryPromise({
          try: () =>
            Option.match(input.owner, {
              onNone: () => Electron.dialog.showOpenDialog(openDialogOptions),
              onSome: (owner) => Electron.dialog.showOpenDialog(owner, openDialogOptions),
            }),
          catch: (cause) =>
            new ElectronDialogPickFilesError({
              ownerWindowId,
              defaultPath,
              cause,
            }),
        })
        return result.canceled ? [] : result.filePaths
      })(),
      "desktop.electron.dialog.pickFiles",
    ),
  showMessageBox: Effect.fn("ElectronDialog.showMessageBox")(function(options, owner) {
    return Effect.tryPromise({
      try: () =>
        owner === undefined
          ? Electron.dialog.showMessageBox(options)
          : Electron.dialog.showMessageBox(owner, options),
      catch: (cause) =>
        new ElectronDialogShowMessageBoxError({
          type: options.type ?? null,
          titleLength: options.title?.length ?? null,
          messageLength: options.message.length,
          detailLength: options.detail?.length ?? null,
          buttonCount: options.buttons?.length ?? 0,
          cause,
        }),
    })
  }),
  showErrorBox: Effect.fn("ElectronDialog.showErrorBox")(function(title, content) {
    return Effect.try({
      try: () => Electron.dialog.showErrorBox(title, content),
      catch: (cause) =>
        new ElectronDialogShowErrorBoxError({
          titleLength: title.length,
          contentLength: content.length,
          cause,
        }),
    }) |> Effect.orDie(%)
  }),
})

export const layer = Layer.succeed(ElectronDialog, make)
