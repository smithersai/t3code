import { DesktopThemeSchema, type DesktopTheme } from "@t3tools/contracts"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"
import * as Scope from "effect/Scope"

import * as Electron from "electron"

const ElectronThemeSetSourceErrorCauseField: Schema.Defect = Schema.Defect()
export schema error ElectronThemeSetSourceError {
  readonly source: DesktopThemeSchema
  cause: ElectronThemeSetSourceErrorCauseField
  override get message(): string {
    return `Failed to set the Electron theme source to ${this.source}.`
  }
}

export service ElectronTheme: {
  readonly shouldUseDarkColors: boolean!!;
  readonly setSource: (theme: DesktopTheme) => void!ElectronThemeSetSourceError;
  readonly onUpdated: (listener: () => void) => void!never!Scope.Scope;
} {
  static readonly key = "@t3tools/desktop/electron/ElectronTheme"
}

/** @public */
export const make = ElectronTheme.of({
  shouldUseDarkColors: effect {
    return Electron.nativeTheme.shouldUseDarkColors
  },
  setSource: Effect.fn("ElectronTheme.setSource")(function(theme) {
    return Effect.try({
      try: () => {
        Electron.nativeTheme.themeSource = theme
      },
      catch: (cause) => new ElectronThemeSetSourceError({ source: theme, cause }),
    })
  }),
  onUpdated: Effect.fn("ElectronTheme.onUpdated")(function(listener) {
    return Effect.acquireRelease(
      effect {
        try Effect.orDie(Effect.try({
          try: () => Electron.nativeTheme.on("updated", listener),
          catch: (error) => error,
        }))
      },
      () =>
        effect {
          try Effect.orDie(Effect.try({
            try: () => Electron.nativeTheme.removeListener("updated", listener),
            catch: (error) => error,
          }))
        },
    )
  }),
})

export const layer = Layer.succeed(ElectronTheme, make)
