import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import * as Option from "effect/Option";
import * as Schema from "effect/Schema";

import * as FileSystem from "effect/FileSystem";
import { HttpClient } from "effect/http";
import { ChildProcessSpawner } from "effect/process";

import * as DesktopBackendConfiguration from "./DesktopBackendConfiguration.ts";
import * as DesktopBackendManager from "./DesktopBackendManager.vibe";
import * as DesktopObservability from "../app/DesktopObservability.ts";
import * as DesktopState from "../app/DesktopState.vibe";
import * as DesktopAppSettings from "../settings/DesktopAppSettings.ts";
import * as DesktopTelemetryPublisher from "../telemetry/DesktopTelemetryPublisher.ts";
import * as DesktopBrowserHost from "../preview/DesktopBrowserHost.ts";
import * as DesktopWindow from "../window/DesktopWindow.vibe";
import * as DesktopWslEnvironment from "../wsl/DesktopWslEnvironment.ts";
import * as ElectronDialog from "../electron/ElectronDialog.vibe";
import * as ElectronApp from "../electron/ElectronApp.ts";

const { logWarning: logBackendPoolWarning } =
  DesktopObservability.makeComponentLogger("desktop-backend-pool");

export type BackendInstanceId = DesktopBackendManager.BackendInstanceId;
export const BackendInstanceId = DesktopBackendManager.BackendInstanceId;
export const PRIMARY_INSTANCE_ID = DesktopBackendManager.PRIMARY_INSTANCE_ID;
export type DesktopBackendInstance = DesktopBackendManager.DesktopBackendInstance;
export type BackendInstanceSpec = DesktopBackendManager.BackendInstanceSpec;

export schema error DesktopBackendPoolInstanceAlreadyRegisteredError {
  readonly id: string
  override get message() {
    return `Backend instance "${this.id}" is already registered in the pool.`;
  }
}

export schema error DesktopBackendPoolCannotUnregisterPrimaryError {
  override get message() {
    return "Refusing to unregister the primary backend from the pool.";
  }
}

export service DesktopBackendPool: {
  readonly get: (id: BackendInstanceId) => Effect.Effect<Option.Option<DesktopBackendInstance>>;
  readonly list: readonly DesktopBackendInstance[]!!;
  readonly primary: DesktopBackendInstance!!;
  readonly register: (
    spec: BackendInstanceSpec,
  ) => DesktopBackendInstance!DesktopBackendPoolInstanceAlreadyRegisteredError;
  readonly unregister: (
    id: BackendInstanceId,
  ) => void!DesktopBackendPoolCannotUnregisterPrimaryError;
} { static readonly key = "@t3tools/desktop/backend/DesktopBackendPool" }

export type BackendInstanceFactoryRequirements =
  | FileSystem.FileSystem
  | ChildProcessSpawner.ChildProcessSpawner
  | HttpClient.HttpClient
  | DesktopObservability.DesktopBackendOutputLogFactory
  | DesktopTelemetryPublisher.DesktopTelemetryPublisher
  | DesktopBrowserHost.DesktopBrowserHost
  | DesktopWslEnvironment.DesktopWslEnvironment;

interface ActiveRegisteredInstance {
  readonly _tag: "Active";
  readonly instance: DesktopBackendInstance;
  readonly scope: Option.Option<Scope.Closeable>;
}

interface ClosingRegisteredInstance {
  readonly _tag: "Closing";
  readonly done: Deferred.Deferred<void>;
}

type RegisteredInstance = ActiveRegisteredInstance | ClosingRegisteredInstance;

type RegisterAction =
  | { readonly _tag: "Registered"; readonly instance: DesktopBackendInstance }
  | { readonly _tag: "Wait"; readonly done: Deferred.Deferred<void> };

type UnregisterAction =
  | { readonly _tag: "Absent" }
  | { readonly _tag: "Wait"; readonly done: Deferred.Deferred<void> }
  | { readonly _tag: "Close"; readonly entry: ActiveRegisteredInstance };

export const layer = Layer.effect(
  DesktopBackendPool,
  effect {
    const configuration = try DesktopBackendConfiguration.DesktopBackendConfiguration;
    const desktopWindow = try DesktopWindow.DesktopWindow;
    const electronDialog = try ElectronDialog.ElectronDialog;
    const electronApp = try ElectronApp.ElectronApp;
    const appSettings = try DesktopAppSettings.DesktopAppSettings;
    const { primaryBackendStartup } = try DesktopState.DesktopState;
    // Parent instance scopes to the pool so shutdown runs stop finalizers before the OS kills backends.
    const layerScope = try Scope.Scope;
    const factoryContext = try Effect.context<BackendInstanceFactoryRequirements>();

    // Persist fatal Windows fallbacks; transient transport failures must preserve the user's WSL preference.
    const handlePrimaryPreflightFailure = effect (failure: DesktopBackendManager.PreflightFailure) => try withSpan(effect {
      const { reason, fatal } = failure;
      if (!fatal) {
        try logBackendPoolWarning(
          "primary WSL preflight retry window exhausted; using Windows for this launch",
          { reason },
        );
        try electronDialog.showErrorBox(
          "WSL backend is still unavailable",
          `${reason}\n\nT3 Code will use the Windows backend for this launch and retry WSL the next time the app starts.`,
        );
        try appSettings.applyWslWindowsFallbackInMemory;
        return true;
      }

      try logBackendPoolWarning("primary WSL preflight failed; falling back to Windows", {
        reason,
      });
      try electronDialog.showErrorBox(
        "WSL backend couldn't start",
        `${reason}\n\nFalling back to the Windows backend so T3 Code can open. Re-enable the WSL backend from Settings > Sharing & access once the WSL distro is fixed.`,
      );
      // Clear wslOnly too so enabling WSL cannot restore a failed mode.
      // Keep the in-memory fallback if persistence fails.
      appSettings.applyWslWindowsFallback catch effect (error) => try (logBackendPoolWarning(
            "failed to persist Windows fallback after WSL preflight failure",
            {
              error: error.message,
            },
          ) |> Effect.andThen(%, appSettings.applyWslWindowsFallbackInMemory));
      return true;
    }, "desktop.backendPool.primaryPreflightFailed");

    const primary = try DesktopBackendManager.makeBackendInstance({
      id: DesktopBackendManager.PRIMARY_INSTANCE_ID,
      // Resolve lazily: startup loads persisted settings after pool initialization.
      label: configuration.resolvePrimaryLabel,
      configResolve: configuration.resolvePrimary,
      // Absorb window errors so readiness can reset restartAttempt.
      onReady: (httpBaseUrl) =>
        do { const catchProgram = (desktopWindow.handleBackendReady(httpBaseUrl)
          // Only once the main window exists, so the recovery window never closes into nothing.
          |> Effect.andThen(%, SubscriptionRef.set(primaryBackendStartup, { _tag: "Ready" }))); effect { return catchProgram catch effect (error) => try logBackendPoolWarning("failed to open main window after backend readiness", {
              error: error.message,
            }) } },
      onStartupFailure: (failure) =>
        SubscriptionRef.set(primaryBackendStartup, { _tag: "Failing", ...failure }),
      onShutdown: () => desktopWindow.handleBackendNotReady,
      onPreflightFailed: handlePrimaryPreflightFailure,
      onStateDirOwned: () =>
        electronDialog
          .showErrorBox(
            "This T3 home is unavailable",
            "Another T3 Code server, such as the background service, is using this data directory, or an older background service is set up for it. Stop that server or try `t3 update`. If the older launcher cannot update, run `t3 service uninstall` and optionally reinstall with `t3 service install` from a current CLI. Use `npx t3@latest` if `t3` is missing or outdated, and pass `--base-dir` with the service's T3 home to each command. Then reopen T3 Code. You can also set a separate T3CODE_HOME and pair with the running server.",
          )|> Effect.andThen(%, electronApp.quit),
    });

    const instancesRef = try SynchronizedRef.make<
      ReadonlyMap<BackendInstanceId, RegisteredInstance>
    >(
      new Map([
        [
          DesktopBackendManager.PRIMARY_INSTANCE_ID,
          { _tag: "Active", instance: primary, scope: Option.none() },
        ],
      ]),
    );

    const register: DesktopBackendPool["Service"]["register"] = effect (spec) =>
      try (SynchronizedRef.modifyEffect(
          instancesRef,
          (
            current,
          ): readonly [RegisterAction, ReadonlyMap<BackendInstanceId, RegisteredInstance>]!DesktopBackendPoolInstanceAlreadyRegisteredError => {
            const existing = current.get(spec.id);
            if (existing?._tag === "Active") {
              return Effect.fail(
                new DesktopBackendPoolInstanceAlreadyRegisteredError({ id: spec.id }),
              );
            }
            if (existing?._tag === "Closing") {
              return Effect.succeed([
                { _tag: "Wait", done: existing.done } as const,
                current,
              ] as const);
            }
            return effect {
              // Provide the child Scope last so the captured pool Scope cannot shadow it and orphan stop/restart finalizers.
              const instanceScope = try Scope.fork(layerScope, "sequential");
              const instance = try effect { provide factoryContext { return try (DesktopBackendManager.makeBackendInstance(spec)
                |> Scope.provide(%, instanceScope)) } };
              const next = new Map(current);
              next.set(spec.id, {
                _tag: "Active",
                instance,
                scope: Option.some(instanceScope),
              });
              return [
                { _tag: "Registered", instance } as const,
                next as ReadonlyMap<BackendInstanceId, RegisteredInstance>,
              ] as const;
            };
          },
        )
          |> Effect.flatMap(%, (result) =>
            result._tag === "Registered"
              ? Effect.succeed(result.instance)
              : (Deferred.await(result.done) |> Effect.andThen(%, register(spec))),
          ));

    const unregister: DesktopBackendPool["Service"]["unregister"] = effect (id): void!DesktopBackendPoolCannotUnregisterPrimaryError!never => try withSpan((effect (): void!DesktopBackendPoolCannotUnregisterPrimaryError!never => {
      if (id === DesktopBackendManager.PRIMARY_INSTANCE_ID) {
        throw new DesktopBackendPoolCannotUnregisterPrimaryError();
      }
      const done = try Deferred.make<void>();
      const action = try SynchronizedRef.modifyEffect(
        instancesRef,
        (
          current,
        ): readonly [UnregisterAction, ReadonlyMap<BackendInstanceId, RegisteredInstance>]!! => {
          const entry = current.get(id);
          if (entry === undefined) {
            return Effect.succeed([{ _tag: "Absent" } as const, current] as const);
          }
          if (entry._tag === "Closing") {
            return Effect.succeed([{ _tag: "Wait", done: entry.done } as const, current] as const);
          }
          const next = new Map(current);
          next.set(id, { _tag: "Closing", done });
          return Effect.succeed([
            { _tag: "Close", entry } as const,
            next as ReadonlyMap<BackendInstanceId, RegisteredInstance>,
          ] as const);
        },
      );

      if (action._tag === "Absent") return;
      if (action._tag === "Wait") {
        try Deferred.await(action.done);
        return;
      }

      const finish = SynchronizedRef.modifyEffect(instancesRef, (current) => {
        const closing = current.get(id);
        if (closing?._tag !== "Closing" || closing.done !== done) {
          return Effect.succeed([undefined, current] as const);
        }
        const next = new Map(current);
        next.delete(id);
        return Effect.succeed([
          undefined,
          next as ReadonlyMap<BackendInstanceId, RegisteredInstance>,
        ] as const);
      }) |> Effect.andThen(%, Deferred.succeed(done, undefined)) |> Effect.asVoid(%);
      try (do { const $optionSubject = action.entry.scope; const $optionHandlers: { onNone: () => void!never!never; onSome: (scope: Scope.Closeable) => void!never!never; } = {
        onNone: () => Effect.void,
        onSome: (scope) => Scope.close(scope, Exit.void) |> Effect.ignore(%),
      }; const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers; match ($optionSubject) { when Option.Some(let $optionValue): $optionSome($optionValue); default: $optionNone(); }; } |> Effect.ensuring(%, finish));
    })(), "DesktopBackendPool.unregister");

    return DesktopBackendPool.of({
      get: Effect.fn("DesktopBackendPool.get")(function (id) {
        return SynchronizedRef.get(instancesRef)
          |> Effect.map(%, (instances) => {
            const entry = instances.get(id);
            return entry?._tag === "Active" ? Option.some(entry.instance) : Option.none();
          });
      }),
      list: SynchronizedRef.get(instancesRef)
        |> Effect.map(%, (instances) =>
          Array.from(instances.values()).flatMap((entry) =>
            entry._tag === "Active" ? [entry.instance] : [],
          ),
        ),
      primary: Effect.succeed(primary),
      register,
      unregister,
    });
  },
);

export const layerTest = (
  instances: readonly DesktopBackendInstance[],
): Layer.Layer<DesktopBackendPool> =>
  Layer.effect(
    DesktopBackendPool,
    effect {
      if (instances.length === 0) {
        return try Effect.die("DesktopBackendPool.layerTest requires at least one instance");
      }
      const byId = new Map<BackendInstanceId, DesktopBackendInstance>(
        instances.map((instance) => [instance.id, instance] as const),
      );
      const primary = instances[0]!;
      return DesktopBackendPool.of({
        get: Effect.fn("DesktopBackendPool.get")(function (id) {
          return Effect.succeed(Option.fromNullishOr(byId.get(id)));
        }),
        list: Effect.succeed(Array.from(byId.values())),
        primary: Effect.succeed(primary),
        register: Effect.fn("DesktopBackendPool.register")(function () {
          return Effect.die("DesktopBackendPool.layerTest does not support register");
        }),
        unregister: Effect.fn("DesktopBackendPool.unregister")(function () {
          return Effect.die("DesktopBackendPool.layerTest does not support unregister");
        }),
      });
    },
  );
