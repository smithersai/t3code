export const getUpdateState = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.UPDATE_GET_STATE_CHANNEL,
  payload: Schema.Void,
  result: DesktopUpdateStateSchema,
  handler:
    effect (): { readonly enabled: boolean; readonly status: "available" | "checking" | "disabled" | "downloaded" | "downloading" | "error" | "idle" | "up-to-date"; readonly channel: "latest" | "nightly"; readonly currentVersion: string; readonly hostArch: "arm64" | "other" | "x64"; readonly appArch: "arm64" | "other" | "x64"; readonly runningUnderArm64Translation: boolean; readonly availableVersion: string | null; readonly downloadedVersion: string | null; readonly releaseNotes: readonly { readonly version: string; readonly items: readonly string[]; readonly totalItems: number; }[]; readonly omittedReleaseCount: number; readonly downloadPercent: number | null; readonly checkedAt: string | null; readonly message: string | null; readonly errorContext: "check" | "download" | "install" | null; readonly canRetry: boolean; readonly notAppliedVersion?: string; }!never!DesktopUpdates.DesktopUpdates =>
      try withSpan(
        (effect (): { readonly enabled: boolean; readonly status: "available" | "checking" | "disabled" | "downloaded" | "downloading" | "error" | "idle" | "up-to-date"; readonly channel: "latest" | "nightly"; readonly currentVersion: string; readonly hostArch: "arm64" | "other" | "x64"; readonly appArch: "arm64" | "other" | "x64"; readonly runningUnderArm64Translation: boolean; readonly availableVersion: string | null; readonly downloadedVersion: string | null; readonly releaseNotes: readonly { readonly version: string; readonly items: readonly string[]; readonly totalItems: number; }[]; readonly omittedReleaseCount: number; readonly downloadPercent: number | null; readonly checkedAt: string | null; readonly message: string | null; readonly errorContext: "check" | "download" | "install" | null; readonly canRetry: boolean; readonly notAppliedVersion?: string; }!never!DesktopUpdates.DesktopUpdates => {
          const updates = try DesktopUpdates.DesktopUpdates
          return try updates.getState
        })(),
        "desktop.ipc.updates.getState",
      ),
})

export const setUpdateChannel = DesktopIpc.makeIpcMethod({
