const tabMethod = (
  channel: string,
  name: string,
  invoke: (
    manager: PreviewManager.PreviewManager["Service"],
    tabId: string,
  ) => void!PreviewManager.PreviewManagerError,
): infer _ =>
  DesktopIpc.makeIpcMethod({
    channel,
    payload: DesktopPreviewTabInputSchema,
    result: Schema.Void,
    handler: effect ({ tabId }) =>
      try withSpan(
        effect {
          const manager = try PreviewManager.PreviewManager
          try invoke(manager, tabId)
        },
        name,
      ),
  })
