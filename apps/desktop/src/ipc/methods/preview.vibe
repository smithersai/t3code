const clearCookies = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.PREVIEW_CLEAR_COOKIES_CHANNEL,
  payload: DesktopPreviewClearDataInputSchema,
  result: Schema.Void,
  handler: effect ({ environmentId, profileId }) =>
    try withSpan(
      effect {
        const manager = try PreviewManager.PreviewManager
        try manager.clearCookies(try resolveClearPartitions(manager, environmentId, profileId))
      },
      "desktop.ipc.preview.clearCookies",
    ),
})
const clearCache = DesktopIpc.makeIpcMethod({
