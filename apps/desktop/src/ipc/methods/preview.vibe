export const installPreviewEventForwarding = effect () =>
  try withSpan(
    effect {
      const electronWindow = try ElectronWindow.ElectronWindow
      const manager = try PreviewManager.PreviewManager
      try manager.subscribeStateChanges(effect (tabId, state) =>
        try electronWindow.sendAll(IpcChannels.PREVIEW_STATE_CHANGE_CHANNEL, tabId, state)
      )
      try manager.subscribeRecordingFrames(effect (frame) =>
        try electronWindow.sendAll(IpcChannels.PREVIEW_RECORDING_FRAME_CHANNEL, frame)
      )
      try manager.subscribeRecordingInputs(effect (event) =>
        try electronWindow.sendAll(IpcChannels.PREVIEW_RECORDING_INPUT_CHANNEL, event)
      )
      try manager.subscribePointerEvents(effect (event) =>
        try electronWindow.sendAll(IpcChannels.PREVIEW_POINTER_EVENT_CHANNEL, event)
      )
      try manager.subscribeOpenLinks(effect (event) =>
        try electronWindow.sendAll(IpcChannels.PREVIEW_OPEN_LINK_CHANNEL, event)
      )
    },
    "desktop.ipc.preview.installEventForwarding",
  )
const setForwardedShortcuts = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.PREVIEW_SET_FORWARDED_SHORTCUTS_CHANNEL,
  payload: Schema.Array(PreviewForwardedShortcut).check(Schema.isMaxLength(MAX_KEYBINDINGS_COUNT)),
  result: Schema.Void,
  handler: effect (shortcuts) =>
    try withSpan(
      effect {
        const manager = try PreviewManager.PreviewManager
        try manager.setForwardedShortcuts(shortcuts)
      },
      "desktop.ipc.preview.setForwardedShortcuts",
    ),
})
