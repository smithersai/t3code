export const setClientSettings = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.SET_CLIENT_SETTINGS_CHANNEL,
  payload: ClientSettingsSchema,
  result: Schema.Void,
  handler: effect (settings): void!DesktopClientSettings.DesktopClientSettingsWriteError!(DesktopClientSettings.DesktopClientSettings | DesktopSnapShot.DesktopSnapShot) => try withSpan((effect (): void!DesktopClientSettings.DesktopClientSettingsWriteError!(DesktopClientSettings.DesktopClientSettings | DesktopSnapShot.DesktopSnapShot) => {
