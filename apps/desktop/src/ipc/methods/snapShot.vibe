export const listPendingSnapShots = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.LIST_PENDING_SNAP_SHOTS_CHANNEL,
  payload: Schema.Void,
  result: Schema.Array(DesktopPendingSnapShot),
  handler: effect (_, event): readonly { readonly id: string; readonly name: string; readonly mimeType: "image/png"; readonly sizeBytes: number; readonly source: { readonly kind: "snap-shot"; readonly capturedAt: string; readonly appName: string; readonly windowTitle: string; readonly accessibleText?: string | undefined; readonly accessibility?: { readonly format: "flat-text"; readonly text: string; readonly truncated: boolean; } | { readonly format: "element-tree"; readonly coordinateSpace: "captured-image"; readonly imageSize: { readonly width: number; readonly height: number; }; readonly truncated: boolean; readonly root: import("@t3tools/contracts").SnapShotAccessibilityNode; } | undefined; readonly appIdentifier?: string | undefined; readonly appIconDataUrl?: string | undefined; }; }[]!(DesktopSnapShot.DesktopSnapShotError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => try withSpan((effect (): readonly { readonly id: string; readonly name: string; readonly mimeType: "image/png"; readonly sizeBytes: number; readonly source: { readonly kind: "snap-shot"; readonly capturedAt: string; readonly appName: string; readonly windowTitle: string; readonly accessibleText?: string | undefined; readonly accessibility?: { readonly format: "flat-text"; readonly text: string; readonly truncated: boolean; } | { readonly format: "element-tree"; readonly coordinateSpace: "captured-image"; readonly imageSize: { readonly width: number; readonly height: number; }; readonly truncated: boolean; readonly root: import("@t3tools/contracts").SnapShotAccessibilityNode; } | undefined; readonly appIdentifier?: string | undefined; readonly appIconDataUrl?: string | undefined; }; }[]!(DesktopSnapShot.DesktopSnapShotError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => {
    try ensureTrustedSnapShotSender(event);
    return try (try DesktopSnapShot.DesktopSnapShot).listPending;
  })(), "desktop.ipc.snapShot.listPending"),
});

export const readSnapShot = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.READ_SNAP_SHOT_CHANNEL,
  payload: DesktopSnapShotId,
  result: DesktopSnapShotSchema,
  handler: effect (id, event): { readonly id: string; readonly name: string; readonly mimeType: "image/png"; readonly sizeBytes: number; readonly source: { readonly kind: "snap-shot"; readonly capturedAt: string; readonly appName: string; readonly windowTitle: string; readonly accessibleText?: string | undefined; readonly accessibility?: { readonly format: "flat-text"; readonly text: string; readonly truncated: boolean; } | { readonly format: "element-tree"; readonly coordinateSpace: "captured-image"; readonly imageSize: { readonly width: number; readonly height: number; }; readonly truncated: boolean; readonly root: import("@t3tools/contracts").SnapShotAccessibilityNode; } | undefined; readonly appIdentifier?: string | undefined; readonly appIconDataUrl?: string | undefined; }; readonly dataUrl: string; }!(DesktopSnapShot.DesktopSnapShotError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => try withSpan((effect (): { readonly id: string; readonly name: string; readonly mimeType: "image/png"; readonly sizeBytes: number; readonly source: { readonly kind: "snap-shot"; readonly capturedAt: string; readonly appName: string; readonly windowTitle: string; readonly accessibleText?: string | undefined; readonly accessibility?: { readonly format: "flat-text"; readonly text: string; readonly truncated: boolean; } | { readonly format: "element-tree"; readonly coordinateSpace: "captured-image"; readonly imageSize: { readonly width: number; readonly height: number; }; readonly truncated: boolean; readonly root: import("@t3tools/contracts").SnapShotAccessibilityNode; } | undefined; readonly appIdentifier?: string | undefined; readonly appIconDataUrl?: string | undefined; }; readonly dataUrl: string; }!(DesktopSnapShot.DesktopSnapShotError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => {
    try ensureTrustedSnapShotSender(event);
    return try (try DesktopSnapShot.DesktopSnapShot).read(id);
  })(), "desktop.ipc.snapShot.read"),
});

export const setSnapShotAnimationDestination = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.SET_SNAP_SHOT_ANIMATION_DESTINATION_CHANNEL,
  payload: DesktopSnapShotAnimationDestination,
  result: Schema.Void,
  handler: effect (destination, event): void!SnapShotIpcUnauthorizedSenderError!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => try withSpan((effect (): void!SnapShotIpcUnauthorizedSenderError!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => {
    const window = try ensureTrustedSnapShotSender(event);
    if (
      destination.viewportFrame.width <= 0 ||
      destination.viewportFrame.height <= 0 ||
      destination.borderWidth < 0 ||
      destination.cornerRadius < 0
    ) {
      return;
    }
    try (try DesktopSnapShot.DesktopSnapShot).setAnimationDestination(destination.id, {
      relativeFrame: snapShotRelativeFrame(
        destination.viewportFrame,
        try Effect.orDie(Effect.try({ try: () => window.getContentBounds(), catch: (e) => e })),
        try Effect.orDie(Effect.try({ try: () => window.webContents.getZoomFactor(), catch: (e) => e })),
      ),
      frame: snapShotScreenFrame(
        destination.viewportFrame,
        try Effect.orDie(Effect.try({ try: () => window.getContentBounds(), catch: (e) => e })),
        try Effect.orDie(Effect.try({ try: () => window.webContents.getZoomFactor(), catch: (e) => e })),
      ),
      backgroundColor: destination.backgroundColor,
      borderColor: destination.borderColor,
      borderWidth: destination.borderWidth * (try Effect.orDie(Effect.try({ try: () => window.webContents.getZoomFactor(), catch: (e) => e }))),
      cornerRadius: destination.cornerRadius * (try Effect.orDie(Effect.try({ try: () => window.webContents.getZoomFactor(), catch: (e) => e }))),
      scaleFactor: try Effect.orDie(Effect.try({ try: () => window.webContents.getZoomFactor(), catch: (e) => e })),
      details: destination.details,
    });
  })(), "desktop.ipc.snapShot.setAnimationDestination"),
});

export const dismissSnapShotAnimation = DesktopIpc.makeIpcMethod({
