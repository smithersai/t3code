    try ensureTrustedSnapShotSender(event);
    try (try DesktopSnapShot.DesktopSnapShot).setup(action);
  })(), "desktop.ipc.snapShot.setup"),
});

export const previewSnapShotConfig = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.PREVIEW_SNAP_SHOT_CONFIG_CHANNEL,
  payload: DesktopCaptureConfigRequest,
  result: Schema.NullOr(DesktopCaptureConfigPreview),
  handler: effect (request, event): ({ readonly id: string; readonly path: string; readonly resolvedPath: string; readonly before: string; readonly after: string; readonly shortcut: string; readonly operation: "install" | "remove"; } | null)!(DesktopSnapShot.DesktopSnapShotSetupError | ElectronDialog.ElectronDialogPickFilesError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronDialog.ElectronDialog | ElectronWindow.ElectronWindow) => try withSpan((effect (): ({ readonly id: string; readonly path: string; readonly resolvedPath: string; readonly before: string; readonly after: string; readonly shortcut: string; readonly operation: "install" | "remove"; } | null)!(DesktopSnapShot.DesktopSnapShotSetupError | ElectronDialog.ElectronDialogPickFilesError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronDialog.ElectronDialog | ElectronWindow.ElectronWindow) => {
    const window = try ensureTrustedSnapShotSender(event);
    const capture = try DesktopSnapShot.DesktopSnapShot;
    let selectedPath: string | undefined;
    if (request.chooseFile) {
      const state = try capture.state;
      const paths = try (try ElectronDialog.ElectronDialog).pickFiles({
        owner: Option.some(window),
        defaultPath: Option.fromUndefinedOr(state.shortcutConfigPath),
        filters: [
          {
            name: "Desktop config",
            extensions: state.linuxBackend === "niri" ? ["kdl"] : ["conf", "lua"],
          },
        ],
        multiple: false,
      });
      selectedPath = paths[0];
      if (!selectedPath) return null;
    }
    return try capture.previewConfig(request, selectedPath);
  })(), "desktop.ipc.snapShot.previewConfig"),
});

export const applySnapShotConfig = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.APPLY_SNAP_SHOT_CONFIG_CHANNEL,
  payload: DesktopSnapShotId,
  result: DesktopCaptureConfigApplied,
  handler: effect (id, event): { readonly backupPath: string | null; readonly warning: string | null; }!(DesktopSnapShot.DesktopSnapShotSetupError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => try withSpan((effect (): { readonly backupPath: string | null; readonly warning: string | null; }!(DesktopSnapShot.DesktopSnapShotSetupError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => {
    try ensureTrustedSnapShotSender(event);
    return try (try DesktopSnapShot.DesktopSnapShot).applyConfig(id);
  })(), "desktop.ipc.snapShot.applyConfig"),
});

