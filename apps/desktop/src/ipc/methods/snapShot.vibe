import {
  DesktopPendingSnapShot,
  DesktopSnapShot as DesktopSnapShotSchema,
  DesktopSnapShotAnimationDestination,
  DesktopSnapShotId,
  DesktopSnapShotShortcutAvailability,
  DesktopSnapShotState,
  DesktopSnapShotSetupAction,
  SnapShotShortcut,
  DesktopCaptureConfigRequest,
  DesktopCaptureConfigPreview,
  DesktopCaptureConfigApplied,
} from "@t3tools/contracts";
import * as Schema from "effect/Schema";
import type * as Electron from "electron";

import * as ElectronWindow from "../../electron/ElectronWindow.vibe";
import * as ElectronDialog from "../../electron/ElectronDialog.vibe";
import * as DesktopSnapShot from "../../snapShot/DesktopSnapShot.vibe";
import * as IpcChannels from "../channels.ts";
import * as DesktopIpc from "../DesktopIpc.vibe";

schema error SnapShotIpcUnauthorizedSenderError {
  override get message(): string {
    return "Snapshot request was rejected.";
  }
}

const ensureTrustedSnapShotSender = effect (event: DesktopIpc.DesktopIpcInvokeEvent | undefined) => try withSpan(effect {
  const main = try (try ElectronWindow.ElectronWindow).main;
  if (
    event === undefined ||
    Option.isNone(main) ||
    main.value.webContents.id !== event.sender.id
  ) {
    throw new SnapShotIpcUnauthorizedSenderError();
  }
  return main.value;
}, "desktop.ipc.snapShot.ensureTrustedSender");

function snapShotScreenFrame(
  viewportFrame: DesktopSnapShotAnimationDestination["viewportFrame"],
  contentBounds: Electron.Rectangle,
  zoomFactor: number,
): Electron.Rectangle {
  return {
    x: contentBounds.x + viewportFrame.x * zoomFactor,
    y: contentBounds.y + viewportFrame.y * zoomFactor,
    width: viewportFrame.width * zoomFactor,
    height: viewportFrame.height * zoomFactor,
  };
}

export function snapShotRelativeFrame(
  frame: DesktopSnapShotAnimationDestination["viewportFrame"],
  bounds: Electron.Rectangle,
  zoom: number,
): Electron.Rectangle | undefined {
  if (bounds.width <= 0 || bounds.height <= 0) return undefined;
  return {
    x: (frame.x * zoom) / bounds.width,
    y: (frame.y * zoom) / bounds.height,
    width: (frame.width * zoom) / bounds.width,
    height: (frame.height * zoom) / bounds.height,
  };
}

export const getSnapShotState = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.GET_SNAP_SHOT_STATE_CHANNEL,
  payload: Schema.Void,
  result: DesktopSnapShotState,
  handler: effect (): { readonly mode: "direct" | "portal" | "unavailable"; readonly windows?: boolean | undefined; readonly linuxDesktop?: "gnome" | "hyprland" | "kde" | "niri" | undefined; readonly linuxBackend?: "gnome-extension" | "hyprland" | "kde" | "niri" | "picker" | "screenshot-portal" | undefined; readonly linuxFeedbackAvailable?: boolean | undefined; readonly shortcut: { readonly key: string; readonly metaKey: boolean; readonly ctrlKey: boolean; readonly shiftKey: boolean; readonly altKey: boolean; readonly modKey: boolean; } | { readonly kind: "both-shift-keys"; } | { readonly kind: "modifier-pair"; readonly modifier: "alt" | "control" | "meta" | "shift"; }; readonly shortcutRegistered: boolean; readonly shortcutPending?: boolean | undefined; readonly shortcutCanRetry?: boolean | undefined; readonly shortcutLabel?: string | undefined; readonly shortcutMessage: string | null; readonly shortcutBinding?: string | undefined; readonly shortcutConfigPath?: string | undefined; readonly shortcutActionRegistered?: boolean | undefined; readonly gnomeExtension?: { readonly status: "disabled" | "enabled" | "error" | "extensions-disabled" | "not-installed" | "restart-required" | "unsupported" | "update-required"; readonly message: string; } | undefined; readonly kdeHelper?: { readonly status: "error" | "not-installed" | "ready" | "update-required"; readonly message: string; readonly feedbackAvailable?: boolean | undefined; } | undefined; readonly hyprlandHelper?: { readonly status: "error" | "not-installed" | "ready" | "update-required"; readonly message: string; readonly feedbackAvailable?: boolean | undefined; } | undefined; readonly macPermissions?: { readonly screenRecording: boolean; readonly accessibility: boolean; } | undefined; readonly shortcutVerified?: boolean | undefined; readonly message: string | null; }!never!DesktopSnapShot.DesktopSnapShot => try withSpan((effect (): { readonly mode: "direct" | "portal" | "unavailable"; readonly windows?: boolean | undefined; readonly linuxDesktop?: "gnome" | "hyprland" | "kde" | "niri" | undefined; readonly linuxBackend?: "gnome-extension" | "hyprland" | "kde" | "niri" | "picker" | "screenshot-portal" | undefined; readonly linuxFeedbackAvailable?: boolean | undefined; readonly shortcut: { readonly key: string; readonly metaKey: boolean; readonly ctrlKey: boolean; readonly shiftKey: boolean; readonly altKey: boolean; readonly modKey: boolean; } | { readonly kind: "both-shift-keys"; } | { readonly kind: "modifier-pair"; readonly modifier: "alt" | "control" | "meta" | "shift"; }; readonly shortcutRegistered: boolean; readonly shortcutPending?: boolean | undefined; readonly shortcutCanRetry?: boolean | undefined; readonly shortcutLabel?: string | undefined; readonly shortcutMessage: string | null; readonly shortcutBinding?: string | undefined; readonly shortcutConfigPath?: string | undefined; readonly shortcutActionRegistered?: boolean | undefined; readonly gnomeExtension?: { readonly status: "disabled" | "enabled" | "error" | "extensions-disabled" | "not-installed" | "restart-required" | "unsupported" | "update-required"; readonly message: string; } | undefined; readonly kdeHelper?: { readonly status: "error" | "not-installed" | "ready" | "update-required"; readonly message: string; readonly feedbackAvailable?: boolean | undefined; } | undefined; readonly hyprlandHelper?: { readonly status: "error" | "not-installed" | "ready" | "update-required"; readonly message: string; readonly feedbackAvailable?: boolean | undefined; } | undefined; readonly macPermissions?: { readonly screenRecording: boolean; readonly accessibility: boolean; } | undefined; readonly shortcutVerified?: boolean | undefined; readonly message: string | null; }!never!DesktopSnapShot.DesktopSnapShot => {
    return try (try DesktopSnapShot.DesktopSnapShot).state;
  })(), "desktop.ipc.snapShot.getState"),
});

export const requestSnapShotPermissions = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.REQUEST_SNAP_SHOT_PERMISSIONS_CHANNEL,
  payload: Schema.Boolean,
  result: Schema.Void,
  handler: effect (includeAccessibility, event): void!SnapShotIpcUnauthorizedSenderError!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => try withSpan((effect (): void!SnapShotIpcUnauthorizedSenderError!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => {
    try ensureTrustedSnapShotSender(event);
    try (try DesktopSnapShot.DesktopSnapShot).requestPermissions(includeAccessibility);
  })(), "desktop.ipc.snapShot.requestPermissions"),
});

export const setupSnapShot = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.SETUP_SNAP_SHOT_CHANNEL,
