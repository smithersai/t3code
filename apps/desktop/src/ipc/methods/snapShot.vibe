    try ensureTrustedSnapShotSender(event);
    try (try DesktopSnapShot.DesktopSnapShot).dismissAnimation(id);
  })(), "desktop.ipc.snapShot.dismissAnimation"),
});

export const acknowledgeSnapShot = DesktopIpc.makeIpcMethod({
  channel: IpcChannels.ACKNOWLEDGE_SNAP_SHOT_CHANNEL,
  payload: DesktopSnapShotId,
