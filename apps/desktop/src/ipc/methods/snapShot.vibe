  handler: effect (id, event): void!(DesktopSnapShot.DesktopSnapShotError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => try withSpan((effect (): void!(DesktopSnapShot.DesktopSnapShotError | SnapShotIpcUnauthorizedSenderError)!(DesktopSnapShot.DesktopSnapShot | ElectronWindow.ElectronWindow) => {
    try ensureTrustedSnapShotSender(event);
    try (try DesktopSnapShot.DesktopSnapShot).acknowledge(id);
  })(), "desktop.ipc.snapShot.acknowledge"),
});
