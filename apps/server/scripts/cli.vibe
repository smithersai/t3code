#!/usr/bin/env -S node --import=vibelang/register
import { readProcessExecPath, readProcessEnv } from platform
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Logger from "effect/Logger"
import * as Option from "effect/Option"
import * as Path from "effect/Path"
import { Command, Flag } from "effect/cli"
import { ChildProcess, ChildProcessSpawner } from "effect/process"

import { DEVELOPMENT_ICON_OVERRIDES } from "../../../scripts/lib/brand-assets.ts"
import { findEsmImportsOfExternalPackages } from "../../../scripts/lib/cli-executable-imports.ts"
import { injectLinuxArm64Sea } from "../../../scripts/lib/linux-arm64-sea.vibe"
import rootPackageJson from "../../../package.json" with { type: "json" }
import * as HostProcess from "@t3tools/shared/HostProcess"
import { resolveSpawnCommand } from "@t3tools/shared/shell"
import {
  ServerCliBuildAssetMissingError,
  ServerCliCommandExitError,
  ServerCliDevelopmentIconSourceMissingError,
  ServerCliDevelopmentIconTargetMissingError,
  ServerCliExecutableImportError,
} from "./cliErrors.vibe"
import * as Layer from "effect/Layer"
import * as Crypto from "@t3tools/shared/Crypto"

module platform {
  import * as Effect from "effect/Effect"

  export const readProcessExecPath = Effect.sync(() => process.execPath)
  export const readProcessEnv = Effect.sync(() => process.env)
}

const RepoRoot = Effect.service(Path.Path)
  |> Effect.flatMap(%, (path) => path.fromFileUrl(new URL("../../..", import.meta.url)))

const runCommand = effect (command: ChildProcess.StandardCommand) =>
  try withSpan(
    effect {
      const spawner = try ChildProcessSpawner.ChildProcessSpawner
      const child = try spawner.spawn(command)
      const exitCode = try child.exitCode

      if (exitCode !== 0) {
        throw new ServerCliCommandExitError({
          command: command.command,
          args: command.args.map(String),
          cwd: command.options.cwd,
          exitCode,
        })
      }
    },
    "runCommand",
  )

const applyDevelopmentIconOverrides = effect (
  repoRoot: string,
  serverDir: string,
) =>
  try withSpan(
    effect {
      const path = try Path.Path
      const fs = try FileSystem.FileSystem

      for (const override of DEVELOPMENT_ICON_OVERRIDES) {
        const sourcePath = path.join(repoRoot, override.sourceRelativePath)
        const targetPath = path.join(serverDir, override.targetRelativePath)

        if (!(try fs.exists(sourcePath))) {
          throw new ServerCliDevelopmentIconSourceMissingError({ sourcePath })
        }
        if (!(try fs.exists(targetPath))) {
          throw new ServerCliDevelopmentIconTargetMissingError({ targetPath })
        }

        try fs.copyFile(sourcePath, targetPath)
      }

      try Effect.log("[cli] Applied development icon overrides to dist/client")
    },
    "applyDevelopmentIconOverrides",
  )

const buildCmd = Command.make(
  "build",
  {
    verbose: Flag.Boolean("verbose").pipe(Flag.withDefault(false)),
  },
  effect (config) => {
    const path = try Path.Path
    const fs = try FileSystem.FileSystem
    const repoRoot = try RepoRoot
    const serverDir = path.join(repoRoot, "apps/server")

    try Effect.log("[cli] Running tsdown...")
    try runCommand(
      ChildProcess.make(try readProcessExecPath, ["--run", "build:bundle"], {
        cwd: serverDir,
        stdout: config.verbose ? "inherit" : "ignore",
        stderr: "inherit",
        shell: false,
      }),
    )

    const webDist = path.join(repoRoot, "apps/web/dist")
    const clientTarget = path.join(serverDir, "dist/client")

    if (try fs.exists(webDist)) {
      try fs.copy(webDist, clientTarget)
      try applyDevelopmentIconOverrides(repoRoot, serverDir)
      try Effect.log("[cli] Bundled web app into dist/client")
    } else {
      try Effect.logWarning("[cli] Web dist not found. Skipping client bundle.")
    }
  },
).pipe(Command.withDescription("Build the server package (tsdown + bundle web client)."))

const buildExeCmd = Command.make(
  "build-exe",
  {
    verbose: Flag.Boolean("verbose").pipe(Flag.withDefault(false)),
    target: Flag.String("target").pipe(
      Flag.withDescription(
        "Cross-build for <platform>-<arch> in nodejs.org naming (for example darwin-x64); defaults to the host.",
      ),
      Flag.optional,
    ),
  },
  (config) =>
    Effect.gen(function*() {
      const path = yield* Path.Path
      const fs = yield* FileSystem.FileSystem
      const repoRoot = yield* RepoRoot
      const serverDir = path.join(repoRoot, "apps/server")

      yield* Effect.log("[cli] Building single-executable...")
      const target = Option.getOrUndefined(config.target)
      // TEMPORARY one-time Node fix. Remove when fixed: https://github.com/nodejs/node/issues/67048
      const linuxArm64 = !target
        && (yield* HostProcess.Platform) === "linux"
        && (yield* HostProcess.Architecture) === "arm64"
      const spawnCommand = yield* resolveSpawnCommand("vp", ["pack"])
      yield* runCommand(
        ChildProcess.make(spawnCommand.command, spawnCommand.args, {
          cwd: serverDir,
          env: {
            ...(yield* readProcessEnv),
            T3CODE_PACK_EXE: linuxArm64 ? "bundle" : "1",
            T3CODE_PACK_EXE_TARGET: target ?? "",
          },
          stdout: config.verbose ? "inherit" : "ignore",
          stderr: "inherit",
          shell: spawnCommand.shell,
        }),
      )

      // Executables reject non-builtin imports even when bundling succeeds; inspect the emitted graph.
      const bundlePath = path.join(serverDir, "dist-exe/bin.mjs")
      const specifiers = findEsmImportsOfExternalPackages(yield* fs.readFileString(bundlePath))
      if (specifiers.length > 0) {
        return yield* new ServerCliExecutableImportError({ bundlePath, specifiers })
      }
      // TEMPORARY one-time Node fix. Remove when fixed: https://github.com/nodejs/node/issues/67048
      if (linuxArm64) {
        yield* injectLinuxArm64Sea({
          bundlePath,
          outputPath: path.join(serverDir, "dist-exe/t3"),
          nodeVersion: rootPackageJson.engines.node,
          verbose: config.verbose,
        })
      }
      yield* Effect.log(
        "[cli] Built dist-exe/t3 (expects client/, resource-monitor/, and the runtime-external node_modules beside it; scripts/build-cli-archive.ts assembles that tree)",
      )
    }),
).pipe(
  Command.withDescription(
    `Build the server as a Node single-executable. Native builds require Node ${rootPackageJson.engines.node}; explicit cross-target builds need a Node 25.7+ host for --build-sea. Linux ARM64 builds only on a Linux ARM64 host. The binary still resolves native packages from a node_modules tree beside it.`,
  ),
)

/** Publish after the GitHub release exists; the launcher downloads from it. */
const publishCmd = Command.make(
  "publish",
  {
    packagesDir: Flag.String("packages-dir").pipe(
      Flag.withDescription("Output dir of scripts/build-npm-launcher.ts."),
    ),
    tag: Flag.String("tag").pipe(Flag.withDefault("latest")),
    access: Flag.String("access").pipe(Flag.withDefault("public")),
    provenance: Flag.Boolean("provenance").pipe(Flag.withDefault(false)),
    dryRun: Flag.Boolean("dry-run").pipe(Flag.withDefault(false)),
    verbose: Flag.Boolean("verbose").pipe(Flag.withDefault(false)),
  },
  effect (config) => {
    const path = try Path.Path
    const fs = try FileSystem.FileSystem
    const packagesDir = path.resolve(config.packagesDir)
    const launcherTarball = path.join(packagesDir, "t3.tgz")
    if (!(try fs.exists(launcherTarball))) {
      throw new ServerCliBuildAssetMissingError({ assetPath: launcherTarball })
    }

    const args = ["publish", "--access", config.access, "--tag", config.tag]
    if (config.provenance) args.push("--provenance")
    if (config.dryRun) args.push("--dry-run")
    const spawnCommand = try resolveSpawnCommand("npm", [...args, launcherTarball])
    try Effect.log(`[cli] npm ${args.join(" ")} t3.tgz`)
    try runCommand(
      ChildProcess.make(spawnCommand.command, spawnCommand.args, {
        cwd: packagesDir,
        stdout: config.verbose ? "inherit" : "ignore",
        stderr: "inherit",
        shell: spawnCommand.shell,
      }),
    )
  },
).pipe(Command.withDescription("Publish the t3 launcher to npm."))

const cli = Command.make("cli").pipe(
  Command.withDescription("T3 server build & publish CLI."),
  Command.withSubcommands([buildCmd, buildExeCmd, publishCmd]),
)

Command.run(cli, { version: "0.0.0" }).pipe(
  Effect.scoped,
  Effect.provide([
    Logger.layer([Logger.consolePretty()]),
    Layer.merge(NodeServices.layer, Crypto.layerWebCrypto),
  ]),
  NodeRuntime.runMain,
)
