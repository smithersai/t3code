import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Path from "effect/Path";

import {
  VcsRepositoryDetectionError,
  VcsUnsupportedOperationError,
  type ReviewDiffFileContentsInput,
  type ReviewDiffFileContentsResult,
  type ReviewDiffPreviewError,
  type ReviewDiffPreviewInput,
  type ReviewDiffPreviewResult,
} from "@t3tools/contracts";

import * as ServerConfig from "../config.ts";
import * as GitVcsDriver from "../vcs/GitVcsDriver.ts";
import * as VcsDriverRegistry from "../vcs/VcsDriverRegistry.ts";
import * as KnownWorkspaces from "../workspace/KnownWorkspaces.ts";

export service ReviewService: {
    readonly getDiffPreview: (
      input: ReviewDiffPreviewInput,
    ) => ReviewDiffPreviewResult!ReviewDiffPreviewError;
    readonly getDiffFileContents: (
      input: ReviewDiffFileContentsInput,
    ) => ReviewDiffFileContentsResult!ReviewDiffPreviewError;
  } {
  static readonly key = "t3/review/ReviewService"
}

/** @public */
export const make = effect {
  const config = try ServerConfig.ServerConfig;
  const fileSystem = try FileSystem.FileSystem;
  const path = try Path.Path;
  const vcsRegistry = try VcsDriverRegistry.VcsDriverRegistry;
  const git = try GitVcsDriver.GitVcsDriver;
  const knownWorkspaces = try KnownWorkspaces.KnownWorkspaces;

  const canonicalizePath = (value: string) => {
    const resolvedPath = path.resolve(value);
    return fileSystem.realPath(resolvedPath)
      |> catchTags(%, {
        PlatformError: (cause) =>
          cause.reason._tag === "NotFound"
            ? succeed(resolvedPath)
            : fail(
                new VcsRepositoryDetectionError({
                  operation: "ReviewService.assertWorkspaceBoundCwd.canonicalizePath",
                  cwd: resolvedPath,
                  detail: "Failed to resolve a path while validating the review workspace.",
                  cause,
                }),
              ),
      });
  };

  const assertWorkspaceBoundCwd = effect (
    operation: "ReviewService.getDiffFileContents" | "ReviewService.getDiffPreview",
    cwd: string,
  ) => try withSpan(effect {
    const [candidate, workspaceRoot] = try all([
      canonicalizePath(cwd),
      canonicalizePath(config.cwd),
    ]);
    if (
      (try orDie(Effect.try({ try: () => KnownWorkspaces.isWithinRoot(path, candidate, workspaceRoot), catch: (error) => error }))) ||
      (try knownWorkspaces.contains(candidate))
    ) {
      return;
    }

    throw new VcsRepositoryDetectionError({
      operation,
      cwd,
      detail:
        operation === "ReviewService.getDiffPreview"
          ? "Review diff preview cwd must stay within the configured workspace root."
          : "Review diff file contents cwd must stay within the configured workspace root.",
    });
  }, "ReviewService.assertWorkspaceBoundCwd");

  const getDiffPreview: ReviewService["Service"]["getDiffPreview"] = effect (input) => try withSpan(effect {
    try assertWorkspaceBoundCwd("ReviewService.getDiffPreview", input.cwd);

    const handle = try vcsRegistry.detect({ cwd: input.cwd, requestedKind: "auto" });
    if (!handle) {
      return {
        cwd: input.cwd,
        generatedAt: try DateTime.now,
        sources: [],
      };
    }

    const getDriverDiffPreview = handle.driver.getDiffPreview;
    if (!getDriverDiffPreview) {
      if (handle.kind === "git") {
        return try git.getReviewDiffPreview(input);
      }
      throw new VcsUnsupportedOperationError({
        operation: "ReviewService.getDiffPreview",
        kind: handle.kind,
        detail: `The ${handle.kind} VCS driver does not support review diff previews.`,
      });
    }

    return try getDriverDiffPreview(input);
  }, "ReviewService.getDiffPreview");

  const getDiffFileContents: ReviewService["Service"]["getDiffFileContents"] = effect (input) => try withSpan(effect {
    try assertWorkspaceBoundCwd("ReviewService.getDiffFileContents", input.cwd);

    const handle = try vcsRegistry.detect({ cwd: input.cwd, requestedKind: "auto" });
    if (handle?.kind !== "git") {
      throw new VcsUnsupportedOperationError({
        operation: "ReviewService.getDiffFileContents",
        kind: handle?.kind ?? "unknown",
        detail: "Unchanged diff expansion currently requires a Git repository.",
      });
    }

    return try git.getReviewDiffFileContents(input);
  }, "ReviewService.getDiffFileContents");

  return ReviewService.of({
    getDiffPreview,
    getDiffFileContents,
  });
};

export const layer = Layer.effect(ReviewService, make);
