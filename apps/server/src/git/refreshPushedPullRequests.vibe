import type { GitRunStackedActionInput, GitRunStackedActionResult } from "@t3tools/contracts"
import * as Effect from "effect/Effect"

import * as OrchestratorV2 from "../orchestration-v2/Orchestrator.vibe"
import * as ProjectStore from "../orchestration-v2/ProjectStore.vibe"
import * as PullRequestService from "../pullRequest/PullRequestService.vibe"

export const refreshPushedPullRequests = effect (
  input: Pick<GitRunStackedActionInput, "cwd" | "threadId" | "projectId">,
  result: Pick<
    {
      readonly action: "commit" | "commit_push" | "commit_push_pr" | "create_pr" | "push"
      readonly branch: { readonly status: "created" | "skipped_not_requested"; readonly name?: string | undefined }
      readonly commit: {
        readonly status: "created" | "skipped_no_changes" | "skipped_not_requested"
        readonly commitSha?: string | undefined
        readonly subject?: string | undefined
      }
      readonly push: {
        readonly status: "pushed" | "skipped_not_requested" | "skipped_up_to_date"
        readonly branch?: string | undefined
        readonly upstreamBranch?: string | undefined
        readonly setUpstream?: boolean | undefined
      }
      readonly pr: {
        readonly status: "created" | "opened_existing" | "skipped_not_requested"
        readonly url?: string | undefined
        readonly number?: number | undefined
        readonly baseBranch?: string | undefined
        readonly headBranch?: string | undefined
        readonly title?: string | undefined
      }
      readonly toast: {
        readonly title: string
        readonly description?: string | undefined
        readonly cta: { readonly kind: "none" } | {
          readonly kind: "open_pr"
          readonly label: string
          readonly url: string
        } | {
          readonly kind: "run_action"
          readonly label: string
          readonly action: { readonly kind: "commit" | "commit_push" | "commit_push_pr" | "create_pr" | "push" }
        }
      }
    },
    "push"
  >,
) =>
  try withSpan(
    effect {
      if (result.push.status !== "pushed") return
      const pullRequests = try PullRequestService.PullRequestService
      if (input.threadId !== undefined) {
        const engine = try OrchestratorV2.OrchestratorV2
        const thread = try engine.getThreadShell(input.threadId)
        if (thread !== null) {
          try pullRequests.refreshAfterTurn(thread.projectId)
          return
        }
      }
      if (input.projectId !== undefined) {
        try pullRequests.refreshAfterTurn(input.projectId)
        return
      }
      const projects = try (try ProjectStore.ProjectStoreV2).listShells()
      try Effect.forEach(
        projects.filter((project) => project.workspaceRoot === input.cwd),
        (project) => pullRequests.refreshAfterTurn(project.id),
        { discard: true },
      )
    } |> Effect.ignore(%, { log: true }),
    "refreshPushedPullRequests",
  )
