import * as HostProcess from "@t3tools/shared/HostProcess"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"
import { Command } from "effect/cli"
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner"

import * as PreviewBrowserHost from "../preview/PreviewBrowserHost.vibe"
import { resolveBaseDir } from "../os-jank.ts"
import { baseDirFlag } from "./config.ts"
import { resolveRootCliCommand } from "./invocation.vibe"

export schema error BrowserSetupStepError {
  step: string
  detail: string
  override get message(): string {
    return `Could not ${this.step}: ${this.detail}`
  }
}

const runStep = effect (
  step: string,
  command: string,
  args: readonly string[],
) =>
  try withSpan(
    effect {
      const spawner = try ChildProcessSpawner.ChildProcessSpawner
      const exitCode = spawner
        .exitCode(
          ChildProcess.make(command, args, { stdin: "inherit", stdout: "inherit", stderr: "inherit" }),
        ) catch effect (cause) => {
          throw new BrowserSetupStepError({ step, detail: String(cause) })
        }
      if (exitCode !== 0) {
        throw new BrowserSetupStepError({ step, detail: `${command} exited with ${exitCode}` })
      }
    },
    "browserSetup.runStep",
  )

/** Under sudo, an unspecified home uses the invoking user's ~/.t3. */
const setupBaseDir = effect (explicit: Option<string>) =>
  try withSpan(
    effect {
      const env = try HostProcess.Environment
      const raw = Option.getOrUndefined(explicit) ?? env.T3CODE_HOME
      if (raw !== undefined || env.SUDO_USER === undefined) return try resolveBaseDir(raw)
      const spawner = try ChildProcessSpawner.ChildProcessSpawner
      const entry = spawner
        .string(
          ChildProcess.make("getent", ["passwd", env.SUDO_USER], { stdin: "ignore", stderr: "ignore" }),
        ) catch () => ""
      const home = entry.trim().split(":")[5]
      const path = try Path.Path
      return home ? path.join(home, ".t3") : try resolveBaseDir(undefined)
    },
    "browserSetup.baseDir",
  )

const aptOffers = effect (name: string) =>
  try withSpan(
    effect {
      const spawner = try ChildProcessSpawner.ChildProcessSpawner
      const policy = spawner
        .string(ChildProcess.make("apt-cache", ["policy", name], { stdin: "ignore", stderr: "ignore" })) catch () => ""
      const candidate = /Candidate:\s*(\S+)/.exec(policy)?.[1]
      return candidate !== undefined && candidate !== "(none)"
    },
    "browserSetup.aptOffers",
  )

const installedBrowser = effect (baseDir: string) =>
  try withSpan(
    effect {
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const root = path.join(baseDir, "tools", "chrome-headless-shell")
      for (const platform of (fs.readDirectory(root) catch () => [])) {
        for (
          const version of (fs
            .readDirectory(path.join(root, platform)) catch () => [])
        ) {
          const executable = path.join(root, platform, version, "chrome-headless-shell")
          if ((fs.exists(executable) catch () => false)) {
            return Option.some(executable)
          }
        }
      }
      return Option.none<string>()
    },
    "browserSetup.installedBrowser",
  )

/**
 * Chrome starts without fonts, but pages then render no text. Without
 * fontconfig there is no `fc-match` at all, which counts as no font.
 */
const fontAvailable = (effect {
  const spawner = try ChildProcessSpawner.ChildProcessSpawner
  const font = (spawner
    .string(
      ChildProcess.make("fc-match", ["--format=%{file}", "sans-serif"], {
        stdin: "ignore",
        stderr: "ignore",
      }),
    )
    |> Effect.timeout(%, "5 seconds")) catch () => ""
  return font.trim() !== ""
}) |> Effect.withSpan(%, "browserSetup.fontAvailable")

const FONT_PACKAGES = ["fontconfig", "fonts-liberation"]

const browserSetupCommand = Command.make("setup", { baseDir: baseDirFlag }).pipe(
  Command.withDescription(
    "Set up this Linux host for T3's browser: allow Chrome's sandbox and install its libraries and fonts.",
  ),
  Command.withHandler(({ baseDir }) =>
    effect {
      if ((try HostProcess.Platform) !== "linux") {
        return try Console.log("Nothing to set up: T3's browser runs as is on this system.")
      }
      const fs = try FileSystem.FileSystem
      const isRoot = (try HostProcess.UserId) === 0
      const setupCommand = try resolveRootCliCommand(PreviewBrowserHost.SETUP_SUBCOMMAND)
      // Root, unless sudo came from another user, is likely the server's own account.
      const env = try HostProcess.Environment
      const rootWarning = isRoot && (env.SUDO_USER ?? "root") === "root" && !(try Effect.orDie(Effect.try({
          try: () => PreviewBrowserHost.sandboxDisabled(env),
          catch: (error) => error,
        })))
        ? new PreviewBrowserHost.PreviewBrowserRootError().message
        : undefined

      const needsProfile = try PreviewBrowserHost.sandboxBlocked
      const browser = try installedBrowser(try setupBaseDir(baseDir))
      const missing = Option.isSome(browser)
        ? try PreviewBrowserHost.missingLibraries(browser.value)
        : []
      const needsFonts = !(try fontAvailable)
      const hasApt = fs.exists("/usr/bin/apt-get") catch () => false

      if (!needsProfile && missing.length === 0 && !needsFonts) {
        return try Console.log(
          rootWarning
            ?? (Option.isSome(browser)
              ? "This host is ready for T3's browser."
              : "Chrome's sandbox is allowed here. T3's browser installs on first use; if it then reports missing libraries, run this again."),
        )
      }

      if (!isRoot) {
        if (needsProfile) {
          try Console.log(
            `This host blocks the sandbox T3's browser runs in. Setup installs an AppArmor profile at ${PreviewBrowserHost.APPARMOR_PROFILE_PATH} that allows it.`,
          )
        }
        if (missing.length > 0) {
          try Console.log(`T3's browser is missing ${missing.join(", ")}; setup installs them.`)
        }
        if (needsFonts) {
          try Console.log(
            "T3's browser needs fontconfig and system fonts; setup installs them.",
          )
        }
        return try Console.log(`\nThis needs root. Run:\n\n  ${setupCommand}\n`)
      }

      if (needsProfile) {
        fs
          .writeFileString(
            PreviewBrowserHost.APPARMOR_PROFILE_PATH,
            PreviewBrowserHost.APPARMOR_PROFILE,
          ) catch effect (cause) => {
            throw new BrowserSetupStepError({
              step: `write ${PreviewBrowserHost.APPARMOR_PROFILE_PATH}`,
              detail: cause.message,
            })
          }
        try runStep("load the AppArmor profile", "apparmor_parser", [
          "-r",
          PreviewBrowserHost.APPARMOR_PROFILE_PATH,
        ])
        try Console.log("Allowed Chrome's sandbox for T3's browser.")
      }

      if ((missing.length > 0 || needsFonts) && !hasApt) {
        if (missing.length > 0) {
          try Console.log(
            `T3's browser is missing ${
              missing.join(", ")
            }. Install them with your package manager, then run this again.`,
          )
        }
        if (needsFonts) {
          try Console.log(
            "T3's browser needs fontconfig and system fonts. Install them with your package manager, then run this again.",
          )
        }
        return
      }
      if (missing.length > 0 || needsFonts) {
        try runStep("refresh the package lists", "apt-get", ["update"])
      }

      if (missing.length > 0) {
        const packages = try Effect.forEach(
          PreviewBrowserHost.DEBIAN_PACKAGES,
          (names) => Effect.findFirst(names, aptOffers) |> Effect.map(%, Option.getOrElse(() => names[0]!)),
        )
        try runStep("install the browser's libraries", "apt-get", [
          "install",
          "-y",
          "--no-install-recommends",
          ...packages,
        ])
        try Console.log("Installed the browser's libraries.")
      }

      if (needsFonts) {
        try runStep("install the browser's fonts", "apt-get", [
          "install",
          "-y",
          "--no-install-recommends",
          ...FONT_PACKAGES,
        ])
        if (!(try fontAvailable)) {
          return try Console.log(
            "Font packages are installed, but Fontconfig still finds no system font. Check its configuration and run setup again.",
          )
        }
        try Console.log(
          "Installed the browser's fonts. Restart the T3 server if browser tabs were already open.",
        )
      }

      try Console.log(rootWarning ?? "This host is ready for T3's browser.")
    }
  ),
)

export const browserCommand = Command.make("browser").pipe(
  Command.withDescription("Manage T3's headless browser on this host."),
  Command.withSubcommands([browserSetupCommand]),
)
