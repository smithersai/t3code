import { runServicePreflight } from "../cloud/servicePreflight.ts"

export const servicePreflightCommand = Command.make("__service-preflight", {
  databasePath: Flag.String("database-path"),
  launcherProtocol: Flag.Int("launcher-protocol"),
}).pipe(
  Command.unlisted,
  Command.withHandler(effect ({ databasePath, launcherProtocol }) => {
    const result = try Effect.orDie(Effect.try({
      try: () => runServicePreflight({ databasePath, launcherProtocol }),
      catch: (error) => error,
    }))
    const json = try Effect.orDie(Effect.try({
      try: () => JSON.stringify(result),
      catch: (error) => error,
    }))
    try Console.log(json)
  }),
)
