import {
  OrchestratorMcpFailure,
  OrchestratorMcpThreadListResult,
  OrchestratorMcpThreadReadResult,
  OrchestratorMcpThreadSendResult,
  OrchestratorMcpThreadWaitResult,
  ProjectId,
  RunId,
  ThreadId,
  TrimmedNonEmptyString,
  type OrchestratorMcpThreadListItem,
  type OrchestratorMcpThreadStatus,
  type OrchestratorMcpThreadTimelineItem,
} from "@t3tools/contracts"
import * as HostProcess from "@t3tools/shared/HostProcess"
import * as Console from "effect/Console"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Option from "effect/Option"
import * as Path from "effect/Path"
import * as References from "effect/References"
import * as Runtime from "effect/Runtime"
import * as Schema from "effect/Schema"
import * as Stdio from "effect/Stdio"
import * as Stream from "effect/Stream"
import { Argument, Command, Flag, GlobalFlag } from "effect/cli"

import * as EnvironmentAuth from "../auth/EnvironmentAuth.vibe"
import * as ServerConfig from "../config.vibe"
import { mcpToolSession, type McpToolSession } from "../mcp/AcpMcpStdioBridge.vibe"
import { readPersistedServerRuntimeState } from "../serverRuntimeState.vibe"
import { projectLocationFlags, resolveCliAuthConfig } from "./config.vibe"

/**
 * Short enough that a run which stops to ask the user something is noticed
 * soon, since `t3_thread_wait` only returns on a terminal run.
 */
const WAIT_SLICE_MS = 15_000
const READ_PAGE_LIMIT = 100
const TITLE_MAX_CHARS = 80

export class ThreadServerNotRunningError extends Schema.TaggedError<ThreadServerNotRunningError>()(
  "ThreadServerNotRunningError",
  { baseDir: Schema.String },
) {
  override readonly [Runtime.errorReported] = false
  override get message(): string {
    return `No running T3 Code server uses ${this.baseDir}. Start T3 Code, then retry.`
  }
}

export class ThreadServerUnreachableError extends Schema.TaggedError<ThreadServerUnreachableError>()(
  "ThreadServerUnreachableError",
  { origin: Schema.String, cause: Schema.Defect() },
) {
  override readonly [Runtime.errorReported] = false
  override get message(): string {
    const reason = this.cause instanceof Error ? ` ${this.cause.message}` : ""
    return `Could not reach the T3 Code server at ${this.origin}.${reason}`
  }
}

export class ThreadToolFailedError extends Schema.TaggedError<ThreadToolFailedError>()(
  "ThreadToolFailedError",
  { tool: Schema.String, detail: Schema.String },
) {
  override readonly [Runtime.errorReported] = false
  override get message(): string {
    return this.detail
  }
}

export class ThreadUsageError extends Schema.TaggedError<ThreadUsageError>()("ThreadUsageError", {
  detail: Schema.String,
}) {
  override readonly [Runtime.errorReported] = false
  override get message(): string {
    return this.detail
  }
}

export class ThreadProjectNotFoundError extends Schema.TaggedError<ThreadProjectNotFoundError>()(
  "ThreadProjectNotFoundError",
  { identifier: Schema.String },
) {
  override readonly [Runtime.errorReported] = false
  override get message(): string {
    return `No T3 Code project matches '${this.identifier}'. Pass a project id or a path inside a project.`
  }
}

/** Exit code 2 lets a script tell "needs a human" apart from a failed run. */
export class ThreadNeedsInputError extends Schema.TaggedError<ThreadNeedsInputError>()(
  "ThreadNeedsInputError",
  { threadId: ThreadId },
) {
  override readonly [Runtime.errorReported] = false
  override readonly [Runtime.errorExitCode] = 2

  override get message(): string {
    return `Thread ${this.threadId} is waiting for an answer. Open it in T3 Code to respond.`
  }
}

export class ThreadRunEndedError extends Schema.TaggedError<ThreadRunEndedError>()(
  "ThreadRunEndedError",
  { threadId: ThreadId, status: Schema.String, error: Schema.optional(Schema.String) },
) {
  override readonly [Runtime.errorReported] = false
  override get message(): string {
    const reason = this.error === undefined ? "." : `: ${this.error}`
    return `Thread ${this.threadId} stopped with status ${this.status}${reason}`
  }
}

const ThreadCliError = Schema.Union([
  ThreadServerNotRunningError,
  ThreadServerUnreachableError,
  ThreadToolFailedError,
  ThreadUsageError,
  ThreadProjectNotFoundError,
  ThreadNeedsInputError,
  ThreadRunEndedError,
])
const isThreadCliError = Schema.is(ThreadCliError)

/**
 * These errors are expected outcomes for a script, so they print as one line
 * on stderr instead of the runtime's logged stack trace.
 */
const reportThreadErrors = <A, E, R>(effect: A!E!R) =>
  effect
  |> Effect.tapError(%, (error) => isThreadCliError(error) ? Console.error(error.message) : Effect.void)

const decodeFailureText = Schema.decodeUnknownOption(Schema.fromJsonString(OrchestratorMcpFailure))
const encodeJson = Schema.encodeSync(Schema.fromJsonString(Schema.Unknown))
const printJson = (value: unknown) => Console.log(encodeJson(value))

const ToolResult = Schema.Struct({
  isError: Schema.optional(Schema.Boolean),
  structuredContent: Schema.optional(Schema.Unknown),
  content: Schema.optional(
    Schema.Array(Schema.Struct({ type: Schema.String, text: Schema.optional(Schema.String) })),
  ),
})

const decodeToolResult = Schema.decodeUnknownEffect(ToolResult)

const ProjectListResult = Schema.Struct({
  projects: Schema.Array(
    Schema.Struct({ id: ProjectId, title: Schema.String, workspaceRoot: Schema.String }),
  ),
  nextCursor: Schema.NullOr(Schema.Int),
})

const ThreadLaunchResult = Schema.Struct({
  threadId: ThreadId,
  projectId: ProjectId,
  runId: Schema.NullOr(RunId),
})

const toolFailureDetail = (result: typeof ToolResult.Type) => {
  const text = result.content?.find((part) => part.text !== undefined)?.text ?? ""
  return do {
    const $optionSubject = decodeFailureText(text)
    const $optionHandlers: { onNone: () => string; onSome: (failure: OrchestratorMcpFailure) => string } = {
      onNone: () => text || "The tool call failed.",
      onSome: (failure) => failure.message,
    }
    const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
    match ($optionSubject) {
      when Option.Some(let $optionValue): $optionSome($optionValue);
      default: $optionNone();
    }
  }
}

const makeThreadTools = (session: McpToolSession, origin: string) => {
  const unexpected = (tool: string) =>
    new ThreadToolFailedError({
      tool,
      detail: `The server sent an unexpected ${tool} result. Update the t3 CLI to match the server.`,
    })
  return {
    call: effect <S extends Schema.Decoder<unknown>>(
      tool: string,
      args: Readonly<Record<string, unknown>>,
      schema: S,
    ): S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)! =>
      try withSpan(
        (effect (): S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)! => {
          const raw = session
            .call(tool, args) catch effect (cause) => {
              throw new ThreadServerUnreachableError({ origin, cause })
            }
          const result = decodeToolResult(raw) catch effect () => {
            throw unexpected(tool)
          }
          if (result.isError === true) {
            throw new ThreadToolFailedError({ tool, detail: toolFailureDetail(result) })
          }
          return Schema.decodeUnknownEffect(schema)(result.structuredContent) catch effect () => {
            throw unexpected(tool)
          }
        })(),
        "cli.thread.callTool",
      ),
  }
}
export type ThreadTools = ReturnType<typeof makeThreadTools>

/**
 * Signs in as a short-lived MCP client of the running server, the same way an
 * outside agent does, and revokes that session when the command ends.
 */
const withThreadTools = effect <A, E, R>(
  flags: { readonly baseDir: Option.Option<string> },
  run: (tools: ThreadTools) => A!E!R,
): A!(E | import("../bootstrap.ts").BootstrapEnvelopeDecodeError | import("../bootstrap.ts").BootstrapEnvelopeReadError | import("../bootstrap.ts").BootstrapFdStatError | import("../bootstrap.ts").BootstrapInputStreamOpenError | import("effect/Config").ConfigError | import("effect/sql/Migrator").MigrationError | import("@t3tools/shared/Net").NetError | import("effect/PlatformError").PlatformError | import("../auth/ServerSecretStore.vibe").SecretStoreConcurrentReadError | import("../auth/ServerSecretStore.vibe").SecretStoreDecodeError | import("../auth/ServerSecretStore.vibe").SecretStoreEncodeError | import("../auth/ServerSecretStore.vibe").SecretStorePersistError | import("../auth/ServerSecretStore.vibe").SecretStoreRandomGenerationError | import("../auth/ServerSecretStore.vibe").SecretStoreReadError | import("../auth/ServerSecretStore.vibe").SecretStoreRemoveError | import("../auth/ServerSecretStore.vibe").SecretStoreSecureError | import("../auth/ServerSecretStore.vibe").SecretStoreTemporaryPathError | EnvironmentAuth.ServerAuthAuthenticatedAccessTokenIssueError | EnvironmentAuth.ServerAuthAuthenticatedSessionIssueError | EnvironmentAuth.ServerAuthBootstrapCredentialValidationError | EnvironmentAuth.ServerAuthCloudHealthJwtSigningError | EnvironmentAuth.ServerAuthCloudLinkJwtSigningError | EnvironmentAuth.ServerAuthCloudMintJwtSigningError | EnvironmentAuth.ServerAuthCloudMintPublicKeyMissingError | EnvironmentAuth.ServerAuthCloudRelayIssuerMissingError | EnvironmentAuth.ServerAuthDpopReplayKeyCalculationError | EnvironmentAuth.ServerAuthDpopReplayStateRecordError | EnvironmentAuth.ServerAuthLinkedCloudAccountMissingError | EnvironmentAuth.ServerAuthLinkedCloudAccountReadError | EnvironmentAuth.ServerAuthLinkedCloudAccountVerificationError | EnvironmentAuth.ServerAuthOtherSessionsRevocationError | EnvironmentAuth.ServerAuthPairingLinkCreationError | EnvironmentAuth.ServerAuthPairingLinkRevocationError | EnvironmentAuth.ServerAuthPairingLinksListError | EnvironmentAuth.ServerAuthSessionCredentialValidationError | EnvironmentAuth.ServerAuthSessionRevocationError | EnvironmentAuth.ServerAuthSessionTokenIssueError | EnvironmentAuth.ServerAuthSessionsListError | EnvironmentAuth.ServerAuthWebSocketTokenIssueError | import("../environment/ServerEnvironment.vibe").ServerEnvironmentIdPersistenceError | import("../auth/SessionStore.vibe").SessionCredentialIssueError | import("effect/sql/SqlError").SqlError | ThreadServerNotRunningError | ThreadServerUnreachableError | import("effect/cli/CliError").UserError | import("../persistence/initializeV2Database.vibe").V2DatabaseImportError)!("effect/cli/GlobalFlag/log-level" | import("@t3tools/shared/Crypto").Crypto | FileSystem.FileSystem | import("@t3tools/shared/Net").NetService | Path.Path | Exclude<Exclude<R, import("effect/Scope").Scope>, import("../persistence/AuthPairingLinks.vibe").AuthPairingLinkRepository | import("../persistence/AuthSessions.vibe").AuthSessionRepository | EnvironmentAuth.EnvironmentAuth | import("../auth/EnvironmentAuthPolicy.vibe").EnvironmentAuthPolicy | import("../auth/PairingGrantStore.vibe").PairingGrantStore | import("../environment/ServerEnvironment.vibe").ServerEnvironmentIdentity | import("../auth/ServerSecretStore.vibe").ServerSecretStore | import("../auth/SessionStore.vibe").SessionStore | import("effect/sql/SqlClient").SqlClient>) =>
  try withSpan(
    effect {
      const logLevel = try GlobalFlag.LogLevel
      const config = try resolveCliAuthConfig(flags, logLevel)
      return try effect {
        provide EnvironmentAuth.layerRuntime.pipe(
              Layer.provide(ServerConfig.layer(config)),
              Layer.provide(Layer.succeed(References.MinimumLogLevel, config.logLevel)),
            ) {
          return try (effect {
            const runtimeState = try readPersistedServerRuntimeState(config.serverRuntimeStatePath)
            if (Option.isNone(runtimeState)) {
              throw new ThreadServerNotRunningError({ baseDir: config.baseDir })
            }
            const origin = runtimeState.value.origin
            const environmentAuth = try EnvironmentAuth.EnvironmentAuth
            const issued = try Effect.acquireRelease(
              environmentAuth.issueMcpClientSession({
                label: "t3 thread cli",
                // The CLI runs as the machine's owner. New threads still start at
                // the project's default mode, never at this ceiling by default.
                access: "full-access",
                peerLink: false,
                client: { deviceType: "bot" },
              }),
              (session) => environmentAuth.revokeSession(session.sessionId) |> Effect.ignore({ log: true })(%),
            )
            const session = mcpToolSession({
              endpoint: new URL("/mcp", origin).href,
              authorization: `Bearer ${issued.token}`,
              clientName: "t3-thread-cli",
            }) catch effect (cause) => {
              throw new ThreadServerUnreachableError({ origin, cause })
            }
            return try run(makeThreadTools(session, origin))
          }
            |> Effect.scoped(%))
        }
      }
    },
    "cli.thread.withThreadTools",
  )

const readMessageArgument = effect (argument: string) =>
  try withSpan(
    effect {
      const text = argument === "-"
        ? try (Stdio.Stdio
          |> Effect.flatMap(%, (stdio) => stdio.stdin.pipe(Stream.decodeText(), Stream.mkString)))
        : argument
      if (text.trim().length === 0) {
        throw new ThreadUsageError({ detail: "The message is empty." })
      }
      return text
    },
    "cli.thread.readMessage",
  )

const listAllProjects = effect (
  tools: {
    call: <S extends Schema.Decoder<unknown>>(
      tool: string,
      args: Readonly<Record<string, unknown>>,
      schema: S,
    ) => S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)!never
  },
) =>
  try withSpan(
    effect {
      const projects: Array<(typeof ProjectListResult.Type)["projects"][number]> = []
      let cursor: number | null = 0
      while (cursor !== null) {
        const page: typeof ProjectListResult.Type = try tools.call(
          "t3_project_list",
          { cursor, limit: 100 },
          ProjectListResult,
        )
        projects.push(...page.projects)
        cursor = page.nextCursor
      }
      return projects
    },
    "cli.thread.listAllProjects",
  )

/** A project id, or a path inside a project's folder (deepest project wins). */
const resolveProject = effect (
  tools: {
    call: <S extends Schema.Decoder<unknown>>(
      tool: string,
      args: Readonly<Record<string, unknown>>,
      schema: S,
    ) => S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)!never
  },
  identifier: string,
) =>
  try withSpan(
    effect {
      const projects = try listAllProjects(tools)
      const byId = projects.find((project) => project.id === identifier)
      if (byId !== undefined) return byId

      const path = try Path.Path
      const fileSystem = try FileSystem.FileSystem
      // Stored roots keep the path the project was added with, which may pass
      // through a symlink (macOS /tmp), so both sides compare as real paths.
      const realPath = (value: string) => fileSystem.realPath(value) |> Effect.orElseSucceed(%, () => value)
      const target = try realPath(path.resolve(try HostProcess.WorkingDirectory, identifier))
      const roots = try Effect.forEach(
        projects,
        (project) => Effect.map(realPath(project.workspaceRoot), (root) => ({ project, root })),
      )
      const containing = roots
        .filter(({ root }) => {
          const relative = path.relative(root, target)
          return (
            relative === ""
            || (relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative))
          )
        })
        .toSorted((left, right) => right.root.length - left.root.length)[0]
      if (containing === undefined) {
        throw new ThreadProjectNotFoundError({ identifier })
      }
      return containing.project
    },
    "cli.thread.resolveProject",
  )

/** Every item on a timeline view, oldest first. */
const readTimeline = effect (
  tools: {
    call: <S extends Schema.Decoder<unknown>>(
      tool: string,
      args: Readonly<Record<string, unknown>>,
      schema: S,
    ) => S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)!never
  },
  threadId: ThreadId,
  view: "activity" | "messages",
) =>
  try withSpan(
    effect {
      const items: Array<OrchestratorMcpThreadTimelineItem> = []
      let afterPosition: number | undefined
      let page: OrchestratorMcpThreadReadResult
      do {
        page = try tools.call(
          "t3_thread_read",
          {
            threadId,
            view,
            limit: READ_PAGE_LIMIT,
            runLimit: 1,
            ...(afterPosition === undefined ? {} : { afterPosition }),
          },
          OrchestratorMcpThreadReadResult,
        )
        items.push(...page.items)
        afterPosition = page.nextPosition ?? undefined
      } while (page.hasMore && afterPosition !== undefined)
      return { thread: page.thread, items }
    },
    "cli.thread.readTimeline",
  )

/** Item text past the read's per-item cap. */
const readFullText = effect (
  tools: {
    call: <S extends Schema.Decoder<unknown>>(
      tool: string,
      args: Readonly<Record<string, unknown>>,
      schema: S,
    ) => S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)!never
  },
  threadId: ThreadId,
  item: OrchestratorMcpThreadTimelineItem,
) =>
  try withSpan(
    effect {
      let text = item.text ?? ""
      let nextTextOffset = item.textTruncated ? (item.nextTextOffset ?? null) : null
      while (nextTextOffset !== null) {
        const page = try tools.call(
          "t3_thread_read",
          { threadId, itemId: item.itemId, textOffset: nextTextOffset, runLimit: 1 },
          OrchestratorMcpThreadReadResult,
        )
        const chunk = page.items.find((candidate) => candidate.itemId === item.itemId)
        if (chunk === undefined) break
        text += chunk.text ?? ""
        nextTextOffset = chunk.textTruncated ? (chunk.nextTextOffset ?? null) : null
      }
      return text
    },
    "cli.thread.readFullText",
  )

/** The run's last assistant message, or its last error when it did not complete. */
const runResultText = effect (
  tools: {
    call: <S extends Schema.Decoder<unknown>>(
      tool: string,
      args: Readonly<Record<string, unknown>>,
      schema: S,
    ) => S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)!never
  },
  threadId: ThreadId,
  runId: RunId,
  type: "assistant_message" | "error",
) =>
  try withSpan(
    effect {
      const { items } = try readTimeline(
        tools,
        threadId,
        type === "assistant_message" ? "messages" : "activity",
      )
      const item = items.findLast((candidate) => candidate.runId === runId && candidate.type === type)
      return item === undefined ? null : try readFullText(tools, threadId, item)
    },
    "cli.thread.runResultText",
  )

type WaitOutcome =
  | {
    readonly type: "ended"
    readonly runId: RunId | null
    readonly status: OrchestratorMcpThreadStatus
  }
  | { readonly type: "needs_input" }

/**
 * Waits for this exact run, following a restart to its continuation, so a
 * message another client sends meanwhile cannot stand in for its result.
 */
export const waitForRun = effect (
  tools: {
    call: <S extends Schema.Decoder<unknown>>(
      tool: string,
      args: Readonly<Record<string, unknown>>,
      schema: S,
    ) => S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)!never
  },
  threadId: ThreadId,
  runId: RunId,
) =>
  try withSpan(
    effect {
      const waitSlice = (timeoutMs: number) =>
        tools.call("t3_thread_wait", { threadId, runId, timeoutMs }, OrchestratorMcpThreadWaitResult)
      const ended = (waited: OrchestratorMcpThreadWaitResult) =>
        ({ type: "ended", runId: waited.runId, status: waited.status }) satisfies WaitOutcome
      while (true) {
        const waited = try waitSlice(WAIT_SLICE_MS)
        if (!waited.timedOut) return ended(waited)
        // A pending request on this run, or on an earlier run this one is queued
        // behind, blocks it until someone answers.
        const { thread } = try tools.call(
          "t3_thread_read",
          { threadId, limit: 1, runLimit: 1 },
          OrchestratorMcpThreadReadResult,
        )
        if (thread.pendingRequestCount > 0) {
          // The count is thread-wide: if this run ended since the slice, the
          // request belongs to a later run.
          const recheck = try waitSlice(1)
          return recheck.timedOut ? ({ type: "needs_input" } satisfies WaitOutcome) : ended(recheck)
        }
      }
    },
    "cli.thread.waitForRun",
  )

/**
 * With --json the result always reaches stdout, so a script keeps the thread
 * id even when the run fails.
 */
const finishRun = effect (
  tools: {
    call: <S extends Schema.Decoder<unknown>>(
      tool: string,
      args: Readonly<Record<string, unknown>>,
      schema: S,
    ) => S["Type"]!(ThreadServerUnreachableError | ThreadToolFailedError)!never
  },
  input: { readonly threadId: ThreadId; readonly runId: RunId; readonly json: boolean },
) =>
  try withSpan(
    effect {
      const outcome = try waitForRun(tools, input.threadId, input.runId)
      const runId = outcome.type === "ended" ? (outcome.runId ?? input.runId) : input.runId
      const status = outcome.type === "ended" ? outcome.status : "waiting"
      const reply = status === "completed"
        ? try runResultText(tools, input.threadId, runId, "assistant_message")
        : null
      const error = status === "completed" || status === "waiting"
        ? null
        : try runResultText(tools, input.threadId, runId, "error")
      if (input.json) {
        try printJson({ threadId: input.threadId, runId, status, reply, error })
      } else if (reply !== null) {
        try Console.log(reply)
      }
      if (outcome.type === "needs_input") {
        throw new ThreadNeedsInputError({ threadId: input.threadId })
      }
      if (status !== "completed") {
        throw new ThreadRunEndedError({
          threadId: input.threadId,
          status,
          ...(error === null ? {} : { error }),
        })
      }
    },
    "cli.thread.finishRun",
  )

const titleFromMessage = (message: string) => {
  const firstLine = message.trim().split("\n")[0]?.trim() ?? ""
  return firstLine.length > TITLE_MAX_CHARS
    ? `${firstLine.slice(0, TITLE_MAX_CHARS - 1).trimEnd()}…`
    : firstLine
}

const launchWorkspaceStrategy = (input: {
  readonly worktree: Option.Option<string>
  readonly branch: Option.Option<string>
}) =>
  do {
    const $optionSubject = input.worktree
    const $optionHandlers: {
      onNone: () => (void!never!never) | (never!ThreadUsageError!never)
      onSome: (baseRef: string) => { type: "worktree"; baseRef: string; branch?: string; }!!
    } = {
      onNone: () =>
        Option.isSome(input.branch)
          ? Effect.fail(new ThreadUsageError({ detail: "--branch needs --worktree <base-ref>." }))
          : Effect.void,
      onSome: (baseRef) =>
        Effect.succeed({
          type: "worktree" as const,
          baseRef,
          ...do {
            const $optionSubject$1 = input.branch
            const $optionHandlers$1: { onNone: () => {}; onSome: (branch: string) => { branch: string } } = {
              onNone: () => ({}),
              onSome: (branch) => ({ branch }),
            }
            const { onNone: $optionNone$1, onSome: $optionSome$1 } = $optionHandlers$1
            match ($optionSubject$1) {
              when Option.Some(let $optionValue$1): $optionSome$1($optionValue$1);
              default: $optionNone$1();
            }
          },
        }),
    }
    const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
    match ($optionSubject) {
      when Option.Some(let $optionValue): $optionSome($optionValue);
      default: $optionNone();
    }
  }

const jsonFlag = Flag.Boolean("json").pipe(
  Flag.withDescription("Print JSON instead of text."),
  Flag.withDefault(false),
)
const waitFlag = Flag.Boolean("wait").pipe(
  Flag.withDescription(
    "Wait for the agent to finish and print its reply. Exits 1 if the run fails and 2 if it waits for an answer.",
  ),
  Flag.withDefault(false),
)
const messageArgument = Argument.String("message").pipe(
  Argument.withDescription("Message for the agent, or - to read it from stdin."),
)
const threadArgument = Argument.String("thread").pipe(Argument.withDescription("Thread id."))

const decodeThreadIdValue = Schema.decodeUnknownEffect(ThreadId)
const decodeTitle = Schema.decodeUnknownEffect(TrimmedNonEmptyString)
const decodeThreadId = (value: string) =>
  decodeThreadIdValue(value.trim())
  |> Effect.mapError(%, () => new ThreadUsageError({ detail: `'${value}' is not a thread id.` }))

const threadListCommand = Command.make("list", {
  ...projectLocationFlags,
  project: Flag.String("project").pipe(
    Flag.withDescription("Project id or a path inside the project. Defaults to this directory."),
    Flag.withDefault("."),
  ),
  json: jsonFlag,
}).pipe(
  Command.withDescription("List a project's threads, newest first."),
  Command.withHandler((flags) =>
    withThreadTools(
      flags,
      effect (
        tools,
      ): void!(ThreadProjectNotFoundError | ThreadServerUnreachableError | ThreadToolFailedError)!(FileSystem.FileSystem | Path.Path) =>
        try withSpan(
          (effect (): void!(ThreadProjectNotFoundError | ThreadServerUnreachableError | ThreadToolFailedError)!(FileSystem.FileSystem | Path.Path) => {
            const project = try resolveProject(tools, flags.project)
            const threads: Array<OrchestratorMcpThreadListItem> = []
            let cursor: number | null = 0
            while (cursor !== null) {
              const page: OrchestratorMcpThreadListResult = try tools.call(
                "t3_thread_list",
                { projectId: project.id, includeSubagents: false, limit: 100, cursor },
                OrchestratorMcpThreadListResult,
              )
              threads.push(...page.threads)
              cursor = page.nextCursor
            }
            if (flags.json) {
              return try printJson(threads)
            }
            for (const thread of threads) {
              try Console.log(`${thread.threadId}  ${thread.status.padEnd(11)}  ${thread.title}`)
            }
          })(),
          "cli.thread.list",
        ),
    ) |> reportThreadErrors(%)
  ),
)

const threadStartCommand = Command.make("start", {
  ...projectLocationFlags,
  project: Argument.String("project").pipe(
    Argument.withDescription("Project id or a path inside the project, such as ."),
  ),
  message: messageArgument,
  title: Flag.String("title").pipe(
    Flag.withDescription("Thread title. Defaults to the message's first line."),
    Flag.optional,
  ),
  provider: Flag.String("provider").pipe(
    Flag.withDescription("Provider instance id. Pass with --model."),
    Flag.optional,
  ),
  model: Flag.String("model").pipe(
    Flag.withDescription("Model slug. Defaults to the project's default model."),
    Flag.optional,
  ),
  worktree: Flag.String("worktree").pipe(
    Flag.withDescription(
      "Run in a new git worktree based on this branch, tag, or commit, instead of the project folder.",
    ),
    Flag.optional,
  ),
  branch: Flag.String("branch").pipe(
    Flag.withDescription("Branch name for the new worktree."),
    Flag.optional,
  ),
  wait: waitFlag,
  json: jsonFlag,
}).pipe(
  Command.withDescription("Start a thread in a project and print its id."),
  Command.withHandler((flags) =>
    effect {
      const message = try readMessageArgument(flags.message)
      const workspaceStrategy = try launchWorkspaceStrategy(flags)
      if (Option.isSome(flags.provider) !== Option.isSome(flags.model)) {
        throw new ThreadUsageError({ detail: "--provider and --model go together." })
      }
      const title = decodeTitle(
        Option.getOrElse(flags.title, () => titleFromMessage(message)),
      ) catch effect () => {
        throw new ThreadUsageError({ detail: "The title is empty." })
      }
      try withThreadTools(
        flags,
        effect (
          tools,
        ): undefined!(ThreadNeedsInputError | ThreadProjectNotFoundError | ThreadRunEndedError | ThreadServerUnreachableError | ThreadToolFailedError)!(FileSystem.FileSystem | Path.Path) =>
          try withSpan(
            (effect (): undefined!(ThreadNeedsInputError | ThreadProjectNotFoundError | ThreadRunEndedError | ThreadServerUnreachableError | ThreadToolFailedError)!(FileSystem.FileSystem | Path.Path) => {
              const project = try resolveProject(tools, flags.project)
              const launched = try tools.call(
                "t3_thread_launch",
                {
                  projectId: project.id,
                  title,
                  message,
                  ...(workspaceStrategy === undefined ? {} : { workspaceStrategy }),
                  ...(Option.isSome(flags.provider) && Option.isSome(flags.model)
                    ? {
                      modelSelection: {
                        instanceId: flags.provider.value,
                        model: flags.model.value,
                      },
                    }
                    : {}),
                },
                ThreadLaunchResult,
              )
              if (flags.wait && launched.runId !== null) {
                if (!flags.json) try Console.error(`Thread ${launched.threadId}`)
                return try finishRun(tools, {
                  threadId: launched.threadId,
                  runId: launched.runId,
                  json: flags.json,
                })
              }
              try (flags.json ? printJson(launched) : Console.log(launched.threadId))
            })(),
            "cli.thread.start",
          ),
      )
    } |> reportThreadErrors(%)
  ),
)

const threadSendCommand = Command.make("send", {
  ...projectLocationFlags,
  thread: threadArgument,
  message: messageArgument,
  wait: waitFlag,
  json: jsonFlag,
}).pipe(
  Command.withDescription(
    "Send a message to a thread. A busy thread gets it as its next turn; nothing is interrupted.",
  ),
  Command.withHandler((flags) =>
    effect {
      const threadId = try decodeThreadId(flags.thread)
      const message = try readMessageArgument(flags.message)
      try withThreadTools(
        flags,
        effect (
          tools,
        ): undefined!(ThreadNeedsInputError | ThreadRunEndedError | ThreadServerUnreachableError | ThreadToolFailedError)!never =>
          try withSpan(
            (effect (): undefined!(ThreadNeedsInputError | ThreadRunEndedError | ThreadServerUnreachableError | ThreadToolFailedError)!never => {
              const sent = try tools.call(
                "t3_thread_send",
                { threadId, message, mode: "queue" },
                OrchestratorMcpThreadSendResult,
              )
              if (flags.wait) {
                return try finishRun(tools, { threadId, runId: sent.runId, json: flags.json })
              }
              try (flags.json
                ? printJson(sent)
                : Console.log(sent.delivery === "queued" ? "Queued." : "Sent."))
            })(),
            "cli.thread.send",
          ),
      )
    } |> reportThreadErrors(%)
  ),
)

const threadShowCommand = Command.make("show", {
  ...projectLocationFlags,
  thread: threadArgument,
  messages: Flag.Int("messages").pipe(
    Flag.withDescription("How many of the latest messages to print."),
    Flag.withDefault(10),
  ),
  json: jsonFlag,
}).pipe(
  Command.withDescription("Show a thread's state and its latest messages."),
  Command.withHandler((flags) =>
    effect {
      const threadId = try decodeThreadId(flags.thread)
      try withThreadTools(
        flags,
        effect (tools): void!(ThreadServerUnreachableError | ThreadToolFailedError)!never =>
          try withSpan(
            (effect (): void!(ThreadServerUnreachableError | ThreadToolFailedError)!never => {
              const { thread, items } = try readTimeline(tools, threadId, "messages")
              const conversation = items.filter(
                (item) => item.type === "user_message" || item.type === "assistant_message",
              )
              const latest = conversation.slice(Math.max(0, conversation.length - flags.messages))
              const messages = try Effect.forEach(latest, (item) =>
                readFullText(tools, threadId, item)
                |> Effect.map(%, (text) => ({
                  role: item.type === "user_message" ? "user" : "assistant",
                  runId: item.runId,
                  text,
                })))
              if (flags.json) {
                return try printJson({ thread, messages })
              }
              try Console.log(thread.title)
              try Console.log(
                [thread.threadId, thread.status, `${thread.providerInstanceId}/${thread.model}`].join(
                  "  ",
                ),
              )
              if (thread.worktreePath !== null) {
                try Console.log(`${thread.branch ?? "(no branch)"}  ${thread.worktreePath}`)
              }
              if (thread.pendingRequestCount > 0) {
                try Console.log(`Waiting for ${thread.pendingRequestCount} answer(s).`)
              }
              for (const entry of messages) {
                try Console.log(`\n[${entry.role}]\n${entry.text}`)
              }
            })(),
            "cli.thread.show",
          ),
      )
    } |> reportThreadErrors(%)
  ),
)

export const threadCommand = Command.make("thread").pipe(
  Command.withDescription("Start, message, and read threads on the running server."),
  Command.withSubcommands([
    threadListCommand,
    threadStartCommand,
    threadSendCommand,
    threadShowCommand,
  ]),
)
