import type {
  EnvironmentId,
  OrchestrationV2DomainEvent,
  OrchestrationV2ThreadShell,
  OrchestrationV2TurnItem,
  Project,
  ThreadId,
} from "@t3tools/contracts"
import {
  RelayApi,
  type RelayAgentActivityPublishProofPayload,
  type RelayAgentActivityState,
} from "@t3tools/contracts/relay"
import { projectThreadAwarenessV2 } from "@t3tools/shared/agentAwareness"
import { turnItemUpdateCanEndBackgroundWork } from "@t3tools/shared/orchestrationV2PendingBackgroundWork"
import { makeDrainableWorker } from "@t3tools/shared/DrainableWorker"
import { withRelayClientTracing } from "@t3tools/shared/relayTracing"
import { normalizeRelayIssuer, RELAY_ACTIVITY_PUBLISH_TYP, signRelayJwt } from "@t3tools/shared/relayJwt"
import * as Cause from "effect/Cause"
import * as Context from "effect/Context"
import * as Crypto from "@t3tools/shared/Crypto"
import * as DateTime from "effect/DateTime"
import * as Effect from "effect/Effect"
import * as Fiber from "effect/Fiber"
import * as Layer from "effect/Layer"
import * as Option from "effect/Option"
import * as Queue from "effect/Queue"
import * as Ref from "effect/Ref"
import type * as Scope from "effect/Scope"
import * as Stream from "effect/Stream"
import * as FetchHttpClient from "effect/http/FetchHttpClient"
import * as HttpClient from "effect/http/HttpClient"
import * as HttpClientRequest from "effect/http/HttpClientRequest"
import * as HttpApiClient from "effect/http-api/HttpApiClient"

import * as ServerSecretStore from "../auth/ServerSecretStore.vibe"
import {
  isAgentActivityPublishingEnabledValue,
  PUBLISH_AGENT_ACTIVITY_SECRET,
  RELAY_ENVIRONMENT_CREDENTIAL_SECRET,
  RELAY_ISSUER_SECRET,
  RELAY_URL_SECRET,
} from "../cloud/config.vibe"
import { getOrCreateEnvironmentKeyPairFromSecretStore } from "../cloud/environmentKeys.vibe"
import * as ServerEnvironment from "../environment/ServerEnvironment.vibe"
import * as ThreadManagement from "../orchestration-v2/ThreadManagementService.vibe"
import * as ProjectService from "../project/ProjectService.vibe"
import { forkParked } from "../serverActivation.vibe"

export service AgentAwarenessRelay: {
  readonly publishThread: (threadId: ThreadId) => void!!;
  readonly drain: void!!;
  readonly requestCatchUp: () => void!!;
  readonly start: () => void!never!Scope.Scope;
} {
  static readonly key = "t3/relay/AgentAwarenessRelay"
}

function eventThreadId(event: OrchestrationV2DomainEvent): ThreadId {
  return event.threadId
}

function isTurnItemPayload(
  payload: unknown,
): payload is Pick<OrchestrationV2TurnItem, "type" | "status"> {
  return (
    typeof payload === "object" && payload !== null && "type" in payload && "status" in payload
  )
}

function shouldPublishAgentAwarenessEvent(
  event: Pick<OrchestrationV2DomainEvent, "type"> & { readonly payload?: unknown },
): boolean {
  if (
    event.type === "thread.created"
    && typeof event.payload === "object"
    && event.payload !== null
    && "historyOrigin" in event.payload
    && event.payload.historyOrigin === "v1_import"
  ) {
    return false
  }
  switch (event.type) {
    case "thread.created":
    case "thread.archived":
    case "thread.unarchived":
    case "thread.deleted":
    case "thread.metadata-updated":
    case "thread.pull-request-link-updated":
    case "thread.pull-request-synced":
    case "thread.settled":
    case "thread.model-selection-updated":
    case "thread.provider-switched":
    case "run.created":
    case "run.updated":
    case "runtime-request.updated":
    case "subagent.updated":
    case "provider-thread.updated":
      return true
    // Unsettling must not re-alert a dismissed result.
    case "thread.unsettled":
    case "thread.guest-share-updated":
    case "thread.snoozed":
    case "thread.unsnoozed":
    case "thread.auto-settle-set":
    case "thread.pinned":
    case "thread.unpinned":
    case "thread.pin-reordered":
    case "thread.active-reordered":
    case "thread.visited":
    case "thread.marked-unread":
    case "thread.runtime-mode-updated":
    case "thread.interaction-mode-updated":
    case "run.background-work-cancelled":
    case "run-attempt.created":
    case "run-attempt.updated":
    case "node.updated":
    case "provider-session.attached":
    case "provider-session.updated":
    case "provider-session.detached":
    case "provider-turn.updated":
    case "turn-item.updated":
      return isTurnItemPayload(event.payload) && turnItemUpdateCanEndBackgroundWork(event.payload)
    case "message.updated":
    case "plan.updated":
    case "checkpoint-scope.created":
    case "checkpoint.captured":
    case "checkpoint.rollback-requested":
    case "context-handoff.updated":
    case "context-transfer.created":
    case "context-transfer.updated":
      return false
  }
}

export const makeAgentAwarenessPublishWorker = effect <R>(
  publish: (threadId: ThreadId) => void!never!R,
) => {
  const queued = new Set<ThreadId>()
  const worker = try makeDrainableWorker((threadId: ThreadId) =>
    effect {
      return queued.delete(threadId)
    } |> Effect.andThen(%, publish(threadId))
  )
  const enqueue = (threadId: ThreadId) =>
    Effect.suspend(() => {
      if (queued.has(threadId)) return Effect.void
      // Remove queued IDs when processing starts so publication can queue one later update.
      queued.add(threadId)
      return worker.enqueue(threadId)
    }) |> Effect.uninterruptible(%)
  return { enqueue, drain: worker.drain }
}

function agentAwarenessPublishIdentity(state: RelayAgentActivityState | null): string {
  if (state === null) {
    return "null"
  }
  const { updatedAt: _updatedAt, ...meaningfulState } = state
  return JSON.stringify(meaningfulState)
}

function resolveAgentActivityPublishingStartupState(input: {
  readonly relayConfigured: boolean
  readonly publishEnabled: boolean
}): "waiting-for-link" | "disabled" | "enabled" {
  if (!input.relayConfigured) {
    return "waiting-for-link"
  }
  return input.publishEnabled ? "enabled" : "disabled"
}

const RELAY_AGENT_ACTIVITY_DETAIL_MAX_LENGTH = 160
const REDACTED_RELAY_AGENT_FAILURE_DETAIL = "The agent run failed."
const RELAY_AGENT_ACTIVITY_RETRY_DELAYS_MS = [1_000, 2_000, 4_000, 8_000, 16_000] as const

function sanitizeRelayAgentActivityState(
  state: RelayAgentActivityState | null,
): RelayAgentActivityState | null {
  if (state === null) {
    return null
  }
  const { detail: _detail, ...rest } = state
  const detail = (state.phase === "failed" ? REDACTED_RELAY_AGENT_FAILURE_DETAIL : state.detail)
    ?.trim()
    .slice(0, RELAY_AGENT_ACTIVITY_DETAIL_MAX_LENGTH)
    .trim()
  return detail ? { ...rest, detail } : rest
}

function relayEnvironmentClient(token: string) {
  return HttpClient.mapRequest(HttpClientRequest.setHeader("authorization", `Bearer ${token}`))
}

function deliveryStats(
  deliveries: ReadonlyArray<{
    readonly ok: boolean
    readonly queued?: boolean | undefined
    readonly kind: string
    readonly apnsStatus?: number | null
    readonly apnsReason?: string | null
  }>,
) {
  let queued = 0
  let successful = 0
  let failed = 0
  const failedReasons: string[] = []
  const kinds = new Set<string>()

  for (const delivery of deliveries) {
    kinds.add(delivery.kind)
    if (delivery.queued) {
      queued += 1
      continue
    }
    if (delivery.ok) {
      successful += 1
      continue
    }
    failed += 1
    failedReasons.push(`${delivery.apnsStatus ?? "transport"}:${delivery.apnsReason ?? "unknown"}`)
  }

  return {
    total: deliveries.length,
    queued,
    successful,
    failed,
    kinds: [...kinds],
    failedReasons,
  }
}

function signRelayAgentActivityPublishProof(input: {
  readonly privateKey: string
  readonly payload: RelayAgentActivityPublishProofPayload
}) {
  return signRelayJwt({
    privateKey: input.privateKey,
    typ: RELAY_ACTIVITY_PUBLISH_TYP,
    payload: input.payload,
  })
}

const makePublishProof = effect (
  input: {
    readonly privateKey: string
    readonly relayIssuer: string
    readonly environmentId: string
    readonly threadId: ThreadId
    readonly state: RelayAgentActivityState | null
    readonly jti: string
  },
) =>
  try withSpan(
    effect {
      const now = try DateTime.now
      const expiresAt = DateTime.add(now, { minutes: 5 })
      const payload = {
        iss: `t3-env:${input.environmentId}`,
        aud: normalizeRelayIssuer(input.relayIssuer),
        sub: input.environmentId,
        jti: input.jti,
        iat: Math.floor(now.epochMilliseconds / 1_000),
        exp: Math.floor(expiresAt.epochMilliseconds / 1_000),
        environmentId: input.environmentId as RelayAgentActivityPublishProofPayload["environmentId"],
        threadId: input.threadId,
        state: input.state,
      } satisfies RelayAgentActivityPublishProofPayload
      return try signRelayAgentActivityPublishProof({ privateKey: input.privateKey, payload })
    },
    "makePublishProof",
  )

function describeThreadShellForAwareness(
  thread: Option.Option<OrchestrationV2ThreadShell>,
): Record<string, unknown> {
  if (Option.isNone(thread)) {
    return { found: false }
  }
  const shell = thread.value
  return {
    found: true,
    status: shell.status,
    activityRunStatus: shell.activityRunStatus ?? null,
    activeRunId: shell.activeRunId ?? null,
    latestRunId: shell.latestRunId ?? null,
    pendingRuntimeRequestKind: shell.pendingRuntimeRequest?.kind ?? null,
    hasActionableProposedPlan: shell.hasActionableProposedPlan,
  }
}

function resolveAgentAwarenessRelayPublishSnapshot(input: {
  readonly environmentId: EnvironmentId
  readonly threadId: ThreadId
  readonly thread: Option.Option<OrchestrationV2ThreadShell>
  readonly project: Option.Option<Project>
}): {
  readonly projectId: string | null
  readonly state: RelayAgentActivityState | null
  readonly reason: "snapshot" | "thread-not-found" | "project-not-found"
} {
  if (Option.isNone(input.thread)) {
    return {
      projectId: null,
      state: null,
      reason: "thread-not-found",
    }
  }
  if (Option.isNone(input.project)) {
    return {
      projectId: input.thread.value.projectId,
      state: null,
      reason: "project-not-found",
    }
  }
  return {
    projectId: input.thread.value.projectId,
    state: sanitizeRelayAgentActivityState(
      projectThreadAwarenessV2({
        environmentId: input.environmentId,
        project: input.project.value,
        thread: input.thread.value,
      }),
    ),
    reason: "snapshot",
  }
}

function terminalWorkSinceStart(thread: OrchestrationV2ThreadShell, startedAt: number): boolean {
  return (
    thread.latestRunCompletedAt != null
    && DateTime.toEpochMillis(thread.latestRunCompletedAt) > startedAt
  )
}

export function resolveAgentAwarenessRelayActiveThreadIds(input: {
  readonly environmentId: EnvironmentId
  readonly startedAt: number
  readonly projects: ReadonlyArray<Pick<Project, "id" | "title">>
  readonly threads: ReadonlyArray<OrchestrationV2ThreadShell>
}): ReadonlyArray<ThreadId> {
  const projectById = new Map(input.projects.map((project) => [project.id, project]))
  return input.threads
    .filter((thread) => {
      const project = projectById.get(thread.projectId)
      if (!project) {
        return false
      }
      const state = projectThreadAwarenessV2({
        environmentId: input.environmentId,
        project,
        thread,
      })
      return (
        state !== null
        && (state.phase !== "completed" && state.phase !== "failed"
          ? true
          : terminalWorkSinceStart(thread, input.startedAt))
      )
    })
    .map((thread) => thread.id)
}

/** @public */
export const make = effect {
  const secrets = try ServerSecretStore.ServerSecretStore
  const serverEnvironment = try ServerEnvironment.ServerEnvironment
  const threads = try ThreadManagement.ThreadManagementService
  const projects = try ProjectService.ProjectService
  const crypto = try Crypto.Crypto
  const scope = try Effect.scope
  const cloudLinkKeyPair = try getOrCreateEnvironmentKeyPairFromSecretStore(secrets)
  const startedAt = (try DateTime.now).epochMilliseconds
  const activeSnapshotPublishedRef = try Ref.make(false)
  const catchUpRequests = try Queue.dropping<void>(1)
  const publishedStateByThreadRef = try Ref.make(new Map<ThreadId, string>())

  const readSecretString = (name: string) =>
    secrets
      .get(name)
    |> Effect.map(%, (bytes) => Option.isSome(bytes) ? new TextDecoder().decode(bytes.value) : null)

  const readRelayConfig = effect {
    const [url, issuer, environmentCredential] = try Effect.all([
      readSecretString(RELAY_URL_SECRET),
      readSecretString(RELAY_ISSUER_SECRET),
      readSecretString(RELAY_ENVIRONMENT_CREDENTIAL_SECRET),
    ])
    return url && environmentCredential
      ? { url, issuer: issuer ?? url, environmentCredential }
      : null
  }

  const readPublishAgentActivityEnabled = readSecretString(PUBLISH_AGENT_ACTIVITY_SECRET)
    |> Effect.map(%, isAgentActivityPublishingEnabledValue)

  const makeRelayClient = (relayConfig: {
    readonly url: string
    readonly environmentCredential: string
  }) =>
    HttpApiClient.make(RelayApi, {
      baseUrl: relayConfig.url,
      transformClient: relayEnvironmentClient(relayConfig.environmentCredential),
    }) |> Effect.provide(%, FetchHttpClient.layer)

  let cachedRelayClient: Effect.Success<ReturnType<typeof makeRelayClient>> | undefined
  let publishedRelayConfig: NonNullable<Effect.Success<typeof readRelayConfig>> | undefined

  // Confirm through the same worker so tombstones cannot race live updates; recovery clears the deadline.
  const publishConfirmDeadlines = new Map<ThreadId, number>()
  // Threads whose confirmation holds a completion, so a thread that settles during the hold still alerts.
  const heldCompletions = new Set<ThreadId>()
  let schedulePublishConfirm: (threadId: ThreadId) => void!! = () => Effect.void
  const publishRetries = new Map<
    ThreadId,
    { readonly attempts: number; timer: Fiber.Fiber<void> | undefined }
  >()
  const cancelPublishRetry = effect (threadId: ThreadId) => {
    const retry = publishRetries.get(threadId)
    publishRetries.delete(threadId)
    if (retry?.timer !== undefined) try Fiber.interrupt(retry.timer)
  }
  const cancelPublishRetries = effect {
    return try Effect.forEach([...publishRetries.keys()], cancelPublishRetry, { discard: true })
  }
  let schedulePublishRetry: (threadId: ThreadId) => void!! = () => Effect.void
  const resetPublishedConnection = effect {
    publishedRelayConfig = undefined
    cachedRelayClient = undefined
    publishConfirmDeadlines.clear()
    heldCompletions.clear()
    try Ref.set(publishedStateByThreadRef, new Map())
  }

  const publishThreadUnsafe = effect (threadId: ThreadId) =>
    try withSpan(
      effect {
        const publishAgentActivity = try readPublishAgentActivityEnabled
        if (!publishAgentActivity) {
          try cancelPublishRetries
          try resetPublishedConnection
          try Effect.logDebug("agent activity publish skipped; publication disabled", {
            threadId,
          })
          return
        }
        const relayConfig = try readRelayConfig
        if (!relayConfig) {
          try cancelPublishRetries
          try resetPublishedConnection
          try Effect.logDebug("agent activity publish skipped; relay link credentials unavailable", {
            threadId,
          })
          return
        }
        if (
          publishedRelayConfig?.url !== relayConfig.url
          || publishedRelayConfig.issuer !== relayConfig.issuer
          || publishedRelayConfig.environmentCredential !== relayConfig.environmentCredential
        ) {
          try resetPublishedConnection
          publishedRelayConfig = relayConfig
        }
        const environmentId = try serverEnvironment.getEnvironmentId

        const publishState = effect (
          input: {
            readonly projectId: string | null
            readonly state: RelayAgentActivityState | null
            readonly reason: string
          },
        ) =>
          try withSpan(
            effect {
              if (cachedRelayClient === undefined) {
                cachedRelayClient = try makeRelayClient(relayConfig)
              }
              const relayClient = cachedRelayClient
              const proof = try makePublishProof({
                privateKey: cloudLinkKeyPair.privateKey,
                relayIssuer: relayConfig.issuer,
                environmentId,
                threadId,
                state: input.state,
                jti: try crypto.randomUUIDv4(),
              })

              try Effect.logInfo("publishing agent activity for thread", {
                environmentId,
                threadId,
                projectId: input.projectId,
                statePhase: input.state?.phase ?? null,
                hasState: input.state !== null,
                reason: input.reason,
              })

              const response = try (relayClient.server
                .publishAgentActivity({
                  params: {
                    environmentId,
                    threadId,
                  },
                  payload: {
                    state: input.state,
                    proof,
                  },
                }) |> Effect.timeout(%, "10 seconds"))

              try Effect.logInfo("agent activity publish completed", {
                environmentId,
                threadId,
                ok: response.ok,
                deliveries: deliveryStats(response.deliveries),
              })
            },
            "relay.agent_activity.publish",
          )

        // Read only this thread; full shell reads would make each activity event scale with all threads.
        const threadShell = try threads.getThreadShell(threadId)
        if (
          threadShell?.lineage.relationshipToParent === "subagent"
          && !(try Ref.get(publishedStateByThreadRef)).has(threadId)
        ) {
          // Subagents have no relay rows to clear; per-event tombstones would needlessly redeliver user aggregates.
          return
        }
        const thread = threadShell === null || threadShell.archivedAt !== null
          ? Option.none<OrchestrationV2ThreadShell>()
          : Option.some(threadShell)
        const project = Option.isSome(thread)
          ? try projects.getById(thread.value.projectId)
          : Option.none<Project>()
        const snapshot = resolveAgentAwarenessRelayPublishSnapshot({
          environmentId,
          threadId,
          thread,
          project,
        })
        const publishIdentity = agentAwarenessPublishIdentity(snapshot.state)
        const publishedStateByThread = try Ref.get(publishedStateByThreadRef)
        if (
          (snapshot.state?.phase === "completed" || snapshot.state?.phase === "failed")
          && !publishedStateByThread.has(threadId)
        ) {
          if (Option.isNone(thread) || !terminalWorkSinceStart(thread.value, startedAt)) return
        }
        if (publishedStateByThread.get(threadId) === publishIdentity) {
          // Clear moot deadlines so later transient nulls cannot skip their deferral window.
          publishConfirmDeadlines.delete(threadId)
          heldCompletions.delete(threadId)
          try Effect.logDebug("agent activity publish skipped; projected state unchanged", {
            environmentId,
            threadId,
            reason: snapshot.reason,
          })
          return
        }

        // Confirm tombstones over live state to avoid removing active cards.
        // Confirm completion: a run can end moments before its continuation starts, and the relay
        // alerts on every move into completed.
        const requiresConfirmation = (snapshot.state === null
          && publishedStateByThread.get(threadId) !== agentAwarenessPublishIdentity(null))
          || snapshot.state?.phase === "completed"
        if (requiresConfirmation) {
          if (snapshot.state?.phase === "completed") heldCompletions.add(threadId)
          const nowMs = (try DateTime.now).epochMilliseconds
          const deadline = publishConfirmDeadlines.get(threadId)
          if (deadline === undefined) {
            publishConfirmDeadlines.set(threadId, nowMs + 5_000)
            try Effect.logInfo("agent activity publish deferred pending confirmation", {
              environmentId,
              threadId,
              reason: snapshot.reason,
              statePhase: snapshot.state?.phase ?? null,
              shell: describeThreadShellForAwareness(thread),
            })
            try schedulePublishConfirm(threadId)
            return
          }
          if (nowMs < deadline) {
            return
          }
          try Effect.logInfo("agent activity deferred publish confirmed", {
            environmentId,
            threadId,
            reason: snapshot.reason,
            statePhase: snapshot.state?.phase ?? null,
            shell: describeThreadShellForAwareness(thread),
          })
          // Settled during the hold, not resumed: alert the current completion, then clear the card
          // on a new window. Only settlement may hide it; queued or silent runs also project to null.
          const unsettled = snapshot.state === null
              && heldCompletions.has(threadId)
              && Option.isSome(thread)
              && thread.value.settledOverride === "settled"
            ? resolveAgentAwarenessRelayPublishSnapshot({
              environmentId,
              threadId,
              thread: Option.some({ ...thread.value, settledOverride: null }),
              project,
            })
            : null
          if (unsettled?.state?.phase === "completed") {
            const completion = unsettled.state
            try (publishState({
              projectId: unsettled.projectId,
              state: completion,
              reason: unsettled.reason,
            }) |> withRelayClientTracing(%))
            heldCompletions.delete(threadId)
            publishConfirmDeadlines.set(threadId, nowMs + 5_000)
            try Ref.update(
              publishedStateByThreadRef,
              (publishedStates) => new Map(publishedStates).set(threadId, agentAwarenessPublishIdentity(completion)),
            )
            try schedulePublishConfirm(threadId)
            return
          }
        } else {
          publishConfirmDeadlines.delete(threadId)
          heldCompletions.delete(threadId)
        }

        if (snapshot.reason === "thread-not-found") {
          try Effect.logDebug("publishing agent activity tombstone; thread not found", {
            environmentId,
            threadId,
          })
        } else if (snapshot.reason === "project-not-found") {
          try Effect.logDebug("publishing agent activity tombstone; project not found", {
            environmentId,
            threadId,
            projectId: snapshot.projectId,
          })
        }

        try (publishState({
          projectId: snapshot.projectId,
          state: snapshot.state,
          reason: snapshot.reason,
        }) |> withRelayClientTracing(%))
        publishConfirmDeadlines.delete(threadId)
        heldCompletions.delete(threadId)
        try Ref.update(publishedStateByThreadRef, (publishedStates) => {
          const nextPublishedStates = new Map(publishedStates)
          if (snapshot.state === null) {
            nextPublishedStates.delete(threadId)
          } else {
            nextPublishedStates.set(threadId, publishIdentity)
          }
          return nextPublishedStates
        })
      },
      "publishThreadUnsafe",
    )

  const processThreadPublish = effect (threadId: ThreadId) => {
    const retry = publishRetries.get(threadId)
    if (retry?.timer !== undefined) {
      const timer = retry.timer
      retry.timer = undefined
      try Fiber.interrupt(timer)
    }
    try withSpan(
      publishThreadUnsafe(threadId)
        |> Effect.tap(%, () => cancelPublishRetry(threadId))
        |> Effect.catchCause(%, (cause) => {
          if (Cause.hasInterruptsOnly(cause)) return Effect.void
          return Effect.logWarning("agent activity publish failed", {
            threadId,
            cause: Cause.pretty(cause),
          }) |> Effect.andThen(%, schedulePublishRetry(threadId))
        }),
      "AgentAwarenessRelay.publishThread",
    )
  }

  const worker = try makeAgentAwarenessPublishWorker(processThreadPublish)
  const enqueueThreadPublish = (threadId: ThreadId) =>
    cancelPublishRetry(threadId) |> Effect.andThen(%, worker.enqueue(threadId))
  const publishThread: AgentAwarenessRelay["Service"]["publishThread"] = (threadId) =>
    enqueueThreadPublish(threadId) |> Effect.andThen(%, worker.drain)

  schedulePublishRetry = effect (threadId: ThreadId) => {
    const attempts = publishRetries.get(threadId)?.attempts ?? 0
    const delayMs = RELAY_AGENT_ACTIVITY_RETRY_DELAYS_MS[attempts]
    if (delayMs === undefined) {
      // Retain exhausted budgets until activity or success resets them; old timers must not restart retries.
      try Effect.logWarning("agent activity publish retry budget exhausted", { threadId })
      return
    }
    const retry = {
      attempts: attempts + 1,
      timer: undefined as Fiber.Fiber<void> | undefined,
    }
    publishRetries.set(threadId, retry)
    const timer = try (Effect.sleep(delayMs)
      |> Effect.andThen(
        %,
        Effect.suspend(() => {
          if (publishRetries.get(threadId) !== retry) return Effect.void
          retry.timer = undefined
          return worker.enqueue(threadId)
        }),
      )
      |> Effect.forkIn(%, scope))
    if (publishRetries.get(threadId) !== retry) {
      try Fiber.interrupt(timer)
    } else {
      retry.timer = timer
    }
  }

  const publishActiveThreadsUnsafe = effect {
    const relayUrl = readSecretString(RELAY_URL_SECRET) catch () => null
    if (!relayUrl) {
      try Effect.logDebug("agent activity snapshot skipped; relay link credentials unavailable")
      return "unlinked" as const
    }
    const publishAgentActivity = readPublishAgentActivityEnabled catch () => false
    if (!publishAgentActivity) {
      try Effect.logDebug("agent activity snapshot skipped; publication disabled")
      return "disabled" as const
    }
    const relayConfig = readRelayConfig catch () => null
    if (!relayConfig) {
      try Effect.logDebug("agent activity snapshot skipped; relay link credentials unavailable")
      return "unlinked" as const
    }
    const environmentId = try serverEnvironment.getEnvironmentId
    const [projectSnapshot, shellSnapshot] = try Effect.all([
      projects.snapshot,
      threads.getShellSnapshot(),
    ])
    const activeThreadIds = resolveAgentAwarenessRelayActiveThreadIds({
      environmentId,
      startedAt,
      projects: projectSnapshot.projects,
      threads: shellSnapshot.threads,
    })
    if (activeThreadIds.length === 0) {
      try Effect.logDebug("agent activity snapshot has no publishable threads")
      return "published" as const
    }
    try Effect.logInfo("publishing active agent activity snapshot", {
      count: activeThreadIds.length,
    })
    try Effect.forEach(activeThreadIds, enqueueThreadPublish, { discard: true })
    try worker.drain
    return "published" as const
  }

  // Many environments never link, so while unlinked the retry backs off from 5
  // s to 60 s. A linked environment keeps the 5 s retry, because `t3 connect
  // publish` can turn publishing on from another process. Keep this untraced:
  // an unlinked environment can retry for the lifetime of the process.
  const publishActiveThreadsOnceWhenConfigured = effect (
    logEnabledWhenReady: boolean,
  ) => {
    let unlinkedRetryDelayMs = 5_000
    while (!(try Ref.get(activeSnapshotPublishedRef))) {
      const result = publishActiveThreadsUnsafe catch () => "failed" as const
      if (result === "published") {
        try Ref.set(activeSnapshotPublishedRef, true)
        if (logEnabledWhenReady) {
          const relayConfig = readRelayConfig catch () => null
          try Effect.logInfo("agent activity publishing enabled after link reconciliation", {
            relayUrl: relayConfig?.url,
          })
        }
        return
      }
      const retryDelayMs = result === "unlinked" ? unlinkedRetryDelayMs : 5_000
      try Effect.race(Effect.sleep(retryDelayMs), Queue.take(catchUpRequests))
      if (result === "unlinked") {
        unlinkedRetryDelayMs = Math.min(unlinkedRetryDelayMs * 2, 60_000)
      }
    }
  }

  schedulePublishConfirm = (threadId) =>
    Effect.forkIn(
      Effect.sleep("5 seconds")
        |> Effect.andThen(%, worker.enqueue(threadId))
        |> Effect.catchCause(%, (cause) =>
          Effect.logWarning("deferred agent activity confirmation failed", {
            threadId,
            cause: Cause.pretty(cause),
          })),
      scope,
    ) |> Effect.asVoid(%)

  const start: AgentAwarenessRelay["Service"]["start"] = effect (): void!never!Scope.Scope =>
    try withSpan(
      (effect (): void!never!Scope.Scope => {
        const [relayConfig, publishEnabled] = try Effect.all([
          readRelayConfig |> Effect.orElseSucceed(%, () => null),
          readPublishAgentActivityEnabled |> Effect.orElseSucceed(%, () => false),
        ])
        const startupState = resolveAgentActivityPublishingStartupState({
          relayConfigured: relayConfig !== null,
          publishEnabled,
        })
        switch (startupState) {
          case "waiting-for-link":
            try Effect.logInfo(
              "agent activity publishing standby; waiting for T3 Connect link reconciliation",
            )
            break
          case "disabled":
            try Effect.logInfo("agent activity publishing disabled by T3 Connect configuration")
            break
          case "enabled":
            try Effect.logInfo("agent activity publishing enabled", {
              relayUrl: relayConfig?.url,
            })
            break
        }
        try forkParked(
          Effect.sleep("1 second")
            |> Effect.andThen(%, publishActiveThreadsOnceWhenConfigured(startupState !== "enabled")),
        )
        try forkParked(
          Stream.runForEach(threads.streamDomainEvents, (event) => {
            const threadId = eventThreadId(event)
            if (!shouldPublishAgentAwarenessEvent(event)) {
              return Effect.void
            }
            return Effect.logDebug("agent activity publishing queued thread publish", {
              eventType: event.type,
              threadId,
            }) |> Effect.andThen(%, enqueueThreadPublish(threadId))
          }),
        )
      })(),
      "AgentAwarenessRelay.start",
    )

  return AgentAwarenessRelay.of({
    publishThread,
    drain: worker.drain,
    requestCatchUp: Effect.fn("AgentAwarenessRelay.requestCatchUp")(function() {
      return Queue.offer(catchUpRequests, undefined) |> Effect.asVoid(%)
    }),
    start,
  })
}

export const layer = Layer.effect(AgentAwarenessRelay, make)
