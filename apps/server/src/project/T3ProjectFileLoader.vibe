import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Option from "effect/Option"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"

import { T3_PROJECT_FILE_NAME, type T3ProjectFile } from "@t3tools/contracts"
import { T3ProjectFileFromJson } from "@t3tools/shared/t3ProjectFile"

const decodeT3ProjectFileJson = Schema.decodeEffect(T3ProjectFileFromJson)

const T3ProjectFileLoadErrorCauseField: Schema.Defect = Schema.Defect()
export schema error T3ProjectFileLoadError {
  readonly operation: "read" | "decode"
  readonly workspaceRoot: string
  readonly filePath: string
  cause: T3ProjectFileLoadErrorCauseField
  override get message(): string {
    return `Failed to ${this.operation} ${T3_PROJECT_FILE_NAME} at ${this.filePath}.`
  }
}

export service T3ProjectFileLoader: {
  /** Never fails; missing/unreadable/invalid files return none, with warnings for invalid files. */
  readonly load: (workspaceRoot: string) => Effect.Effect<Option.Option<T3ProjectFile>>;
} {
  static readonly key = "t3/project/T3ProjectFileLoader"
}

const logT3ProjectFileLoadError = (error: T3ProjectFileLoadError) =>
  Effect.logWarning(error)
  |> Effect.annotateLogs({
    operation: error.operation,
    workspaceRoot: error.workspaceRoot,
    filePath: error.filePath,
    errorTag: error._tag,
  })(%)

/** @public */
export const make = effect {
  const fileSystem = try FileSystem.FileSystem
  const path = try Path.Path

  const load: T3ProjectFileLoader["Service"]["load"] = effect (
    workspaceRoot,
  ): Option.Option<{ readonly $schema?: string; readonly iconPath?: string; readonly defaultThreadEnvMode?: "local" | "worktree"; readonly worktreeSubmodules?: "none" | "recursive" | "top-level"; readonly scripts?: readonly { readonly name: string; readonly command: string; readonly icon?: "build" | "configure" | "debug" | "lint" | "play" | "test"; readonly runOnWorktreeCreate?: boolean; readonly runOnSettle?: boolean; readonly async?: boolean; readonly previewUrl?: string; readonly autoOpenPreview?: boolean; }[]; }>!never!never =>
    try withSpan(
      (effect (): Option.Option<{ readonly $schema?: string; readonly iconPath?: string; readonly defaultThreadEnvMode?: "local" | "worktree"; readonly worktreeSubmodules?: "none" | "recursive" | "top-level"; readonly scripts?: readonly { readonly name: string; readonly command: string; readonly icon?: "build" | "configure" | "debug" | "lint" | "play" | "test"; readonly runOnWorktreeCreate?: boolean; readonly runOnSettle?: boolean; readonly async?: boolean; readonly previewUrl?: string; readonly autoOpenPreview?: boolean; }[]; }>!never!never => {
        const filePath = path.join(workspaceRoot, T3_PROJECT_FILE_NAME)
        const raw = (fileSystem.readFileString(filePath)
          |> Effect.asSome(%)) catch effect (error) => match (error) {
            when { _tag: "PlatformError" }: try (error.reason._tag === "NotFound"
              ? Effect.succeed(Option.none<string>())
              : (logT3ProjectFileLoadError(
                new T3ProjectFileLoadError({
                  operation: "read",
                  workspaceRoot,
                  filePath,
                  cause: error,
                }),
              ) |> Effect.as(%, Option.none<string>())));
          }
        if (Option.isNone(raw)) {
          return Option.none<T3ProjectFile>()
        }
        return (decodeT3ProjectFileJson(raw.value)
          |> Effect.asSome(%)) catch effect (error) => match (error) {
            when { _tag: "SchemaError" }: try (logT3ProjectFileLoadError(
              new T3ProjectFileLoadError({
                operation: "decode",
                workspaceRoot,
                filePath,
                cause: error,
              }),
            ) |> Effect.as(%, Option.none<T3ProjectFile>()));
          }
      })(),
      "T3ProjectFileLoader.load",
    )

  return T3ProjectFileLoader.of({ load })
}

export const layer = Layer.effect(T3ProjectFileLoader, make)
