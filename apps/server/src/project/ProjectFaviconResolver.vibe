import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Path from "effect/Path";
import * as Schema from "effect/Schema";

import * as WorkspacePaths from "../workspace/WorkspacePaths.vibe";
import * as T3ProjectFileLoader from "./T3ProjectFileLoader.vibe";

const FAVICON_CACHE_CAPACITY = 512;
const FAVICON_POSITIVE_CACHE_TTL = Duration.minutes(10);
const FAVICON_NEGATIVE_CACHE_TTL = Duration.minutes(1);

function faviconCacheKey(cwd: string, faviconPath?: string): string {
  return `${faviconPath ?? ""}\0${cwd}`;
}

function parseFaviconCacheKey(key: string): {
  readonly cwd: string;
  readonly faviconPath?: string;
} {
  const separatorIndex = key.indexOf("\0");
  if (separatorIndex === -1) {
    return { cwd: key };
  }
  const faviconPath = key.slice(0, separatorIndex);
  const cwd = key.slice(separatorIndex + 1);
  return faviconPath.length === 0 ? { cwd } : { cwd, faviconPath };
}

const FAVICON_CANDIDATES = [
  "favicon.svg",
  "favicon.ico",
  "favicon.png",
  "public/favicon.svg",
  "public/favicon.ico",
  "public/favicon.png",
  "app/favicon.ico",
  "app/favicon.png",
  "app/icon.svg",
  "app/icon.png",
  "app/icon.ico",
  "src/favicon.ico",
  "src/favicon.svg",
  "src/app/favicon.ico",
  "src/app/icon.svg",
  "src/app/icon.png",
  "assets/icon.svg",
  "assets/icon.png",
  "assets/logo.svg",
  "assets/logo.png",
  ".idea/icon.svg",
  "Resources/AppIcon.icns",
  "AppIcon.icns",
] as const;

const ICON_SOURCE_FILES = [
  "index.html",
  "public/index.html",
  "app/routes/__root.tsx",
  "src/routes/__root.tsx",
  "app/root.tsx",
  "src/root.tsx",
  "src/index.html",
] as const;

// Anchor HTML at <link and scan brace-free metadata runs to avoid quadratic regex rescans.
const LINK_ICON_HTML_RE =
  /<link\b(?=[^>]*\brel=["'](?:icon|shortcut icon)["'])(?=[^>]*\bhref=["']([^"'?]+))[^>]*>/i;
const ICON_REL_RE = /\brel\s*:\s*["'](?:icon|shortcut icon)["']/i;
const ICON_HREF_RE = /\bhref\s*:\s*["']([^"'?]+)/i;

export class ProjectFaviconResolutionError extends Schema.TaggedError<ProjectFaviconResolutionError>()(
  "ProjectFaviconResolutionError",
  {
    operation: Schema.Literals([
      "normalize-workspace",
      "resolve-path",
      "stat-candidate",
      "read-source",
    ]),
    workspaceRoot: Schema.String,
    relativePath: Schema.optional(Schema.String),
    absolutePath: Schema.optional(Schema.String),
    cause: Schema.Defect(),
  },
) {
  override get message(): string {
    return `Failed to resolve project favicon during ${this.operation} for workspace ${this.workspaceRoot}.`;
  }
}

const isWorkspaceRootNotExistsError = Schema.is(WorkspacePaths.WorkspaceRootNotExistsError);

export const isMissingWorkspaceRoot = (error: ProjectFaviconResolutionError): boolean =>
  error.operation === "normalize-workspace" && isWorkspaceRootNotExistsError(error.cause);

export service ProjectFaviconResolver: {
  readonly resolvePath: (
    cwd: string,
    faviconPath?: string,
  ) => (string | null)!ProjectFaviconResolutionError;
  /** Forgets cached lookups for a workspace whose files changed, such as a finished clone. */
  readonly invalidate: (cwd: string) => void!!;
} { static readonly key = "t3/project/ProjectFaviconResolver" }

function extractIconHref(source: string): string | null {
  const htmlMatch = source.match(LINK_ICON_HTML_RE);
  if (htmlMatch?.[1]) return htmlMatch[1];
  for (const run of source.split("}")) {
    if (!ICON_REL_RE.test(run)) continue;
    const hrefMatch = run.match(ICON_HREF_RE);
    if (hrefMatch?.[1]) return hrefMatch[1];
  }
  return null;
}

const optionOnNotFound = <A, R>(
  effect: A!PlatformError.PlatformError!R,
): Option.Option<A>!PlatformError.PlatformError!R =>
  do { const catchProgram = (effect
    |> Effect.asSome(%)); effect { return catchProgram catch effect (error) => match (error) {
    when { _tag: "PlatformError" }: try (error.reason._tag === "NotFound" ? Effect.succeed(Option.none<A>()) : Effect.fail(error));
  } } };

export const make = effect {
  const fileSystem = try FileSystem.FileSystem;
  const path = try Path.Path;
  const workspacePaths = try WorkspacePaths.WorkspacePaths;
  const projectFileLoader = try T3ProjectFileLoader.T3ProjectFileLoader;

  const resolveIconHref = (href: string): ReadonlyArray<string> => {
    const clean = href.replace(/^\//, "");
    return [path.join("public", clean), clean];
  };

  const findExistingFile = effect (
    projectCwd: string,
    relativeCandidates: readonly string[],
    candidateScope: "filesystem" | "workspace",
  ): (string | null)!ProjectFaviconResolutionError! => try withSpan((effect (): (string | null)!ProjectFaviconResolutionError! => {
    for (const relativePath of relativeCandidates) {
      const candidate = ((
        candidateScope === "filesystem" && path.isAbsolute(relativePath)
          ? Effect.succeed({ absolutePath: relativePath, relativePath })
          : workspacePaths.resolveRelativePathWithinRoot({
              workspaceRoot: projectCwd,
              relativePath,
            })
      )
        |> Effect.asSome(%)) catch (e) => match (e) {
        when { _tag: "WorkspacePathOutsideRootError" }: Option.none<{ readonly absolutePath: string; readonly relativePath: string }>();
      };
      if (Option.isNone(candidate)) {
        continue;
      }
      const stats = optionOnNotFound(fileSystem.stat(candidate.value.absolutePath)) catch effect (cause) => { throw new ProjectFaviconResolutionError({
              operation: "stat-candidate",
              workspaceRoot: projectCwd,
              relativePath,
              absolutePath: candidate.value.absolutePath,
              cause,
            }) };
      if (Option.isSome(stats) && stats.value.type === "File") {
        return candidate.value.absolutePath;
      }
    }
    return null;
  })(), "ProjectFaviconResolver.findExistingFile");

  const findIconFromSource = effect (
    projectCwd: string,
    sourceFile: string,
  ): (string | null)!ProjectFaviconResolutionError! => try withSpan((effect (): (string | null)!ProjectFaviconResolutionError! => {
    const sourcePath = workspacePaths
      .resolveRelativePathWithinRoot({
        workspaceRoot: projectCwd,
        relativePath: sourceFile,
      }) catch effect (cause) => { throw new ProjectFaviconResolutionError({
              operation: "resolve-path",
              workspaceRoot: projectCwd,
              relativePath: sourceFile,
              cause,
            }) };
    const source = optionOnNotFound(fileSystem.readFileString(sourcePath.absolutePath)) catch effect (cause) => { throw new ProjectFaviconResolutionError({
            operation: "read-source",
            workspaceRoot: projectCwd,
            relativePath: sourceFile,
            absolutePath: sourcePath.absolutePath,
            cause,
          }) };
    if (Option.isNone(source)) {
      return null;
    }
    const href = extractIconHref(source.value);
    if (!href) {
      return null;
    }
    return try findExistingFile(projectCwd, resolveIconHref(href), "workspace");
  })(), "ProjectFaviconResolver.findIconFromSource");

  // Probe concurrently but join in list order so lower-ranked probes cannot delay a hit.
  // A failure surfaces only if no earlier probe found a file; scope exit interrupts remaining probes.
  const firstInOrder = effect <A>(
    items: readonly A[],
    probe: (item: A) => Effect.Effect<(string | null), ProjectFaviconResolutionError>,
  ) => try withSpan(effect {
    const fibers = try Effect.forEach(items, (item) => Effect.forkScoped(probe(item)));
    for (const fiber of fibers) {
      const found = try Fiber.join(fiber);
      if (found) {
        return found;
      }
    }
    return null;
  } |> Effect.scoped(%), "ProjectFaviconResolver.firstInOrder");

  const resolvePathUncached = effect (
    cwd: string,
    faviconPath?: string | undefined,
  ): (string | null)!ProjectFaviconResolutionError! => try withSpan((effect (): (string | null)!ProjectFaviconResolutionError! => {
    const projectCwd = workspacePaths.normalizeWorkspaceRoot(cwd) catch effect (cause) => { throw new ProjectFaviconResolutionError({
            operation: "normalize-workspace",
            workspaceRoot: cwd,
            cause,
          }) };
    if (faviconPath !== undefined) {
      const existing = try findExistingFile(projectCwd, [faviconPath], "filesystem");
      if (existing) {
        return existing;
      }
    }

    const projectFile = try projectFileLoader.load(projectCwd);
    if (Option.isSome(projectFile) && projectFile.value.iconPath !== undefined) {
      const existing = try findExistingFile(
        projectCwd,
        [projectFile.value.iconPath],
        "workspace",
      );
      if (existing) {
        return existing;
      }
    }

    const wellKnown = try firstInOrder(FAVICON_CANDIDATES, (candidate) =>
      findExistingFile(projectCwd, [candidate], "workspace"),
    );
    if (wellKnown) {
      return wellKnown;
    }

    return try firstInOrder(ICON_SOURCE_FILES, (sourceFile) =>
      findIconFromSource(projectCwd, sourceFile),
    );
  })(), "ProjectFaviconResolver.resolvePathUncached");

  const faviconCache = try Cache.makeWith<string, string | null, ProjectFaviconResolutionError>(
    (key) => {
      const { cwd, faviconPath } = parseFaviconCacheKey(key);
      return resolvePathUncached(cwd, faviconPath);
    },
    {
      capacity: FAVICON_CACHE_CAPACITY,
      timeToLive: Exit.match({
        onSuccess: (value: string | null) =>
          value === null ? FAVICON_NEGATIVE_CACHE_TTL : FAVICON_POSITIVE_CACHE_TTL,
        onFailure: () => Duration.zero,
      }),
    },
  );

  const resolvePath: ProjectFaviconResolver["Service"]["resolvePath"] = effect (cwd, faviconPath): (string | null)!ProjectFaviconResolutionError!never => try withSpan((effect (): (string | null)!ProjectFaviconResolutionError!never => {
    const key = faviconCacheKey(cwd, faviconPath);
    const cached = try Cache.get(faviconCache, key);
    if (cached === null) {
      return null;
    }

    const stats = optionOnNotFound(fileSystem.stat(cached)) catch effect (cause) => { throw new ProjectFaviconResolutionError({
            operation: "stat-candidate",
            workspaceRoot: cwd,
            absolutePath: cached,
            cause,
          }) };
    if (Option.isSome(stats) && stats.value.type === "File") {
      return cached;
    }

    try Cache.invalidate(faviconCache, key);
    return try Cache.get(faviconCache, key);
  })(), "ProjectFaviconResolver.resolvePath");

  const invalidate: ProjectFaviconResolver["Service"]["invalidate"] = (cwd) =>
    Cache.keys(faviconCache)
      |> Effect.flatMap(%, (keys) =>
        Effect.forEach(
          Array.from(keys).filter((key) => parseFaviconCacheKey(key).cwd === cwd),
          (key) => Cache.invalidate(faviconCache, key),
          { discard: true },
        ),
      );

  return ProjectFaviconResolver.of({ resolvePath, invalidate });
};

export const layer = Layer.effect(ProjectFaviconResolver, make);
