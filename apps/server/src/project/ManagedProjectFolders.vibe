import {
  CommandId,
  type GitManagerServiceError,
  ProjectId,
  type ThreadId,
  VcsProcessSpawnError,
} from "@t3tools/contracts";
import { newProjectFolderName } from "@t3tools/shared/path";
import * as Cause from "effect/Cause";
import * as Context from "effect/Context";
import * as Crypto from "@t3tools/shared/Crypto";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Option from "effect/Option";
import * as Path from "effect/Path";
import * as Schema from "effect/Schema";

import * as ServerConfig from "../config.ts";
import * as GitWorkflow from "../git/GitWorkflowService.ts";
import * as GitVcsDriver from "../vcs/GitVcsDriver.ts";
import * as ProjectService from "./ProjectService.ts";

export schema error ScratchUnavailableError {
  override get message(): string {
    return "Threads without a project are not available on this environment.";
  }
}

const ScratchFolderErrorCauseField = Schema.Defect()
export schema error ScratchFolderError {
  readonly folder: string
  cause: ScratchFolderErrorCauseField
  override get message(): string {
    return "Failed to create the folder for threads without a project.";
  }
}

const ScratchProjectErrorCauseField = Schema.Defect()
export schema error ScratchProjectError {
  readonly workspaceRoot: string
  cause: ScratchProjectErrorCauseField
  override get message(): string {
    return "Failed to create the project for threads without a project.";
  }
}

export type ScratchError = ScratchUnavailableError | ScratchFolderError | ScratchProjectError;

const NamedProjectFolderErrorCauseField = Schema.Defect()
export schema error NamedProjectFolderError {
  readonly folder: string
  cause: NamedProjectFolderErrorCauseField
  override get message(): string {
    return "Failed to create the project folder.";
  }
}

const NamedProjectCreateErrorCauseField = Schema.Defect()
export schema error NamedProjectCreateError {
  readonly workspaceRoot: string
  cause: NamedProjectCreateErrorCauseField
  override get message(): string {
    return "Failed to create the project.";
  }
}

export type NamedProjectError = NamedProjectFolderError | NamedProjectCreateError;

export service ManagedProjectFolders: {
    readonly scratchRoot: Option.Option<string>!!;
    readonly ensureScratchProject: { readonly projectId: ProjectId }!ScratchError;
    readonly isScratchProject: (projectId: ProjectId) => boolean!!;
    readonly folderForThread: (input: {
      readonly projectId: ProjectId;
      readonly threadId: ThreadId;
      readonly text: string;
    }) => Option.Option<string>!ScratchFolderError;
    readonly namedProjectsRoot: string;
    /** Removes failed/cancelled creations' folders only while no project owns them. */
    readonly createNamedProject: (input: { readonly name: string }) => {
        readonly projectId: ProjectId;
        readonly workspaceRoot: string;
        readonly commitError?: string;
      }!NamedProjectError;
  } {
  static readonly key = "t3/project/ManagedProjectFolders"
}

const folderWords = (text: string) =>
  text
    .toLowerCase()
    .split(/[^a-z0-9]+/)
    .filter(Boolean)
    .slice(0, 5)
    .join("-")
    .slice(0, 48)
    .replace(/-+$/, "");

const ICON_BACKGROUNDS = [
  "#dc2626",
  "#ea580c",
  "#d97706",
  "#16a34a",
  "#059669",
  "#0d9488",
  "#0891b2",
  "#0284c7",
  "#2563eb",
  "#4f46e5",
  "#7c3aed",
  "#9333ea",
  "#c026d3",
  "#db2777",
  "#e11d48",
] as const;

const MAX_NAMED_FOLDER_ATTEMPTS = 100;

function escapeXml(value: string): string {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

// ProjectFaviconResolver finds assets/icon.svg on every clone.
function namedProjectIconSvg(name: string): string {
  const words = name.split(/[^\p{L}\p{N}]+/u).filter(Boolean);
  const initials =
    words
      .slice(0, 2)
      .map((word) => Array.from(word)[0] ?? "")
      .join("")
      .toUpperCase() ||
    Array.from(name.trim())[0] ||
    "?";
  let hash = 0;
  for (const char of name) hash = (hash * 31 + (char.codePointAt(0) ?? 0)) >>> 0;
  const background = ICON_BACKGROUNDS[hash % ICON_BACKGROUNDS.length];
  return [
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">`,
    `  <rect width="64" height="64" rx="14" fill="${background}"/>`,
    `  <text x="32" y="32" dy="0.35em" text-anchor="middle" font-family="ui-sans-serif, system-ui, -apple-system, sans-serif" font-size="${initials.length > 1 ? 26 : 32}" font-weight="600" fill="#ffffff">${escapeXml(initials)}</text>`,
    `</svg>`,
    "",
  ].join("\n");
}

function namedProjectReadme(name: string): string {
  return [
    `<img src="assets/icon.svg" width="64" height="64" alt="">`,
    "",
    `# ${name}`,
    "",
    "Created in [T3 Code](https://t3.codes).",
    "",
  ].join("\n");
}

function describeCommitFailure(stderr: string): string {
  if (/identity unknown|tell me who you are|no (name|email) was given/i.test(stderr)) {
    return "Git has no name or email on this machine. Set user.name and user.email, then commit.";
  }
  const lines = stderr
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);
  return lines.at(-1) ?? "Git could not make the first commit.";
}

const isVcsProcessSpawnError = Schema.is(VcsProcessSpawnError);

const isGitMissing = (error: GitManagerServiceError) =>
  error._tag === "GitManagerError" &&
  isVcsProcessSpawnError(error.cause) &&
  PlatformError.isPlatformError(error.cause.cause) &&
  error.cause.cause.reason._tag === "NotFound";

const make = effect {
  const config = try ServerConfig.ServerConfig;
  const fileSystem = try FileSystem.FileSystem;
  const path = try Path.Path;
  const gitWorkflow = try GitWorkflow.GitWorkflowService;
  const git = try GitVcsDriver.GitVcsDriver;
  const projects = try ProjectService.ProjectService;
  const crypto = try Crypto.Crypto;

  // Non-recursive mkdir atomically claims a name; racers move on after AlreadyExists.
  const claimFreeFolder = effect <E>(
    folderFor: (attempt: number) => Option.Option<string>!E,
    onError: (folder: string, cause: PlatformError) => E,
  ) => {
    for (let attempt = 1; ; attempt++) {
      const folder = try folderFor(attempt);
      if (Option.isNone(folder)) return folder;
      const claimed = (fileSystem.makeDirectory(folder.value)
        |> as(%, true)
        |> catchIf(
          %, (error) => error.reason._tag === "AlreadyExists",
          () => succeed(false),
        )) catch effect (cause) => { throw onError(folder.value, cause) };
      if (claimed) return folder;
    }
  };

  // Scratch inside a checkout would inherit its git status and checkpoints; require a data dir outside work trees.
  const [probe, invalidate] = try cachedInvalidateWithTTL(
    gitWorkflow.isRepository(config.baseDir)
      |> catchIf(%, isGitMissing, () => succeed(false))
      |> map(%, (isRepository) =>
        isRepository ? Option.none<string>() : Option.some(path.resolve(config.baseDir, "scratch")),
      )
      |> catchCause(%, (cause) =>
        Cause.hasInterrupts(cause) ? Effect.interrupt : succeed(Option.none<string>()),
      ),
    Duration.infinity,
  );
  const scratchRoot = effect { return try (probe |> onInterrupt(%, () => invalidate)) };

  const makeScratchFolder = (folder: string) =>
    fileSystem
      .makeDirectory(folder, { recursive: true })|> mapError(%, (cause) => new ScratchFolderError({ folder, cause }));

  const ensureScratchProject: ManagedProjectFolders["Service"]["ensureScratchProject"] = effect {
    const workspaceRoot = try (scratchRoot
      |> flatMap(
        %, Option.match({
          onNone: () => fail(new ScratchUnavailableError()),
          onSome: (value) => succeed(value),
        }),
      ));
    try makeScratchFolder(workspaceRoot);
    const id = crypto
      .randomUUIDv4() catch effect (cause) => { throw new ScratchProjectError({ workspaceRoot, cause }) };
    const bootstrapped = (projects
      .bootstrap({
        commandId: CommandId.make(`scratch-project:${id}`),
        projectId: ProjectId.make(id),
        title: "No project",
        workspaceRoot,
      })
        // bootstrap reads before locking; racing creates return the winner in a conflict.
        |> catchTags(%, {
          ProjectConflictError: (conflict) =>
            succeed({
              project: { id: conflict.conflictingProjectId },
              created: false,
            }),
        })) catch effect (cause) => { throw new ScratchProjectError({ workspaceRoot, cause }) };
    if (bootstrapped.created) {
      // Set once at create, so a user's own icon choice is never overwritten.
      projects
        .update({
          commandId: CommandId.make(`scratch-project-icon:${id}`),
          projectId: bootstrapped.project.id,
          projectIcon: { kind: "lucide", name: "message-square-dashed", color: "gray" },
        }) catch effect (cause) => { throw new ScratchProjectError({ workspaceRoot, cause }) };
    }
    return { projectId: bootstrapped.project.id };
  };

  const isScratchRoot = (projectId: ProjectId, root: string) =>
    projects.getById(projectId)
      |> map(
        %, Option.exists((project) => path.resolve(project.workspaceRoot) === path.resolve(root)),
      )
      |> orElseSucceed(%, () => false);

  const isScratchProject: ManagedProjectFolders["Service"]["isScratchProject"] = (projectId) =>
    scratchRoot
      |> flatMap(
        %, Option.match({
          onNone: () => succeed(false),
          onSome: (root) => isScratchRoot(projectId, root),
        }),
      );

  const folderForThread: ManagedProjectFolders["Service"]["folderForThread"] = effect (input) => try withSpan(effect {
    const root = try scratchRoot;
    if (Option.isNone(root)) return Option.none();
    if (!(try isScratchRoot(input.projectId, root.value))) return Option.none();
    const date = DateTime.formatIso(try DateTime.now).slice(0, 10);
    const words = folderWords(input.text);
    const id = input.threadId.toLowerCase().replace(/[^a-z0-9]/g, "");
    const folderFor = (idPart: string) =>
      path.join(root.value, [date, words, idPart].filter(Boolean).join("-"));
    try makeScratchFolder(root.value);
    const fullFolder = folderFor(id);
    return try claimFreeFolder(
      (attempt) =>
        attempt === 1
          ? succeedSome(folderFor(id.slice(-8)))
          : attempt === 2
            ? succeedSome(fullFolder)
            : (crypto.randomUUIDv4()
                |> map(%, (uuid) => Option.some(`${fullFolder}-${uuid.slice(0, 8)}`))
                |> mapError(%, (cause) => new ScratchFolderError({ folder: fullFolder, cause }))),
      (folder, cause) => new ScratchFolderError({ folder, cause }),
    );
  }, "ManagedProjectFolders.folderForThread");

  const namedProjectsRoot = path.resolve(config.baseDir, "projects");

  const claimNamedFolder = effect (
    name: string,
  ) => try withSpan(effect {
    fileSystem
      .makeDirectory(namedProjectsRoot, { recursive: true }) catch effect (cause) => { throw new NamedProjectFolderError({ folder: namedProjectsRoot, cause }) };
    const folderName = try orDie(Effect.try({ try: () => newProjectFolderName(name), catch: (error) => error }));
    const claimed = try claimFreeFolder(
      (attempt) =>
        succeed(
          attempt > MAX_NAMED_FOLDER_ATTEMPTS
            ? Option.none()
            : Option.some(
                path.join(
                  namedProjectsRoot,
                  attempt === 1 ? folderName : `${folderName}-${attempt}`,
                ),
              ),
        ),
      (folder, cause) => new NamedProjectFolderError({ folder, cause }),
    );
    if (Option.isSome(claimed)) return claimed.value;
    throw new NamedProjectFolderError({
      folder: path.join(namedProjectsRoot, folderName),
      cause: `Every folder name for "${folderName}" is taken.`,
    });
  }, "ManagedProjectFolders.claimNamedFolder");

  const scaffoldRepository = effect (
    cwd: string,
    name: string,
  ) => try withSpan(effect {
    const branch =
      (git
        .readConfigValue(cwd, "init.defaultBranch") catch () => null) ?? "main";
    try git.execute({
      operation: "ManagedProjectFolders.init",
      cwd,
      args: ["init", `--initial-branch=${branch}`],
      timeoutMs: 10_000,
    });
    try fileSystem.writeFileString(path.join(cwd, "README.md"), namedProjectReadme(name));
    try fileSystem.makeDirectory(path.join(cwd, "assets"));
    try fileSystem.writeFileString(
      path.join(cwd, "assets", "icon.svg"),
      namedProjectIconSvg(name),
    );
    // Force explicit filenames so global ignore rules cannot drop them.
    try git.execute({
      operation: "ManagedProjectFolders.add",
      cwd,
      args: ["add", "--force", "--", "README.md", "assets/icon.svg"],
      timeoutMs: 10_000,
    });
    return try (git
      .execute({
        operation: "ManagedProjectFolders.commit",
        cwd,
        args: ["commit", "--message", "Initial commit"],
        allowNonZeroExit: true,
        timeoutMs: 30_000,
      })
        |> map(%, (result) =>
          result.exitCode === 0 ? undefined : describeCommitFailure(result.stderr),
        )
        |> Effect.catch(%, (error) => succeed(error.message)));
  }, "ManagedProjectFolders.scaffoldRepository");

  const createNamedProject: ManagedProjectFolders["Service"]["createNamedProject"] = effect (input) => try withSpan(effect {
    const workspaceRoot = try claimNamedFolder(input.name);
    const removeFolder = effect { return try (fileSystem.remove(workspaceRoot, { recursive: true }) |> ignore(%)) };
    const prepared = try (all([
      scaffoldRepository(workspaceRoot, input.name)
        |> mapError(%, (cause) => new NamedProjectFolderError({ folder: workspaceRoot, cause })),
      crypto
        .randomUUIDv4()|> mapError(%, (cause) => new NamedProjectCreateError({ workspaceRoot, cause })),
    ]) |> onExit(%, (exit) => (Exit.isSuccess(exit) ? Effect.void : removeFolder)));
    const [commitError, id] = prepared;
    const project = (projects
      .create({
        commandId: CommandId.make(`named-project:${id}`),
        projectId: ProjectId.make(id),
        title: input.name,
        workspaceRoot,
      })
        // Re-check ownership before deleting rejected creations; interruption after commit or conflicts can leave an owner.
        |> tapError(%, (error) =>
          error._tag === "ProjectConflictError"
            ? Effect.void
            : (projects.getByWorkspaceRoot(workspaceRoot)
                |> flatMap(%, (owner) => (Option.isNone(owner) ? removeFolder : Effect.void))
                |> ignore(%)),
        )) catch effect (cause) => { throw new NamedProjectCreateError({ workspaceRoot, cause }) };
    return {
      projectId: project.id,
      workspaceRoot,
      ...(commitError === undefined ? {} : { commitError }),
    };
  }, "ManagedProjectFolders.createNamedProject");

  return ManagedProjectFolders.of({
    scratchRoot,
    ensureScratchProject,
    isScratchProject,
    folderForThread,
    namedProjectsRoot,
    createNamedProject,
  });
};

export const layer = Layer.effect(ManagedProjectFolders, make);
