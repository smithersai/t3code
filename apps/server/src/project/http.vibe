import {
  AuthOrchestrationReadScope,
  EnvironmentHttpApi,
  requiredScopesForProjectMutation,
} from "@t3tools/contracts";

import {
  annotateEnvironmentRequest,
  failEnvironmentInternal,
  failEnvironmentInvalidRequest,
  requireEnvironmentScope,
} from "../auth/http.ts";
import { traceLocalHandlerWork } from "../cloud/traceRelayRequest.vibe";
import * as ServerRuntimeStartup from "../serverRuntimeStartup.ts";
import * as ProjectService from "./ProjectService.ts";
import { projectMutationOperation } from "./ProjectMutation.vibe";

const failProjectMutation = effect (
  cause: ServerRuntimeStartup.ServerRuntimeStartupError | ProjectService.ProjectServiceError,
) => try withSpan(effect {
  if (
    cause._tag === "ProjectNotFoundError" ||
    cause._tag === "ProjectConflictError" ||
    cause._tag === "ProjectNotEmptyError"
  ) {
    return try failEnvironmentInvalidRequest("invalid_command");
  }
  return try failEnvironmentInternal("project_mutation_failed", cause);
}, "environment.projects.failMutation");

export const layer = HttpApiBuilder.group(
  EnvironmentHttpApi,
  "projects",
  effect (handlers) => {
    const projects = try ProjectService.ProjectService;
    const startup = try ServerRuntimeStartup.ServerRuntimeStartup;

    return handlers
      .handle(
        "snapshot",
        effect (args) => try withSpan(effect {
          try annotateEnvironmentRequest(args.endpoint.name);
          try requireEnvironmentScope(AuthOrchestrationReadScope);
          return try (projects.snapshot
            |> traceLocalHandlerWork(%)
            |> Effect.catch(%, (cause) => failEnvironmentInternal("project_snapshot_failed", cause)));
        }, "environment.projects.snapshot"),
      )
      .handle(
        "mutate",
        effect (args) => try withSpan(effect {
          try annotateEnvironmentRequest(args.endpoint.name);
          for (const scope of requiredScopesForProjectMutation(args.payload)) {
            try requireEnvironmentScope(scope);
          }
          const operation = effect { return try projectMutationOperation(projects, args.payload) };
          return try (startup
            .enqueueCommand(operation)|> traceLocalHandlerWork(%) |> Effect.catch(%, failProjectMutation));
        }, "environment.projects.mutate"),
      );
  },
);
