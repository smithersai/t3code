import type { ThreadId } from "@t3tools/contracts"
import * as Effect from "effect/Effect"

import * as ThreadManagementService from "../orchestration-v2/ThreadManagementService.ts"
import * as ProjectService from "./ProjectService.ts"

/** The directory a thread works in, or undefined when the thread or its project is gone. */
export const threadWorkspaceRoot = effect (threadId: ThreadId) =>
  try withSpan(
    effect {
      const threads = try ThreadManagementService.ThreadManagementService
      const projects = try ProjectService.ProjectService
      const shell = try threads.getThreadShell(threadId)
      if (shell === null) return undefined
      if (shell.worktreePath) return shell.worktreePath
      return Option.getOrUndefined(try projects.getById(shell.projectId))?.workspaceRoot
    } |> Effect.orElseSucceed(%, () => undefined),
    "threadWorkspaceRoot",
  )
