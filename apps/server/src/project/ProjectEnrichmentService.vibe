import type { RepositoryIdentity } from "@t3tools/contracts";
import * as Context from "effect/Context";
import * as Duration from "effect/Duration";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import * as PubSub from "effect/PubSub";
import type * as Scope from "effect/Scope";

import * as ProjectFaviconResolver from "./ProjectFaviconResolver.vibe";
import * as RepositoryIdentityResolver from "./RepositoryIdentityResolver.vibe";

const DEFAULT_CACHE_CAPACITY = 512;
const DEFAULT_MAX_PENDING = 512;
const DEFAULT_CONCURRENCY = 4;
const DEFAULT_SUCCESS_TTL = Duration.minutes(1);
// Frequent shell reads scan ~20 files per project; icons change rarely, so cache longer than identities.
const DEFAULT_FAVICON_TTL = Duration.minutes(15);
const DEFAULT_FAILURE_TTL = Duration.seconds(5);

export interface ProjectEnrichment {
  readonly repositoryIdentity: RepositoryIdentity | null;
  readonly faviconPath: string | null;
  readonly repositoryIdentityResolved: boolean;
}

export interface ProjectEnrichmentChange {
  readonly workspaceRoot: string;
  readonly enrichment: ProjectEnrichment;
  readonly repositoryIdentityResolved: boolean;
}

export interface ProjectEnrichmentServiceOptions {
  readonly cacheCapacity?: number;
  readonly maxPending?: number;
  readonly concurrency?: number;
  readonly successTtl?: Duration.Input;
  readonly faviconTtl?: Duration.Input;
  readonly failureTtl?: Duration.Input;
}

export service ProjectEnrichmentService: {
    readonly peek: (workspaceRoot: string) => ProjectEnrichment!!;
    readonly request: (workspaceRoot: string) => void!!;
    readonly getAvailable: (workspaceRoot: string) => ProjectEnrichment!!;
    readonly readRepositoryIdentity: (
      workspaceRoot: string,
    ) => (RepositoryIdentity | null)!!;
    readonly invalidate: (workspaceRoots: Iterable<string>) => void!!;
    readonly subscribeChanges: PubSub.Subscription<ProjectEnrichmentChange>!never!Scope.Scope;
  } {
  static readonly key = "t3/project/ProjectEnrichmentService"
}

function availableValue<A, E>(cached: Option<Exit<A, E>>): A | null {
  return do { const $optionSubject = cached; const $optionHandlers: { onNone: () => null; onSome: (exit: Exit<A, E>) => A | null; } = {
    onNone: () => null,
    onSome: (exit) =>
      Exit.match(exit, {
        onFailure: () => null,
        onSuccess: (value) => value,
      }),
  }; const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers; match ($optionSubject) { when Option.Some(let $optionValue): $optionSome($optionValue); default: $optionNone(); }; };
}

function isSuccessfullyResolved<A, E>(cached: Option<Exit<A, E>>): boolean {
  return do { const $optionSubject = cached; const $optionHandlers: { onNone: () => boolean; onSome: (exit: Exit<A, E>) => exit is Exit.Success<A, E>; } = {
    onNone: () => false,
    onSome: (exit) => Exit.isSuccess(exit),
  }; const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers; match ($optionSubject) { when Option.Some(let $optionValue): $optionSome($optionValue); default: $optionNone(); }; };
}

interface EnrichmentWorkLane {
  readonly pendingRoots: Ref<ReadonlySet<string>>;
  readonly queue: Queue<string>;
}

export const make = effect (
  options: ProjectEnrichmentServiceOptions = {},
) => try withSpan(effect {
  const repositoryIdentityResolver = try RepositoryIdentityResolver.RepositoryIdentityResolver;
  const faviconResolver = try ProjectFaviconResolver.ProjectFaviconResolver;
  const cacheCapacity = Math.max(1, options.cacheCapacity ?? DEFAULT_CACHE_CAPACITY);
  const maxPending = Math.max(1, options.maxPending ?? DEFAULT_MAX_PENDING);
  const concurrency = Math.max(1, options.concurrency ?? DEFAULT_CONCURRENCY);
  const successTtl = options.successTtl ?? DEFAULT_SUCCESS_TTL;
  const failureTtl = options.failureTtl ?? DEFAULT_FAILURE_TTL;
  const faviconTtl = options.faviconTtl ?? DEFAULT_FAVICON_TTL;

  const repositoryIdentityCache = try Cache.makeWith(
    (workspaceRoot: string) => exit(repositoryIdentityResolver.resolve(workspaceRoot)),
    {
      capacity: cacheCapacity,
      timeToLive: Exit.match({
        onFailure: () => failureTtl,
        onSuccess: (result) => (Exit.isSuccess(result) ? successTtl : failureTtl),
      }),
    },
  );
  const faviconCache = try Cache.makeWith(
    (workspaceRoot: string) => exit(faviconResolver.resolvePath(workspaceRoot)),
    {
      capacity: cacheCapacity,
      timeToLive: Exit.match({
        onFailure: () => failureTtl,
        onSuccess: (result) => (Exit.isSuccess(result) ? faviconTtl : failureTtl),
      }),
    },
  );
  const makeWorkLane = effect {
    const pendingRoots = try Ref.make<ReadonlySet<string>>(new Set());
    const queue = try acquireRelease(Queue.dropping<string>(maxPending), (queue) =>
      Queue.shutdown(queue),
    );
    return { pendingRoots, queue } satisfies EnrichmentWorkLane;
  };
  const repositoryIdentityLane = try makeWorkLane;
  const faviconLane = try makeWorkLane;
  const changes = try acquireRelease(
    PubSub.sliding<ProjectEnrichmentChange>(256),
    (pubsub) => PubSub.shutdown(pubsub),
  );

  const removePending = (lane: EnrichmentWorkLane, workspaceRoot: string) =>
    Ref.update(lane.pendingRoots, (current) => {
      if (!current.has(workspaceRoot)) return current;
      const next = new Set(current);
      next.delete(workspaceRoot);
      return next;
    });

  const reservePending = (lane: EnrichmentWorkLane, workspaceRoot: string) =>
    Ref.modify(lane.pendingRoots, (current) => {
      if (current.has(workspaceRoot) || current.size >= maxPending) {
        return [false, current] as const;
      }
      const next = new Set(current);
      next.add(workspaceRoot);
      return [true, next] as const;
    });

  const logFailure = <A, E>(
    workspaceRoot: string,
    field: "repositoryIdentity" | "faviconPath",
    result: Exit<A, E>,
  ) =>
    Exit.isFailure(result)
      ? logWarning("Failed to enrich optional project metadata", {
          workspaceRoot,
          field,
          cause: Cause.pretty(result.cause),
        })
      : Effect.void;

  const resolveRepositoryIdentity = effect (workspaceRoot: string) => try withSpan(effect {
    const repositoryIdentity = try Cache.get(repositoryIdentityCache, workspaceRoot);
    try logFailure(workspaceRoot, "repositoryIdentity", repositoryIdentity);
    const faviconPath = try Cache.getSuccess(faviconCache, workspaceRoot);
    const repositoryIdentityResolved = Exit.isSuccess(repositoryIdentity);
    try PubSub.publish(changes, {
      workspaceRoot,
      repositoryIdentityResolved,
      enrichment: {
        repositoryIdentity: availableValue(Option.some(repositoryIdentity)),
        faviconPath: availableValue(faviconPath),
        repositoryIdentityResolved,
      },
    });
  }, "ProjectEnrichmentService.resolveRepositoryIdentity");

  const resolveFavicon = effect (
    workspaceRoot: string,
  ) => try withSpan(effect {
    const faviconPath = try Cache.get(faviconCache, workspaceRoot);
    const isMissingWorkspaceRoot = Option.exists(
      Exit.findErrorOption(faviconPath),
      ProjectFaviconResolver.isMissingWorkspaceRoot,
    );
    if (isMissingWorkspaceRoot) {
      return;
    }
    try logFailure(workspaceRoot, "faviconPath", faviconPath);
  }, "ProjectEnrichmentService.resolveFavicon");

  const startWorkers = (
    lane: EnrichmentWorkLane,
    resolve: (workspaceRoot: string) => void!!,
  ) => {
    const worker = Queue.take(lane.queue)
      |> flatMap(%, (workspaceRoot) =>
        resolve(workspaceRoot) |> ensuring(%, removePending(lane, workspaceRoot)),
      )
      |> forever(%);
    return forEach(Array.from({ length: concurrency }), () => forkScoped(worker), {
      discard: true,
    });
  };
  try all(
    [
      startWorkers(repositoryIdentityLane, resolveRepositoryIdentity),
      startWorkers(faviconLane, resolveFavicon),
    ],
    { concurrency: "unbounded", discard: true },
  );

  const requestLane = effect (
    lane: EnrichmentWorkLane,
    workspaceRoot: string,
    field: "faviconPath" | "repositoryIdentity",
  ) => try withSpan(effect {
    if (!(try reservePending(lane, workspaceRoot))) return;
    if (!(try Queue.offer(lane.queue, workspaceRoot))) {
      try removePending(lane, workspaceRoot);
      try logWarning("Project metadata enrichment queue is full", {
        workspaceRoot,
        field,
      });
    }
  }, "ProjectEnrichmentService.requestLane");

  const peek: ProjectEnrichmentService["Service"]["peek"] = effect (workspaceRoot) => try withSpan(effect {
    const [repositoryIdentity, faviconPath] = try all(
      [
        Cache.getSuccess(repositoryIdentityCache, workspaceRoot),
        Cache.getSuccess(faviconCache, workspaceRoot),
      ] as const,
      { concurrency: "unbounded" },
    );
    return {
      repositoryIdentity: availableValue(repositoryIdentity),
      faviconPath: availableValue(faviconPath),
      repositoryIdentityResolved: isSuccessfullyResolved(repositoryIdentity),
    };
  }, "ProjectEnrichmentService.peek");

  const request: ProjectEnrichmentService["Service"]["request"] = effect (workspaceRoot) => try withSpan(effect {
    const [hasRepositoryIdentity, hasFaviconPath] = try all(
      [Cache.has(repositoryIdentityCache, workspaceRoot), Cache.has(faviconCache, workspaceRoot)],
      { concurrency: "unbounded" },
    );
    try all(
      [
        hasRepositoryIdentity
          ? Effect.void
          : requestLane(repositoryIdentityLane, workspaceRoot, "repositoryIdentity"),
        hasFaviconPath ? Effect.void : requestLane(faviconLane, workspaceRoot, "faviconPath"),
      ],
      { concurrency: "unbounded", discard: true },
    );
  }, "ProjectEnrichmentService.request");

  const getAvailable: ProjectEnrichmentService["Service"]["getAvailable"] = effect (workspaceRoot) => try withSpan(effect {
    const available = try peek(workspaceRoot);
    try request(workspaceRoot);
    return available;
  }, "ProjectEnrichmentService.getAvailable");

  const readRepositoryIdentity: ProjectEnrichmentService["Service"]["readRepositoryIdentity"] =
    effect (workspaceRoot) => try withSpan(effect {
      const resolved = try Cache.get(repositoryIdentityCache, workspaceRoot);
      return Exit.isSuccess(resolved) ? resolved.value : null;
    }, "ProjectEnrichmentService.readRepositoryIdentity");

  const invalidate: ProjectEnrichmentService["Service"]["invalidate"] = effect (workspaceRoots) => try withSpan(effect {
    try forEach(
      new Set(workspaceRoots),
      (workspaceRoot) =>
        all(
          [
            Cache.invalidate(repositoryIdentityCache, workspaceRoot),
            Cache.invalidate(faviconCache, workspaceRoot),
            // The resolver keeps its own misses, which would outlive a clone filling the folder.
            faviconResolver.invalidate(workspaceRoot),
          ],
          { concurrency: "unbounded", discard: true },
        ),
      { discard: true },
    );
  }, "ProjectEnrichmentService.invalidate");

  return ProjectEnrichmentService.of({
    peek,
    request,
    getAvailable,
    readRepositoryIdentity,
    invalidate,
    subscribeChanges: PubSub.subscribe(changes),
  });
}, "ProjectEnrichmentService.make");

export const layer = Layer.effect(ProjectEnrichmentService, make());
