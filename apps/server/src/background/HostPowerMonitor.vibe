import type { HostPowerSnapshot } from "@t3tools/contracts";
import * as Context from "effect/Context";
import * as DateTime from "effect/DateTime";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import * as Stream from "effect/Stream";

import * as DesktopTelemetryReceiver from "../resourceTelemetry/DesktopTelemetryReceiver.ts";

export service HostPowerMonitor: {
    readonly snapshot: HostPowerSnapshot!!;
    readonly report: (snapshot: HostPowerSnapshot) => void!!;
    readonly streamChanges: Stream.Stream<HostPowerSnapshot>;
  } {
  static readonly key = "t3/background/HostPowerMonitor"
}

const makeUnknownSnapshot = (
  source: HostPowerSnapshot["source"],
  updatedAt: HostPowerSnapshot["updatedAt"],
): HostPowerSnapshot => ({
  source,
  idle: "unknown",
  idleSeconds: null,
  locked: "unknown",
  suspended: false,
  onBattery: "unknown",
  lowPowerMode: "unknown",
  thermalState: "unknown",
  stale: true,
  updatedAt,
});

function samePowerState(left: HostPowerSnapshot, right: HostPowerSnapshot): boolean {
  return (
    left.source === right.source &&
    left.idle === right.idle &&
    left.locked === right.locked &&
    left.suspended === right.suspended &&
    left.onBattery === right.onBattery &&
    left.lowPowerMode === right.lowPowerMode &&
    left.thermalState === right.thermalState &&
    left.stale === right.stale
  );
}

export const make = effect (
  initialSnapshot?: { readonly source: "electron-main" | "node-linux" | "node-macos-native" | "node-macos-shell" | "node-windows" | "unknown"; readonly idle: "false" | "true" | "unknown"; readonly idleSeconds: number | null; readonly locked: "false" | "true" | "unknown"; readonly suspended: boolean; readonly onBattery: "false" | "true" | "unknown"; readonly lowPowerMode: "false" | "true" | "unknown"; readonly thermalState: "critical" | "fair" | "nominal" | "serious" | "unknown"; readonly stale: boolean; readonly updatedAt: DateTime.Utc; } | undefined,
) => try withSpan(effect {
  const initial = initialSnapshot ?? makeUnknownSnapshot("unknown", try DateTime.now);
  const latestRef = try Ref.make(initial);
  const changes = try PubSub.sliding<HostPowerSnapshot>(1);

  const report: HostPowerMonitor["Service"]["report"] = (snapshot) =>
    Ref.modify(latestRef, (current) => {
      if (DateTime.isLessThan(snapshot.updatedAt, current.updatedAt)) {
        return [Option.none<HostPowerSnapshot>(), current] as const;
      }
      return [
        samePowerState(current, snapshot) ? Option.none() : Option.some(snapshot),
        snapshot,
      ] as const;
    })
      |> flatMap(
        %, Option.match({
          onNone: () => Effect.void,
          onSome: (next) => PubSub.publish(changes, next),
        }),
      )
      |> asVoid(%);

  return HostPowerMonitor.of({
    snapshot: Ref.get(latestRef),
    report,
    streamChanges: Stream.fromPubSub(changes),
  });
}, "background.hostPower.make");

export const layer = Layer.effect(
  HostPowerMonitor,
  effect {
    const desktopTelemetry = try DesktopTelemetryReceiver.DesktopTelemetryReceiver;
    const desktopSubscription = try desktopTelemetry.subscribe;
    const initial = desktopSubscription.latest;
    const monitor = try Option.match(initial, {
      onNone: () => make(),
      onSome: (snapshot) => make(snapshot.power),
    });
    try (desktopSubscription.changes
      |> Stream.map(%, (snapshot) => snapshot.power)
      |> Stream.runForEach(%, monitor.report)
      |> forkScoped(%));
    return monitor;
  },
);
