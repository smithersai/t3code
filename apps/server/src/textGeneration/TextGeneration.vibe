import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import type { ProviderInstanceId } from "@t3tools/contracts"
import type { ProviderTextGeneration } from "@t3tools/provider-core/server/textGeneration"
import { TextGenerationError } from "@t3tools/contracts"

import * as ProviderInstanceRegistry from "../provider/ProviderInstanceRegistry.ts"
import type { ProviderInstance } from "@t3tools/provider-core/server/driver"
import * as SourceControlProviderRegistry from "../sourceControl/SourceControlProviderRegistry.vibe"
import * as ThreadTitleLinks from "./ThreadTitleLinks.vibe"

export type {
  BranchNameGenerationInput,
  BranchNameGenerationResult,
  CommitMessageGenerationInput,
  CommitMessageGenerationResult,
  PrContentGenerationInput,
  PrContentGenerationResult,
  ReviewGuideGenerationInput,
  ReviewGuideGenerationResult,
  ThreadTitleGenerationInput,
  ThreadTitleGenerationResult,
} from "@t3tools/provider-core/server/textGeneration"

export service TextGeneration: ProviderTextGeneration {
  static readonly key = "t3/textGeneration/TextGeneration"
}

type TextGenerationOp =
  | "generateCommitMessage"
  | "generatePrContent"
  | "generateBranchName"
  | "generateThreadTitle"
  | "generateReviewGuide"

const resolveInstance = (
  registry: ProviderInstanceRegistry.ProviderInstanceRegistry["Service"],
  operation: TextGenerationOp,
  instanceId: ProviderInstanceId,
): ProviderInstance["textGeneration"]!TextGenerationError =>
  registry.getInstance(instanceId)
  |> Effect.flatMap(%, (instance) =>
    instance
      ? Effect.succeed(instance.textGeneration)
      : Effect.fail(
        new TextGenerationError({
          operation,
          detail: `No provider instance registered for id '${instanceId}'.`,
        }),
      ))

/** @public */
export const make = effect {
  const registry = try ProviderInstanceRegistry.ProviderInstanceRegistry
  const sourceControl = try SourceControlProviderRegistry.SourceControlProviderRegistry
  return TextGeneration.of({
    generateCommitMessage: Effect.fn("TextGeneration.generateCommitMessage")(function(input) {
      return resolveInstance(
        registry,
        "generateCommitMessage",
        input.modelSelection.instanceId,
      ) |> Effect.flatMap(%, (textGeneration) => textGeneration.generateCommitMessage(input))
    }),
    generatePrContent: Effect.fn("TextGeneration.generatePrContent")(function(input) {
      return resolveInstance(registry, "generatePrContent", input.modelSelection.instanceId)
        |> Effect.flatMap(%, (textGeneration) => textGeneration.generatePrContent(input))
    }),
    generateBranchName: Effect.fn("TextGeneration.generateBranchName")(function(input) {
      return resolveInstance(registry, "generateBranchName", input.modelSelection.instanceId)
        |> Effect.flatMap(%, (textGeneration) => textGeneration.generateBranchName(input))
    }),
    generateReviewGuide: Effect.fn("TextGeneration.generateReviewGuide")(function(input) {
      return resolveInstance(registry, "generateReviewGuide", input.modelSelection.instanceId)
        |> Effect.flatMap(%, (textGeneration) => textGeneration.generateReviewGuide(input))
    }),
    generateThreadTitle: Effect.fn("TextGeneration.generateThreadTitle")(function(input) {
      return resolveInstance(registry, "generateThreadTitle", input.modelSelection.instanceId)
        |> Effect.flatMap(%, effect (textGeneration) => {
          const linkedContext = input.linkedContext
            ?? (try effect {
              provide SourceControlProviderRegistry.SourceControlProviderRegistry = sourceControl {
                return try ThreadTitleLinks.resolveThreadTitleLinks(input)
              }
            })
          return try textGeneration.generateThreadTitle({ ...input, linkedContext })
        })
    }),
  })
}

export const layer = Layer.effect(TextGeneration, make)
