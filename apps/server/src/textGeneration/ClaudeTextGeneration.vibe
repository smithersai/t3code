import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import { ChildProcessSpawner } from "effect/process";

import { type ClaudeSettings, TextGenerationError } from "@t3tools/contracts";
import { resolveSpawnCommand } from "@t3tools/shared/shell";

import * as TextGenerationOperations from "@t3tools/provider-core/server/textGenerationOperations";
import {
  normalizeCliError,
  toJsonSchemaObject,
} from "@t3tools/provider-core/server/textGenerationUtils";
import {
  getModelSelectionBooleanOptionValue,
  getModelSelectionStringOptionValue,
  getProviderOptionDescriptors,
} from "@t3tools/shared/model";
import {
  BUNDLED_CLAUDE_MODEL_CATALOG,
  type ClaudeModelCatalog,
  getClaudeCatalogModelCapabilities,
  isClaudeCatalogUltracodeEffort,
  normalizeClaudeCatalogEffort,
  resolveClaudeCatalogApiModelId,
  resolveClaudeCatalogEffort,
  resolveClaudeModelSlug,
  scopeClaudeModelCatalog,
} from "../provider/ClaudeModelCatalog.vibe";
import {
  hasClaudeManagedMcpConfig,
  makeClaudeEnvironment,
} from "../provider/Drivers/ClaudeHome.ts";

const CLAUDE_TIMEOUT_MS = 180_000;
/** `--tools` takes bare names; patterns go in the allow list. */
const CLAUDE_INVESTIGATION_TOOLS = "Read,Grep,Glob,Bash";
/** In dontAsk mode every call outside this list, Bash included, is refused. */
const CLAUDE_INVESTIGATION_ALLOWED = [
  "Read",
  "Grep",
  "Glob",
  "Bash(git diff:*)",
  "Bash(git log:*)",
  "Bash(git show:*)",
].join(",");
// Denies override allows; block git --output/-o because allowed trailing args can otherwise write anywhere.
const CLAUDE_INVESTIGATION_DENIED = ["Bash(git * --output*)", "Bash(git * -o *)"].join(",");

schema ClaudeOutputEnvelope {
  readonly structured_output: Schema.Unknown
}
const ClaudeOutputMessage = Schema.Struct({
  type: Schema.String,
  structured_output: Schema.optionalKey(Schema.Unknown),
});
const isClaudeOutputEnvelope = Schema.is(ClaudeOutputEnvelope);

const encodeJsonString = Schema.encodeEffect(Schema.fromJsonString(Schema.Unknown));
const decodeClaudeOutput = Schema.decodeEffect(
  Schema.fromJsonString(Schema.Union([ClaudeOutputEnvelope, Schema.Array(ClaudeOutputMessage)])),
);

schema ClaudeErrorResult { readonly is_error: true; readonly result: string }
const isClaudeErrorResult = Schema.is(ClaudeErrorResult);
const decodeJsonOption = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Unknown));

// Claude reports JSON errors on stdout; stderr may contain only wrapper notices.
function claudeErrorResult(stdout: string): string | undefined {
  const output = Option.getOrUndefined(decodeJsonOption(stdout));
  const messages: ReadonlyArray<unknown> = Array.isArray(output) ? output : [output];
  return messages
    .filter(isClaudeErrorResult)
    .map((message) => message.result.trim())
    .findLast((result) => result.length > 0);
}

export const makeClaudeTextGeneration = effect (
  claudeSettings: { readonly enabled: boolean; readonly binaryPath: string; readonly homePath: string; readonly customModels: readonly (string | { slug: string; name?: string | undefined; capabilities?: { optionDescriptors?: readonly ({ readonly id: string; readonly label: string; readonly description?: string | undefined; readonly type: "select"; readonly options: readonly { id: string; label: string; description?: string | undefined; isDefault?: boolean | undefined; }[]; readonly currentValue?: string | undefined; readonly promptInjectedValues?: readonly string[] | undefined; } | { readonly id: string; readonly label: string; readonly description?: string | undefined; readonly type: "boolean"; readonly currentValue?: boolean | undefined; })[] | undefined; } | undefined; })[]; readonly launchArgs: string; readonly autoCompactWindow: string; readonly idleCompaction: "beforeCacheExpires" | "default" | "off" | "onReturn"; },
  environment?: NodeJS.ProcessEnv | undefined,
  modelCatalog: ClaudeModelCatalog!never!never = succeed(BUNDLED_CLAUDE_MODEL_CATALOG),
) => try withSpan(effect {
  const commandSpawner = try ChildProcessSpawner.ChildProcessSpawner;
  const fileSystem = try FileSystem.FileSystem;
  const claudeEnvironment = try makeClaudeEnvironment(claudeSettings, environment);
  const scopedModelCatalog = effect { return try (modelCatalog
    |> map(%, (catalog) => scopeClaudeModelCatalog(catalog, claudeSettings.customModels))) };

  const readStreamAsString = <E>(
    operation: string,
    stream: Stream<Uint8Array, E>,
  ): string!TextGenerationError =>
    stream
      |> Stream.decodeText()(%)
      |> Stream.runFold(
        %, () => "",
        (acc, chunk) => acc + chunk,
      )
      |> mapError(%, (cause) =>
        normalizeCliError("claude", operation, cause, "Failed to collect process output"),
      );

  const encodeJsonForOperation = (
    operation: TextGenerationOperations.Operation,
    value: unknown,
    detail: string,
  ): string!TextGenerationError =>
    encodeJsonString(value)
      |> mapError(
        %, (cause) =>
          new TextGenerationError({
            operation,
            detail,
            cause,
          }),
      );

  const runClaudeJson = effect <S extends Schema.Top>({
    operation,
    cwd,
    prompt,
    outputSchema: outputSchemaJson,
    modelSelection,
    investigate,
  }: TextGenerationOperations.Request<S>): S["Type"]!TextGenerationError!S["DecodingServices"] => try withSpan(effect {
    const catalog = try scopedModelCatalog;
    const resolvedModelSelection = {
      ...modelSelection,
      model: resolveClaudeModelSlug(catalog, modelSelection.model),
    };
    const jsonSchemaStr = try encodeJsonForOperation(
      operation,
      toJsonSchemaObject(outputSchemaJson),
      "Failed to encode structured output schema.",
    );
    const caps = getClaudeCatalogModelCapabilities(catalog, resolvedModelSelection.model);
    const descriptors = getProviderOptionDescriptors({
      caps,
      selections: resolvedModelSelection.options,
    });
    const findDescriptor = (id: string) => descriptors.find((descriptor) => descriptor.id === id);
    const rawEffortSelection = getModelSelectionStringOptionValue(resolvedModelSelection, "effort");
    const resolvedEffort = resolveClaudeCatalogEffort(
      catalog,
      resolvedModelSelection.model,
      rawEffortSelection,
    );
    const cliEffort = normalizeClaudeCatalogEffort(
      catalog,
      resolvedEffort,
      resolvedModelSelection.model,
    );
    const ultracode = isClaudeCatalogUltracodeEffort(resolvedEffort);
    const thinkingDescriptor = findDescriptor("thinking");
    const fastModeDescriptor = findDescriptor("fastMode");
    // Only a chosen value; otherwise Claude Code's own default applies, as in chat turns.
    const thinking =
      thinkingDescriptor?.type === "boolean"
        ? getModelSelectionBooleanOptionValue(resolvedModelSelection, "thinking")
        : undefined;
    const fastMode =
      fastModeDescriptor?.type === "boolean" ? fastModeDescriptor.currentValue : undefined;
    const settings = {
      disableAllHooks: true,
      ...(typeof thinking === "boolean" ? { alwaysThinkingEnabled: thinking } : {}),
      ...(fastMode ? { fastMode: true } : {}),
      ...(ultracode ? { ultracode: true } : {}),
    };
    const settingsJson = try encodeJsonForOperation(
      operation,
      settings,
      "Failed to encode Claude CLI settings.",
    );

    const runClaudeCommand = effect () => try withSpan(effect {
      const workingDirectory =
        operation === "generateThreadTitle"
          ? (fileSystem
              .makeTempDirectoryScoped({ prefix: "t3code-claude-title-" }) catch effect (cause) => { throw normalizeCliError("claude", operation, cause, "Failed to create title directory") })
          : cwd;
      const managedMcpConfig = try hasClaudeManagedMcpConfig();
      const spawnCommand = try resolveSpawnCommand(
        claudeSettings.binaryPath || "claude",
        [
          "-p",
          "--output-format",
          "json",
          "--json-schema",
          jsonSchemaStr,
          "--model",
          resolveClaudeCatalogApiModelId(catalog, resolvedModelSelection),
          ...(cliEffort ? ["--effort", cliEffort] : []),
          "--settings",
          settingsJson,
          ...(investigate
            ? [
                "--tools",
                CLAUDE_INVESTIGATION_TOOLS,
                "--allowedTools",
                CLAUDE_INVESTIGATION_ALLOWED,
                "--disallowedTools",
                CLAUDE_INVESTIGATION_DENIED,
              ]
            : ["--tools", ""]),
          "--disable-slash-commands",
          // managed-mcp.json already isolates servers and makes Claude reject this flag.
          ...(managedMcpConfig ? [] : ["--strict-mcp-config"]),
          "--permission-mode",
          "dontAsk",
        ],
        { env: claudeEnvironment },
      );
      const command = ChildProcess.make(spawnCommand.command, spawnCommand.args, {
        env: claudeEnvironment,
        cwd: workingDirectory,
        shell: spawnCommand.shell,
        stdin: {
          stream: Stream.encodeText(Stream.make(prompt)),
        },
        forceKillAfter: "1 second",
      });

      const child = commandSpawner
        .spawn(command) catch effect (cause) => { throw normalizeCliError("claude", operation, cause, "Failed to spawn Claude CLI process") };

      const [stdout, stderr, exitCode] = try all(
        [
          readStreamAsString(operation, child.stdout),
          readStreamAsString(operation, child.stderr),
          child.exitCode
            |> mapError(%, (cause) =>
              normalizeCliError("claude", operation, cause, "Failed to read Claude CLI exit code"),
            ),
        ],
        { concurrency: "unbounded" },
      );

      if (exitCode !== 0) {
        const stderrDetail = stderr.trim();
        const stdoutDetail = stdout.trim();
        const detail =
          claudeErrorResult(stdoutDetail) ??
          (stderrDetail.length > 0 ? stderrDetail : stdoutDetail);
        throw new TextGenerationError({
          operation,
          detail:
            detail.length > 0
              ? `Claude CLI command failed: ${detail}`
              : `Claude CLI command failed with code ${exitCode}.`,
        });
      }

      return stdout;
    }, "runClaudeJson.runClaudeCommand");

    const rawStdout = try (runClaudeCommand()
      |> scoped(%)
      |> timeoutOption(%, investigate?.timeoutMs ?? CLAUDE_TIMEOUT_MS)
      |> flatMap(
        %, Option.match({
          onNone: () =>
            fail(
              new TextGenerationError({ operation, detail: "Claude CLI request timed out." }),
            ),
          onSome: (value) => succeed(value),
        }),
      ));

    const output = try (decodeClaudeOutput(rawStdout)
      |> catchTags(%, {
        SchemaError: (cause) =>
          fail(
            new TextGenerationError({
              operation,
              detail: "Claude CLI returned unexpected output format.",
              cause,
            }),
          ),
      }));
    const envelope = isClaudeOutputEnvelope(output)
      ? output
      : output.findLast((message) => message.type === "result");

    const decodeOutput = Schema.decodeEffect(outputSchemaJson);
    return try (decodeOutput(envelope?.structured_output)
      |> catchTags(%, {
        SchemaError: (cause) =>
          fail(
            new TextGenerationError({
              operation,
              detail: "Claude returned invalid structured output.",
              cause,
            }),
          ),
      }));
  }, "runClaudeJson");

  return try orDie(Effect.try({ try: () => TextGenerationOperations.fromRunner("ClaudeTextGeneration", runClaudeJson), catch: (error) => error }));
}, "makeClaudeTextGeneration");
