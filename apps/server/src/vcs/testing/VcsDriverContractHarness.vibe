import { assert, it, describe } from "@effect/vitest";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Path from "effect/Path";

import type { VcsDriverKind } from "@t3tools/contracts";
import * as VcsDriver from "../VcsDriver.ts";

function normalizePathForComparison(value: string): string {
  return value.replaceAll("\\", "/");
}

export interface VcsDriverFixture<R, E> {
  readonly createRepo: (cwd: string) => void!E!R;
  readonly writeFile: (
    cwd: string,
    relativePath: string,
    contents: string,
  ) => void!E!(R | FileSystem.FileSystem | Path.Path);
  readonly trackFile?: (cwd: string, relativePath: string) => void!E!R;
  readonly commit?: (cwd: string, message: string) => void!E!R;
  readonly ignorePath: (
    cwd: string,
    pattern: string,
  ) => void!E!(R | FileSystem.FileSystem | Path.Path);
}

export interface VcsDriverContractSuiteInput<R, E> {
  readonly name: string;
  readonly kind: VcsDriverKind;
  readonly layer: Layer.Layer<
    VcsDriver.VcsDriver | R | FileSystem.FileSystem | Path.Path,
    E,
    never
  >;
  readonly fixture: VcsDriverFixture<R, E>;
}

export function runVcsDriverContractSuite<R, E>(input: VcsDriverContractSuiteInput<R, E>) {
  const makeTmpDir = (
    prefix = `t3-${input.kind}-vcs-contract-`,
  ): string!PlatformError!(FileSystem.FileSystem | Scope) =>
    effect {
      const fileSystem = try FileSystem.FileSystem;
      return try fileSystem.makeTempDirectoryScoped({ prefix });
    };

  it.layer(input.layer)(`${input.name} VCS driver contract`, (it) => {
    describe("repository detection", () => {
      it.effect("returns null outside a repository", effect () => {
        const cwd = try makeTmpDir();
        const driver = try VcsDriver.VcsDriver;

        assert.equal(try driver.detectRepository(cwd), null);
        assert.equal(try driver.isInsideWorkTree(cwd), false);
      },
      );

      it.effect("detects repository identity inside a repository and nested directories", effect () => {
        const cwd = try makeTmpDir();
        const driver = try VcsDriver.VcsDriver;

        try input.fixture.createRepo(cwd);
        try input.fixture.writeFile(cwd, "src/index.ts", "export const value = 1;\n");
        const identity = try driver.detectRepository(cwd);
        assert.equal(identity?.kind, input.kind);
        assert.isTrue(
          normalizePathForComparison(identity?.rootPath ?? "").endsWith(
            normalizePathForComparison(cwd),
          ),
        );
        assert.equal(identity?.freshness.source, "live-local");
        assert.isTrue(DateTime.isDateTime(identity?.freshness.observedAt));
        assert.isTrue(Option.isNone(identity?.freshness.expiresAt ?? Option.none()));
        assert.equal(try driver.isInsideWorkTree(cwd), true);

        const path = try Path.Path;
        const nestedDir = path.join(cwd, "src");
        const nestedIdentity = try driver.detectRepository(nestedDir);
        assert.equal(nestedIdentity?.rootPath, identity?.rootPath);
        assert.equal(try driver.isInsideWorkTree(nestedDir), true);
      },
      );
    });

    describe("workspace files", () => {
      it.effect("lists tracked and untracked non-ignored files", effect () => {
        const cwd = try makeTmpDir();
        const driver = try VcsDriver.VcsDriver;

        try input.fixture.createRepo(cwd);
        try input.fixture.writeFile(cwd, "tracked.ts", "export const tracked = true;\n");
        if (input.fixture.trackFile && input.fixture.commit) {
          try input.fixture.trackFile(cwd, "tracked.ts");
          try input.fixture.commit(cwd, "Track file");
        }
        try input.fixture.writeFile(cwd, "untracked.ts", "export const untracked = true;\n");

        const result = try driver.listWorkspaceFiles(cwd);

        assert.include(result.paths, "tracked.ts");
        assert.include(result.paths, "untracked.ts");
        assert.equal(result.truncated, false);
        assert.equal(result.freshness.source, "live-local");
        assert.isTrue(DateTime.isDateTime(result.freshness.observedAt));
        assert.isTrue(Option.isNone(result.freshness.expiresAt));
      },
      );

      it.effect("excludes ignored files from workspace listing", effect () => {
        const cwd = try makeTmpDir();
        const driver = try VcsDriver.VcsDriver;

        try input.fixture.createRepo(cwd);
        try input.fixture.ignorePath(cwd, "*.log");
        try input.fixture.writeFile(cwd, "included.ts", "export const included = true;\n");
        try input.fixture.writeFile(cwd, "debug.log", "ignore me\n");
        try input.fixture.writeFile(cwd, "nested/error.log", "ignore me too\n");

        const result = try driver.listWorkspaceFiles(cwd);

        assert.include(result.paths, "included.ts");
        assert.notInclude(result.paths, "debug.log");
        assert.notInclude(result.paths, "nested/error.log");
      },
      );
    });

    describe("ignored path filtering", () => {
      it.effect("filters ignored paths", effect () => {
        const cwd = try makeTmpDir();
        const driver = try VcsDriver.VcsDriver;

        try input.fixture.createRepo(cwd);
        try input.fixture.ignorePath(cwd, "*.log");

        const result = try driver.filterIgnoredPaths(cwd, [
          "keep.ts",
          "debug.log",
          "nested/error.log",
        ]);

        assert.deepStrictEqual(result, ["keep.ts"]);
      },
      );

      it.effect("returns empty input unchanged", effect () => {
        const cwd = try makeTmpDir();
        const driver = try VcsDriver.VcsDriver;

        try input.fixture.createRepo(cwd);

        assert.deepStrictEqual(try driver.filterIgnoredPaths(cwd, []), []);
      },
      );
    });
  });
}
