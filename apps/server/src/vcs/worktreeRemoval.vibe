import { GitCommandError } from "@t3tools/contracts"
import * as HostProcess from "@t3tools/shared/HostProcess"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"

import type * as GitVcsDriver from "./GitVcsDriver.ts"

const INDEX_LIST_MAX_BYTES = 64 * 1024 * 1024

/**
 * Git for Windows before 2.54 follows NTFS junctions; newer Git leaves them behind.
 * On Windows, mirror Git's removal checks, then delete with Node's `rm`, which
 * unlinks junctions without following them. Git then removes the worktree metadata.
 */
export const removeLinkedWorktree = effect <
  A,
  E,
  R,
>(
  input: {
    readonly operation: string
    readonly cwd: string
    readonly worktreePath: string
    readonly force: boolean
    readonly execute: GitVcsDriver.GitVcsDriver["Service"]["execute"]
    readonly run: (args: ReadonlyArray<string>) => A!E!R
  },
): A!(E | GitCommandError)!(R | FileSystem.FileSystem | Path.Path) =>
  try withSpan(
    effect {
      const fileSystem = try FileSystem.FileSystem
      const path = try Path.Path
      const worktreePath = input.worktreePath
      const gitFile = path.join(worktreePath, ".git")
      // Git refuses to remove a worktree with untracked files unless forced, but
      // its check honors `status.showUntrackedFiles=no` and would delete them.
      const statusConfig = ["-c", "status.showUntrackedFiles=normal"]
      const linked = (try HostProcess.isWindows)
        && ((fileSystem.stat(gitFile)
          |> Effect.map(%, (info) => info.type === "File")) catch () => false)
      if (!linked) {
        return try input.run([
          ...statusConfig,
          "worktree",
          "remove",
          ...(input.force ? ["--force"] : []),
          "--",
          worktreePath,
        ])
      }

      // Git's own refusals, worded the way it prints them.
      const refuse = (message: string, cause?: unknown) =>
        new GitCommandError({
          operation: input.operation,
          command: "git worktree remove",
          cwd: input.cwd,
          detail: `fatal: ${message}`,
          ...(cause === undefined ? {} : { cause }),
        })
      const gitOutput = (cwd: string, args: ReadonlyArray<string>, env?: NodeJS.ProcessEnv) =>
        input
          .execute({
            operation: input.operation,
            cwd,
            args,
            maxOutputBytes: INDEX_LIST_MAX_BYTES,
            ...(env === undefined ? {} : { env }),
          }) |> Effect.map(%, (result) => result.stdout)
      const samePath = (left: string, right: string) =>
        Effect.all([fileSystem.realPath(left), fileSystem.realPath(right)])
        |> Effect.map(%, ([a, b]) => a.toLowerCase() === b.toLowerCase())
        |> Effect.orElseSucceed(%, () => false)

      // A registered worktree of this repository: its `.git` file names an admin
      // directory under the common `worktrees/`, whose `gitdir` points back.
      const notAWorktree = refuse(`'${worktreePath}' is not a working tree`)
      const adminDir = path.resolve(
        worktreePath,
        (gitOutput(worktreePath, ["rev-parse", "--absolute-git-dir"]) catch effect () => {
          throw notAWorktree
        }).trim(),
      )
      const commonDir = path.resolve(
        input.cwd,
        (try gitOutput(input.cwd, ["rev-parse", "--git-common-dir"])).trim(),
      )
      const pointsBack = (fileSystem.readFileString(path.join(adminDir, "gitdir"))
        |> Effect.flatMap(%, (gitdir) => samePath(path.resolve(adminDir, gitdir.trim()), gitFile))) catch () => false
      if (!pointsBack || !(try samePath(path.dirname(adminDir), path.join(commonDir, "worktrees")))) {
        throw notAWorktree
      }
      // Git counts the file's existence as a lock. T3 passes at most one
      // `--force`, which never removes a locked worktree. Anything but a
      // confirmed absence refuses.
      const lockFile = path.join(adminDir, "locked")
      const locked = (fileSystem.stat(lockFile)
        |> Effect.as(%, true)) catch effect (error) =>
          try (error.reason._tag === "NotFound"
            ? Effect.succeed(false)
            : Effect.fail(refuse(`cannot inspect the lock of '${worktreePath}'`, error)))
      if (locked) {
        const reason = Option.getOrElse(
          Option.map(try (fileSystem.readFileString(lockFile) |> Effect.option(%)), (text) => text.trim()),
          () => "",
        )
        throw refuse(
          reason === ""
            ? "cannot remove a locked working tree;\nuse 'remove -f -f' to override or unlock first"
            : `cannot remove a locked working tree, lock reason: ${reason}\nuse 'remove -f -f' to override or unlock first`,
        )
      }
      if (!input.force) {
        // Bound like Git's own check, so `core.worktree` can't point it elsewhere.
        const boundEnv = { GIT_DIR: gitFile, GIT_WORK_TREE: worktreePath }
        const submodules = refuse("working trees containing submodules cannot be moved or removed")
        // An unreadable path counts as present, so a doubt refuses.
        const present = (target: string) => fileSystem.exists(target) |> Effect.orElseSucceed(%, () => true)
        if (try present(path.join(adminDir, "modules"))) throw submodules
        const index = try gitOutput(worktreePath, ["ls-files", "--stage", "-z"], boundEnv)
        for (const entry of index.split("\0")) {
          if (!entry.startsWith("160000 ")) continue
          const submodule = entry.slice(entry.indexOf("\t") + 1)
          if (try present(path.join(worktreePath, submodule, ".git"))) throw submodules
        }
        const status = try gitOutput(
          worktreePath,
          [...statusConfig, "status", "--porcelain", "--ignore-submodules=none"],
          boundEnv,
        )
        if (status !== "") {
          throw refuse(
            `'${worktreePath}' contains modified or untracked files, use --force to delete it`,
          )
        }
      }

      // A file held open can stop the delete partway. Putting `.git` back, when
      // that works, leaves a worktree that a retry can remove.
      const gitFileContents = fileSystem
        .readFileString(gitFile) catch effect () => {
          throw notAWorktree
        }
      ;(fileSystem.remove(worktreePath, { recursive: true })
        |> Effect.tapError(%, () => fileSystem.writeFileString(gitFile, gitFileContents) |> Effect.ignore(%)))
        catch effect (cause) => {
          throw refuse(`failed to delete '${worktreePath}'`, cause)
        }
      // The folder is gone, so Git only drops the worktree's metadata.
      return try input.run(["worktree", "remove", "--force", "--force", "--", worktreePath])
    },
    "WorktreeRemoval.removeLinkedWorktree",
  )
