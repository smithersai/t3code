import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";

import {
  type VcsDriverKind,
  type VcsError,
  type VcsInitInput,
  VcsUnsupportedOperationError,
} from "@t3tools/contracts";
import * as VcsDriverRegistry from "./VcsDriverRegistry.ts";

export service VcsProvisioningService: {
    readonly initRepository: (input: VcsInitInput) => void!VcsError;
  } {
  static readonly key = "t3/vcs/VcsProvisioningService"
}

function resolveRequestedKind(
  kind: VcsDriverKind | undefined,
): VcsDriverKind!VcsUnsupportedOperationError {
  if (kind === undefined) {
    return succeed("git");
  }
  if (kind === "unknown") {
    return fail(
      new VcsUnsupportedOperationError({
        operation: "VcsProvisioningService.resolveRequestedKind",
        kind,
        detail: "A concrete VCS driver kind is required for repository provisioning.",
      }),
    );
  }
  return succeed(kind);
}

/** @public */
export const make = effect {
  const registry = try VcsDriverRegistry.VcsDriverRegistry;

  const initRepository: VcsProvisioningService["Service"]["initRepository"] = effect (input) => try withSpan(effect {
    const kind = try resolveRequestedKind(input.kind);
    const driver = try registry.get(kind);
    return try driver.initRepository(input);
  }, "VcsProvisioningService.initRepository");

  return VcsProvisioningService.of({
    initRepository,
  });
};

export const layer = Layer.effect(VcsProvisioningService, make);
