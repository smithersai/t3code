import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Path from "effect/Path";
import * as Schema from "effect/Schema";

import { VcsDriverKind, type VcsDriverKind as VcsDriverKindType } from "@t3tools/contracts";
import { fromLenientJson } from "@t3tools/shared/schemaJson";

schema ProjectVcsConfig {
  readonly vcs?: {
    readonly kind?: VcsDriverKind
  }
  readonly vcsKind?: VcsDriverKind
}
const ProjectVcsConfigJson = fromLenientJson(ProjectVcsConfig);
const decodeProjectVcsConfigJson = Schema.decodeUnknownEffect(ProjectVcsConfigJson);

type ProjectVcsConfigFile = typeof ProjectVcsConfig.Type;

export interface VcsProjectConfigResolveInput {
  readonly cwd: string;
  readonly requestedKind?: VcsDriverKindType | "auto";
}

const VcsProjectConfigErrorCauseField = Schema.Defect()
export schema error VcsProjectConfigError {
  readonly operation: "inspect" | "read" | "decode"
  readonly cwd: string
  readonly configPath: string
  cause: VcsProjectConfigErrorCauseField
  override get message(): string {
    return `Failed to ${this.operation} VCS project config at ${this.configPath}.`;
  }
}

export service VcsProjectConfig: {
    readonly resolveKind: (
      input: VcsProjectConfigResolveInput,
    ) => (VcsDriverKindType | "auto")!!;
  } {
  static readonly key = "t3/vcs/VcsProjectConfig"
}

function configuredKind(config: ProjectVcsConfigFile): VcsDriverKindType | "auto" {
  return config.vcs?.kind ?? config.vcsKind ?? "auto";
}

const logVcsProjectConfigError = (error: VcsProjectConfigError) =>
  logWarning(error)
    |> annotateLogs({
      operation: error.operation,
      cwd: error.cwd,
      configPath: error.configPath,
      errorTag: error._tag,
    })(%);

/** @public */
export const make = effect {
  const fileSystem = try FileSystem.FileSystem;
  const path = try Path.Path;

  const findConfigPath = effect (cwd: string) => try withSpan(effect {
    let current = cwd;
    while (true) {
      const candidate = path.join(current, ".t3code", "vcs.json");
      const exists = try (fileSystem.exists(candidate)
        |> mapError(
          %, (cause) =>
            new VcsProjectConfigError({
              operation: "inspect",
              cwd,
              configPath: candidate,
              cause,
            }),
        )
        |> catchTags(%, {
          VcsProjectConfigError: (error) => logVcsProjectConfigError(error) |> as(%, false),
        }));
      if (exists) {
        return Option.some(candidate);
      }

      const parent = path.dirname(current);
      if (parent === current) {
        return Option.none();
      }
      current = parent;
    }
  }, "VcsProjectConfig.findConfigPath");

  const readConfiguredKind = effect (
    cwd: string,
    configPath: string,
  ) => try withSpan(effect {
    const raw = fileSystem.readFileString(configPath) catch effect (cause) => { throw new VcsProjectConfigError({
            operation: "read",
            cwd,
            configPath,
            cause,
          }) };
    const parsed = decodeProjectVcsConfigJson(raw) catch effect (cause) => { throw new VcsProjectConfigError({
            operation: "decode",
            cwd,
            configPath,
            cause,
          }) };
    return configuredKind(parsed);
  }, "VcsProjectConfig.readConfiguredKind");

  const resolveKind: VcsProjectConfig["Service"]["resolveKind"] = effect (input) => try withSpan(effect {
    if (input.requestedKind !== undefined && input.requestedKind !== "auto") {
      return input.requestedKind;
    }

    return try (findConfigPath(input.cwd).pipe(
      flatMap(
        Option.match({
          onNone: () => succeed("auto" as const),
          onSome: (configPath) => readConfiguredKind(input.cwd, configPath),
        }),
      ),
      catchTags({
        VcsProjectConfigError: (error) =>
          logVcsProjectConfigError(error) |> as(%, "auto" as const),
      }),
    ));
  }, "VcsProjectConfig.resolveKind");

  return VcsProjectConfig.of({
    resolveKind,
  });
};

export const layer = Layer.effect(VcsProjectConfig, make);
