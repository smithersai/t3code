import { type AntigravitySettings, UsageReadError } from "@t3tools/contracts";
import { expandHomePath } from "@t3tools/provider-core/server/pathExpansion";
import * as ProviderHost from "@t3tools/provider-core/server/ProviderHost";
import type {
  ProviderUsageInstance,
  ProviderUsageReader,
  ProviderUsageScan,
} from "@t3tools/provider-core/server/usage";
import * as HostProcess from "@t3tools/shared/HostProcess";
import * as Context from "effect/Context";
import * as Crypto from "@t3tools/shared/Crypto";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Path from "effect/Path";

import { resolveAntigravityInstanceDirectories } from "../antigravityAuthSupport.ts";
import { makeAntigravityUsageCache, readAntigravityUsage } from "./antigravityUsageReader.ts";

export service AntigravityUsage: {
    readonly scan: (input: {
      readonly instances: ReadonlyArray<ProviderUsageInstance<AntigravitySettings>>;
      readonly windowStartMs: number;
    }) => ReadonlyArray<ProviderUsageScan>!UsageReadError;
  } {
  static readonly key = "t3/provider/Drivers/AntigravityUsage"
}

const make = effect {
  const crypto = try Crypto.Crypto;
  const fileSystem = try FileSystem.FileSystem;
  const path = try Path.Path;
  const host = try ProviderHost.ProviderHost;
  const cache = try orDie(Effect.try({ try: () => makeAntigravityUsageCache(), catch: (error) => error }));

  const dataRoots = effect (
    environment: NodeJS.ProcessEnv,
  ) => try withSpan(effect {
    const home = try HostProcess.HomeDirectory;
    const configured = environment["ANTIGRAVITY_DATA_DIR"]
      ?.split(",")
      .map((value) => value.trim())
      .filter(Boolean);
    const defaults = [
      ...["antigravity", "antigravity-cli", "antigravity-ide", "antigravity-backup"].map((name) =>
        path.join(home, ".gemini", name),
      ),
      path.join(home, ".config", "antigravity"),
    ];
    const canonical = new Set<string>();
    for (const root of configured?.length ? configured : defaults) {
      const resolved = path.resolve(try orDie(Effect.try({ try: () => expandHomePath(root, home), catch: (error) => error })));
      canonical.add(
        fileSystem.realPath(resolved) catch () => resolved,
      );
    }
    return [...canonical];
  }, "AntigravityUsage.dataRoots");

  const scan: AntigravityUsage["Service"]["scan"] = effect ({
    instances,
    windowStartMs,
  }) => try withSpan(effect {
    const roots: Array<string> = [];
    for (const instance of instances) roots.push(...(try dataRoots(instance.environment)));
    for (const { instanceId } of instances.filter((instance) => instance.configured)) {
      const directories = (resolveAntigravityInstanceDirectories(
        host.paths.stateDir,
        instanceId,
      )
        |> provideService(%, Crypto.Crypto, crypto)
        |> provideService(%, Path.Path, path)) catch effect (cause) => { throw new UsageReadError({
              reason: "scanFailed",
              detail: "Antigravity profile directory could not be resolved.",
              cause,
            }) };
      roots.push(path.join(directories.profile, "antigravity-acp"));
    }
    const conversationDirs = new Set<string>();
    for (const root of roots) {
      const resolvedRoot = fileSystem.realPath(root) catch () => root;
      const nested = path.join(resolvedRoot, "conversations");
      const dir = (try (fileSystem
        .exists(nested)|> catchCause(%, () => succeed(false))))
        ? nested
        : resolvedRoot;
      conversationDirs.add(fileSystem.realPath(dir) catch () => dir);
    }
    const result = try effect { provide Path.Path = path { return try effect { provide FileSystem.FileSystem = fileSystem { return try readAntigravityUsage([...conversationDirs], windowStartMs, cache) } } } };
    const scanned: ProviderUsageScan[] = [];
    for (const dir of conversationDirs) {
      const exists = try (fileSystem
        .exists(dir)|> catchCause(%, () => succeed(false)));
      const failed = result.errors.some(
        (error) => error === dir || error.startsWith(`${dir}${path.sep}`),
      );
      scanned.push({
        dir,
        files: !exists && !failed ? null : result.files.filter((file) => file.root === dir),
        status: failed ? "partial" : "ok",
        ...(failed ? { message: "Some Antigravity history could not be read." } : {}),
      });
    }
    return scanned;
  }, "AntigravityUsage.scan");

  return AntigravityUsage.of({ scan });
};

export const layer = Layer.effect(AntigravityUsage, make);

export const antigravityUsageReader: ProviderUsageReader<AntigravitySettings, AntigravityUsage> = {
  kind: "scan",
  provider: "antigravity",
  scan: ({ instances, windowStartMs }) =>
    AntigravityUsage |> flatMap(%, (usage) => usage.scan({ instances, windowStartMs })),
};
