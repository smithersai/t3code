import { withAgentDeviceEnvironment } from "@t3tools/provider-core/server/mcpSession";
import * as McpProviderSessions from "@t3tools/provider-core/server/McpProviderSessions";
import { AntigravitySettings, ProviderDriverKind, ProviderSetupError } from "@t3tools/contracts";
import * as HostProcess from "@t3tools/shared/HostProcess";
import { resolveSelfInvocation } from "@t3tools/shared/nodeRuntime";
import {
  NodeRuntimeUnavailableError,
  nodeRuntimeUnavailableMessage,
} from "@t3tools/shared/nodeRuntime";
import * as Crypto from "@t3tools/shared/Crypto";
import * as FileSystem from "effect/FileSystem";
import * as Path from "effect/Path";
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner";
import { HttpClient } from "effect/http";
import type { AcpError } from "effect-acp/errors";

import * as ProviderHost from "@t3tools/provider-core/server/ProviderHost";
import {
  isAntigravityTextGenerationAvailable,
  makeAntigravityTextGeneration,
} from "../../textGeneration/AntigravityTextGeneration.ts";
import { makeAntigravityAuth, type AntigravityAuth } from "../AntigravityAuth.ts";
import * as AntigravityInstallation from "../AntigravityInstallation.ts";
import * as AntigravityUsage from "./AntigravityUsage.vibe";
import {
  antigravityAuthConfigIssue,
  antigravityAuthLabel,
  antigravityAuthUsesBrowser,
  buildAntigravityAcpSpawnInput,
  isAntigravitySignInRequiredError,
  prepareAntigravityProfile,
  resolveAntigravityInstanceDirectories,
  type AntigravityAuthConfig,
} from "../antigravityAuthSupport.ts";
import {
  makeAntigravityAcpRuntime,
  type AntigravityAcpRuntimeInput,
} from "../acp/AntigravityAcpSupport.ts";
import type * as AcpSessionRuntime from "@t3tools/provider-acp/server/AcpSessionRuntime";
import type { ServerProviderDraft } from "@t3tools/provider-core/server/snapshotProbe";
import {
  removeAntigravityRuntimeTempDirs,
  removeAntigravitySessionFiles,
} from "../acp/AntigravitySessionFiles.vibe";
import * as IdAllocator from "@t3tools/provider-core/server/IdAllocator";
import * as ProviderContinuationRequests from "@t3tools/provider-core/server/ProviderContinuationRequests";
import { makeAntigravityAdapterV2 } from "../../orchestration-v2/Adapters/AntigravityAdapterV2.ts";
import { makeAcpNativeLoggerFactory } from "@t3tools/provider-acp/server/nativeLogging";
import { ProviderDriverError } from "../Errors.vibe";
import { makeAntigravityProvider } from "../AntigravityProvider.ts";
import { makeAntigravityUsageProbe } from "../antigravityUsageLimits.ts";
import * as ProviderEventLoggers from "@t3tools/provider-core/server/ProviderEventLoggers";
import * as ModelCatalog from "@t3tools/provider-core/server/ModelCatalog";
import {
  defaultProviderContinuationIdentity,
  type ProviderDriver,
  type ProviderInstance,
} from "@t3tools/provider-core/server/driver";
import { mergeProviderInstanceEnvironment } from "@t3tools/provider-core/server/instanceEnvironment";
import { withInstanceIdentity } from "@t3tools/provider-core/server/instanceIdentity";
import { discoverAntigravitySkills, resolveAntigravityUserHome } from "./AntigravitySkills.ts";

const DRIVER = ProviderDriverKind.make("antigravity");
const decodeSettings = Schema.decodeSync(AntigravitySettings);
const isNodeRuntimeUnavailableError = Schema.is(NodeRuntimeUnavailableError);

export type AntigravityDriverEnv =
  | AntigravityInstallation.AntigravityInstallation
  | ProviderHost.ProviderHost
  | ChildProcessSpawner.ChildProcessSpawner
  | Crypto.Crypto
  | FileSystem.FileSystem
  | HttpClient.HttpClient
  | IdAllocator.IdAllocatorV2
  | McpProviderSessions.McpProviderSessions
  | ModelCatalog.ModelCatalog
  | Path.Path
  | ProviderEventLoggers.ProviderEventLoggers;

export const AntigravityDriver: ProviderDriver<
  AntigravitySettings,
  AntigravityDriverEnv,
  AntigravityUsage.AntigravityUsage
> = {
  driverKind: DRIVER,
  metadata: { displayName: "Antigravity", supportsMultipleInstances: true },
  configSchema: AntigravitySettings,
  defaultConfig: () => decodeSettings({}),
  usage: AntigravityUsage.antigravityUsageReader,
  create: effect ({
    instanceId,
    displayName,
    accentColor,
    environment,
    enabled,
    config,
  }) => try withSpan(effect {
    const crypto = try Crypto.Crypto;
    const fileSystem = try FileSystem.FileSystem;
    const httpClient = try HttpClient.HttpClient;
    const path = try Path.Path;
    const spawner = try ChildProcessSpawner.ChildProcessSpawner;
    const host = try ProviderHost.ProviderHost;
    const selfInvocation = try resolveSelfInvocation();
    const installation = try AntigravityInstallation.AntigravityInstallation;
    const loggers = try ProviderEventLoggers.ProviderEventLoggers;
    const modelCatalog = try ModelCatalog.ModelCatalog;
    const currentCatalog = effect { return try modelCatalog.current(DRIVER) };
    const continuationRequests = try ProviderContinuationRequests.ProviderContinuationRequests;
    const makeNativeLogger = try makeAcpNativeLoggerFactory();
    const settings = { ...config, enabled } satisfies AntigravitySettings;
    const auth: AntigravityAuthConfig = {
      authMethod: settings.authMethod,
      apiKey: settings.apiKey,
      gcpProject: settings.gcpProject,
      gcpLocation: settings.gcpLocation,
    };
    const authConfigIssue = try orDie(Effect.try({ try: () => antigravityAuthConfigIssue(auth), catch: (error) => error }));
    const processEnvironment = try mergeProviderInstanceEnvironment(environment);
    const platform = try HostProcess.Platform
    const home = try HostProcess.HomeDirectory
    const userHome = try orDie(Effect.try({ try: () => resolveAntigravityUserHome(
      platform,
      processEnvironment,
      home,
    ), catch: (error) => error }));
    const directories = (resolveAntigravityInstanceDirectories(
      host.paths.stateDir,
      instanceId,
    )
      |> provideService(%, Crypto.Crypto, crypto)
      |> provideService(%, Path.Path, path)) catch effect (cause) => { throw new ProviderDriverError({
            driver: DRIVER,
            instanceId,
            detail: "Could not resolve the Antigravity profile directory.",
            cause,
          }) };
    const profileDirectory = directories.profile;
    for (const directory of [
      directories.runtimeTemp,
      path.join(profileDirectory, "antigravity-acp", "tmp"),
    ]) {
      try effect { provide FileSystem.FileSystem = fileSystem { return try removeAntigravityRuntimeTempDirs(directory) } };
    }
    const continuationIdentity = defaultProviderContinuationIdentity({
      driverKind: DRIVER,
      instanceId,
    });
    const stampIdentity = try orDie(Effect.try({ try: () => withInstanceIdentity({
      instanceId,
      driverKind: DRIVER,
      displayName,
      accentColor,
      continuationGroupKey: continuationIdentity.continuationKey,
    }), catch: (error) => error }));
    const classifyModels = (draft: ServerProviderDraft) =>
      currentCatalog
        |> map(%, (catalog) => stampIdentity(ModelCatalog.applyModelCatalog(draft, catalog)));

    const makeRuntime = effect (
      input: Omit<AntigravityAcpRuntimeInput, "childProcessSpawner" | "spawn">,
    ): AcpSessionRuntime.AcpSessionRuntime["Service"]!(AcpError | ProviderSetupError)!Scope => try withSpan(effect {
      if (authConfigIssue !== null) {
        throw new ProviderSetupError({
          instanceId,
          operation: "configure",
          detail: authConfigIssue,
        });
      }
      const executable = installation.acquire(settings.binaryPath, processEnvironment) catch effect (cause) => { throw new ProviderSetupError({
              instanceId,
              operation: "resolve",
              detail: cause.detail,
              cause,
            }) };
      const profile = (prepareAntigravityProfile({
        profileDirectory,
        baseEnv: processEnvironment,
        auth,
        userHome,
        tempDirectory: directories.runtimeTemp,
      })
        |> provideService(%, FileSystem.FileSystem, fileSystem)
        |> provideService(%, Path.Path, path)
        |> provideService(%, ChildProcessSpawner.ChildProcessSpawner, spawner)) catch effect (cause) => { throw isNodeRuntimeUnavailableError(cause.cause)
            ? new ProviderSetupError({
                instanceId,
                operation: "start",
                detail: try orDie(Effect.try({ try: () => nodeRuntimeUnavailableMessage("Antigravity sign-in"), catch: (error) => error })),
                cause,
              })
            : cause };
      // Use one directory per process; shared cleanup could delete files another session still reads.
      // Remove after the child dies, best-effort on Windows where handles may outlive the kill;
      // the next driver start sweeps leftovers.
      const runtimeTempDirectory = try acquireRelease(
        fileSystem.makeTempDirectory({ directory: profile.tempDirectory, prefix: "run-" })
          |> mapError(
            %, (cause) =>
              new ProviderSetupError({
                instanceId,
                operation: "start",
                detail: "Could not create an Antigravity runtime temp directory.",
                cause,
              }),
          ),
        (directory) =>
          fileSystem
            .remove(directory, { recursive: true, force: true })
              |> Effect.catch(%, () =>
                logWarning("Could not remove an Antigravity runtime temp directory."),
              ),
      );
      const runtime = try effect { provide Crypto.Crypto = crypto { return try makeAntigravityAcpRuntime({
        ...input,
        authMethod: auth.authMethod,
        childProcessSpawner: spawner,
        spawn: try orDie(Effect.try({ try: () => buildAntigravityAcpSpawnInput({
          installation: executable,
          profile,
          cwd: input.cwd,
          baseEnv: withAgentDeviceEnvironment(processEnvironment, input),
          auth,
          runtimeTempDirectory,
        }), catch: (error) => error })),
      }) } };
      return {
        ...runtime,
        start: () =>
          runtime
            .start()
              |> tapError(%, (cause): void!! =>
                input.onAuthorizationUrl === undefined && isAntigravitySignInRequiredError(cause)
                  ? provider.onAuthRequired
                  : Effect.void,
              ),
      };
    }, "AntigravityDriver.makeRuntime");

    const makeDisposableRuntime = effect (
      input: Pick<AntigravityAcpRuntimeInput, "onAuthorizationUrl">,
    ) => try withSpan(effect {
      const cwd = fileSystem
        .makeTempDirectoryScoped({ prefix: "t3-antigravity-setup-" }) catch effect () => { throw new ProviderSetupError({
                instanceId,
                operation: "start",
                detail: "Could not create an Antigravity setup workspace.",
              }) };
      let sessionId: string | undefined;
      try addFinalizer(() =>
        removeAntigravitySessionFiles({
          profileDirectory,
          sessionId,
          cwd,
        })
          |> provideService(%, FileSystem.FileSystem, fileSystem)
          |> provideService(%, Path.Path, path),
      );
      const runtime = try makeRuntime({
        cwd,
        clientInfo: { name: "t3-code-provider-setup", version: "0.0.0" },
        mcpServers: [],
        ...(input.onAuthorizationUrl ? { onAuthorizationUrl: input.onAuthorizationUrl } : {}),
      });
      return {
        ...runtime,
        start: () =>
          runtime.start()
            |> tap(%, effect (started) =>
              {
                sessionId = started.sessionId;
              },
            ),
      };
    }, "AntigravityDriver.makeDisposableRuntime");

    const publishCatalog = effect (
      started: AcpSessionRuntime.AcpSessionRuntimeStartResult,
      runtime: Pick<{ readonly handleRequestPermission: import("effect-acp/client").AcpClient["Service"]["handleRequestPermission"]; readonly handleElicitation: import("effect-acp/client").AcpClient["Service"]["handleElicitation"]; readonly handleMcpConnect: import("effect-acp/client").AcpClient["Service"]["handleMcpConnect"]; readonly handleMcpMessage: import("effect-acp/client").AcpClient["Service"]["handleMcpMessage"]; readonly handleMcpDisconnect: import("effect-acp/client").AcpClient["Service"]["handleMcpDisconnect"]; readonly handleMcpNotification: import("effect-acp/client").AcpClient["Service"]["handleMcpNotification"]; readonly handleReadTextFile: import("effect-acp/client").AcpClient["Service"]["handleReadTextFile"]; readonly handleWriteTextFile: import("effect-acp/client").AcpClient["Service"]["handleWriteTextFile"]; readonly handleCreateTerminal: import("effect-acp/client").AcpClient["Service"]["handleCreateTerminal"]; readonly handleTerminalOutput: import("effect-acp/client").AcpClient["Service"]["handleTerminalOutput"]; readonly handleTerminalWaitForExit: import("effect-acp/client").AcpClient["Service"]["handleTerminalWaitForExit"]; readonly handleTerminalKill: import("effect-acp/client").AcpClient["Service"]["handleTerminalKill"]; readonly handleTerminalRelease: import("effect-acp/client").AcpClient["Service"]["handleTerminalRelease"]; readonly handleSessionUpdate: import("effect-acp/client").AcpClient["Service"]["handleSessionUpdate"]; readonly handleElicitationComplete: import("effect-acp/client").AcpClient["Service"]["handleElicitationComplete"]; readonly handleUnknownExtRequest: import("effect-acp/client").AcpClient["Service"]["handleUnknownExtRequest"]; readonly handleUnknownExtNotification: import("effect-acp/client").AcpClient["Service"]["handleUnknownExtNotification"]; readonly handleExtRequest: import("effect-acp/client").AcpClient["Service"]["handleExtRequest"]; readonly handleExtNotification: import("effect-acp/client").AcpClient["Service"]["handleExtNotification"]; readonly initialize: () => import("effect-acp/compat").InitializeResponse!AcpError; readonly authenticate?: (methodId: string) => void!AcpError; readonly start: () => AcpSessionRuntime.AcpSessionRuntimeStartResult!AcpError; readonly getEvents: () => Stream<AcpSessionRuntime.AcpSessionRuntimeEvent, never>; readonly drainEvents: void!!; readonly getModeState: (import("@t3tools/provider-acp/server/runtimeModel").AcpSessionModeState | undefined)!!; readonly getConfigOptions: ReadonlyArray<import("effect-acp/compat").SessionConfigOption>!!; readonly loadSession: (sessionId: string, options?: AcpSessionRuntime.AcpSessionActivationOptions) => AcpSessionRuntime.AcpSessionRuntimeStartResult!AcpError; readonly resumeSession: (sessionId: string, options?: AcpSessionRuntime.AcpSessionActivationOptions) => AcpSessionRuntime.AcpSessionRuntimeStartResult!AcpError; readonly forkSession: (sessionId: string, options?: AcpSessionRuntime.AcpSessionActivationOptions) => AcpSessionRuntime.AcpSessionRuntimeStartResult!AcpError; readonly listSessions: (cursor?: string) => import("effect-acp/compat").ListSessionsResponse!AcpError; readonly closeSession: (sessionId?: string) => import("effect-acp/compat").CloseSessionResponse!AcpError; readonly deleteSession: (sessionId: string) => import("effect-acp/compat").DeleteSessionResponse!AcpError; readonly listProviders: import("effect-acp/compat").ListProvidersResponse!AcpError; readonly setProvider: (provider: import("effect-acp/compat").SetProviderRequest) => import("effect-acp/compat").SetProviderResponse!AcpError; readonly disableProvider: (providerId: string) => import("effect-acp/compat").DisableProviderResponse!AcpError; readonly logout: import("effect-acp/compat").LogoutResponse!AcpError; readonly prompt: (payload: Omit<import("effect-acp/compat").PromptRequest, "sessionId">, options?: { readonly dispatched?: Deferred<void>; }) => import("effect-acp/compat").PromptResponse!AcpError; readonly cancel: void!AcpError; readonly processContainment: "cgroup-v2" | "process-ledger-reduced-guarantee" | "process-group" | "none"; readonly terminateProcessGroup?: void!AcpSessionRuntime.AcpProcessGroupTerminationError; readonly setMode: (modeId: string) => import("effect-acp/compat").SetSessionModeResponse!AcpError; readonly setSessionModel: (modelId: string, meta?: import("effect-acp/compat").SetSessionModelRequest["_meta"]) => import("effect-acp/compat").SetSessionModelResponse!AcpError; readonly setConfigOption: (configId: string, value: string | boolean, options?: { readonly allowUnlistedValue?: boolean; }) => import("effect-acp/compat").SetSessionConfigOptionResponse!AcpError; readonly setModel: (model: string) => void!AcpError; readonly request: (method: string, payload: unknown) => unknown!AcpError; readonly notify: (method: string, payload: unknown) => void!AcpError; }, "drainEvents" | "getEvents">,
    ) => try withSpan(effect {
      try provider.onSessionStarted(started);
      try (Stream.runForEach(runtime.getEvents(), (event) => {
        if (event._tag === "EventStreamBarrier") {
          return Deferred.succeed(event.acknowledge, undefined) |> asVoid(%);
        }
        if (event._tag === "ConfigOptionsUpdated") {
          return provider.onConfigOptionsUpdated(event.configOptions);
        }
        return event._tag === "AvailableCommandsUpdated"
          ? provider.onAvailableCommands(event.availableCommands)
          : Effect.void;
      }) |> forkScoped(%));
      try runtime.drainEvents;
    } |> scoped(%), "AntigravityDriver.publishCatalog");

    const authFlow: AntigravityAuth = try makeAntigravityAuth({
      instanceId,
      makeRuntime: makeDisposableRuntime,
      onAuthenticated: publishCatalog,
      onSignedOut: effect { return try provider.onSignedOut },
      usesBrowser: try orDie(Effect.try({ try: () => antigravityAuthUsesBrowser(auth.authMethod), catch: (error) => error })),
    });

    // The probe must not spawn. The agent is a PyInstaller one-file bundle
    // that unpacks about 1 GB per launch, and the health check runs every
    // minute.
    const probe = effect {
      try modelCatalog.refreshInBackground;
      if (authConfigIssue !== null) {
        throw new ProviderSetupError({
          instanceId,
          operation: "configure",
          detail: authConfigIssue,
        });
      }
      const executable = installation.resolve(settings.binaryPath, processEnvironment) catch effect (cause) => { throw new ProviderSetupError({
              instanceId,
              operation: "resolve",
              detail: cause.detail,
              cause,
            }) };
      return {
        protocolVersion: 1,
        agentCapabilities: {
          loadSession: true,
          promptCapabilities: { image: true, audio: true, embeddedContext: true },
          sessionCapabilities: { list: {}, resume: {} },
        },
        authMethods: [{ id: "oauth-personal", name: "Log in with Google" }],
        agentInfo: {
          name: "antigravity-acp",
          title: "Google Antigravity",
          version: executable.version ?? "unknown",
        },
      };
    };

    const usage = try effect { provide HttpClient.HttpClient = httpClient { return try effect { provide Crypto.Crypto = crypto { return try effect { provide Path.Path = path { return try effect { provide FileSystem.FileSystem = fileSystem { return try makeAntigravityUsageProbe({
      profileDirectory,
      authMethod: auth.authMethod,
    }) } } } } } } } };
    const provider = makeAntigravityProvider(settings, {
      stampIdentity: classifyModels,
      probe,
      probeUsage: usage.probe,
      clearUsage: usage.clear,
      auth: { type: auth.authMethod, label: try orDie(Effect.try({ try: () => antigravityAuthLabel(auth.authMethod), catch: (error) => error })) },
      supportsTextGeneration: isAntigravityTextGenerationAvailable(profileDirectory)
        |> provideService(%, FileSystem.FileSystem, fileSystem)
        |> provideService(%, Path.Path, path)
        |> orElseSucceed(%, () => false),
    }) catch effect (cause) => { throw new ProviderDriverError({
            driver: DRIVER,
            instanceId,
            detail: "Could not prepare the Antigravity provider status.",
            cause,
          }) };
    const defaultModel = effect { return try (currentCatalog |> map(%, (catalog) => catalog?.defaultChatModel)) };
    const orchestrationAdapter = try makeAntigravityAdapterV2({
      instanceId,
      selfInvocation,
      makeRuntime,
      withProcess: authFlow.withProcess,
      defaultModel,
      onSessionStarted: provider.onSessionStarted,
      onSessionEvent: (event) => {
        if (event._tag === "ConfigOptionsUpdated") {
          return provider.onConfigOptionsUpdated(event.configOptions);
        }
        return event._tag === "AvailableCommandsUpdated"
          ? provider.onAvailableCommands(event.availableCommands)
          : Effect.void;
      },
      continuationRequests,
      nativeLogging: (threadId) =>
        makeNativeLogger({
          nativeEventLogger: loggers.native,
          provider: DRIVER,
          threadId,
        }),
    });
    const textGeneration = try makeAntigravityTextGeneration({
      profileDirectory,
      defaultModel,
      withProcess: authFlow.withProcess,
      makeRuntime: (cwd) =>
        makeRuntime({
          cwd,
          clientInfo: { name: "t3-code-text", version: "0.0.0" },
          mcpServers: [],
        }),
    });

    const refreshModels = effect () => try withSpan(effect {
      const processScope = try Scope.make();
      try addFinalizer((exit) => Scope.close(processScope, exit));
      try effect { provide Scope.Scope = processScope { return try authFlow
        .withProcess(
          Scope.close(processScope, Exit.void),
          effect {
            const runtime = try makeDisposableRuntime({});
            const started = try runtime.start();
            try publishCatalog(started, runtime);
          },
        ) } };
    } |> scoped(%) |> timeoutOrElse(%, {
        duration: "90 seconds",
        orElse: () =>
          fail(
            new ProviderDriverError({
              driver: DRIVER,
              instanceId,
              detail: "Antigravity model refresh timed out. Try again or check Google sign-in.",
            }),
          ),
      }) |> tapError(%, (cause) =>
        isAntigravitySignInRequiredError(cause) ? provider.onAuthRequired : Effect.void) |> mapError(%, (cause) =>
        cause._tag === "ProviderDriverError"
          ? cause
          : new ProviderDriverError({
              driver: DRIVER,
              instanceId,
              detail: isAntigravitySignInRequiredError(cause)
                ? "Sign in to Antigravity in provider settings before refreshing models."
                : cause._tag === "ProviderSetupError" &&
                    (cause.operation === "configure" || cause.operation === "start")
                  ? cause.detail
                  : "Could not refresh Antigravity models. The previous model list is unchanged.",
              cause,
            })), "AntigravityDriver.refreshModels");

    return {
      instanceId,
      driverKind: DRIVER,
      continuationIdentity,
      displayName,
      accentColor,
      enabled,
      snapshot: provider.snapshot,
      snapshotForCwd: (cwd) =>
        !enabled
          ? provider.snapshot.getSnapshot
          : (discoverAntigravitySkills({ cwd, userHome })
              |> provideService(%, FileSystem.FileSystem, fileSystem)
              |> provideService(%, Path.Path, path)
              |> flatMap(%, (skills) => provider.snapshotForCwd(cwd, skills))
              |> mapError(
                %, (cause) =>
                  new ProviderDriverError({
                    driver: DRIVER,
                    instanceId,
                    detail: "Could not read Antigravity workspace skills.",
                    cause,
                  }),
              )),
      orchestrationAdapter,
      textGeneration,
      auth: authFlow.controller,
      refreshModels,
    } satisfies ProviderInstance;
  }, "AntigravityDriver.create"),
};
