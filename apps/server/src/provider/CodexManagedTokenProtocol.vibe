// @effect-diagnostics nodeBuiltinImport:off - Private local IPC framing, shared by server and lean CLI.
import type * as NodeNet from "node:net"
import { readFrame as readPlatformFrame, writeFrame as writePlatformFrame } from platform
import * as Schema from "effect/Schema"

module platform {
  import type * as NodeNet from "node:net"
  import * as Effect from "effect/Effect"

  export const readFrame = <E>(
    socket: NodeNet.Socket,
    maxBytes: number,
    timeoutMs: number,
    ErrorType: new() => E,
  ) =>
    Effect.callback<string, E>((resume) => {
      let bytes = Buffer.alloc(0)
      const fail = () => resume(Effect.fail(new ErrorType()))
      const onData = (chunk: Buffer) => {
        if (bytes.length + chunk.length > maxBytes) return fail()
        bytes = Buffer.concat([bytes, chunk])
        const end = bytes.indexOf(10)
        if (end < 0) return
        if (end !== bytes.length - 1) return fail()
        resume(Effect.succeed(bytes.subarray(0, end).toString("utf8")))
      }
      socket.on("data", onData)
      socket.once("error", fail)
      socket.once("close", fail)
      socket.once("end", fail)
      return Effect.sync(() => {
        socket.off("data", onData)
        socket.off("error", fail)
        socket.off("close", fail)
        socket.off("end", fail)
      })
    }).pipe(
      Effect.timeoutOrElse({ duration: timeoutMs, orElse: () => Effect.fail(new ErrorType()) }),
    )

  export const writeFrame = <E>(
    socket: NodeNet.Socket,
    frame: string,
    maxBytes: number,
    timeoutMs: number,
    ErrorType: new() => E,
  ) =>
    Effect.callback<void, E>((resume) => {
      if (socket.destroyed || Buffer.byteLength(frame) + 1 > maxBytes) {
        resume(Effect.fail(new ErrorType()))
        return
      }
      const fail = () => resume(Effect.fail(new ErrorType()))
      socket.once("error", fail)
      socket.once("close", fail)
      socket.end(`${frame}\n`, () => resume(Effect.void))
      return Effect.sync(() => {
        socket.off("error", fail)
        socket.off("close", fail)
      })
    }).pipe(
      Effect.timeoutOrElse({
        duration: timeoutMs,
        orElse: () => Effect.fail(new ErrorType()),
      }),
    )
}

export const Request = Schema.Struct({
  version: Schema.Literal(1),
  instanceId: Schema.NonEmptyString,
  environmentId: Schema.NonEmptyString,
  profileKey: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u)),
})
export const Response = Schema.Struct({ token: Schema.NonEmptyString })
// Selectors are small; tokens can be larger JWTs. Never truncate either frame
// into something that could be accepted.
export const REQUEST_BYTES = 1024
export const RESPONSE_BYTES = 64 * 1024
// Idle/incomplete peers and blocked response consumers must not retain sockets.
export const SOCKET_IDLE_MS = 5_000
// Existing lock retry (40s), OAuth (20s), plus startup/store headroom (20s).
export const COMMAND_TIMEOUT_MS = 80_000
class ProtocolError extends Schema.TaggedError<ProtocolError>()("ManagedTokenProtocolError", {}) {
  override get message(): string {
    return "The managed token frame was invalid or incomplete."
  }
}

export const readFrame = effect (socket: NodeNet.Socket, maxBytes: number, timeoutMs: number) =>
  try readPlatformFrame(socket, maxBytes, timeoutMs, ProtocolError)

export const writeFrame = effect (socket: NodeNet.Socket, frame: string, maxBytes: number) =>
  try writePlatformFrame(socket, frame, maxBytes, SOCKET_IDLE_MS, ProtocolError)
