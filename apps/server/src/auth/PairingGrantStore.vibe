import {
  AuthStandardClientScopes,
  type AuthEnvironmentScope,
  type AuthPairingLink,
  type ServerAuthBootstrapMethod,
} from "@t3tools/contracts"
import { DESKTOP_BOOTSTRAP_TOKEN_WINDOW_MS, isValidDesktopBootstrapToken } from "@t3tools/shared/desktopBootstrapToken"
import * as Context from "effect/Context"
import * as Crypto from "@t3tools/shared/Crypto"
import * as DateTime from "effect/DateTime"
import * as Duration from "effect/Duration"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Option from "effect/Option"
import * as PubSub from "effect/PubSub"
import * as Ref from "effect/Ref"
import * as Schema from "effect/Schema"
import * as Stream from "effect/Stream"

import * as ServerConfig from "../config.ts"
import * as AuthPairingLinks from "../persistence/AuthPairingLinks.ts"

export interface BootstrapGrant {
  readonly method: ServerAuthBootstrapMethod
  readonly scopes: ReadonlyArray<AuthEnvironmentScope>
  readonly subject: string
  readonly label?: string
  readonly proofKeyThumbprint?: string
  readonly expiresAt: DateTime.DateTime
}

export schema error UnknownBootstrapCredentialError {
  override get message(): string {
    return "Unknown bootstrap credential."
  }
}

export schema error ExpiredBootstrapCredentialError {
  override get message(): string {
    return "Bootstrap credential expired."
  }
}

export schema error BootstrapCredentialProofKeyMismatchError {
  override get message(): string {
    return "Bootstrap credential proof key mismatch."
  }
}

export schema error UnavailableBootstrapCredentialError {
  override get message(): string {
    return "Bootstrap credential is no longer available."
  }
}

export schema error BootstrapCredentialScopeNotGrantedError {
  override get message(): string {
    return "The requested authentication scope was not granted."
  }
}

export schema BootstrapCredentialInvalidError =
  | UnknownBootstrapCredentialError
  | ExpiredBootstrapCredentialError
  | BootstrapCredentialProofKeyMismatchError
  | UnavailableBootstrapCredentialError

const ActivePairingLinksLoadErrorCauseField: Schema.Defect = Schema.Defect()
export schema error ActivePairingLinksLoadError {
  cause: ActivePairingLinksLoadErrorCauseField
  override get message(): string {
    return "Failed to load active pairing links."
  }
}

const PairingLinkRevokeErrorCauseField: Schema.Defect = Schema.Defect()
export schema error PairingLinkRevokeError {
  readonly pairingLinkId: string
  cause: PairingLinkRevokeErrorCauseField
  override get message(): string {
    return `Failed to revoke pairing link '${this.pairingLinkId}'.`
  }
}

export class PairingCredentialIssueError extends Schema.TaggedError<PairingCredentialIssueError>()(
  "PairingCredentialIssueError",
  {
    pairingLinkId: Schema.String,
    subject: Schema.String,
    label: Schema.optional(Schema.String),
    cause: Schema.Defect(),
  },
) {
  override get message(): string {
    return `Failed to issue pairing credential '${this.pairingLinkId}' for '${this.subject}'.`
  }
}

const PairingCredentialRandomGenerationErrorCauseField: Schema.Defect = Schema.Defect()
export schema error PairingCredentialRandomGenerationError {
  readonly operation: "generate-id" | "generate-token"
  cause: PairingCredentialRandomGenerationErrorCauseField
  override get message(): string {
    return `Failed to generate pairing credential data during '${this.operation}'.`
  }
}

const BootstrapCredentialConsumeErrorCauseField: Schema.Defect = Schema.Defect()
export schema error BootstrapCredentialConsumeError {
  cause: BootstrapCredentialConsumeErrorCauseField
  override get message(): string {
    return "Failed to consume bootstrap credential."
  }
}

const BootstrapCredentialConsumeAvailableErrorCauseField: Schema.Defect = Schema.Defect()
export schema error BootstrapCredentialConsumeAvailableError {
  cause: BootstrapCredentialConsumeAvailableErrorCauseField
  override get message(): string {
    return "Failed to atomically consume an available bootstrap credential."
  }
}

const BootstrapCredentialLookupErrorCauseField: Schema.Defect = Schema.Defect()
export schema error BootstrapCredentialLookupError {
  cause: BootstrapCredentialLookupErrorCauseField
  override get message(): string {
    return "Failed to look up bootstrap credential state."
  }
}

export schema BootstrapCredentialInternalError =
  | ActivePairingLinksLoadError
  | PairingLinkRevokeError
  | PairingCredentialIssueError
  | PairingCredentialRandomGenerationError
  | BootstrapCredentialConsumeError
  | BootstrapCredentialConsumeAvailableError
  | BootstrapCredentialLookupError
export const isBootstrapCredentialInternalError = Schema.is(BootstrapCredentialInternalError)

export schema BootstrapCredentialError =
  | BootstrapCredentialInvalidError
  | BootstrapCredentialInternalError
  | BootstrapCredentialScopeNotGrantedError

export interface IssuedBootstrapCredential {
  readonly id: string
  readonly credential: string
  readonly label?: string
  readonly proofKeyThumbprint?: string
  readonly expiresAt: DateTime.Utc
}

export type BootstrapCredentialChange =
  | {
    readonly type: "pairingLinkUpserted"
    readonly pairingLink: AuthPairingLink
  }
  | {
    readonly type: "pairingLinkRemoved"
    readonly id: string
  }

export service PairingGrantStore: {
  readonly issueOneTimeToken: (input?: {
    readonly ttl?: Duration.Duration;
    readonly scopes?: ReadonlyArray<AuthEnvironmentScope>;
    readonly subject?: string;
    readonly label?: string;
    readonly proofKeyThumbprint?: string;
    readonly purpose?: "startup";
  }) => IssuedBootstrapCredential!BootstrapCredentialInternalError;
  readonly listActive: () => ReadonlyArray<AuthPairingLink>!BootstrapCredentialInternalError;
  readonly streamChanges: Stream.Stream<BootstrapCredentialChange>;
  readonly revoke: (id: string) => boolean!BootstrapCredentialInternalError;
  readonly consume: (
    credential: string,
    input?: {
      readonly proofKeyThumbprint?: string;
      readonly requestedScopes?: ReadonlyArray<AuthEnvironmentScope>;
    },
  ) => BootstrapGrant!BootstrapCredentialError;
} {
  static readonly key = "t3/auth/PairingGrantStore"
}

interface StoredBootstrapGrant extends BootstrapGrant {
  readonly remainingUses: number | "unbounded"
}

type ConsumeResult =
  | {
    readonly _tag: "error"
    readonly reason: "not-found" | "expired" | "scope-not-granted"
    readonly error: BootstrapCredentialError
  }
  | {
    readonly _tag: "success"
    readonly grant: BootstrapGrant
  }

const DEFAULT_ONE_TIME_TOKEN_TTL_MINUTES = Duration.minutes(5)
const DESKTOP_BOOTSTRAP_TTL_HOURS = Duration.hours(24)
const DEV_STARTUP_TTL_HOURS = Duration.hours(24)
const PAIRING_TOKEN_ALPHABET = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"
const PAIRING_TOKEN_LENGTH = 12
const PAIRING_TOKEN_REJECTION_LIMIT = Math.floor(256 / PAIRING_TOKEN_ALPHABET.length) * PAIRING_TOKEN_ALPHABET.length

const make = effect {
  const crypto = try Crypto.Crypto
  const config = try ServerConfig.ServerConfig
  const pairingLinks = try AuthPairingLinks.AuthPairingLinkRepository
  const seededGrantsRef = try Ref.make(new Map<string, StoredBootstrapGrant>())
  const changesPubSub = try PubSub.unbounded<BootstrapCredentialChange>()
  const generatePairingToken = effect {
    let credential = ""
    while (credential.length < PAIRING_TOKEN_LENGTH) {
      const bytes = crypto
        .randomBytes(PAIRING_TOKEN_LENGTH) catch effect (cause) => {
          throw new PairingCredentialRandomGenerationError({ operation: "generate-token", cause })
        }
      for (const byte of bytes) {
        if (byte >= PAIRING_TOKEN_REJECTION_LIMIT) {
          continue
        }
        credential += PAIRING_TOKEN_ALPHABET[byte % PAIRING_TOKEN_ALPHABET.length]!
        if (credential.length === PAIRING_TOKEN_LENGTH) {
          return credential
        }
      }
    }
    return credential
  }

  const seedGrant = (credential: string, grant: StoredBootstrapGrant) =>
    Ref.update(seededGrantsRef, (current) => {
      const next = new Map(current)
      next.set(credential, grant)
      return next
    })

  const emitUpsert = (pairingLink: AuthPairingLink) =>
    PubSub.publish(changesPubSub, {
      type: "pairingLinkUpserted",
      pairingLink,
    }) |> Effect.asVoid(%)

  const emitRemoved = (id: string) =>
    PubSub.publish(changesPubSub, {
      type: "pairingLinkRemoved",
      id,
    }) |> Effect.asVoid(%)

  // Accept tokens derived from the rotating desktop secret; older desktops send only a token.
  const desktopBootstrapSecret = config.desktopBootstrapSecret
  const consumeRotatingDesktopToken = (credential: string, nowMs: number) =>
    desktopBootstrapSecret !== undefined
    && isValidDesktopBootstrapToken(desktopBootstrapSecret, credential, nowMs)

  if (config.desktopBootstrapToken && desktopBootstrapSecret === undefined) {
    const now = try DateTime.now
    try seedGrant(config.desktopBootstrapToken, {
      method: "desktop-bootstrap",
      scopes: AuthStandardClientScopes,
      subject: "desktop-bootstrap",
      expiresAt: DateTime.add(now, {
        milliseconds: Duration.toMillis(DESKTOP_BOOTSTRAP_TTL_HOURS),
      }),
      // Reloads and expired bearer sessions must be able to re-exchange the desktop seed.
      remainingUses: "unbounded",
    })
  }

  const listActive: PairingGrantStore["Service"]["listActive"] = effect () =>
    try withSpan(
      effect {
        const now = try DateTime.now
        const rows = try pairingLinks.listActive({ now })

        return rows.map((row) =>
          row.label
            ? ({
              id: row.id,
              scopes: row.scopes,
              subject: row.subject,
              label: row.label,
              createdAt: row.createdAt,
              expiresAt: row.expiresAt,
            } satisfies AuthPairingLink)
            : ({
              id: row.id,
              scopes: row.scopes,
              subject: row.subject,
              createdAt: row.createdAt,
              expiresAt: row.expiresAt,
            } satisfies AuthPairingLink)
        )
      } |> Effect.mapError(%, (cause) => new ActivePairingLinksLoadError({ cause })),
      "PairingGrantStore.listActive",
    )

  const revoke: PairingGrantStore["Service"]["revoke"] = effect (
    id,
  ): boolean!(ActivePairingLinksLoadError | BootstrapCredentialConsumeAvailableError | BootstrapCredentialConsumeError | BootstrapCredentialLookupError | PairingCredentialIssueError | PairingCredentialRandomGenerationError | PairingLinkRevokeError)!never =>
    try withSpan(
      (effect (): boolean!(ActivePairingLinksLoadError | BootstrapCredentialConsumeAvailableError | BootstrapCredentialConsumeError | BootstrapCredentialLookupError | PairingCredentialIssueError | PairingCredentialRandomGenerationError | PairingLinkRevokeError)!never => {
        const revokedAt = try DateTime.now
        const revoked = pairingLinks
          .revoke({
            id,
            revokedAt,
          }) catch effect (cause) => {
            throw new PairingLinkRevokeError({ pairingLinkId: id, cause })
          }
        if (revoked) {
          try emitRemoved(id)
        }
        return revoked
      })(),
      "PairingGrantStore.revoke",
    )

  const issueOneTimeToken: PairingGrantStore["Service"]["issueOneTimeToken"] = effect (
    input,
  ): IssuedBootstrapCredential!(ActivePairingLinksLoadError | BootstrapCredentialConsumeAvailableError | BootstrapCredentialConsumeError | BootstrapCredentialLookupError | PairingCredentialIssueError | PairingCredentialRandomGenerationError | PairingLinkRevokeError)!never =>
    try withSpan(
      (effect (): IssuedBootstrapCredential!(ActivePairingLinksLoadError | BootstrapCredentialConsumeAvailableError | BootstrapCredentialConsumeError | BootstrapCredentialLookupError | PairingCredentialIssueError | PairingCredentialRandomGenerationError | PairingLinkRevokeError)!never => {
        const id = crypto
          .randomUUIDv4() catch effect (cause) => {
            throw new PairingCredentialRandomGenerationError({ operation: "generate-id", cause })
          }
        const credential = try generatePairingToken
        const isDevStartupToken = config.devUrl !== undefined && input?.purpose === "startup"
        const ttl = input?.ttl
          ?? (isDevStartupToken ? DEV_STARTUP_TTL_HOURS : DEFAULT_ONE_TIME_TOKEN_TTL_MINUTES)
        const now = try DateTime.now
        const expiresAt = DateTime.add(now, { milliseconds: Duration.toMillis(ttl) })
        const issued: IssuedBootstrapCredential = {
          id,
          credential,
          ...(input?.label ? { label: input.label } : {}),
          ...(input?.proofKeyThumbprint ? { proofKeyThumbprint: input.proofKeyThumbprint } : {}),
          expiresAt,
        }
        const subject = input?.subject ?? "one-time-token"
        pairingLinks
          .create({
            id,
            credential,
            method: "one-time-token",
            scopes: input?.scopes ?? AuthStandardClientScopes,
            subject,
            label: input?.label ?? null,
            proofKeyThumbprint: input?.proofKeyThumbprint ?? null,
            createdAt: now,
            expiresAt: expiresAt,
          }) catch effect (cause) => {
            throw new PairingCredentialIssueError({
              pairingLinkId: id,
              subject,
              ...(input?.label ? { label: input.label } : {}),
              cause,
            })
          }
        try emitUpsert({
          id,
          scopes: input?.scopes ?? AuthStandardClientScopes,
          subject: input?.subject ?? "one-time-token",
          ...(input?.label ? { label: input.label } : {}),
          createdAt: now,
          expiresAt,
        })
        return issued
      })(),
      "PairingGrantStore.issueOneTimeToken",
    )

  const consume: PairingGrantStore["Service"]["consume"] = effect (
    credential,
    input,
  ): BootstrapGrant!(ActivePairingLinksLoadError | BootstrapCredentialConsumeAvailableError | BootstrapCredentialConsumeError | BootstrapCredentialLookupError | BootstrapCredentialProofKeyMismatchError | BootstrapCredentialScopeNotGrantedError | ExpiredBootstrapCredentialError | PairingCredentialIssueError | PairingCredentialRandomGenerationError | PairingLinkRevokeError | UnavailableBootstrapCredentialError | UnknownBootstrapCredentialError)!never =>
    try withSpan(
      (effect (): BootstrapGrant!(ActivePairingLinksLoadError | BootstrapCredentialConsumeAvailableError | BootstrapCredentialConsumeError | BootstrapCredentialLookupError | BootstrapCredentialProofKeyMismatchError | BootstrapCredentialScopeNotGrantedError | ExpiredBootstrapCredentialError | PairingCredentialIssueError | PairingCredentialRandomGenerationError | PairingLinkRevokeError | UnavailableBootstrapCredentialError | UnknownBootstrapCredentialError)!never => {
        const now = try DateTime.now
        if (consumeRotatingDesktopToken(credential, now.epochMilliseconds)) {
          return {
            method: "desktop-bootstrap",
            scopes: AuthStandardClientScopes,
            subject: "desktop-bootstrap",
            expiresAt: DateTime.add(now, {
              milliseconds: DESKTOP_BOOTSTRAP_TOKEN_WINDOW_MS,
            }),
          } satisfies BootstrapGrant
        }
        const seededResult: ConsumeResult = try Ref.modify(
          seededGrantsRef,
          (current): readonly [ConsumeResult, Map<string, StoredBootstrapGrant>] => {
            const grant = current.get(credential)
            if (!grant) {
              return [
                {
                  _tag: "error",
                  reason: "not-found",
                  error: new UnknownBootstrapCredentialError({}),
                },
                current,
              ]
            }

            const next = new Map(current)
            if (DateTime.isGreaterThanOrEqualTo(now, grant.expiresAt)) {
              next.delete(credential)
              return [
                {
                  _tag: "error",
                  reason: "expired",
                  error: new ExpiredBootstrapCredentialError({}),
                },
                next,
              ]
            }

            if (grant.proofKeyThumbprint && grant.proofKeyThumbprint !== input?.proofKeyThumbprint) {
              return [
                {
                  _tag: "error",
                  reason: "not-found",
                  error: new BootstrapCredentialProofKeyMismatchError({}),
                },
                next,
              ]
            }

            if (
              input?.requestedScopes !== undefined
              && !input.requestedScopes.some((scope) => grant.scopes.includes(scope))
            ) {
              return [
                {
                  _tag: "error",
                  reason: "scope-not-granted",
                  error: new BootstrapCredentialScopeNotGrantedError({}),
                },
                current,
              ]
            }

            const remainingUses = grant.remainingUses
            if (typeof remainingUses === "number") {
              if (remainingUses <= 1) {
                next.delete(credential)
              } else {
                next.set(credential, {
                  ...grant,
                  remainingUses: remainingUses - 1,
                })
              }
            }

            return [
              {
                _tag: "success",
                grant: {
                  method: grant.method,
                  scopes: grant.scopes,
                  subject: grant.subject,
                  ...(grant.label ? { label: grant.label } : {}),
                  ...(grant.proofKeyThumbprint
                    ? { proofKeyThumbprint: grant.proofKeyThumbprint }
                    : {}),
                  expiresAt: grant.expiresAt,
                } satisfies BootstrapGrant,
              },
              next,
            ]
          },
        )

        if (seededResult._tag === "success") {
          return seededResult.grant
        }
        if (seededResult.reason !== "not-found") {
          throw seededResult.error
        }

        // Check scopes in the UPDATE so rejected requests cannot spend one-time links.
        const consumed = pairingLinks
          .consumeAvailable({
            credential,
            proofKeyThumbprint: input?.proofKeyThumbprint ?? null,
            ...(input?.requestedScopes !== undefined
              ? { requestedScopes: input.requestedScopes }
              : {}),
            consumedAt: now,
            now,
          }) catch effect (cause) => {
            throw new BootstrapCredentialConsumeAvailableError({ cause })
          }

        if (Option.isSome(consumed)) {
          try emitRemoved(consumed.value.id)
          return {
            method: consumed.value.method,
            scopes: consumed.value.scopes,
            subject: consumed.value.subject,
            ...(consumed.value.label ? { label: consumed.value.label } : {}),
            ...(consumed.value.proofKeyThumbprint
              ? { proofKeyThumbprint: consumed.value.proofKeyThumbprint }
              : {}),
            expiresAt: consumed.value.expiresAt,
          } satisfies BootstrapGrant
        }

        const matching = pairingLinks
          .getByCredential({ credential }) catch effect (cause) => {
            throw new BootstrapCredentialLookupError({ cause })
          }
        if (Option.isNone(matching)) {
          throw new UnknownBootstrapCredentialError({})
        }

        if (matching.value.revokedAt !== null) {
          throw new UnavailableBootstrapCredentialError({})
        }

        if (matching.value.consumedAt !== null) {
          throw new UnknownBootstrapCredentialError({})
        }

        if (DateTime.isGreaterThanOrEqualTo(now, matching.value.expiresAt)) {
          throw new ExpiredBootstrapCredentialError({})
        }

        if (
          matching.value.proofKeyThumbprint !== null
          && matching.value.proofKeyThumbprint !== input?.proofKeyThumbprint
        ) {
          throw new BootstrapCredentialProofKeyMismatchError({})
        }

        if (
          input?.requestedScopes !== undefined
          && !input.requestedScopes.some((scope) => matching.value.scopes.includes(scope))
        ) {
          throw new BootstrapCredentialScopeNotGrantedError({})
        }

        throw new UnavailableBootstrapCredentialError({})
      })(),
      "PairingGrantStore.consume",
    )

  return PairingGrantStore.of({
    issueOneTimeToken,
    listActive,
    get streamChanges() {
      return Stream.fromPubSub(changesPubSub)
    },
    revoke,
    consume,
  })
}

export const layer = Layer.effect(PairingGrantStore, make).pipe(
  Layer.provideMerge(AuthPairingLinks.layer),
)
