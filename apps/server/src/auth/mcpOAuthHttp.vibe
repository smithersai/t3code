import {
  AuthMcpApprovalError,
  type AuthMcpAuthorizationRequest,
  AuthMcpClientAccess,
  EnvironmentHttpApi,
  mcpClientScopes,
} from "@t3tools/contracts";

import * as McpOAuth from "./McpOAuth.ts";
import { renderErrorPage } from "./mcpOAuthHtml.ts";

const APPROVAL_PAGE_PATH = "/connect-agent";

const PAGE_HEADERS = {
  "content-security-policy":
    "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'",
  "x-frame-options": "DENY",
  "cache-control": "no-store",
  "referrer-policy": "no-referrer",
  "x-content-type-options": "nosniff",
};

// OAuth responses contain credentials and must not be cached.
const noStore = HttpEffect.appendPreResponseHandler((_request, response) =>
  succeed(
    HttpServerResponse.setHeaders(response, { "cache-control": "no-store", pragma: "no-cache" }),
  ),
);

const requestUrls = map(HttpServerRequest.HttpServerRequest, McpOAuth.requestUrls);

/**
 * An unverified client or redirect is reported, never redirected; any other problem goes back to
 * the agent through its (verified) redirect URI.
 */
const forwardedAuthorization =
  /* Request instrumentation already owns the span; keep this helper in that context. */
  effect (
    oauth: { readonly register: (input: import("@t3tools/contracts").AuthMcpClientRegistration) => McpOAuth.McpOAuthClient!import("@t3tools/contracts").AuthMcpRegistrationError; readonly validateAuthorization: (input: { readonly urls: McpOAuth.McpOAuthUrls; readonly request: AuthMcpAuthorizationRequest; }) => McpOAuth.AuthorizationRequest!(McpOAuth.McpOAuthPageError | McpOAuth.McpOAuthRedirectError); readonly approvingBrowserSession: (request: HttpServerRequest, authorization: McpOAuth.AuthorizationRequest) => ({ readonly csrfToken: string; readonly scopes: ReadonlyArray<import("@t3tools/contracts").AuthEnvironmentScope>; } | undefined)!!; readonly approve: (input: { readonly request: HttpServerRequest; readonly authorization: McpOAuth.AuthorizationRequest; readonly decision: McpOAuth.ApprovalDecision; }) => string!(import("./EnvironmentAuth.ts").ServerAuthMcpApprovalCodeError | McpOAuth.McpOAuthPageError); readonly deny: (authorization: McpOAuth.AuthorizationRequest) => string; readonly exchangeCode: (input: { readonly request: HttpServerRequest; readonly urls: McpOAuth.McpOAuthUrls; readonly token: import("@t3tools/contracts").AuthMcpTokenRequest; }) => import("@t3tools/contracts").AuthMcpTokenResult!import("@t3tools/contracts").AuthMcpTokenError; },
    request: { readonly response_type?: string; readonly client_id?: string; readonly redirect_uri?: string; readonly code_challenge?: string; readonly code_challenge_method?: string; readonly state?: string; readonly resource?: string; },
  ) => {
    const urls = try requestUrls;
    return try (oauth.validateAuthorization({ urls, request })
      |> catchTags(%, {
        McpOAuthPageError: (error) =>
          fail(new AuthMcpApprovalError({ message: error.description })),
        McpOAuthRedirectError: (error) =>
          succeed({ redirectTo: McpOAuth.redirectForError(error, urls.issuer) }),
      }));
  };

export const layer = HttpApiBuilder.group(
  EnvironmentHttpApi,
  "mcpOAuth",
  effect (handlers) => {
    const oauth = try McpOAuth.McpOAuth;
    const protectedResource = () =>
      requestUrls |> map(%, McpOAuth.protectedResourceMetadata);

    return handlers
      .handle("protectedResource", protectedResource)
      .handle("mcpProtectedResource", protectedResource)
      .handle("authorizationServer", () =>
        requestUrls |> map(%, McpOAuth.authorizationServerMetadata),
      )
      .handle("register", ({ payload }) =>
        oauth.register(payload)
          |> map(%, (client) => ({
            client_id: client.clientId,
            client_name: client.name,
            redirect_uris: client.redirectUris,
            grant_types: ["authorization_code" as const],
            response_types: ["code" as const],
            token_endpoint_auth_method: "none" as const,
          }))
          |> tap(%, () => noStore),
      )
      .handleRaw("authorize", ({ request }) =>
        effect {
          const urls = try requestUrls;
          const url = new URL(request.url, urls.issuer);
          const authorization = try (oauth
            .validateAuthorization({ urls, request: Object.fromEntries(url.searchParams) })|> result(%));
          const headers = { "cache-control": "no-store", "referrer-policy": "no-referrer" };
          if (Result.isSuccess(authorization)) {
            return HttpServerResponse.redirect(`${APPROVAL_PAGE_PATH}${url.search}`, { headers });
          }
          const error = authorization.failure;
          return error._tag === "McpOAuthPageError"
            ? HttpServerResponse.text(try orDie(Effect.try({ try: () => renderErrorPage(error.description), catch: (error) => error })), {
                status: 400,
                contentType: "text/html; charset=utf-8",
                headers: PAGE_HEADERS,
              })
            : HttpServerResponse.redirect(try orDie(Effect.try({ try: () => McpOAuth.redirectForError(error, urls.issuer), catch: (error) => error })), {
                headers,
              });
        },
      )
      .handle("approval", ({ payload, request }) =>
        effect {
          const resolved = try forwardedAuthorization(oauth, payload);
          if ("redirectTo" in resolved) return resolved;
          const urls = try requestUrls;
          const session = try oauth.approvingBrowserSession(request, resolved);
          try noStore;
          return {
            clientName: resolved.client.name,
            redirectHost: new URL(resolved.redirectUri).host,
            environmentHost: new URL(urls.issuer).host,
            ...(session === undefined
              ? {}
              : {
                  csrfToken: session.csrfToken,
                  oneClickAccess: AuthMcpClientAccess.literals.filter((access) =>
                    mcpClientScopes(access).every((scope) => session.scopes.includes(scope)),
                  ),
                }),
          };
        },
      )
      .handle("decision", ({ payload, request }) =>
        effect {
          const resolved = try forwardedAuthorization(oauth, payload.authorization);
          if ("redirectTo" in resolved) return resolved;
          try noStore;
          const { decision } = payload;
          if (decision._tag === "deny") return { redirectTo: try orDie(Effect.try({ try: () => oauth.deny(resolved), catch: (error) => error })) };
          return (oauth.approve({ request, authorization: resolved, decision })
            |> map(%, (redirectTo) => ({ redirectTo }))) catch effect (error) => { throw new AuthMcpApprovalError({ message: error.message }) };
        },
      )
      .handle("token", ({ payload, request }) =>
        effect {
          try noStore;
          return try oauth.exchangeCode({ request, urls: try requestUrls, token: payload });
        },
      );
  },
);
