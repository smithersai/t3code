import { AuthEnvironmentMaintainScope, type ServerAuthDescriptor } from "@t3tools/contracts";
import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";

import * as ServerConfig from "../config.ts";
import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
import { isRemoteReachableHost, resolveSessionCookieName } from "./utils.ts";

export service EnvironmentAuthPolicy: {
    readonly getDescriptor: () => ServerAuthDescriptor!!;
  } {
  static readonly key = "t3/auth/EnvironmentAuthPolicy"
}

/** @public */
export const make = effect {
  const config = try ServerConfig.ServerConfig;
  const serverEnvironment = try ServerEnvironment.ServerEnvironmentIdentity;
  const isRemoteReachable = try orDie(Effect.try({ try: () => isRemoteReachableHost(config.host), catch: (error) => error }));

  const policy =
    config.mode === "desktop"
      ? isRemoteReachable
        ? "remote-reachable"
        : "desktop-managed-local"
      : isRemoteReachable
        ? "remote-reachable"
        : "loopback-browser";

  const bootstrapMethods: ServerAuthDescriptor["bootstrapMethods"] =
    policy === "desktop-managed-local"
      ? ["desktop-bootstrap"]
      : config.mode === "desktop" && policy === "remote-reachable"
        ? ["desktop-bootstrap", "one-time-token"]
        : ["one-time-token"];

  const input = {
      mode: config.mode,
      port: config.port,
      host: config.host,
      instanceKey: config.stateDir,
      environmentId: try serverEnvironment.getEnvironmentId,
      development: config.devUrl !== undefined,
    }
  const descriptor: ServerAuthDescriptor = {
    policy,
    bootstrapMethods,
    sessionMethods: ["browser-session-cookie", "bearer-access-token", "dpop-access-token"],
    serverUpdateScope: AuthEnvironmentMaintainScope,
    sessionCookieName: try orDie(Effect.try({ try: () => resolveSessionCookieName(input), catch: (error) => error })),
  };

  return EnvironmentAuthPolicy.of({
    getDescriptor: fn("EnvironmentAuthPolicy.getDescriptor")(function () {
      return succeed(descriptor);
    }),
  });
};

export const layer = Layer.effect(EnvironmentAuthPolicy, make);
