import { flushNodeCompileCache } from platform
import * as Effect from "effect/Effect"

module platform {
  import * as NodeModule from "node:module"

  export function flushNodeCompileCache(): void {
    NodeModule.flushCompileCache()
  }
}

// Windows force-kills on quit; persist the cache after startup.
export const flushCompileCache = Effect.try(flushNodeCompileCache)
  |> Effect.ignore(%)
