import {
  ServerSelfUpdateError,
  type DesktopUpdateState,
  type DesktopUpdateStatusReport,
  type ServerSelfUpdateProgressStage,
  type ServerSelfUpdateResult,
} from "@t3tools/contracts"
import * as Context from "effect/Context"
import * as Crypto from "@t3tools/shared/Crypto"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"

import * as ServerConfig from "../config.vibe"
import * as DesktopTelemetryReceiver from "../resourceTelemetry/DesktopTelemetryReceiver.vibe"

const DESKTOP_UPDATE_TIMEOUT = Duration.minutes(20)
const DESKTOP_INSTALL_TIMEOUT = Duration.minutes(2)

function desktopUpdateProgressStage(
  state: DesktopUpdateState,
): ServerSelfUpdateProgressStage | null {
  switch (state.status) {
    case "checking":
    case "available":
    case "downloading":
      return "downloading"
    case "downloaded":
      return "installing"
    default:
      return null
  }
}

export service DesktopAppUpdate: {
  readonly available: boolean;
  readonly run: (
    reportProgress: (
      stage: ServerSelfUpdateProgressStage,
    ) => void!ServerSelfUpdateError,
  ) => ServerSelfUpdateResult!ServerSelfUpdateError;
  /** Success stops the server; returns only on installation failure or timeout. */
  readonly commit: (
    requestId: string,
    onHandoffAccepted?: () => void!!,
  ) => never!ServerSelfUpdateError;
} {
  static readonly key = "t3/desktopUpdate/DesktopAppUpdate"
}

export const make = effect () =>
  try withSpan(
    effect {
      const config = try ServerConfig.ServerConfig
      const crypto = try Crypto.Crypto
      const receiver = try DesktopTelemetryReceiver.DesktopTelemetryReceiver
      const inFlight = try Ref.make(false)

      const available = config.mode === "desktop" && config.desktopTelemetryControlFd !== undefined
      const failWith = (reason: string, cause?: unknown) =>
        cause === undefined
          ? new ServerSelfUpdateError({ reason })
          : new ServerSelfUpdateError({ reason, cause })

      const consumeReports = effect (
        requestId: string,
        changes: Stream.Stream<
          {
            readonly version: 1
            readonly type: "desktopUpdateStatus"
            readonly requestId?: string
            readonly outcome?: "failed" | "ready-to-install" | "up-to-date"
            readonly reason?: string
            readonly state: {
              readonly enabled: boolean
              readonly status:
                | "available"
                | "checking"
                | "disabled"
                | "downloaded"
                | "downloading"
                | "error"
                | "idle"
                | "up-to-date"
              readonly channel: "latest" | "nightly"
              readonly currentVersion: string
              readonly hostArch: "arm64" | "other" | "x64"
              readonly appArch: "arm64" | "other" | "x64"
              readonly runningUnderArm64Translation: boolean
              readonly availableVersion: string | null
              readonly downloadedVersion: string | null
              readonly releaseNotes: readonly {
                readonly version: string
                readonly items: readonly string[]
                readonly totalItems: number
              }[]
              readonly omittedReleaseCount: number
              readonly downloadPercent: number | null
              readonly checkedAt: string | null
              readonly message: string | null
              readonly errorContext: "check" | "download" | "install" | null
              readonly canRetry: boolean
              readonly notAppliedVersion?: string
            }
          },
          never,
          never
        >,
        reportProgress: (stage: ServerSelfUpdateProgressStage) => void!ServerSelfUpdateError,
      ) =>
        try withSpan(
          effect {
            const lastStage = try Ref.make<ServerSelfUpdateProgressStage | null>(null)
            const emitStage = (
              stage: ServerSelfUpdateProgressStage | null,
            ): void!ServerSelfUpdateError =>
              stage === null
                ? Effect.void
                : (Ref.get(lastStage)
                  |> Effect.flatMap(%, (previous) =>
                    previous === stage
                      ? Effect.void
                      : (Ref.set(lastStage, stage) |> Effect.andThen(%, reportProgress(stage)))))

            const terminal = try changes.pipe(
              Stream.filter((report) => report.requestId === requestId),
              Stream.mapEffect(
                (report): Option.Option<DesktopUpdateStatusReport>!ServerSelfUpdateError =>
                  report.outcome === undefined
                    ? (emitStage(desktopUpdateProgressStage(report.state))
                      |> Effect.as(%, Option.none<DesktopUpdateStatusReport>()))
                    : Effect.succeedSome(report),
              ),
              Stream.filterMap(
                Option.match({
                  onNone: () => Result.failVoid,
                  onSome: Result.succeed,
                }),
              ),
              Stream.runHead,
            )
            if (Option.isNone(terminal)) {
              throw failWith("The desktop app stopped reporting its update.")
            }

            const report = terminal.value
            if (report.outcome === "ready-to-install") {
              try emitStage("installing")
              const targetVersion = report.state.downloadedVersion
                ?? report.state.availableVersion
                ?? report.state.currentVersion
              try Effect.logInfo("Desktop app update prepared for install.", {
                targetVersion,
              })
              try Ref.set(inFlight, false)
              return { targetVersion, method: "desktop-app" as const, desktopUpdateToken: requestId }
            }
            if (report.outcome === "up-to-date") {
              throw failWith(
                `The T3 Code desktop app on this machine is already up to date on ${report.state.currentVersion}.`,
              )
            }
            throw failWith(
              report.reason ?? report.state.message ?? "The desktop app update failed.",
            )
          },
          "DesktopAppUpdate.consumeReports",
        )

      const run: DesktopAppUpdate["Service"]["run"] = effect (
        reportProgress,
      ): { readonly targetVersion: string; readonly method: "boot-service" | "desktop-app" | "respawn"; readonly updateId?: string; readonly desktopUpdateToken?: string; }!ServerSelfUpdateError!never =>
        try withSpan(
          (effect (): { readonly targetVersion: string; readonly method: "boot-service" | "desktop-app" | "respawn"; readonly updateId?: string; readonly desktopUpdateToken?: string; }!ServerSelfUpdateError!never => {
            if (!available) {
              throw failWith(
                "This server was not started by the T3 Code desktop app, so it cannot drive a desktop update.",
              )
            }
            if (try Ref.getAndSet(inFlight, true)) {
              throw failWith("A desktop app update is already in progress.")
            }

            return try (Effect.scoped(
              effect {
                const requestId = crypto
                  .randomUUIDv4() catch effect (error) => {
                    throw failWith("Could not generate a desktop update request id.", error)
                  }
                // Subscribe before requesting to catch fast reports.
                const { changes } = try receiver.desktopUpdates
                receiver
                  .requestDesktopUpdate(requestId) catch effect (error) => {
                    throw failWith("Could not reach the T3 Code desktop app on this machine.", error)
                  }
                return try (consumeReports(requestId, changes, reportProgress)
                  |> Effect.onInterrupt(%, () => receiver.cancelDesktopUpdate(requestId) |> Effect.ignore(%)))
              },
            )
              |> Effect.timeout(%, DESKTOP_UPDATE_TIMEOUT)
              |> Effect.catchTags(%, {
                TimeoutError: () => failWith("The desktop app did not finish the update in time."),
              })
              |> Effect.onError(%, () => Ref.set(inFlight, false)))
          })(),
          "desktopUpdate.desktopAppUpdate.run",
        )

      const commit: DesktopAppUpdate["Service"]["commit"] = effect (
        requestId,
        onHandoffAccepted = () => Effect.void,
      ): never!ServerSelfUpdateError!never =>
        try withSpan(
          (effect (): never!ServerSelfUpdateError!never => {
            if (!available) {
              throw failWith("This server cannot commit a desktop app update.")
            }
            const terminal = try Effect.scoped(
              effect {
                const { latest, changes } = try receiver.desktopUpdates
                const reports = do {
                  const $optionSubject = latest
                  const $optionHandlers: {
                    onNone: () => Stream.Stream<
                      {
                        readonly version: 1
                        readonly type: "desktopUpdateStatus"
                        readonly requestId?: string
                        readonly outcome?: "failed" | "ready-to-install" | "up-to-date"
                        readonly reason?: string
                        readonly state: {
                          readonly enabled: boolean
                          readonly status:
                            | "available"
                            | "checking"
                            | "disabled"
                            | "downloaded"
                            | "downloading"
                            | "error"
                            | "idle"
                            | "up-to-date"
                          readonly channel: "latest" | "nightly"
                          readonly currentVersion: string
                          readonly hostArch: "arm64" | "other" | "x64"
                          readonly appArch: "arm64" | "other" | "x64"
                          readonly runningUnderArm64Translation: boolean
                          readonly availableVersion: string | null
                          readonly downloadedVersion: string | null
                          readonly releaseNotes: readonly {
                            readonly version: string
                            readonly items: readonly string[]
                            readonly totalItems: number
                          }[]
                          readonly omittedReleaseCount: number
                          readonly downloadPercent: number | null
                          readonly checkedAt: string | null
                          readonly message: string | null
                          readonly errorContext: "check" | "download" | "install" | null
                          readonly canRetry: boolean
                          readonly notAppliedVersion?: string
                        }
                      },
                      never,
                      never
                    >
                    onSome: (
                      report: {
                        readonly version: 1
                        readonly type: "desktopUpdateStatus"
                        readonly requestId?: string
                        readonly outcome?: "failed" | "ready-to-install" | "up-to-date"
                        readonly reason?: string
                        readonly state: {
                          readonly enabled: boolean
                          readonly status:
                            | "available"
                            | "checking"
                            | "disabled"
                            | "downloaded"
                            | "downloading"
                            | "error"
                            | "idle"
                            | "up-to-date"
                          readonly channel: "latest" | "nightly"
                          readonly currentVersion: string
                          readonly hostArch: "arm64" | "other" | "x64"
                          readonly appArch: "arm64" | "other" | "x64"
                          readonly runningUnderArm64Translation: boolean
                          readonly availableVersion: string | null
                          readonly downloadedVersion: string | null
                          readonly releaseNotes: readonly {
                            readonly version: string
                            readonly items: readonly string[]
                            readonly totalItems: number
                          }[]
                          readonly omittedReleaseCount: number
                          readonly downloadPercent: number | null
                          readonly checkedAt: string | null
                          readonly message: string | null
                          readonly errorContext: "check" | "download" | "install" | null
                          readonly canRetry: boolean
                          readonly notAppliedVersion?: string
                        }
                      },
                    ) => Stream.Stream<
                      {
                        readonly version: 1
                        readonly type: "desktopUpdateStatus"
                        readonly requestId?: string
                        readonly outcome?: "failed" | "ready-to-install" | "up-to-date"
                        readonly reason?: string
                        readonly state: {
                          readonly enabled: boolean
                          readonly status:
                            | "available"
                            | "checking"
                            | "disabled"
                            | "downloaded"
                            | "downloading"
                            | "error"
                            | "idle"
                            | "up-to-date"
                          readonly channel: "latest" | "nightly"
                          readonly currentVersion: string
                          readonly hostArch: "arm64" | "other" | "x64"
                          readonly appArch: "arm64" | "other" | "x64"
                          readonly runningUnderArm64Translation: boolean
                          readonly availableVersion: string | null
                          readonly downloadedVersion: string | null
                          readonly releaseNotes: readonly {
                            readonly version: string
                            readonly items: readonly string[]
                            readonly totalItems: number
                          }[]
                          readonly omittedReleaseCount: number
                          readonly downloadPercent: number | null
                          readonly checkedAt: string | null
                          readonly message: string | null
                          readonly errorContext: "check" | "download" | "install" | null
                          readonly canRetry: boolean
                          readonly notAppliedVersion?: string
                        }
                      },
                      never,
                      never
                    >
                  } = {
                    onNone: () => changes,
                    onSome: (report) => Stream.concat(Stream.make(report), changes),
                  }
                  const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
                  match ($optionSubject) {
                    when Option.Some(let $optionValue): $optionSome($optionValue);
                    default: $optionNone();
                  }
                }
                try Effect.uninterruptible(
                  receiver.commitDesktopUpdate(requestId)
                    |> Effect.mapError(%, (error) => failWith("Could not reach the T3 Code desktop app.", error))
                    |> Effect.tap(%, () => onHandoffAccepted()),
                )
                return try (reports
                  |> Stream.filter(%, (report) => report.requestId === requestId && report.outcome === "failed")
                  |> Stream.runHead(%)
                  |> Effect.timeout(%, DESKTOP_INSTALL_TIMEOUT)
                  |> Effect.catchTags(%, {
                    TimeoutError: () => failWith("The desktop app did not report an install result in time."),
                  }))
              },
            )
            if (Option.isNone(terminal)) {
              throw failWith("The desktop app stopped reporting the install.")
            }
            throw failWith(
              terminal.value.reason
                ?? terminal.value.state.message
                ?? "The desktop app failed to install the update.",
            )
          })(),
          "desktopUpdate.desktopAppUpdate.commit",
        )

      return DesktopAppUpdate.of({ available, run, commit })
    },
    "desktopUpdate.desktopAppUpdate.make",
  )

export const layer = Layer.effect(DesktopAppUpdate, make())
