import {
  EnvironmentId,
  ORCHESTRATION_PROTOCOL_VERSION,
  PROVIDER_SEND_TURN_MAX_FILE_BYTES,
  type ExecutionEnvironmentDescriptor,
} from "@t3tools/contracts"
import * as HostProcess from "@t3tools/shared/HostProcess"
import * as Context from "effect/Context"
import * as Crypto from "@t3tools/shared/Crypto"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"

import packageJson from "../../package.json" with { type: "json" }
import * as ServerSecretStore from "../auth/ServerSecretStore.vibe"
import { resolveServerInstallation } from "../cli/invocation.vibe"
import { readAgentActivityPublishingActive } from "../cloud/config.vibe"
import { resolveServerSelfUpdateCapability } from "../cloud/selfUpdate.vibe"
import { resolveServiceLauncherMode } from "../cloud/serviceLauncherClient.vibe"
import * as ServerConfig from "../config.vibe"
import * as ProcessRunner from "../processRunner.vibe"
import { resolveServerEnvironmentLabel } from "./ServerEnvironmentLabel.vibe"
import { detectServerEnvironmentMachineKind } from "./ServerEnvironmentMachine.vibe"

export class ServerEnvironmentIdPersistenceError extends Schema.TaggedError<ServerEnvironmentIdPersistenceError>()(
  "ServerEnvironmentIdPersistenceError",
  {
    operation: Schema.Literals(["check", "read", "write", "initialize"]),
    environmentIdPath: Schema.String,
    cause: Schema.optional(Schema.Defect()),
  },
) {
  override get message(): string {
    if (this.operation === "initialize") {
      return `Server environment ID file is missing or empty after initialization at '${this.environmentIdPath}'.`
    }
    return `Server environment ID ${this.operation} failed at '${this.environmentIdPath}'.`
  }
}

export service ServerEnvironment: {
  readonly getEnvironmentId: EnvironmentId!!;
  readonly getDescriptor: ExecutionEnvironmentDescriptor!!;
} {
  static readonly key = "t3/environment/ServerEnvironment"
}

export service ServerEnvironmentIdentity: {
  readonly getEnvironmentId: EnvironmentId!!;
} {
  static readonly key = "t3/environment/ServerEnvironment/ServerEnvironmentIdentity"
}

function platformOs(platform: NodeJS.Platform): ExecutionEnvironmentDescriptor["platform"]["os"] {
  switch (platform) {
    case "darwin":
      return "darwin"
    case "linux":
      return "linux"
    case "win32":
      return "windows"
    default:
      return "unknown"
  }
}

function platformArch(
  architecture: NodeJS.Architecture,
): ExecutionEnvironmentDescriptor["platform"]["arch"] {
  switch (architecture) {
    case "arm64":
      return "arm64"
    case "x64":
      return "x64"
    default:
      return "other"
  }
}

const makeIdentity = effect {
  const fileSystem = try FileSystem.FileSystem
  const serverConfig = try ServerConfig.ServerConfig
  const crypto = try Crypto.Crypto

  const readPersistedEnvironmentId = effect {
    const exists = fileSystem.exists(serverConfig.environmentIdPath) catch effect (cause) => {
      throw new ServerEnvironmentIdPersistenceError({
        operation: "check",
        environmentIdPath: serverConfig.environmentIdPath,
        cause,
      })
    }
    if (!exists) {
      return null
    }

    const raw = (fileSystem.readFileString(serverConfig.environmentIdPath)
      |> Effect.map(%, (value) => value.trim())) catch effect (cause) => {
        throw new ServerEnvironmentIdPersistenceError({
          operation: "read",
          environmentIdPath: serverConfig.environmentIdPath,
          cause,
        })
      }

    return raw.length > 0 ? raw : null
  }

  const persistEnvironmentId = effect (value: string, mode: "create" | "recover") =>
    try withSpan(
      effect {
        const destinationPath = mode === "recover"
          ? `${serverConfig.environmentIdPath}.recovery`
          : serverConfig.environmentIdPath
        const tempPath = try fileSystem.makeTempFileScoped({
          directory: serverConfig.stateDir,
          prefix: ".environment-id-",
        })
        try fileSystem.writeFileString(tempPath, `${value}\n`)
        // Publish the completed file without replacing an ID created by another process.
        try (fileSystem.link(tempPath, destinationPath)
          |> Effect.catchIf(
            %,
            (cause) => cause.reason._tag === "AlreadyExists",
            () => Effect.void,
          ))
        if (mode === "recover") {
          // Keep the recovery ID so delayed initializers also publish the same winner.
          try fileSystem.remove(tempPath)
          try fileSystem.copyFile(destinationPath, tempPath)
          try fileSystem.rename(tempPath, serverConfig.environmentIdPath)
        }
      } |> Effect.scoped(%) |> Effect.mapError(%, (cause) =>
        new ServerEnvironmentIdPersistenceError({
          operation: "write",
          environmentIdPath: serverConfig.environmentIdPath,
          cause,
        })),
      "ServerEnvironmentIdentity.persistEnvironmentId",
    )

  const environmentIdRaw = try effect {
    const persisted = try readPersistedEnvironmentId
    if (persisted) {
      return persisted
    }

    const generated = try crypto.randomUUIDv4()
    try persistEnvironmentId(generated, "create")
    let winner = try readPersistedEnvironmentId
    if (winner === null) {
      try persistEnvironmentId(generated, "recover")
      winner = try readPersistedEnvironmentId
    }
    if (winner === null) {
      throw new ServerEnvironmentIdPersistenceError({
        operation: "initialize",
        environmentIdPath: serverConfig.environmentIdPath,
      })
    }
    return winner
  }

  const environmentId = EnvironmentId.make(environmentIdRaw)
  return ServerEnvironmentIdentity.of({
    getEnvironmentId: Effect.succeed(environmentId),
  })
}

/** @public */
export const make = effect {
  const path = try Path.Path
  const serverConfig = try ServerConfig.ServerConfig
  const secrets = try ServerSecretStore.ServerSecretStore
  const identity = try ServerEnvironmentIdentity
  const hostPlatform = try HostProcess.Platform
  const hostArchitecture = try HostProcess.Architecture
  const environmentId = try identity.getEnvironmentId
  const cwdBaseName = path.basename(serverConfig.cwd).trim()
  const label = try resolveServerEnvironmentLabel({ cwdBaseName })
  const machine = try detectServerEnvironmentMachineKind()
  const launcher = try resolveServiceLauncherMode()
  const serverSelfUpdate = try Effect.orDie(Effect.try({
    try: () =>
      resolveServerSelfUpdateCapability({
        desktopManaged: serverConfig.mode === "desktop",
        launcherManaged: launcher.managed,
      }),
    catch: (e) => e,
  }))
  const serverInstallation = serverSelfUpdate === null ? try resolveServerInstallation : null
  // Desktop and server ship together; a control fd guarantees requestDesktopUpdate support.

  const desktopAppUpdate = serverSelfUpdate === "desktop-managed"
    && serverConfig.desktopTelemetryControlFd !== undefined

  const descriptor: ExecutionEnvironmentDescriptor = {
    environmentId,
    label,
    platform: {
      os: platformOs(hostPlatform),
      arch: platformArch(hostArchitecture),
      ...(machine === null ? {} : { machine }),
    },
    serverVersion: packageJson.version,
    orchestrationProtocolVersion: ORCHESTRATION_PROTOCOL_VERSION,
    capabilities: {
      repositoryIdentity: true,
      connectionProbe: true,
      attachmentUploads: true,
      questionAttachments: true,
      fileAttachments: { maxUploadBytes: PROVIDER_SEND_TURN_MAX_FILE_BYTES },
      pullRequests: true,
      pullRequestChecks: true,
      inlineMessageContext: true,
      requiredWorktreeBootstrap: true,
      threadSettlement: true,
      threadAutoSettlement: true,
      storageCleanup: true,
      storageCleanupRun: true,
      databaseStorage: true,
      otlpEndpointCheck: true,
      projectWorktreeCleanup: true,
      settledWorktreeCleanup: true,
      worktreesDirectory: true,
      threadAutoSettlementScope: true,
      threadRestartContinuation: true,
      projectSettingsOverrides: true,
      projectProviderInstanceOverrides: true,
      threadSnooze: true,
      environmentThemes: true,
      usageLimitSources: true,
      providerWorkspaceSnapshotsOnDemand: true,
      usagePriceOverrides: true,
      usageModelAliases: true,
      threadPinning: true,
      threadPinReorder: true,
      threadActiveReorder: true,
      threadAutoSettleOptOut: true,
      threadTitleRegeneration: true,
      commandOutputStreaming: true,
      threadVisitedTracking: true,
      threadPullRequests: true,
      threadPullRequestWatch: true,
      pullRequestStackActions: true,
      threadPullRequestLinking: true,
      serverResolvedCommandContext: true,
      threadStop: true,
      ...(hostPlatform === "win32" ? {} : { localServerStop: true }),
      environmentIcon: true,
      projectCloneTracking: true,
      ignoredFileListing: true,
      triage: true,
      ...(serverSelfUpdate === null ? {} : { serverSelfUpdate }),
      ...(serverInstallation === null ? {} : { serverInstallation }),
      ...(serverSelfUpdate === "boot-service" || desktopAppUpdate
        ? { serverSelfUpdateProgress: true }
        : {}),
      ...(desktopAppUpdate ? { desktopAppUpdate: true } : {}),
      serverBrowser: true,
      peerLinks: true,
      mcpModeLimitHeader: true,
      linkFence: true,
    },
  }

  return ServerEnvironment.of({
    getEnvironmentId: Effect.succeed(environmentId),
    // Publishing opt-in and relay links change at runtime; read the capability per request.
    getDescriptor: readAgentActivityPublishingActive(secrets)
      |> Effect.map(%, (agentActivityPublishing) => ({
        ...descriptor,
        capabilities: { ...descriptor.capabilities, agentActivityPublishing },
      })),
  })
}

export const layerIdentity = Layer.effect(ServerEnvironmentIdentity, makeIdentity)

export const layer = Layer.effect(ServerEnvironment, make).pipe(
  Layer.provideMerge(layerIdentity),
  Layer.provide(ProcessRunner.layer),
)
