import * as HostProcess from "@t3tools/shared/HostProcess";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Schema from "effect/Schema";

import * as ProcessRunner from "../processRunner.ts";

interface ResolveServerEnvironmentLabelInput {
  readonly cwdBaseName: string;
}

schema ServerEnvironmentLabelCommandProbe = "macos-computer-name" | "linux-pretty-hostname"

const ServerEnvironmentLabelFileErrorCauseField = Schema.Defect()
export schema error ServerEnvironmentLabelFileError {
  readonly operation: "inspect" | "read"
  readonly path: string
  cause: ServerEnvironmentLabelFileErrorCauseField
  override get message(): string {
    return `Failed to ${this.operation} environment-label file at ${this.path}.`;
  }
}

const ServerEnvironmentLabelCommandErrorCauseField = Schema.Defect()
export schema error ServerEnvironmentLabelCommandError {
  readonly probe: ServerEnvironmentLabelCommandProbe
  readonly executable: string
  readonly argumentCount: number
  cause: ServerEnvironmentLabelCommandErrorCauseField
  override get message(): string {
    return `Failed to run environment-label probe '${this.probe}' with ${this.executable}.`;
  }
}

function normalizeLabel(value: string | null | undefined): string | null {
  const trimmed = value?.trim();
  return trimmed && trimmed.length > 0 ? trimmed : null;
}

function parseMachineInfoValue(raw: string, key: string): string | null {
  for (const line of raw.split(/\r?\n/g)) {
    const trimmed = line.trim();
    if (trimmed.length === 0 || trimmed.startsWith("#") || !trimmed.startsWith(`${key}=`)) {
      continue;
    }
    const value = trimmed.slice(key.length + 1).trim();
    if (
      (value.startsWith('"') && value.endsWith('"')) ||
      (value.startsWith("'") && value.endsWith("'"))
    ) {
      return normalizeLabel(value.slice(1, -1));
    }
    return normalizeLabel(value);
  }
  return null;
}

const readLinuxMachineInfo = effect () => try withSpan(effect {
  const fileSystem = try FileSystem.FileSystem;
  const machineInfoPath = "/etc/machine-info";
  return try (fileSystem.exists(machineInfoPath)
    |> mapError(
      %, (cause) =>
        new ServerEnvironmentLabelFileError({
          operation: "inspect",
          path: machineInfoPath,
          cause,
        }),
    )
    |> flatMap(%, (exists) =>
      exists
        ? (fileSystem.readFileString(machineInfoPath)
            |> mapError(
              %, (cause) =>
                new ServerEnvironmentLabelFileError({
                  operation: "read",
                  path: machineInfoPath,
                  cause,
                }),
            ))
        : succeed(null),
    )
    |> catchTags(%, {
      ServerEnvironmentLabelFileError: (error) =>
        logDebug(error.message)
          |> annotateLogs({
            operation: error.operation,
            path: error.path,
            cause: error,
          })(%)
          |> as(%, null),
    }));
}, "readLinuxMachineInfo");

const runFriendlyLabelCommand = effect (input: { readonly probe: ServerEnvironmentLabelCommandProbe; readonly command: string; readonly args: readonly string[]; }) => try withSpan(effect {
  const processRunner = try ProcessRunner.ProcessRunner;
  const result = try (processRunner
    .run({
      command: input.command,
      args: input.args,
      timeoutBehavior: "timedOutResult",
    })
      |> mapError(
        %, (cause) =>
          new ServerEnvironmentLabelCommandError({
            probe: input.probe,
            executable: input.command,
            argumentCount: input.args.length,
            cause,
          }),
      )
      |> asSome(%)
      |> catchTags(%, {
        ServerEnvironmentLabelCommandError: (error) =>
          logDebug(error.message)
            |> annotateLogs({
              probe: error.probe,
              executable: error.executable,
              argumentCount: error.argumentCount,
              cause: error,
            })(%)
            |> as(%, Option.none()),
      }));

  if (Option.isNone(result) || result.value.code !== 0) {
    return null;
  }

  return normalizeLabel(result.value.stdout);
}, "runFriendlyLabelCommand");

const resolveFriendlyHostLabel = effect () => try withSpan(effect {
  const platform = try HostProcess.Platform;
  if (platform === "darwin") {
    return try runFriendlyLabelCommand({
      probe: "macos-computer-name",
      command: "scutil",
      args: ["--get", "ComputerName"],
    });
  }

  if (platform === "linux") {
    const machineInfo = normalizeLabel(try readLinuxMachineInfo());
    if (machineInfo) {
      const prettyHostname = parseMachineInfoValue(machineInfo, "PRETTY_HOSTNAME");
      if (prettyHostname) {
        return prettyHostname;
      }
    }

    return try runFriendlyLabelCommand({
      probe: "linux-pretty-hostname",
      command: "hostnamectl",
      args: ["--pretty"],
    });
  }

  return null;
}, "resolveFriendlyHostLabel");

export const resolveServerEnvironmentLabel = effect (
  input: ResolveServerEnvironmentLabelInput,
) => try withSpan(effect {
  const friendlyHostLabel = try resolveFriendlyHostLabel();
  if (friendlyHostLabel) {
    return friendlyHostLabel;
  }

  const hostname = normalizeLabel(try HostProcess.Hostname);
  if (hostname) {
    return hostname;
  }

  return normalizeLabel(input.cwdBaseName) ?? "T3 environment";
}, "resolveServerEnvironmentLabel");
