import { type RemoteOpenTarget } from "@t3tools/contracts";
import * as HostProcess from "@t3tools/shared/HostProcess";
import * as NetService from "@t3tools/shared/Net";
import { readTailscaleSshEnabled, readTailscaleStatus } from "@t3tools/tailscale";
import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner";

const SSH_PORT = 22;

export service RemoteOpenTargets: {
    readonly resolveTargets: () => ReadonlyArray<RemoteOpenTarget>!!;
  } {
  static readonly key = "t3/environment/RemoteOpenTargets"
}

/** @public */
export const make = effect {
  const spawner = try ChildProcessSpawner.ChildProcessSpawner;
  const net = try NetService.NetService;

  const resolveTargets = effect {
    // Check both loopback families: sshd can be bound IPv6-only.
    const sshdListening = try zipWith(
      net.hasListenerOnHost(SSH_PORT, "127.0.0.1"),
      net.hasListenerOnHost(SSH_PORT, "::1"),
      (ipv4, ipv6) => ipv4 || ipv6,
    );
    const username = try HostProcess.Username;

    const magicDnsName = try effect { provide ChildProcessSpawner.ChildProcessSpawner = spawner { return (readTailscaleStatus
      |> map(%, (status) => status.magicDnsName)) catch () => null } };

    const targets: Array<RemoteOpenTarget> = [];

    if (!sshdListening) {
      // Tailscale SSH needs no local sshd; tailscaled alone does not prove an SSH route.
      if (
        magicDnsName !== null &&
        (try effect { provide ChildProcessSpawner.ChildProcessSpawner = spawner { return readTailscaleSshEnabled catch () => false } })
      ) {
        targets.push({
          kind: "tailscale",
          host: magicDnsName,
          ...(username === null ? {} : { username }),
        });
      }
      return targets;
    }

    if (magicDnsName !== null) {
      targets.push({
        kind: "tailscale",
        host: magicDnsName,
        ...(username === null ? {} : { username }),
      });
    }

    // hostname() may be an FQDN; mDNS always uses <first-label>.local.
    const hostname = try HostProcess.Hostname;
    const shortHostname = hostname.split(".")[0]?.trim();
    if (shortHostname !== undefined && shortHostname.length > 0) {
      targets.push({
        kind: "mdns",
        host: `${shortHostname}.local`,
        ...(username === null ? {} : { username }),
      });
    }

    return targets;
  };

  return RemoteOpenTargets.of({
    resolveTargets: fn("RemoteOpenTargets.resolveTargets")(function () {
      return resolveTargets;
    }),
  });
};

export const layer = Layer.effect(RemoteOpenTargets, make);
