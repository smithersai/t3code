/** @public */
/** @public */
export const make = effect {
  const localHost = try DeviceHost.DeviceHost
  const config = try ServerConfig.ServerConfig
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const runner = try ProcessRunner.ProcessRunner
  const settings = try ServerSettings.ServerSettingsService
  const scope = try Scope.Scope
  const hosts = new Map<DeviceHostId, DeviceHost.DeviceHost["Service"]>([
    [localHost.id, localHost],
  ])
  const crypto = try Crypto.Crypto
  const configPath = (hostId: DeviceHostId, deviceId?: DeviceId) =>
    agentDeviceConfigPath(config.stateDir, hostId, path, deviceId)
    |> Effect.provideService(%, Crypto.Crypto, crypto)
  const configureAgent = effect (
    hostId: string,
    endpoint: DeviceHost.AgentDaemonEndpoint,
    deviceId?: string | undefined,
  ) =>
    try withSpan(
      effect {
        const file = try configPath(hostId, deviceId)
        try writeAgentDeviceConfig(file, endpoint)
        return file
      } |> Effect.provideService(%, FileSystem.FileSystem, fs) |> Effect.provideService(%, Path.Path, path)
        |> Effect.mapError(%, (cause) =>
          new DeviceOperationError({
            operation: "configure agent",
            reason: "settings_failed",
            cause,
          })),
      "DeviceService.configureAgent",
    )
  const probeContext = try Effect.context<Effect.Services<ReturnType<typeof SshDeviceHost.probe>>>()
  const localTargetContext = try Effect.context<Effect.Services<ReturnType<typeof isLocalSshDeviceHost>>>()
  const service = try makeWithHosts(
    hosts,
    (host) =>
      effect {
        if (
          (try effect {
            provide localTargetContext {
              return try isLocalSshDeviceHost(host)
            }
          })
        ) {
          return try localHost.summary
        }
        return try effect {
          provide probeContext {
            return try SshDeviceHost.probe(host)
          }
        }
      }
      |> Effect.mapError(
        %,
        (error) =>
          new DeviceOperationError({
            operation: "probe host",
            reason: "request_failed",
            cause: error,
          }),
      ),
    configureAgent,
    (tool) =>
      (tool === "hub" ? ensureDeviceHub(config.baseDir) : ensureAgentDevice(config.baseDir))
      |> Effect.provideService(%, FileSystem.FileSystem, fs)
      |> Effect.provideService(%, Path.Path, path)
      |> Effect.provideService(%, ProcessRunner.ProcessRunner, runner)
      |> Effect.mapError(
        %,
        (cause) =>
          new DeviceOperationError({
            operation: "update device tool",
            reason: "command_failed",
            // Only the exit code goes into the shown message; npm's stderr can carry registry credentials.
            ...(cause.exitCode !== undefined ? { exitCode: cause.exitCode } : {}),
            cause,
          }),
      ),
  )
  const hostContext = try Effect.context<Effect.Services<ReturnType<typeof SshDeviceHost.make>>>()
  const easContext = try Effect.context<Effect.Services<ReturnType<typeof EasDeviceHost.make>>>()
  const configured = new Map<string, { config: DeviceHostConfig; scope: Scope.Closeable }>()
  const unchanged = (current: DeviceHostConfig, previous: DeviceHostConfig) =>
    current.kind === "ssh" && previous.kind === "ssh"
      ? current.label === previous.label
        && current.target === previous.target
        && current.port === previous.port
        && current.identityFile === previous.identityFile
      : JSON.stringify(current) === JSON.stringify(previous)
  const reconcile = effect (
    configuredHosts: readonly DeviceHostConfig[],
  ) =>
    try withSpan(
      effect {
        const next = try effect {
          provide localTargetContext {
            return try remoteSshDeviceHosts(configuredHosts)
          }
        }
        const removed = try service.withLifecycleLock(
          effect {
            const removed: Array<{ id: string; scope: Scope.Closeable }> = []
            for (const [id, previous] of configured) {
              if (next.some((host) => host.id === id && unchanged(host, previous.config))) continue
              hosts.delete(id)
              configured.delete(id)
              removed.push({ id, scope: previous.scope })
            }
            if (removed.length > 0) try service.refreshHosts
            return removed
          },
        )
        // Stop old writers before deleting config files or publishing replacements, without blocking healthy hosts.
        try Effect.forEach(
          removed,
          ({ id, scope }) =>
            effect {
              try Scope.close(scope, Exit.void)
              try (fs.remove(try configPath(id), { force: true }) |> Effect.ignore(%))
            },
          { concurrency: 4, discard: true },
        )
        try service.withLifecycleLock(
          effect {
            let added = false
            for (const host of next) {
              if (configured.has(host.id)) continue
              added = true
              const hostScope = try Scope.fork(scope)
              if (host.kind === "eas") {
                // Closing this scope stops the host's running sessions, so a changed
                // limit or token never leaves a billed session behind.
                const instance = try effect {
                  provide easContext {
                    return try effect {
                      provide Scope.Scope = hostScope {
                        return try EasDeviceHost.make(host)
                      }
                    }
                  }
                }
                hosts.set(host.id, instance)
                configured.set(host.id, { config: host, scope: hostScope })
                continue
              }
              const instance = try effect {
                provide hostContext {
                  return try effect {
                    provide Scope.Scope = hostScope {
                      return try SshDeviceHost.make(
                        host,
                        (ready) =>
                          (ready.agentDevice
                            ? (configureAgent(host.id, ready.agentDevice) |> Effect.asVoid(%))
                            : Effect.void)
                          |> Effect.mapError(
                            %,
                            (error) =>
                              new DeviceHost.DeviceHostError({
                                hostId: host.id,
                                step: "configuring agent access",
                                cause: error,
                              }),
                          ),
                        (status, detail) =>
                          service
                            .setHostStatus(host.id, { status, ...(detail ? { detail } : {}) }) |> Effect.asVoid(%),
                      )
                    }
                  }
                }
              }
              hosts.set(host.id, instance)
              configured.set(host.id, { config: host, scope: hostScope })
            }
            // Refresh again after removed scopes closed so a late status write from an old host cannot linger.
            if (added || removed.length > 0) try service.refreshHosts
          },
        )
      },
      "DeviceService.reconcile",
    )
  const changes = try settings.subscribeChanges
  // Settings keep EAS hosts apart from SSH hosts; an id both lists use stays the SSH host's.
  const configuredHosts = (value: {
    readonly deviceHosts: ReadonlyArray<SshDeviceHostConfig>
    readonly easDeviceHosts: ReadonlyArray<EasDeviceHostConfig>
  }): ReadonlyArray<DeviceHostConfig> => [
    ...value.deviceHosts,
    ...value.easDeviceHosts.filter((host) => !value.deviceHosts.some((ssh) => ssh.id === host.id)),
  ]
  try reconcile(configuredHosts(try settings.getSettings))
  try (changes
    |> Stream.runForEach(%, (value) => reconcile(configuredHosts(value)))
    |> Effect.forkIn(%, scope))
  try Effect.addFinalizer(() =>
    Effect.forEach(configured.values(), (value) => Scope.close(value.scope, Exit.void), {
      discard: true,
      concurrency: 4,
    })
  )
  const easAccount: DeviceService["Service"]["easAccount"] = effect (input) =>
    try withSpan(
      effect {
        const saved = input.hostId === undefined
          ? ""
          : ((try settings.getSettings).easDeviceHosts.find((host) => host.id === input.hostId)
            ?.accessToken ?? "")
        const credential = try resolveExpoCredential(input.accessToken ?? saved)
        const viewer = try makeExpoApi(try HttpClient.HttpClient, credential).viewer
        return { signedInAs: viewer.name, credentialSource: credential.source, apps: viewer.apps }
      } |> Effect.provide(%, easContext)
        // Only bounded text reaches the browser: the credential errors' own
        // guidance, or a category for what Expo answered, never Expo's text.
        |> Effect.mapError(%, (cause) =>
          new DeviceEasAccountError({
            reason: cause._tag === "ExpoApiError"
              ? cause.status === 401 || cause.status === 403
                ? `Expo rejected the credential (HTTP ${cause.status}).`
                : cause.rejected
                ? "Expo refused the account check."
                : "Could not complete the Expo account check."
              : cause.message,
          })),
      "DeviceService.easAccount",
    )

  return {
    ...service,
    easAccount,
    agentCli: resolveNodeExecutable("Device automation")
      |> Effect.andThen(%, ensureAgentDevice(config.baseDir))
      |> Effect.provideService(%, FileSystem.FileSystem, fs)
      |> Effect.provideService(%, Path.Path, path)
      |> Effect.provideService(%, ProcessRunner.ProcessRunner, runner)
      |> Effect.map(%, (tool) => tool.entryPath)
      |> Effect.mapError(%, (error) =>
        error._tag === "NodeRuntimeUnavailableError"
          ? new DeviceHostUnavailableError({
            hostId: LOCAL_DEVICE_HOST_ID,
            hostLabel: LOCAL_DEVICE_HOST_LABEL,
            reason: nodeRuntimeUnavailableMessage("Device automation"),
            cause: error,
          })
          : new DeviceOperationError({
            operation: "install agent CLI",
            reason: "command_failed",
            cause: error,
          })),
  }
}

export const layer = Layer.effect(DeviceService, make).pipe(Layer.provide(LocalDeviceHost.layer))

export const stateStream = (service: DeviceService["Service"]): Stream.Stream<DeviceServiceState> =>
  Stream.unwrap(
    effect {
      // Subscribe before reading so no change is lost.
      const subscription = try service.subscribe
      const initial = try service.state
      return Stream.concat(Stream.make(initial), Stream.fromSubscription(subscription))
    },
  ).pipe(Stream.scoped)
