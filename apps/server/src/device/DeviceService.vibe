import * as LocalDeviceHost from "./LocalDeviceHost.vibe"

export const DEVICE_HUB_ROUTE_PREFIX = "/api/device-hub"

const sshProbeFailureMessage = (error: DeviceHost.DeviceHostError): string => {
  const cause = error.cause
  if (
    !(cause instanceof SshCommandError)
    || cause.exitCode === null
    || cause.exitCode < 1
    || cause.exitCode > 254
  ) {
    return "Could not connect to this host over SSH."
  }

  // Only the known bootstrap diagnostic is safe to expose as Node guidance.
  if (
    cause.exitCode === 1
    && cause.stderr
      .split(/\r?\n/u)
      .some((line) => line.trim() === "Node is missing from the non-interactive SSH PATH")
  ) {
    return "Connected over SSH, but Node is not on this host's PATH for non-interactive SSH commands."
  }

  return `Connected over SSH, but the device host check failed (exit code ${cause.exitCode}).`
}

export interface DeviceScreenshot {
  readonly device: DeviceSummary
  readonly png: Uint8Array
}

export interface DeviceReadiness extends DeviceHost.DeviceHostReady {
  readonly hostId: DeviceHostId
}

export interface DeviceAgentReadiness extends DeviceReadiness {
  /** Null when each device has its own daemon; see `DeviceOperations.agentEndpoint`. */
  readonly agentDevice: DeviceHost.AgentDeviceEndpoint | null
}

export class DeviceService extends Context.Service<
  DeviceService,
  {
    readonly agentCli: string!DeviceError
    readonly testHost: (
      config: SshDeviceHostConfig,
    ) => DeviceHostSummary!DeviceError
    /** Who an Expo credential signs in as and which EAS projects it can run sessions under. */
    readonly easAccount: (
      input: DeviceEasAccountInput,
    ) => DeviceEasAccount!DeviceEasAccountError
    /**
     * The agent-device flags that reach the device: its config and session,
     * and the id agent-device selects it by, which can differ from its id here.
     */
    readonly agentTarget: (input: {
      threadId: ThreadId
      hostId: DeviceHostId
      deviceId: DeviceId
    }) => { readonly agentDeviceId: string; readonly args: ReadonlyArray<string> }!DeviceError
    readonly state: DeviceServiceState!!
    readonly subscribe: PubSub.Subscription<DeviceServiceState>!never!Scope.Scope
    readonly configure: (
      input: DeviceConfigureInput,
    ) => DeviceServiceState!DeviceError
    readonly list: DeviceServiceState!DeviceError
    readonly updateTool: (tool: "hub" | "agent") => DeviceServiceState!DeviceError
    readonly inspect: DeviceServiceState!!
    readonly retryHost: (hostId: DeviceHostId) => DeviceServiceState!DeviceError
    readonly open: (
      input: DeviceOpenInput,
      context?: DeviceHost.DeviceOpenContext,
    ) => DeviceSession!DeviceError
    readonly close: (input: DeviceCloseInput) => void!DeviceError
    readonly shutdown: (input: DeviceShutdownInput) => void!DeviceError
    readonly detail: (input: DeviceDetailInput) => DeviceDetail!DeviceError
    readonly action: (input: DeviceActionInput) => DeviceDetail!DeviceError
    readonly screenshot: (input: {
      readonly hostId?: DeviceHostId | undefined
      readonly deviceId: DeviceId
    }) => DeviceScreenshot!DeviceError
    readonly readiness: (hostId?: DeviceHostId) => DeviceReadiness!DeviceError
    readonly readinessIfSupported: (
      hostId?: DeviceHostId,
    ) => (DeviceReadiness | null)!DeviceError
    readonly agentReadinessIfSupported: (
      hostId?: DeviceHostId,
    ) => (DeviceAgentReadiness | null)!DeviceError
    readonly currentReadiness: (hostId?: DeviceHostId) => (DeviceReadiness | null)!!
    readonly sessionsForThread: (threadId: ThreadId) => ReadonlyArray<DeviceSession>!!
  }
>()("t3/device/DeviceService") {}

interface ServiceState {
  readonly state: DeviceServiceState
}

export const makeWithHosts = effect (
  hosts: ReadonlyMap<DeviceHostId, DeviceHost.DeviceHost["Service"]>,
  testHost: ((config: SshDeviceHostConfig) => DeviceHostSummary!DeviceError) | undefined = (host) =>
    Effect.fail(
      new DeviceHostUnavailableError({
        hostId: host.id,
        hostLabel: host.label,
        reason: "SSH probing is unavailable in this device service.",
      }),
    ),
  configureAgent:
    | ((hostId: DeviceHostId, endpoint: DeviceHost.AgentDaemonEndpoint, deviceId?: DeviceId) => string!DeviceError)
    | undefined = (hostId) =>
      Effect.fail(
        new DeviceHostUnavailableError({
          hostId,
          reason: "Agent configuration is unavailable in this device service.",
        }),
      ),
  installTool?: ((tool: "hub" | "agent") => unknown!DeviceError) | undefined,
) =>
  try withSpan(
    effect {
      const settings = try ServerSettings.ServerSettingsService
      const crypto = try Crypto.Crypto
      const lifecycleLock = try Semaphore.make(1)
      const readDeviceSettings = settings.getSettings
        |> Effect.map(%, (value) => ({
          enabled: value.enableDeviceSupport,
          agentAccessEnabled: value.enableAgentDeviceAccess,
          onboardingCompleted: value.deviceOnboardingCompleted,
        }))
        |> Effect.mapError(
          %,
          (cause) => new DeviceOperationError({ operation: "settings", reason: "settings_failed", cause }),
        )
      const initialSettings = try readDeviceSettings

      const statePubSub = try PubSub.unbounded<DeviceServiceState>()
      const initialHosts = try Effect.forEach(hosts.values(), (host) => host.summary)
      let publishedHosts = new Map(hosts)
      const stateRef = try SynchronizedRef.make<ServiceState>({
        state: {
          supportsHostRetry: true,
          supportsToolUpdate: installTool !== undefined,
          supportsToolInspection: true,
          supportsEasHosts: true,
          hosts: initialHosts,
          hostStatus: initialSettings.enabled ? "idle" : "disabled",
          hostStatuses: {},
          devices: [],
          sessions: [],
          onboardingCompleted: initialSettings.onboardingCompleted,
          agentAccessEnabled: initialSettings.agentAccessEnabled,
          hubBasePath: DEVICE_HUB_ROUTE_PREFIX,
          revision: 0,
        },
      })

      const publish = (update: (state: DeviceServiceState) => DeviceServiceState) =>
        SynchronizedRef.updateAndGetEffect(stateRef, ({ state }) => {
          const next = { ...update(state), revision: state.revision + 1 }
          return PubSub.publish(statePubSub, next) |> Effect.as(%, { state: next })
        }) |> Effect.map(%, ({ state }) => state)

      const resolveHost = effect (
        hostId: string | undefined,
      ) =>
        try withSpan(
          effect {
            const id = hostId ?? LOCAL_DEVICE_HOST_ID
            const host = hosts.get(id)
            if (!host) {
              throw new DeviceHostUnavailableError({ hostId: id, reason: "Unknown host." })
            }
            return host
          },
          "DeviceService.resolveHost",
        )

      const setHostStatus = effect (
        hostId: DeviceHostId,
        status: DeviceServiceState["hostStatuses"][string],
      ) =>
        try (!hosts.has(hostId)
          ? (SynchronizedRef.get(stateRef) |> Effect.map(%, ({ state }) => state))
          : publish((state) => ({
            ...state,
            ...(hostId === LOCAL_DEVICE_HOST_ID
              ? { hostStatus: status.status, hostStatusDetail: status.detail }
              : {}),
            hostStatuses: {
              ...state.hostStatuses,
              [hostId]: {
                ...(state.hostStatuses[hostId]?.androidDiscoveryIncomplete
                  ? { androidDiscoveryIncomplete: true }
                  : {}),
                ...status,
              },
            },
          })))

      const readiness: DeviceService["Service"]["readiness"] = effect (hostId) =>
        try withSpan(
          effect {
            const host = try resolveHost(hostId)
            if (!(try readDeviceSettings).enabled) {
              throw new DeviceHostUnavailableError({
                hostId: host.id,
                hostLabel: host.label,
                reason:
                  "Device support is off. Enable it in the Device panel before installing or starting device tools.",
              })
            }
            const ready = (host
              .ensureReady((status, detail) => setHostStatus(host.id, { status, detail }) |> Effect.asVoid(%))
              |> Effect.tapError(%, (error) =>
                setHostStatus(host.id, {
                  status: "failed",
                  detail: error._tag === "DeviceHostError" && error.step === "probe"
                    ? sshProbeFailureMessage(error)
                    : error.message,
                }))) catch effect (error) => {
                throw new DeviceHostUnavailableError({
                  hostId: host.id,
                  hostLabel: host.label,
                  reason: error._tag === "NodeRuntimeUnavailableError"
                    ? nodeRuntimeUnavailableMessage("Local device support")
                    : error.step === "probe"
                    ? sshProbeFailureMessage(error)
                    : `Device support failed during ${error.step}.`,
                  cause: error,
                })
              }
            if (hosts.get(host.id) !== host) {
              throw new DeviceHostUnavailableError({
                hostId: host.id,
                hostLabel: host.label,
                reason: "Host configuration changed. Retry the operation.",
              })
            }
            const { state } = try SynchronizedRef.get(stateRef)
            if (state.hostStatuses[host.id]?.status !== "ready") {
              try setHostStatus(host.id, { status: "ready" })
            }
            return { hostId: host.id, ...ready }
          } |> lifecycleLock.withPermit(%),
          "DeviceService.readiness",
        )

      const readinessIfSupported: DeviceService["Service"]["readinessIfSupported"] = effect (
        hostId,
      ): (DeviceReadiness | null)!(import("@t3tools/contracts").DeviceActionUnavailableError | import("@t3tools/contracts").DeviceBootError | DeviceHostUnavailableError | DeviceNotFoundError | DeviceOperationError | DevicePlatformUnavailableError)!never =>
        try withSpan(
          (effect (): (DeviceReadiness | null)!(import("@t3tools/contracts").DeviceActionUnavailableError | import("@t3tools/contracts").DeviceBootError | DeviceHostUnavailableError | DeviceNotFoundError | DeviceOperationError | DevicePlatformUnavailableError)!never => {
            if (!(try readDeviceSettings).enabled) return null
            const host = try resolveHost(hostId)
            const summary = try host.summary
            if (summary.kind === "local" && !summary.platforms.some((platform) => platform.available)) {
              return null
            }
            return try readiness(host.id)
          })(),
          "DeviceService.readinessIfSupported",
        )

      const agentReadinessIfSupported: DeviceService["Service"]["agentReadinessIfSupported"] = effect (hostId) =>
        try withSpan(
          effect {
            const deviceSettings = try readDeviceSettings
            if (!deviceSettings.enabled || !deviceSettings.agentAccessEnabled) return null
            const host = try resolveHost(hostId)
            const summary = try host.summary
            if (summary.kind === "local" && !summary.platforms.some((platform) => platform.available)) {
              return null
            }
            const ready = (host
              .ensureAgentReady((phase, detail) =>
                setHostStatus(host.id, { status: phase, detail }) |> Effect.asVoid(%)
              )
              |> Effect.tapError(%, (error) =>
                setHostStatus(host.id, {
                  status: "failed",
                  detail: error._tag === "DeviceHostError" && error.step === "probe"
                    ? sshProbeFailureMessage(error)
                    : error.message,
                }))) catch effect (error) => {
                throw new DeviceHostUnavailableError({
                  hostId: host.id,
                  hostLabel: host.label,
                  reason: error._tag === "NodeRuntimeUnavailableError"
                    ? nodeRuntimeUnavailableMessage("Local device support")
                    : error._tag === "DeviceHostTimeoutError"
                    ? `Agent tools did not start within ${error.timeoutMs} ms.`
                    : error._tag === "AgentDeviceStartError"
                    ? error.message
                    : error.step === "probe"
                    ? sshProbeFailureMessage(error)
                    : `Device support failed during ${error.step}.`,
                  cause: error,
                })
              }
            const hostSummaries = try Effect.forEach(hosts.values(), (candidate) => candidate.summary)
            try publish((state) => ({ ...state, hosts: hostSummaries }))
            try setHostStatus(host.id, { status: "ready" })
            return { hostId: host.id, ...ready }
          } |> lifecycleLock.withPermit(%),
          "DeviceService.agentReadinessIfSupported",
        )

      const currentReadiness: DeviceService["Service"]["currentReadiness"] = (hostId) =>
        resolveHost(hostId)
        |> Effect.flatMap(
          %,
          (host) => host.current |> Effect.map(%, (ready) => (ready ? { hostId: host.id, ...ready } : null)),
        )
        |> Effect.orElseSucceed(%, () => null)

      const fetchDevices = effect (ready: DeviceReadiness) =>
        try withSpan(
          effect {
            const { devices, detail, androidDiscoveryIncomplete } = try ready.devices.list
            return {
              devices: devices.map((device): DeviceSummary => ({ ...device, hostId: ready.hostId })),
              detail,
              androidDiscoveryIncomplete,
            }
          },
          "DeviceService.fetchDevices",
        )

      const refresh = effect (ready: DeviceReadiness) =>
        try withSpan(
          effect {
            const host = hosts.get(ready.hostId)
            // A session opened while the listing ran is on a device the listing could
            // not have seen yet; only sessions from before it can be pruned by it.
            const sessionKey = (session: DeviceSession) =>
              `${session.hostId}\u0000${session.deviceId}\u0000${session.threadId}\u0000${session.openedAt}`
            const before = new Set((try SynchronizedRef.get(stateRef)).state.sessions.map(sessionKey))
            const { devices, detail, androidDiscoveryIncomplete } = try fetchDevices(ready)
            const hostSummaries = try Effect.forEach(hosts.values(), (host) => host.summary)
            return try lifecycleLock.withPermit(
              effect {
                if (!(try readDeviceSettings).enabled || !host || hosts.get(ready.hostId) !== host) {
                  return (try SynchronizedRef.get(stateRef)).state
                }
                return try publish((state) => ({
                  ...state,
                  hosts: hostSummaries,
                  ...(ready.hostId === LOCAL_DEVICE_HOST_ID ? { hostStatusDetail: detail } : {}),
                  devices: [
                    ...state.devices.filter((device) => device.hostId !== ready.hostId),
                    ...devices,
                  ],
                  // A host that ends devices itself (EAS stops sessions at their limits)
                  // leaves sessions on devices it no longer lists with nothing to stream.
                  // Other hosts can miss a device for one listing, so theirs stay.
                  sessions: ready.devices.endsDevices
                    ? state.sessions.filter(
                      (session) =>
                        session.hostId !== ready.hostId
                        || !before.has(sessionKey(session))
                        || devices.some((device) => device.id === session.deviceId),
                    )
                    : state.sessions,
                  hostStatuses: {
                    ...state.hostStatuses,
                    [ready.hostId]: {
                      status: "ready",
                      ...(detail ? { detail } : {}),
                      ...(androidDiscoveryIncomplete ? { androidDiscoveryIncomplete } : {}),
                    },
                  },
                }))
              },
            )
          },
          "DeviceService.refresh",
        )

      const list: DeviceService["Service"]["list"] = effect {
        if (!(try readDeviceSettings).enabled) return (try SynchronizedRef.get(stateRef)).state
        try Effect.forEach(
          hosts.values(),
          (host) =>
            do {
              const catchProgram = effect {
                const ready = try readinessIfSupported(host.id)
                if (ready) try refresh(ready)
              }
              effect {
                return catchProgram catch effect (error) =>
                  try setHostStatus(host.id, {
                    status: "failed",
                    detail: error._tag === "DeviceHostUnavailableError" ? error.reason : error.message,
                  })
              }
            },
          { concurrency: 4 },
        )
        return (try SynchronizedRef.get(stateRef)).state
      } |> withSpan(%, "DeviceService.list")

      const inspect = effect {
        try Effect.forEach(
          hosts.values(),
          effect (host) => {
            const result = try ((host.inspect ?? host.summary) |> Effect.result(%))
            if (hosts.get(host.id) !== host) return
            if (result._tag === "Failure") {
              try publish((state) => ({
                ...state,
                hosts: state.hosts.map((value) =>
                  value.id === host.id
                    ? {
                      ...value,
                      toolInspectionError:
                        "Cannot check versions. Reconnect the host and check again. Installed tools have not been changed.",
                    }
                    : value
                ),
              }))
              return
            }
            try publish((state) => ({
              ...state,
              hosts: state.hosts.map((value) => (value.id === host.id ? result.success : value)),
            }))
          },
          { concurrency: 4 },
        )
        return (try SynchronizedRef.get(stateRef)).state
      }

      const retryHost: DeviceService["Service"]["retryHost"] = effect (
        hostId,
      ): { readonly supportsHostRetry?: boolean | undefined; readonly supportsToolUpdate?: boolean | undefined; readonly supportsToolInspection?: boolean | undefined; readonly supportsEasHosts?: boolean | undefined; readonly hostStatus: "disabled" | "failed" | "idle" | "installing" | "ready" | "starting"; readonly hostStatusDetail?: string | undefined; readonly hostStatuses: { readonly [x: string]: { readonly status: "disabled" | "failed" | "idle" | "installing" | "ready" | "starting"; readonly detail?: string | undefined; readonly androidDiscoveryIncomplete?: boolean | undefined; }; }; readonly devices: readonly { readonly hostId: string; readonly id: string; readonly platform: "android" | "ios"; readonly name: string; readonly version: string; readonly booted: boolean; readonly physical: boolean; }[]; readonly sessions: readonly { readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; readonly hostId: string; readonly deviceId: string; readonly platform: "android" | "ios"; readonly openedAt: string; }[]; readonly bootingDevices?: readonly { readonly hostId: string; readonly id: string; readonly platform: "android" | "ios"; readonly name: string; readonly version: string; readonly booted: boolean; readonly physical: boolean; readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; }[] | undefined; readonly onboardingCompleted: boolean; readonly agentAccessEnabled: boolean; readonly hubBasePath: string; readonly revision: number; readonly hosts: readonly ({ readonly id: string; readonly label: string; readonly platforms: readonly { readonly platform: "android" | "ios"; readonly available: boolean; readonly reason?: string | undefined; }[]; readonly tools?: { readonly hub: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; readonly agent: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; } | undefined; readonly toolInspectionError?: string | undefined; readonly hubInstalled: boolean; readonly agentDeviceInstalled: boolean; readonly kind: "local" | "ssh"; } | { readonly id: string; readonly label: string; readonly platforms: readonly { readonly platform: "android" | "ios"; readonly available: boolean; readonly reason?: string | undefined; }[]; readonly tools?: { readonly hub: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; readonly agent: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; } | undefined; readonly toolInspectionError?: string | undefined; readonly hubInstalled: boolean; readonly agentDeviceInstalled: boolean; readonly kind: "eas"; })[]; }!(import("@t3tools/contracts").DeviceActionUnavailableError | import("@t3tools/contracts").DeviceBootError | DeviceHostUnavailableError | DeviceNotFoundError | DeviceOperationError | DevicePlatformUnavailableError)!never =>
        try withSpan(
          (effect (): { readonly supportsHostRetry?: boolean | undefined; readonly supportsToolUpdate?: boolean | undefined; readonly supportsToolInspection?: boolean | undefined; readonly supportsEasHosts?: boolean | undefined; readonly hostStatus: "disabled" | "failed" | "idle" | "installing" | "ready" | "starting"; readonly hostStatusDetail?: string | undefined; readonly hostStatuses: { readonly [x: string]: { readonly status: "disabled" | "failed" | "idle" | "installing" | "ready" | "starting"; readonly detail?: string | undefined; readonly androidDiscoveryIncomplete?: boolean | undefined; }; }; readonly devices: readonly { readonly hostId: string; readonly id: string; readonly platform: "android" | "ios"; readonly name: string; readonly version: string; readonly booted: boolean; readonly physical: boolean; }[]; readonly sessions: readonly { readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; readonly hostId: string; readonly deviceId: string; readonly platform: "android" | "ios"; readonly openedAt: string; }[]; readonly bootingDevices?: readonly { readonly hostId: string; readonly id: string; readonly platform: "android" | "ios"; readonly name: string; readonly version: string; readonly booted: boolean; readonly physical: boolean; readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; }[] | undefined; readonly onboardingCompleted: boolean; readonly agentAccessEnabled: boolean; readonly hubBasePath: string; readonly revision: number; readonly hosts: readonly ({ readonly id: string; readonly label: string; readonly platforms: readonly { readonly platform: "android" | "ios"; readonly available: boolean; readonly reason?: string | undefined; }[]; readonly tools?: { readonly hub: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; readonly agent: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; } | undefined; readonly toolInspectionError?: string | undefined; readonly hubInstalled: boolean; readonly agentDeviceInstalled: boolean; readonly kind: "local" | "ssh"; } | { readonly id: string; readonly label: string; readonly platforms: readonly { readonly platform: "android" | "ios"; readonly available: boolean; readonly reason?: string | undefined; }[]; readonly tools?: { readonly hub: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; readonly agent: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; } | undefined; readonly toolInspectionError?: string | undefined; readonly hubInstalled: boolean; readonly agentDeviceInstalled: boolean; readonly kind: "eas"; })[]; }!(import("@t3tools/contracts").DeviceActionUnavailableError | import("@t3tools/contracts").DeviceBootError | DeviceHostUnavailableError | DeviceNotFoundError | DeviceOperationError | DevicePlatformUnavailableError)!never => {
            try resolveHost(hostId)
            if (!(try readDeviceSettings).enabled) return (try SynchronizedRef.get(stateRef)).state
            ;(effect {
              const ready = (try agentReadinessIfSupported(hostId)) ?? (try readinessIfSupported(hostId))
              if (ready) try refresh(ready)
            }) catch effect (error) =>
              try setHostStatus(hostId, {
                status: "failed",
                detail: error._tag === "DeviceHostUnavailableError" ? error.reason : error.message,
              })
            return (try SynchronizedRef.get(stateRef)).state
          })(),
          "DeviceService.retryHost",
        )

      const configure: DeviceService["Service"]["configure"] = effect (
        input,
      ): { readonly supportsHostRetry?: boolean | undefined; readonly supportsToolUpdate?: boolean | undefined; readonly supportsToolInspection?: boolean | undefined; readonly supportsEasHosts?: boolean | undefined; readonly hostStatus: "disabled" | "failed" | "idle" | "installing" | "ready" | "starting"; readonly hostStatusDetail?: string | undefined; readonly hostStatuses: { readonly [x: string]: { readonly status: "disabled" | "failed" | "idle" | "installing" | "ready" | "starting"; readonly detail?: string | undefined; readonly androidDiscoveryIncomplete?: boolean | undefined; }; }; readonly devices: readonly { readonly hostId: string; readonly id: string; readonly platform: "android" | "ios"; readonly name: string; readonly version: string; readonly booted: boolean; readonly physical: boolean; }[]; readonly sessions: readonly { readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; readonly hostId: string; readonly deviceId: string; readonly platform: "android" | "ios"; readonly openedAt: string; }[]; readonly bootingDevices?: readonly { readonly hostId: string; readonly id: string; readonly platform: "android" | "ios"; readonly name: string; readonly version: string; readonly booted: boolean; readonly physical: boolean; readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; }[] | undefined; readonly onboardingCompleted: boolean; readonly agentAccessEnabled: boolean; readonly hubBasePath: string; readonly revision: number; readonly hosts: readonly ({ readonly id: string; readonly label: string; readonly platforms: readonly { readonly platform: "android" | "ios"; readonly available: boolean; readonly reason?: string | undefined; }[]; readonly tools?: { readonly hub: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; readonly agent: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; } | undefined; readonly toolInspectionError?: string | undefined; readonly hubInstalled: boolean; readonly agentDeviceInstalled: boolean; readonly kind: "local" | "ssh"; } | { readonly id: string; readonly label: string; readonly platforms: readonly { readonly platform: "android" | "ios"; readonly available: boolean; readonly reason?: string | undefined; }[]; readonly tools?: { readonly hub: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; readonly agent: { readonly requiredVersion: string; readonly installedVersions: readonly string[]; readonly runningVersion: string | null; }; } | undefined; readonly toolInspectionError?: string | undefined; readonly hubInstalled: boolean; readonly agentDeviceInstalled: boolean; readonly kind: "eas"; })[]; }!(import("@t3tools/contracts").DeviceActionUnavailableError | import("@t3tools/contracts").DeviceBootError | DeviceHostUnavailableError | DeviceNotFoundError | DeviceOperationError | DevicePlatformUnavailableError)!never =>
        try withSpan(
