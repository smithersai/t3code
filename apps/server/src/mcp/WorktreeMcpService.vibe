import {
  CommandId,
  MessageId,
  type ProjectId,
  WorktreeMcpFailure,
  type WorktreeMcpContinuationStatus,
  type WorktreeMcpHandoffInput,
  type WorktreeMcpHandoffResult,
  type WorktreeMcpSetupScriptStatus,
  type WorktreeMcpStatusResult,
} from "@t3tools/contracts";
import * as Context from "effect/Context";
import * as Crypto from "@t3tools/shared/Crypto";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";

import * as GitWorkflowService from "../git/GitWorkflowService.vibe";
import * as ThreadManagementService from "../orchestration-v2/ThreadManagementService.ts";
import * as ProjectService from "../project/ProjectService.ts";
import * as ProjectSetupScriptRunner from "../project/ProjectSetupScriptRunner.ts";
import * as ServerSettings from "../serverSettings.ts";
import * as VcsStatusBroadcaster from "../vcs/VcsStatusBroadcaster.ts";
import type { McpInvocationScope, McpThreadInvocationScope } from "./McpInvocationContext.vibe";

export service WorktreeMcpService: {
    readonly handoff: (
      scope: McpInvocationScope,
      input: WorktreeMcpHandoffInput,
    ) => WorktreeMcpHandoffResult!WorktreeMcpFailure;
    readonly status: (
      scope: McpInvocationScope,
    ) => WorktreeMcpStatusResult!WorktreeMcpFailure;
  } {
  static readonly key = "t3/mcp/WorktreeMcpService"
}

function failure(code: WorktreeMcpFailure["code"], message: string): WorktreeMcpFailure {
  return new WorktreeMcpFailure({ code, message });
}

function errorMessage(error: unknown): string {
  if (error instanceof Error) return error.message;
  if (typeof error === "object" && error !== null && "message" in error) {
    return String((error as { message: unknown }).message);
  }
  return String(error);
}

const asOperationFailed = (prefix: string) =>
  mapError((error: unknown) =>
    failure("operation_failed", `${prefix}: ${errorMessage(error)}`),
  );

const make = effect {
  const crypto = try Crypto.Crypto;
  const threadManagement = try ThreadManagementService.ThreadManagementService;
  const projects = try ProjectService.ProjectService;
  const serverSettings = try ServerSettings.ServerSettingsService;
  const gitWorkflow = try GitWorkflowService.GitWorkflowService;
  const setupScriptRunner = try ProjectSetupScriptRunner.ProjectSetupScriptRunner;
  const vcsStatusBroadcaster = try VcsStatusBroadcaster.VcsStatusBroadcaster;

  // Serialize handoffs per thread to avoid creating two worktrees and orphaning one.
  const handoffThreadsInFlight = new Set<string>();

  const requireThreadScope = (scope: McpInvocationScope) =>
    scope.thread === undefined
      ? fail(
          failure(
            "thread_credential_required",
            "Worktree handoff and status act as the calling T3 thread, so they need an agent running inside T3 Code.",
          ),
        )
      : succeed(scope as McpThreadInvocationScope);

  const requireCapability = (scope: McpInvocationScope) =>
    scope.capabilities.has("worktree")
      ? Effect.void
      : fail(
          failure("capability_denied", "This MCP credential does not grant worktree capabilities."),
        );

  const loadThread = (scope: McpThreadInvocationScope) =>
    threadManagement.getThreadRecords(scope.thread.threadId, [])
      |> mapError(%, (error) =>
        error._tag === "OrchestratorProjectionError"
          ? failure("thread_not_found", `Thread '${scope.thread.threadId}' was not found.`)
          : failure(
              "operation_failed",
              `Unable to read thread ${scope.thread.threadId}: ${errorMessage(error)}`,
            ),
      )
      |> filterOrFail(
        %, (projection) => projection.thread.deletedAt === null,
        () => failure("thread_not_found", `Thread '${scope.thread.threadId}' was not found.`),
      );

  const loadProject = (scope: McpThreadInvocationScope, projectId: ProjectId) =>
    projects.getById(projectId)
      |> asOperationFailed(`Unable to read project ${projectId}`)(%)
      |> flatMap(
        %, Option.match({
          onNone: () =>
            fail(
              failure(
                "project_not_found",
                `Project '${projectId}' was not found for thread '${scope.thread.threadId}'.`,
              ),
            ),
          onSome: (value) => succeed(value),
        }),
      );

  const readDefaultStartFromOrigin = effect { return try (serverSettings.getSettings
    |> map(%, (settings) => settings.newWorktreesStartFromOrigin)
    |> asOperationFailed("Unable to read server settings")(%)) };

  const handoffIds = (scope: McpThreadInvocationScope) =>
    crypto.randomUUIDv4()
      |> map(%, (uuid) => {
        const part = (kind: string, operation: string) =>
          [kind, "mcp", encodeURIComponent(scope.thread.providerSessionId), operation, uuid].join(
            ":",
          );
        return {
          commandId: CommandId.make(part("command", "worktree-handoff")),
          continuationCommandId: CommandId.make(part("command", "worktree-continuation")),
          continuationMessageId: MessageId.make(part("message", "worktree-continuation")),
        };
      })
      |> orDie(%);

  const performHandoff = effect (
    scope: McpThreadInvocationScope,
    input: { readonly branch: string; readonly baseRef?: string | undefined; readonly startFromOrigin?: boolean | undefined; readonly runSetupScript?: boolean | undefined; readonly continuationPrompt?: string | undefined; },
  ) => try withSpan(effect {
    const alreadyInWorktree = (worktreePath: string) =>
      failure(
        "already_in_worktree",
        `Thread '${scope.thread.threadId}' is already attached to worktree '${worktreePath}'.`,
      );

    const projection = try loadThread(scope);
    if (projection.thread.worktreePath !== null) {
      throw alreadyInWorktree(projection.thread.worktreePath);
    }
    if (projection.thread.archivedAt !== null) {
      throw failure(
        "invalid_request",
        `Thread '${scope.thread.threadId}' is archived and cannot be handed off to a worktree.`,
      );
    }

    const project = try loadProject(scope, projection.thread.projectId);
    const projectCwd = project.workspaceRoot;

    const localStatus = try (gitWorkflow
      .localStatus({ cwd: projectCwd })|> asOperationFailed("Unable to read git status")(%));
    if (!localStatus.isRepo) {
      throw failure(
        "invalid_request",
        `Project workspace '${projectCwd}' is not a git repository.`,
      );
    }

    const localBranchNames = try (gitWorkflow
      .listLocalBranchNames(projectCwd)|> asOperationFailed("Unable to list branches")(%));
    if (localBranchNames.includes(input.branch)) {
      const existingRef = (gitWorkflow
        .listRefs({ cwd: projectCwd, query: input.branch, refKind: "local" })
          |> map(%, (result) =>
            result.refs.find((ref) => ref.name === input.branch && ref.isRemote !== true),
          )) catch () => undefined;
      const checkoutPath = existingRef?.worktreePath ?? null;
      throw failure(
        "invalid_request",
        `Branch '${input.branch}' already exists${
          checkoutPath === null ? "" : ` and is checked out at '${checkoutPath}'`
        }. Choose a different branch name, or delete the existing branch${
          checkoutPath === null ? "" : " and its worktree"
        } first.`,
      );
    }

    let baseRef = input.baseRef;
    if (baseRef === undefined) {
      if (localStatus.refName === null) {
        throw failure(
          "invalid_request",
          "Could not determine the current branch of the project workspace (detached HEAD?). Pass baseRef explicitly.",
        );
      }
      baseRef = localStatus.refName;
    }

    const startFromOrigin = input.startFromOrigin ?? (try readDefaultStartFromOrigin);

    let worktreeBaseRef = baseRef;
    let baseRefName = baseRef;
    let startedFromOrigin = false;
    if (startFromOrigin) {
      const resolvedRemoteBase = try (gitWorkflow
        .fetchWorktreeBaseCommit({ cwd: projectCwd, refName: baseRef })|> asOperationFailed(`Unable to fetch the remote base of '${baseRef}'`)(%));
      if (resolvedRemoteBase !== null) {
        worktreeBaseRef = resolvedRemoteBase.commitSha;
        baseRefName = `refs/remotes/${resolvedRemoteBase.remoteRefName}`;
        startedFromOrigin = true;
      }
    }

    const ids = try handoffIds(scope);

    // Mask interruption after worktree creation through setup; binding can detach and interrupt the caller.
    return try uninterruptibleMask(effect (restore) => {
      const worktree = try restore(
        gitWorkflow
          .createWorktree({
            cwd: projectCwd,
            refName: worktreeBaseRef,
            newRefName: input.branch,
            baseRefName,
            path: null,
          })|> asOperationFailed("Unable to create the worktree")(%),
      );
      const worktreePath = worktree.worktree.path;

      const reportFailed = (logMessage: string) =>
        catchCause((cause: Cause<unknown>) => {
          const detail = errorMessage(Cause.squash(cause));
          return logWarning(logMessage, {
            threadId: scope.thread.threadId,
            worktreePath,
            detail,
          }) |> as(%, { status: "failed", detail } as const);
        });

      const removeCreatedWorktree = effect { return try (effect { return try (gitWorkflow.removeWorktree({ cwd: projectCwd, path: worktreePath, force: true })
          |> andThen(
            %, effect { return try gitWorkflow.deleteLocalBranch({
                cwd: projectCwd,
                refName: worktree.worktree.refName,
                force: true,
              }) },
          )) } |> ignoreCause({ log: true })(%)) };

      const recheckAndBind = effect { return try ((effect {
        // A concurrent UI binding may have landed during git work; do not orphan a second worktree.
        const recheck = try loadThread(scope);
        if (recheck.thread.worktreePath !== null) {
          throw alreadyInWorktree(recheck.thread.worktreePath);
        }
        if (recheck.thread.archivedAt !== null) {
          throw failure(
            "invalid_request",
            `Thread '${scope.thread.threadId}' was archived while the worktree was being created; the handoff was rolled back.`,
          );
        }
        try (threadManagement
          .dispatch({
            type: "thread.metadata.update",
            commandId: ids.commandId,
            threadId: scope.thread.threadId,
            branch: worktree.worktree.refName,
            worktreePath,
            expectedWorktreePath: null,
          })
            |> catchCause(%, (cause) =>
              Cause.hasInterruptsOnly(cause)
                ? failCause(cause as Cause<never>)
                : fail(
                    failure(
                      "operation_failed",
                      `Unable to re-point the thread at the worktree: ${errorMessage(Cause.squash(cause))}`,
                    ),
                  ),
            ));
      })
        // Do not remove on interruption alone; the thread binding may already have committed.
        |> onError(%, (cause) =>
          Cause.hasInterruptsOnly(cause) ? Effect.void : removeCreatedWorktree,
        )) };

      // Queue continuation immediately after binding; detachment terminates the caller, so relaunch needs a durable message.
      const queueContinuation: WorktreeMcpContinuationStatus!WorktreeMcpFailure =
        effect { return try (input.continuationPrompt === undefined
            ? succeed<WorktreeMcpContinuationStatus>({ status: "skipped" })
            : (threadManagement
                .sendToThread({
                  projectId: projection.thread.projectId,
                  commandId: ids.continuationCommandId,
                  threadId: scope.thread.threadId,
                  messageId: ids.continuationMessageId,
                  text: input.continuationPrompt,
                  attachments: [],
                  mode: "queue",
                  createdBy: "agent",
                  creationSource: "mcp",
                })
                  |> map(%, (sendResult): WorktreeMcpContinuationStatus => ({
                    status: "scheduled",
                    delivery: sendResult.delivery,
                  }))
                  |> reportFailed("worktree handoff continuation failed to queue")(%))) };

      const continuation = try (recheckAndBind |> andThen(%, queueContinuation));

      try (vcsStatusBroadcaster
        .refreshStatus(worktreePath)|> ignoreCause({ log: true })(%) |> forkDetach(%));

      let setupScript: WorktreeMcpSetupScriptStatus = { status: "skipped" };
      if (input.runSetupScript ?? true) {
        setupScript = try (setupScriptRunner
          .runForThread({
            threadId: scope.thread.threadId,
            projectId: projection.thread.projectId,
            projectCwd,
            worktreePath,
            project: {
              id: project.id,
              workspaceRoot: project.workspaceRoot,
              scripts: project.scripts,
            },
          })
            |> map(%, (result): WorktreeMcpSetupScriptStatus =>
              result.status === "started"
                ? {
                    status: "started",
                    scriptName: result.scriptName,
                    terminalId: result.terminalId,
                  }
                : result.status === "skipped-for-link"
                  ? { status: "skipped" }
                  : { status: "no-script" },
            )
            |> reportFailed("worktree handoff setup script failed")(%));
      }

      const result: WorktreeMcpHandoffResult = {
        worktreePath,
        branch: worktree.worktree.refName,
        baseRef,
        startedFromOrigin,
        setupScript,
        continuation,
        note:
          continuation.status === "scheduled"
            ? "Handoff recorded. Changing the workspace detaches this provider session, so the current turn ends shortly after this call; the queued continuation prompt then starts the next turn inside the worktree with the conversation preserved. The worktree is not removed automatically when the thread is deleted."
            : "Handoff recorded. Changing the workspace detaches this provider session, so the current turn ends shortly after this call; the conversation continues inside the worktree when the thread receives its next message. Pass continuationPrompt to resume automatically. The worktree is not removed automatically when the thread is deleted.",
      };
      return result;
    },
    );
  }, "WorktreeMcpService.performHandoff");

  const handoff: WorktreeMcpService["Service"]["handoff"] = effect (callerScope, input) => try withSpan(effect {
    try requireCapability(callerScope);
    const scope = try requireThreadScope(callerScope);
    // Acquire and register cleanup atomically so cancellation cannot strand the guard until restart.
    return try uninterruptibleMask((restore) =>
      suspend(() => {
        if (handoffThreadsInFlight.has(scope.thread.threadId)) {
          return fail(
            failure(
              "handoff_in_progress",
              `A worktree handoff is already in progress for thread '${scope.thread.threadId}'.`,
            ),
          );
        }
        handoffThreadsInFlight.add(scope.thread.threadId);
        return restore(performHandoff(scope, input))
          |> ensuring(
            %, effect { return handoffThreadsInFlight.delete(scope.thread.threadId) },
          );
      }),
    );
  }, "WorktreeMcpService.handoff");

  const status: WorktreeMcpService["Service"]["status"] = effect (callerScope) => try withSpan(effect {
    try requireCapability(callerScope);
    const scope = try requireThreadScope(callerScope);
    const projection = try loadThread(scope);
    const project = try loadProject(scope, projection.thread.projectId);

    const defaultStartFromOrigin = try readDefaultStartFromOrigin;

    const result: WorktreeMcpStatusResult = {
      attached: projection.thread.worktreePath !== null,
      worktreePath: projection.thread.worktreePath,
      branch: projection.thread.branch,
      projectWorkspaceRoot: project.workspaceRoot,
      defaultStartFromOrigin,
    };
    return result;
  }, "WorktreeMcpService.status");

  return WorktreeMcpService.of({ handoff, status });
};

export const layer: Layer.Layer<
  WorktreeMcpService,
  never,
  | Crypto.Crypto
  | ThreadManagementService.ThreadManagementService
  | ProjectService.ProjectService
  | ServerSettings.ServerSettingsService
  | GitWorkflowService.GitWorkflowService
  | ProjectSetupScriptRunner.ProjectSetupScriptRunner
  | VcsStatusBroadcaster.VcsStatusBroadcaster
> = Layer.effect(WorktreeMcpService, make);
