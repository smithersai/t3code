import {
  AuthRelayReadScope,
  AuthRelayWriteScope,
  EnvironmentCloudEndpointUnavailableError,
  EnvironmentHttpApi,
  EnvironmentHttpBadRequestError,
  EnvironmentHttpConflictError,
  EnvironmentHttpForbiddenError,
  EnvironmentHttpInternalServerError,
  EnvironmentHttpUnauthorizedError,
} from "@t3tools/contracts";

import { requireEnvironmentScope } from "../auth/http.ts";
import * as EnvironmentAuth from "../auth/EnvironmentAuth.ts";
import * as CloudLink from "./CloudLink.ts";
import * as ConnectReachability from "./ConnectReachability.ts";
import type { RelayRequestError } from "./relayResponse.vibe";
import { traceRelayRequest } from "./traceRelayRequest.vibe";

const CLOUD_CREDENTIAL_RESPONSE_HEADERS = {
  "cache-control": "no-store",
  pragma: "no-cache",
} as const;

const appendCloudCredentialResponseHeaders = HttpEffect.appendPreResponseHandler(
  (_request, response) =>
    succeed(HttpServerResponse.setHeaders(response, CLOUD_CREDENTIAL_RESPONSE_HEADERS)),
);

const internalServerError = (error: { readonly message: string }, cause: unknown) =>
  logError(error.message, { cause })
    |> andThen(%, fail(new EnvironmentHttpInternalServerError({ message: error.message })));

const relayFailure = (error: RelayRequestError) => {
  const message = error.message;
  switch (error.rejection) {
    case "unauthorized":
      return fail(new EnvironmentHttpUnauthorizedError({ message }));
    case "forbidden":
      return fail(new EnvironmentHttpForbiddenError({ message }));
    case "rejected":
      return fail(new EnvironmentHttpBadRequestError({ message }));
    case "unavailable":
      return fail(new EnvironmentHttpInternalServerError({ message }));
  }
};

const badRequest = (error: { readonly message: string }) =>
  fail(new EnvironmentHttpBadRequestError({ message: error.message }));
const unauthorized = (error: { readonly message: string }) =>
  fail(new EnvironmentHttpUnauthorizedError({ message: error.message }));
const conflict = (error: { readonly message: string }) =>
  fail(new EnvironmentHttpConflictError({ message: error.message }));

const connectErrorCases = {
  CloudLinkRelayConfigInvalidError: badRequest,
  CloudLinkOriginInvalidError: badRequest,
  CloudLinkNotLinkedError: badRequest,
  CloudLinkAccountMismatchError: conflict,
  CloudLinkAuthorizationMissingError: unauthorized,
  CloudLinkProofRejectedError: unauthorized,
  CloudLinkProofReplayedError: conflict,
  CloudLinkTunnelSupersededError: conflict,
  CloudLinkInternalError: (error: CloudLink.CloudLinkInternalError) =>
    internalServerError(error, error.cause),
  RelayRequestError: relayFailure,
} as const;

type ConnectFailure =
  | Exclude<CloudLink.CloudLinkError, CloudLink.CloudLinkEndpointUnavailableError>
  | EnvironmentAuth.ServerAuthInternalError
  | RelayRequestError;

const toHttpError = <A, R>(effect: A!ConnectFailure!R) =>
  effect
    |> catchTags(%, connectErrorCases)
    |> catchIf(%, EnvironmentAuth.isServerAuthInternalError, (error) =>
      internalServerError(error, error),
    );

const toHttpErrorOrUnavailable = <A, R>(
  effect: A!(ConnectFailure | CloudLink.CloudLinkEndpointUnavailableError)!R,
) =>
  effect
    |> catchTags(%, {
      ...connectErrorCases,
      CloudLinkEndpointUnavailableError: (error) =>
        fail(
          new EnvironmentCloudEndpointUnavailableError({
            message: error.message,
            endpointRuntimeStatus: error.endpointRuntimeStatus,
          }),
        ),
    })
    |> catchIf(%, EnvironmentAuth.isServerAuthInternalError, (error) =>
      internalServerError(error, error),
    );

export const layer = HttpApiBuilder.group(
  EnvironmentHttpApi,
  "connect",
  effect (handlers) => {
    const cloudLink = try CloudLink.CloudLink;
    const reachability = try ConnectReachability.ConnectReachability;
    return handlers
      .handle("linkProof", ({ payload }) =>
        effect {
          try requireEnvironmentScope(AuthRelayWriteScope);
          const request = try HttpServerRequest.HttpServerRequest;
          const proof = try toHttpError(cloudLink.linkProof(payload, request));
          try appendCloudCredentialResponseHeaders;
          return proof;
        },
      )
      .handle("relayConfig", ({ payload }) =>
        requireEnvironmentScope(AuthRelayWriteScope)
          |> andThen(%, toHttpErrorOrUnavailable(cloudLink.applyRelayConfig(payload))),
      )
      .handle("linkState", () =>
        requireEnvironmentScope(AuthRelayReadScope)
          |> andThen(%, toHttpError(cloudLink.linkState())),
      )
      .handle("checkReachability", () =>
        requireEnvironmentScope(AuthRelayReadScope) |> andThen(%, reachability.check),
      )
      .handle("unlink", () =>
        requireEnvironmentScope(AuthRelayWriteScope)
          |> andThen(%, toHttpError(cloudLink.unlink())),
      )
      .handle("preferences", ({ payload }) =>
        requireEnvironmentScope(AuthRelayWriteScope)
          |> andThen(%, toHttpError(cloudLink.updatePreferences(payload))),
      )
      .handle("health", ({ payload }) =>
        toHttpError(cloudLink.answerHealthRequest(payload))
          |> tap(%, () => appendCloudCredentialResponseHeaders),
      )
      .handle("mintCredential", ({ payload }) =>
        toHttpError(cloudLink.mintCredential(payload))
          |> tap(%, () => appendCloudCredentialResponseHeaders),
      )
      .handle("t3MintCredential", ({ payload }) =>
        traceRelayRequest(
          toHttpError(cloudLink.mintCredential(payload))
            |> tap(%, () => appendCloudCredentialResponseHeaders),
        ),
      );
  },
);
