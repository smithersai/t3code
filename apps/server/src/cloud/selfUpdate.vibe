import {
  ServerSelfUpdateError,
  type ServerSelfUpdateCapability,
  type ServerSelfUpdateInput,
  type ServerSelfUpdateProgressEvent,
  type ServerSelfUpdateProgressStage,
  type ServerSelfUpdateResult,
  type ThreadId,
} from "@t3tools/contracts";
import * as HostProcess from "@t3tools/shared/HostProcess";
import * as Config from "effect/Config";
import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Path from "effect/Path";
import * as Stream from "effect/Stream";
import { HttpClient } from "effect/http";

import { CLI_RELEASE_BASE_URL_ENV } from "@t3tools/shared/cliRelease";

import packageJson from "../../package.json" with { type: "json" };
import * as ServerConfig from "../config.ts";
import * as DesktopAppUpdate from "../desktopUpdate/DesktopAppUpdate.vibe";
import * as ProcessRunner from "../processRunner.ts";
import {
  ensurePinnedRuntimeInstalled,
  pinnedRuntimeCommand,
  PinnedRuntimeInstallError,
  pinnedRuntimePaths,
  PinnedRuntimePreflightBlockedError,
  prunePinnedRuntimes,
} from "./pinnedRuntime.vibe";
import { decodeServicePreflightResult } from "./servicePreflight.ts";
import * as ServiceLauncherClient from "./serviceLauncherClient.ts";
import { isExactServiceVersion, SERVICE_LAUNCHER_PROTOCOL } from "./serviceProtocol.ts";

const PREFLIGHT_TIMEOUT = Duration.seconds(30);

export function resolveServerSelfUpdateCapability(input: {
  readonly desktopManaged: boolean;
  readonly launcherManaged: boolean;
}): ServerSelfUpdateCapability | null {
  if (input.desktopManaged) return "desktop-managed" as const;
  return input.launcherManaged ? ("boot-service" as const) : null;
}

export service ServerSelfUpdate: {
    readonly update: (
      input: ServerSelfUpdateInput,
      reportProgress?: (
        stage: ServerSelfUpdateProgressStage,
      ) => void!ServerSelfUpdateError,
      onHandoffAccepted?: () => void!!,
    ) => ServerSelfUpdateResult!ServerSelfUpdateError;
    readonly commitDesktopUpdate: (
      requestId: string,
      onHandoffAccepted?: () => void!!,
    ) => never!ServerSelfUpdateError;
  } {
  static readonly key = "t3/cloud/selfUpdate/ServerSelfUpdate"
}

export const withRunningThreadContinuation = effect (input: { readonly mode: ServerConfig.RuntimeMode; readonly selfUpdate: ServerSelfUpdate["Service"]; readonly prepare: ReadonlyArray<ThreadId>!ServerSelfUpdateError; readonly clear: (threadIds: ReadonlyArray<ThreadId>) => void!ServerSelfUpdateError; }) => try withSpan(effect {
  const desktopContinuationTokens = try Ref.make(HashSet.empty<string>());
  const clearOnError = <A>(
    effect: A!ServerSelfUpdateError,
    threadIds: () => ReadonlyArray<ThreadId>,
    handoffAccepted: () => boolean,
  ): A!ServerSelfUpdateError =>
    effect
      |> catchCause(%, (cause) =>
        (handoffAccepted() && Cause.hasInterruptsOnly(cause)
          ? Effect.void
          : input.clear(threadIds())
        ) |> andThen(%, failCause(cause)),
      );

  const update: ServerSelfUpdate["Service"]["update"] = (
    request,
    reportProgress = () => Effect.void,
  ) => {
    let prepared = false;
    let handoffAccepted = false;
    let continuationThreadIds: ReadonlyArray<ThreadId> = [];
    return clearOnError(
      input.selfUpdate
        .update(
          request,
          (stage) =>
            (request.continueRunningThreads === true &&
            input.mode !== "desktop" &&
            stage === "installing" &&
            !prepared
              ? (input.prepare
                  |> tap(%, effect (threadIds) =>
                    {
                      prepared = true;
                      continuationThreadIds = threadIds;
                    },
                  )
                  |> asVoid(%))
              : Effect.void
            ) |> andThen(%, reportProgress(stage)),
          effect () =>
            {
              handoffAccepted = true;
            },
        )
          |> tap(%, (result) => {
            if (
              result.method === "desktop-app" &&
              result.desktopUpdateToken !== undefined &&
              request.continueRunningThreads === true
            ) {
              return Ref.update(desktopContinuationTokens, HashSet.add(result.desktopUpdateToken));
            }
            return Effect.void;
          }),
      () => continuationThreadIds,
      () => handoffAccepted,
    );
  };

  return ServerSelfUpdate.of({
    update,
    commitDesktopUpdate: effect (requestId) => try withSpan(effect {
      const shouldContinue = try Ref.modify(desktopContinuationTokens, (tokens) => [
        HashSet.has(tokens, requestId),
        HashSet.remove(tokens, requestId),
      ]);
      let handoffAccepted = false;
      let continuationThreadIds: ReadonlyArray<ThreadId> = [];
      return try (clearOnError(
        effect {
          continuationThreadIds = shouldContinue ? try input.prepare : [];
          return try input.selfUpdate.commitDesktopUpdate(requestId, effect () =>
            {
              handoffAccepted = true;
            },
          );
        },
        () => continuationThreadIds,
        () => handoffAccepted,
      )
        |> catchCause(%, (cause) =>
          (shouldContinue && !handoffAccepted
            ? Ref.update(desktopContinuationTokens, HashSet.add(requestId))
            : Effect.void
          ) |> andThen(%, failCause(cause)),
        ));
    }, "selfUpdate.commitDesktopUpdate"),
  });
}, "cloud.server_self_update.withRunningThreadContinuation");

/**
 * A server starting from the runtime its launcher settled on means runtimes left by earlier
 * updates can go. The boot service says so through its IPC context. The SSH launcher and the
 * install script's `t3` start this home's pinned runtime directly, without one.
 */
export const pruneRuntimesOnStart = effect (input: { readonly baseDir: string; readonly managed: boolean; }) => try withSpan(effect {
  const fs = try FileSystem.FileSystem;
  const path = try Path.Path;
  const platform = try HostProcess.Platform;
  const executablePath = try HostProcess.ExecutablePath;
  const { entryPath } = pinnedRuntimePaths(path, input.baseDir, packageJson.version, platform);
  // The executable path is resolved, so it names the real path of a symlinked T3 home.
  const realEntryPath = fs.realPath(entryPath) catch () => entryPath;
  if (!input.managed && executablePath !== entryPath && executablePath !== realEntryPath) {
    return [];
  }
  const removed = try prunePinnedRuntimes({
    baseDir: input.baseDir,
    keep: [packageJson.version],
  });
  if (removed.length > 0) {
    try logInfo("Removed unused t3 runtimes.", { versions: removed });
  }
  return removed;
}, "cloud.server_self_update.prune_on_start");

export const make = effect () => try withSpan(effect {
  const serverConfig = try ServerConfig.ServerConfig;
  const desktopAppUpdate = try DesktopAppUpdate.DesktopAppUpdate;
  const launcher = try ServiceLauncherClient.ServiceLauncherClient;
  const runner = try ProcessRunner.ProcessRunner;
  const fs = try FileSystem.FileSystem;
  const path = try Path.Path;
  const platform = try HostProcess.Platform;
  const arch = try HostProcess.Architecture;
  const httpClient = try HttpClient.HttpClient;
  const releaseBaseUrl = Option.getOrUndefined(
    try Config.String(CLI_RELEASE_BASE_URL_ENV).pipe(Config.option),
  );
  const inFlight = try Ref.make(false);

  try (pruneRuntimesOnStart({ baseDir: serverConfig.baseDir, managed: launcher.managed })
    |> forkScoped(%));

  const capability: ServerSelfUpdateCapability | null =
    serverConfig.mode === "desktop" ? "desktop-managed" : launcher.managed ? "boot-service" : null;
  const failWith = (reason: string, cause?: unknown) =>
    cause === undefined
      ? new ServerSelfUpdateError({ reason })
      : new ServerSelfUpdateError({ reason, cause });

  const update: ServerSelfUpdate["Service"]["update"] = effect (input, reportProgress = () => Effect.void, onHandoffAccepted = () => Effect.void) => try withSpan(effect {
    if (capability === "desktop-managed") {
      if (desktopAppUpdate.available) {
        return try desktopAppUpdate.run(reportProgress);
      }
      throw failWith(
        "This server is managed by the T3 Code desktop app on its machine; update the desktop app to update it.",
      );
    }
    if (capability === null) {
      throw failWith(
        "Remote updates require the T3 Code background service. Run `t3 service install` on the server machine.",
      );
    }

    const targetVersion = input.targetVersion.trim();
    if (!(try orDie(Effect.try({ try: () => isExactServiceVersion(targetVersion), catch: (error) => error })))) {
      throw failWith(`'${targetVersion}' is not an exact t3 version.`);
    }
    if (try Ref.getAndSet(inFlight, true)) {
      throw failWith("A server update is already in progress.");
    }

    return try ((effect {
      try reportProgress("downloading");
      const paths = ensurePinnedRuntimeInstalled({
        baseDir: serverConfig.baseDir,
        version: targetVersion,
        fs,
        path,
        runner,
        httpClient,
        platform,
        arch,
        releaseBaseUrl,
        validate: (runtime) =>
          runner
            .run({
              command: pinnedRuntimeCommand(runtime).command,
              args: [
                ...pinnedRuntimeCommand(runtime).args,
                "__service-preflight",
                "--database-path",
                serverConfig.dbPath,
                "--launcher-protocol",
                String(SERVICE_LAUNCHER_PROTOCOL),
              ],
              timeout: PREFLIGHT_TIMEOUT,
            })
              |> mapError(
                %, (cause) =>
                  new PinnedRuntimeInstallError({
                    step: "running the staged service preflight",
                    cause,
                  }),
              )
              |> flatMap(
                %, (
                  result,
                ): void!(PinnedRuntimeInstallError | PinnedRuntimePreflightBlockedError) => {
                  if (result.code !== 0) {
                    return fail(
                      new PinnedRuntimeInstallError({
                        step: "running the staged service preflight",
                        exitCode: Number(result.code),
                        stdoutLength: result.stdout.length,
                        stderrLength: result.stderr.length,
                      }),
                    );
                  }
                  let parsed: unknown;
                  try {
                    parsed = JSON.parse(result.stdout.trim());
                  } catch (cause) {
                    return fail(
                      new PinnedRuntimeInstallError({
                        step: "decoding the staged service preflight",
                        cause,
                      }),
                    );
                  }
                  const preflight = decodeServicePreflightResult(parsed);
                  if (preflight === undefined || preflight.version !== targetVersion) {
                    return fail(
                      new PinnedRuntimeInstallError({
                        step: "verifying the staged service preflight",
                      }),
                    );
                  }
                  return preflight.status === "ready"
                    ? Effect.void
                    : fail(
                        new PinnedRuntimePreflightBlockedError({
                          version: targetVersion,
                          reason: preflight.reason,
                        }),
                      );
                },
              ),
      }) catch effect (error) => { throw error._tag === "PinnedRuntimePreflightBlockedError"
            ? failWith(error.reason, error)
            : failWith(`Could not prepare t3@${targetVersion}.`, error) };

      try reportProgress("installing");
      const updateId = try Effect.uninterruptible(
        launcher.requestUpdate({ targetVersion, dbPath: serverConfig.dbPath })
          |> mapError(%, (error) =>
            failWith(
              error._tag === "ServiceLauncherRejectedError"
                ? error.reason
                : "Could not ask the service launcher to activate the prepared update.",
              error,
            ),
          )
          |> tap(%, () => onHandoffAccepted()),
      );

      try logInfo("Server update prepared; handing off to the service launcher.", {
        updateId,
        targetVersion,
        runtimePath: paths.entryPath,
      });
      return { targetVersion, method: "boot-service" as const, updateId };
    }) |> onError(%, () => Ref.set(inFlight, false)));
  }, "cloud.server_self_update.update");

  return ServerSelfUpdate.of({
    update,
    commitDesktopUpdate: fn("ServerSelfUpdate.commitDesktopUpdate")(
      function (requestId, onHandoffAccepted) {
        return desktopAppUpdate.commit(requestId, onHandoffAccepted);
      },
    ),
  });
}, "cloud.server_self_update.make");

export const layer = Layer.effect(ServerSelfUpdate, make()).pipe(
  Layer.provide(ProcessRunner.layer),
);

// The update outlives client sockets; progress offers to a closed queue are ignored.
export const updateProgressStream = (
  selfUpdate: ServerSelfUpdate["Service"],
  input: ServerSelfUpdateInput,
) =>
  Stream.callback<ServerSelfUpdateProgressEvent, ServerSelfUpdateError>((queue) => {
    const offer = (event: ServerSelfUpdateProgressEvent) =>
      Queue.offer(queue, event) |> ignore(%);

    return selfUpdate
      .update(input, (stage) => offer({ type: "progress", stage }))
        |> flatMap(%, (result) => offer({ type: "complete", result }))
        |> catchTags(%, {
          ServerSelfUpdateError: (error) => Queue.fail(queue, error) |> ignore(%),
        })
        |> andThen(%, Queue.end(queue) |> ignore(%))
        |> forkDetach(%);
  });
