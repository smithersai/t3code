import { VcsUnsupportedOperationError, type CheckpointRef } from "@t3tools/contracts"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"

import type { CheckpointStoreError } from "./Errors.vibe"
import type { VcsCheckpointOps } from "../vcs/VcsDriver.ts"
import * as VcsDriverRegistry from "../vcs/VcsDriverRegistry.vibe"

export interface CaptureCheckpointInput {
  readonly cwd: string
  readonly checkpointRef: CheckpointRef
}

export interface RestoreCheckpointInput {
  readonly cwd: string
  readonly checkpointRef: CheckpointRef
  readonly fallbackToHead?: boolean
}

export interface DiffCheckpointsInput {
  readonly cwd: string
  readonly fromCheckpointRef: CheckpointRef
  readonly toCheckpointRef: CheckpointRef
  readonly fallbackFromToHead?: boolean
  readonly ignoreWhitespace: boolean
  readonly format?: "patch" | "numstat"
  /** Maximum bytes collected from the diff command. */
  readonly maxOutputBytes?: number
  /** Limits the diff to these exact paths. An empty list yields an empty diff. */
  readonly filePaths?: ReadonlyArray<string>
}

export interface ListAuthoredPathsInput {
  readonly cwd: string
  readonly fromCheckpointRef: CheckpointRef
  readonly toCheckpointRef: CheckpointRef
}

export interface DeleteCheckpointRefsInput {
  readonly cwd: string
  readonly checkpointRefs: ReadonlyArray<CheckpointRef>
}

export service CheckpointStore: {
  readonly isGitRepository: (cwd: string) => boolean!CheckpointStoreError;

  readonly captureCheckpoint: (
    input: CaptureCheckpointInput,
  ) => void!CheckpointStoreError;

  readonly hasCheckpointRef: (
    input: Omit<RestoreCheckpointInput, "fallbackToHead">,
  ) => boolean!CheckpointStoreError;

  readonly restoreCheckpoint: (
    input: RestoreCheckpointInput,
  ) => boolean!CheckpointStoreError;

  readonly diffCheckpoints: (
    input: DiffCheckpointsInput,
  ) => string!CheckpointStoreError;

  /** Null means HEAD is unchanged or unrecorded; all changed paths then belong to the turn. */
  readonly listAuthoredPaths: (
    input: ListAuthoredPathsInput,
  ) => (ReadonlySet<string> | null)!CheckpointStoreError;

  readonly deleteCheckpointRefs: (
    input: DeleteCheckpointRefsInput,
  ) => void!CheckpointStoreError;
} {
  static readonly key = "t3/checkpointing/CheckpointStore"
}

/** @public */
export const make = effect {
  const vcsRegistry = try VcsDriverRegistry.VcsDriverRegistry

  const resolveCheckpoints = effect (
    operation: string,
    cwd: string,
  ) =>
    try withSpan(
      effect {
        const handle = try vcsRegistry.resolve({ cwd })
        if (!handle.driver.checkpoints) {
          throw new VcsUnsupportedOperationError({
            operation,
            kind: handle.kind,
            detail: `${handle.kind} driver does not implement checkpoint operations.`,
          })
        }
        return handle.driver.checkpoints satisfies VcsCheckpointOps
      },
      "CheckpointStore.resolveCheckpoints",
    )

  const isGitRepository: CheckpointStore["Service"]["isGitRepository"] = (cwd) =>
    vcsRegistry
      .detect({ cwd, requestedKind: "git" }) |> Effect.map(%, (repository) => repository !== null)

  const captureCheckpoint: CheckpointStore["Service"]["captureCheckpoint"] = effect (
    input,
  ): void!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never =>
    try withSpan(
      (effect (): void!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never => {
        const checkpoints = try resolveCheckpoints("CheckpointStore.captureCheckpoint", input.cwd)
        return try checkpoints.captureCheckpoint(input)
      })(),
      "captureCheckpoint",
    )

  const hasCheckpointRef: CheckpointStore["Service"]["hasCheckpointRef"] = effect (
    input,
  ): boolean!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never =>
    try withSpan(
      (effect (): boolean!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never => {
        const checkpoints = try resolveCheckpoints("CheckpointStore.hasCheckpointRef", input.cwd)
        return try checkpoints.hasCheckpointRef(input)
      })(),
      "hasCheckpointRef",
    )

  const restoreCheckpoint: CheckpointStore["Service"]["restoreCheckpoint"] = effect (
    input,
  ): boolean!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never =>
    try withSpan(
      (effect (): boolean!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never => {
        const checkpoints = try resolveCheckpoints("CheckpointStore.restoreCheckpoint", input.cwd)
        return try checkpoints.restoreCheckpoint(input)
      })(),
      "restoreCheckpoint",
    )

  const diffCheckpoints: CheckpointStore["Service"]["diffCheckpoints"] = effect (
    input,
  ): string!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never =>
    try withSpan(
      (effect (): string!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never => {
        const checkpoints = try resolveCheckpoints("CheckpointStore.diffCheckpoints", input.cwd)
        return try checkpoints.diffCheckpoints(input)
      })(),
      "diffCheckpoints",
    )

  const listAuthoredPaths: CheckpointStore["Service"]["listAuthoredPaths"] = effect (
    input,
  ): (ReadonlySet<string> | null)!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never =>
    try withSpan(
      (effect (): (ReadonlySet<string> | null)!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never => {
        const checkpoints = try resolveCheckpoints("CheckpointStore.listAuthoredPaths", input.cwd)
        return try checkpoints.listAuthoredPaths(input)
      })(),
      "listAuthoredPaths",
    )

  const deleteCheckpointRefs: CheckpointStore["Service"]["deleteCheckpointRefs"] = effect (
    input,
  ): void!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never =>
    try withSpan(
      (effect (): void!(import("@t3tools/contracts").VcsProcessExitError | import("@t3tools/contracts").VcsProcessMissingExitCodeError | import("@t3tools/contracts").VcsProcessOutputLimitError | import("@t3tools/contracts").VcsProcessOutputReadError | import("@t3tools/contracts").VcsProcessSpawnError | import("@t3tools/contracts").VcsProcessStdinWriteError | import("@t3tools/contracts").VcsProcessTimeoutError | import("@t3tools/contracts").VcsRepositoryDetectionError | VcsUnsupportedOperationError)!never => {
        const checkpoints = try resolveCheckpoints(
          "CheckpointStore.deleteCheckpointRefs",
          input.cwd,
        )
        return try checkpoints.deleteCheckpointRefs(input)
      })(),
      "deleteCheckpointRefs",
    )

  return CheckpointStore.of({
    isGitRepository,
    captureCheckpoint,
    hasCheckpointRef,
    restoreCheckpoint,
    diffCheckpoints,
    listAuthoredPaths,
    deleteCheckpointRefs,
  })
}

export const layer = Layer.effect(CheckpointStore, make)
