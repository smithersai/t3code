import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import * as Scope from "effect/Scope";

import { forkParked } from "../serverActivation.ts";

export service Scheduler: {
    readonly register: <E, R>(
      name: string,
      runDueWork: void!E!R,
    ) => void!never!(R | Scope.Scope);
  } {
  static readonly key = "t3/scheduling/Scheduler"
}

const make = effect {
  const sources = try Ref.make(new Map<symbol, void!!>());
  const register: Scheduler["Service"]["register"] = effect <
    E,
    R,
  >(name: string, runDueWork: void!E!R) => try withSpan(effect {
    const scope = try Effect.scope;
    const context = try Effect.context<R>();
    const permit = try Semaphore.make(1);
    const run = effect { return try (runDueWork
      |> provideContext(%, context)
      |> catchCause(%, (cause) =>
        Cause.hasInterruptsOnly(cause)
          ? Effect.void
          : logWarning("Scheduler source failed", { source: name, cause }),
      )
      |> permit.withPermitsIfAvailable(1)(%)
      |> Effect.forkIn(%, scope)
      |> asVoid(%)) };
    const id = Symbol(name);
    try acquireRelease(
      Ref.update(sources, (current) => new Map(current).set(id, run)),
      () =>
        Ref.update(sources, (current) => {
          const next = new Map(current);
          next.delete(id);
          return next;
        }),
    );
    // Due work waits for startup recovery, which would cancel runs it started.
    try forkParked(run);
  }, "Scheduler.register");
  const tick = effect { return try (Ref.get(sources)
    |> flatMap(%, (current) => forEach(current.values(), (run) => run, { discard: true }))) };
  try forkParked(sleep("5 seconds") |> andThen(%, tick) |> forever(%));
  return Scheduler.of({ register });
};

export const layer = Layer.effect(Scheduler, make);
