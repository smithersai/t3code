import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"
import * as SqlClient from "effect/sql/SqlClient"
import { isSqlError } from "effect/sql/SqlError"

import * as EventStore from "../orchestration-v2/EventStore.ts"
import * as ProjectionMaintenance from "../orchestration-v2/ProjectionMaintenance.ts"
import * as ProjectionStore from "../orchestration-v2/ProjectionStore.ts"
import { rebuildMessageSearch } from "../orchestration-v2/messageSearchIndex.vibe"

export schema error DatabaseMissingError {
  readonly path: string
  override get message() {
    return "No existing T3 Code database was found in this data directory."
  }
}

const DatabaseInUseErrorCauseField: Schema.Defect = Schema.Defect()
export schema error DatabaseInUseError {
  readonly path: string
  cause: DatabaseInUseErrorCauseField
  override get message() {
    return "Stop the T3 Code server and desktop app, including any version before 0.1.0, before repairing the database."
  }
}

export schema error DatabaseProjectionsInvalidError {
  readonly path: string
  override get message() {
    return "Database projections need repair before compaction. Start T3 Code once so it rebuilds them, then run doctor again. If this CLI is older than the one that wrote the database, update T3 Code first."
  }
}

const DatabaseInspectErrorCauseField: Schema.Defect = Schema.Defect()
export schema error DatabaseInspectError {
  readonly path: string
  cause: DatabaseInspectErrorCauseField
  override get message() {
    return "Could not read the database. Check that this user can open it."
  }
}

const DatabaseCompactErrorCauseField: Schema.Defect = Schema.Defect()
export schema error DatabaseCompactError {
  readonly path: string
  cause: DatabaseCompactErrorCauseField
  override get message() {
    return "Database compaction failed. Check that no other process has the database open and enough disk space is available."
  }
}

const LegacyDatabaseRemoveErrorCauseField: Schema.Defect = Schema.Defect()
export schema error LegacyDatabaseRemoveError {
  readonly path: string
  cause: LegacyDatabaseRemoveErrorCauseField
  override get message() {
    return "Could not delete the database from before 0.1.0. Check that this user can write to the data directory."
  }
}

export service DatabaseMaintenance: {
  readonly inspect: (databasePath: string) => {
      readonly databaseBytes: number;
      readonly reclaimableBytes: number;
      readonly incrementalVacuumEnabled: boolean;
      /** Size of the database from before 0.1.0 still kept beside it, or null. */
      readonly legacyDatabaseBytes: number | null;
    }!(DatabaseMissingError | DatabaseInspectError);
  /** Compacts history, then VACUUMs into incremental auto_vacuum. Refuses while a server has it open. */
  readonly compact: (databasePath: string) => {
      readonly beforeBytes: number;
      readonly afterBytes: number;
      readonly deletedEventCount: number;
      readonly deletedReceiptCount: number;
    }!(| DatabaseMissingError
    | DatabaseInUseError
    | DatabaseProjectionsInvalidError
    | DatabaseCompactError);
  /** Deletes only the pre-0.1.0 database; earlier versions still use it. */
  readonly removeLegacyDatabase: (
    databasePath: string,
  ) => void!(DatabaseInUseError | LegacyDatabaseRemoveError);
} {
  static readonly key = "t3/persistence/DatabaseMaintenance"
}

const isDomainError = Schema.is(
  Schema.Union([DatabaseMissingError, DatabaseInUseError, DatabaseProjectionsInvalidError]),
)

const readStorage = effect {
  const sql = try SqlClient.SqlClient
  const pages = try sql<{ readonly page_count: number }>`PRAGMA page_count`
  const free = try sql<{ readonly freelist_count: number }>`PRAGMA freelist_count`
  const size = try sql<{ readonly page_size: number }>`PRAGMA page_size`
  const mode = try sql<{ readonly auto_vacuum: number }>`PRAGMA auto_vacuum`
  const pageSize = size[0]?.page_size ?? 0
  return {
    databaseBytes: (pages[0]?.page_count ?? 0) * pageSize,
    reclaimableBytes: (free[0]?.freelist_count ?? 0) * pageSize,
    incrementalVacuumEnabled: mode[0]?.auto_vacuum === 2,
  }
}

/**
 * Holds an exclusive lock on the connection's database. In WAL mode this is
 * refused while any other connection has the file open, even an idle one,
 * which is how a running server or desktop app is detected.
 */
const lockExclusively = effect (
  databasePath: string,
) =>
  try withSpan(
    effect {
      const sql = try SqlClient.SqlClient
      try sql`PRAGMA busy_timeout = 0`
      try sql`PRAGMA locking_mode = EXCLUSIVE`
      sql`BEGIN EXCLUSIVE` catch effect (cause) => {
        throw isSqlError(cause) && cause.reason._tag === "LockTimeoutError"
          ? new DatabaseInUseError({ path: databasePath, cause })
          : cause
      }
      try sql`COMMIT`
    },
    "DatabaseMaintenance.lockExclusively",
  )

const make = effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const legacyPath = (databasePath: string) => path.join(path.dirname(databasePath), "state.sqlite")

  const locate = effect (databasePath: string) =>
    try withSpan(
      effect {
        if (!(try fs.exists(databasePath))) {
          throw new DatabaseMissingError({ path: databasePath })
        }
      },
      "DatabaseMaintenance.locate",
    )

  const inspect = effect (databasePath: string) =>
    try withSpan(
      effect {
        try locate(databasePath)
        const storage = try effect {
          provide NodeSqliteClient.layer({ filename: databasePath, readonly: true }) {
            return try readStorage
          }
        }
        const legacy = legacyPath(databasePath)
        const legacyDatabaseBytes = (try fs.exists(legacy))
          ? Number((try fs.stat(legacy)).size)
          : null
        return { ...storage, legacyDatabaseBytes }
      } |> ((effect, databasePath) =>
        effect
        |> Effect.mapError(
          %,
          (cause) => isDomainError(cause) ? cause : new DatabaseInspectError({ path: databasePath, cause }),
        ))(%, databasePath),
      "DatabaseMaintenance.inspect",
    )

  const compact = effect (databasePath: string) =>
    try withSpan(
      effect {
        try locate(databasePath)
        const beforeBytes = Number((try fs.stat(databasePath)).size)
        const result = try effect {
          provide ProjectionMaintenance.layer.pipe(
                Layer.provide(Layer.merge(EventStore.layer, ProjectionStore.layer)),
                Layer.provideMerge(NodeSqliteClient.layer({ filename: databasePath })),
              ) {
            return try (effect {
              const sql = try SqlClient.SqlClient
              try lockExclusively(databasePath)
              const maintenance = try ProjectionMaintenance.ProjectionMaintenanceV2
              if (!(try maintenance.verify).valid) {
                throw new DatabaseProjectionsInvalidError({ path: databasePath })
              }
              const summary = try maintenance.compactEventStore()
              if (!(try maintenance.verify).valid) {
                throw new DatabaseProjectionsInvalidError({ path: databasePath })
              }
              // VACUUM is required to enable incremental auto_vacuum on existing databases.
              try sql`PRAGMA auto_vacuum = INCREMENTAL`
              try sql`VACUUM`
              try rebuildMessageSearch(sql)
              try sql`PRAGMA wal_checkpoint(TRUNCATE)`
              return summary
            })
          }
        }
        const afterBytes = Number((try fs.stat(databasePath)).size)
        return {
          beforeBytes,
          afterBytes,
          deletedEventCount: result.deletedEventCount,
          deletedReceiptCount: result.deletedReceiptCount,
        }
      } |> ((effect, databasePath) =>
        effect
        |> Effect.mapError(
          %,
          (cause) => isDomainError(cause) ? cause : new DatabaseCompactError({ path: databasePath, cause }),
        ))(%, databasePath),
      "DatabaseMaintenance.compact",
    )

  const removeLegacyDatabase = effect (databasePath: string) =>
    try withSpan(
      effect {
        const legacy = legacyPath(databasePath)
        if (!(try fs.exists(legacy))) return
        // Older servers may use this file; hold its lock and delete the database before WAL to preserve commits on failure.
        try effect {
          provide NodeSqliteClient.layer({ filename: legacy }) {
            return try (effect {
              try lockExclusively(legacy)
              for (const suffix of ["", "-wal", "-shm"]) {
                try fs.remove(legacy + suffix, { force: true })
              }
            })
          }
        }
      } |> ((effect, databasePath) =>
        effect
        |> Effect.mapError(%, (cause) =>
          cause._tag === "DatabaseInUseError"
            ? cause
            : new LegacyDatabaseRemoveError({ path: legacyPath(databasePath), cause })))(%, databasePath),
      "DatabaseMaintenance.removeLegacyDatabase",
    )

  return DatabaseMaintenance.of({ inspect, compact, removeLegacyDatabase })
}

export const layer = Layer.effect(DatabaseMaintenance, make)
