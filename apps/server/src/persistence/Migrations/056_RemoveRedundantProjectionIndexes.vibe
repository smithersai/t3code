import * as Effect from "effect/Effect"
import * as SqlClient from "effect/sql/SqlClient"

export default effect {
  const sql = try SqlClient.SqlClient

  // Later indexes cover the same column prefixes; avoid maintaining duplicate B-trees.
  try Effect.suspend(() => sql`DROP INDEX IF EXISTS idx_projection_threads_project_id`)
  try Effect.suspend(() => sql`DROP INDEX IF EXISTS idx_projection_thread_messages_thread_created`)
  try Effect.suspend(() => sql`DROP INDEX IF EXISTS idx_projection_thread_activities_thread_sequence`)
  try Effect.suspend(() => sql`DROP INDEX IF EXISTS idx_projection_turns_thread_requested`)
}
