import * as Effect from "effect/Effect"
import * as SqlClient from "effect/sql/SqlClient"

// V2 never reads these copied V1 projections; pre-0.1.0 builds use state.sqlite, preserving rollback.
export default effect {
  const sql = try SqlClient.SqlClient

  try Effect.suspend(() => sql`DROP TABLE IF EXISTS projection_thread_activities`)
  try Effect.suspend(() => sql`DROP TABLE IF EXISTS projection_turns`)
  try Effect.suspend(() => sql`DROP TABLE IF EXISTS projection_thread_proposed_plans`)
  try Effect.suspend(() => sql`DROP TABLE IF EXISTS projection_pending_approvals`)
  try Effect.suspend(() => sql`DROP TABLE IF EXISTS projection_state`)
  try Effect.suspend(() => sql`DROP TABLE IF EXISTS checkpoint_diff_blobs`)
}
