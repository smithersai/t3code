import type { DatabaseStorageStatus } from "@t3tools/contracts";
import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Path from "effect/Path";
import * as Stream from "effect/Stream";
import * as SqlClient from "effect/sql/SqlClient";

import { resolveHostCliCommand } from "../cli/invocation.vibe";
import * as ServerConfig from "../config.ts";
import * as ProjectionMaintenance from "../orchestration-v2/ProjectionMaintenance.ts";
import { forkParked } from "../serverActivation.ts";

// Bound each reclaim pass to one minute of churn.
const RECLAIM_PAGES_PER_PASS = 1024;
const COMPACTION_INTERVAL = Duration.hours(6);

export service DatabaseStorage: {
    /** Return free pages to the filesystem on databases with incremental auto_vacuum. */
    readonly reclaim: void!!;
    /** Current file accounting, re-published after each maintenance pass. Null until first read. */
    readonly status: Stream.Stream<DatabaseStorageStatus | null>;
  } {
  static readonly key = "t3/persistence/DatabaseStorage"
}

// Deleted events have newer retained replacements; old cursors replay to the same state.
const make = effect {
  const sql = try SqlClient.SqlClient;
  const maintenance = try ProjectionMaintenance.ProjectionMaintenanceV2;
  const config = try ServerConfig.ServerConfig;
  const fs = try FileSystem.FileSystem;
  const path = try Path.Path;
  const statusRef = try SubscriptionRef.make<DatabaseStorageStatus | null>(null);

  // The notice shows host-shell quoting verbatim; desktop needs its launcher because t3 is absent from PATH.
  const { command: compactCommand } = try resolveHostCliCommand("doctor", [
    "--base-dir",
    config.baseDir,
  ]);
  // doctor --base-dir targets userdata, not implicit dev homes; suppress status to avoid touching the live install.
  const doctorTargetsThisDatabase =
    path.resolve(config.dbPath) ===
    path.resolve(config.baseDir, "userdata", path.basename(config.dbPath));
  const publishStatus = effect { return try ((effect {
    if (!doctorTargetsThisDatabase) return;
    const pages = try sql<{ readonly page_count: number }>`PRAGMA page_count`;
    const free = try sql<{ readonly freelist_count: number }>`PRAGMA freelist_count`;
    const size = try sql<{ readonly page_size: number }>`PRAGMA page_size`;
    const mode = try sql<{ readonly auto_vacuum: number }>`PRAGMA auto_vacuum`;
    const pageSize = size[0]?.page_size ?? 0;
    const next: DatabaseStorageStatus = {
      databaseBytes: (pages[0]?.page_count ?? 0) * pageSize,
      reclaimableBytes: (free[0]?.freelist_count ?? 0) * pageSize,
      incrementalVacuumEnabled: mode[0]?.auto_vacuum === 2,
      compactCommand,
    };
    // Every set reaches each open Storage page; most passes change nothing.
    if (!Equal.equals(try SubscriptionRef.get(statusRef), next)) {
      try SubscriptionRef.set(statusRef, next);
    }
  })
    |> Effect.catch(%, (cause) => logWarning("Database storage inspection failed", { cause }))) };

  const reclaim = effect { return try ((effect {
    const mode = try sql<{ readonly auto_vacuum: number }>`PRAGMA auto_vacuum`;
    if (mode[0]?.auto_vacuum !== 2) return;
    // The driver steps once per statement; incremental_vacuum frees one page per step. Yield between pages.
    for (let page = 0; page < RECLAIM_PAGES_PER_PASS; page++) {
      const free = try sql<{ readonly freelist_count: number }>`PRAGMA freelist_count`;
      if ((free[0]?.freelist_count ?? 0) === 0) break;
      try sql`PRAGMA incremental_vacuum(1)`;
      try Effect.yieldNow;
    }
  })
    |> Effect.catch(%, (cause) => logWarning("Database space reclamation failed", { cause }))) };

  // Even a pass that deletes nothing scans the event store. Persist completion
  // so restarting does not trigger another scan before the six-hour interval.
  const compactedAtPath = path.join(path.dirname(config.dbPath), "compacted-at");
  const compact = effect { return try ((effect {
    let sliceStarted = try Clock.monotonicTimeNanos;
    const betweenPages = effect {
      const elapsed = (try Clock.monotonicTimeNanos) - sliceStarted;
      if (elapsed < 25_000_000n) return;
      // Keep background maintenance at 10% duty, including pages that exceed the budget.
      try sleep((Number(elapsed) / 1_000_000) * 9);
      sliceStarted = try Clock.monotonicTimeNanos;
    };
    const result = try maintenance.compactEventStore(betweenPages);
    const completedAt = try Clock.currentTimeMillis;
    try (fs.writeFileString(compactedAtPath, String(completedAt)) |> ignore(%));
    if (result.deletedEventCount > 0 || result.deletedReceiptCount > 0) {
      try logInfo("Compacted orchestration history", result);
    }
  })
    |> Effect.catch(%, (cause) =>
      logWarning("Orchestration history compaction failed", { cause }),
    )) };
  const lastCompactedAt = try (fs.readFileString(compactedAtPath).pipe(
    map(Number),
    orElseSucceed(() => Number.NaN),
  ));
  const intervalMs = Duration.toMillis(COMPACTION_INTERVAL);
  const untilDueMs = Number.isFinite(lastCompactedAt)
    ? lastCompactedAt + intervalMs - (try Clock.currentTimeMillis)
    : 0;
  const firstCompactionDelay = Duration.millis(
    Math.min(intervalMs, Math.max(Duration.toMillis(Duration.minutes(1)), untilDueMs)),
  );

  try forkParked(
    sleep(firstCompactionDelay)
      |> andThen(
        %, compact
          |> andThen(%, publishStatus)
          |> repeat(%, Schedule.spaced(COMPACTION_INTERVAL)),
      ),
  );
  try forkParked(
    publishStatus
      |> andThen(%, sleep("1 minute"))
      |> andThen(
        %, reclaim |> andThen(%, publishStatus) |> repeat(%, Schedule.spaced("1 minute")),
      ),
  );

  return DatabaseStorage.of({ reclaim, status: SubscriptionRef.changes(statusRef) });
};

export const layer = Layer.effect(DatabaseStorage, make);
