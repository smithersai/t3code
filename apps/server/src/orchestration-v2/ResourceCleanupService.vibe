import { ThreadId } from "@t3tools/contracts";
import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Layer from "effect/Layer";
import * as Schema from "effect/Schema";

import { resolveAttachmentRelativePath } from "../attachmentPaths.ts";
import { parseAttachmentFileExtension, resolveAttachmentPathById } from "../attachmentStore.ts";
import * as ServerConfig from "../config.ts";
import * as PreviewManager from "../preview/Manager.ts";
import * as ScheduledTaskService from "../scheduledTasks/ScheduledTaskService.ts";
import * as TerminalManager from "../terminal/Manager.ts";

const ResourceCleanupErrorCauseField = Schema.Defect()
export schema error ResourceCleanupError {
  readonly operation: "terminal" | "preview" | "attachment" | "scheduled-tasks"
  readonly threadId?: string
  readonly attachmentId?: string
  cause: ResourceCleanupErrorCauseField
}

export class ResourceCleanupService extends Context.Reference<{
  readonly cleanupScheduledTasks: (threadId: ThreadId) => void!ResourceCleanupError;
  readonly cleanupTerminals: (threadId: string) => void!ResourceCleanupError;
  readonly cleanupPreviews: (threadId: string) => void!ResourceCleanupError;
  readonly cleanupAttachments: (
    attachmentIds: ReadonlyArray<string>,
  ) => void!ResourceCleanupError;
}>("t3/orchestration-v2/ResourceCleanupService", {
  defaultValue: () => ({
    cleanupScheduledTasks: () => Effect.void,
    cleanupTerminals: () => Effect.void,
    cleanupPreviews: () => Effect.void,
    cleanupAttachments: () => Effect.void,
  }),
}) {}

export const layer = Layer.effect(
  ResourceCleanupService,
  effect {
    const terminals = try TerminalManager.TerminalManager;
    const previews = try PreviewManager.PreviewManager;
    const fileSystem = try FileSystem.FileSystem;
    const config = try ServerConfig.ServerConfig;
    const scheduledTasks = try ScheduledTaskService.ScheduledTaskService;
    return {
      cleanupScheduledTasks: fn("ResourceCleanupService.cleanupScheduledTasks")(function (
        threadId: ThreadId,
      ) {
        return scheduledTasks
          .deleteForThread(threadId)
            |> mapError(
              %, (cause) =>
                new ResourceCleanupError({ operation: "scheduled-tasks", threadId, cause }),
            );
      }),
      cleanupTerminals: fn("ResourceCleanupService.cleanupTerminals")(function (
        threadId: string,
      ) {
        return terminals
          .close({ threadId, deleteHistory: true })
            |> mapError(
              %, (cause) => new ResourceCleanupError({ operation: "terminal", threadId, cause }),
            );
      }),
      cleanupPreviews: fn("ResourceCleanupService.cleanupPreviews")(function (
        threadId: string,
      ) {
        return previews
          .close({ threadId: ThreadId.make(threadId) })
            |> mapError(
              %, (cause) => new ResourceCleanupError({ operation: "preview", threadId, cause }),
            );
      }),
      cleanupAttachments: fn("ResourceCleanupService.cleanupAttachments")(function (
        attachmentIds: ReadonlyArray<string>,
      ) {
        return forEach(
          attachmentIds,
          (attachmentId) => {
            const extension = parseAttachmentFileExtension(attachmentId);
            const path =
              resolveAttachmentPathById({
                attachmentsDir: config.attachmentsDir,
                attachmentId,
              }) ??
              (extension
                ? resolveAttachmentRelativePath({
                    attachmentsDir: config.attachmentsDir,
                    relativePath: `${attachmentId}.${extension}`,
                  })
                : null);
            return path === null
              ? Effect.void
              : (fileSystem.remove(path, { force: true })
                  |> andThen(%, fileSystem.remove(`${path}.txt`, { force: true }))
                  |> mapError(
                    %, (cause) =>
                      new ResourceCleanupError({ operation: "attachment", attachmentId, cause }),
                  ));
          },
          { discard: true, concurrency: 4 },
        );
      }),
    };
  },
);
