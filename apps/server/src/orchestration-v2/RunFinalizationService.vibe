import { CheckpointScopeId, ProjectId, RunId, ThreadId } from "@t3tools/contracts"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"

import * as PullRequestService from "../pullRequest/PullRequestService.ts"
import * as VcsStatusBroadcaster from "../vcs/VcsStatusBroadcaster.vibe"
import * as WorkspaceEntries from "../workspace/WorkspaceEntries.ts"
import * as CheckpointCapture from "./CheckpointCaptureService.vibe"
import * as ProjectionStore from "./ProjectionStore.ts"

const RunFinalizationErrorCauseField: Schema.Defect = Schema.Defect()
export schema error RunFinalizationError {
  readonly threadId: ThreadId
  readonly runId: RunId
  readonly scopeId: CheckpointScopeId
  readonly operation: "capture-checkpoint" | "refresh-workspace"
  cause: RunFinalizationErrorCauseField
}

const RunFinalizationRefreshErrorCauseField: Schema.Defect = Schema.Defect()
export schema error RunFinalizationRefreshError {
  readonly cwd: string
  cause: RunFinalizationRefreshErrorCauseField
}

export class RunFinalizationObserver extends Context.Reference<{
  readonly refreshAfterTurn: (projectId: ProjectId) => void!!
  readonly refresh: (input: {
    readonly cwd: string
    readonly threadId: ThreadId
    readonly runId: RunId
  }) => void!RunFinalizationRefreshError
}>("t3/orchestration-v2/RunFinalizationObserver", {
  defaultValue: () => ({ refresh: () => Effect.void, refreshAfterTurn: () => Effect.void }),
}) {}

export service RunFinalizationService: {
  readonly finalize: (input: {
    readonly threadId: ThreadId;
    readonly runId: RunId;
    readonly scopeId: CheckpointScopeId;
  }) => void!RunFinalizationError;
} {
  static readonly key = "t3/orchestration-v2/RunFinalizationService"
}

const make = effect {
  const checkpointCapture = try CheckpointCapture.CheckpointCaptureServiceV2
  const projections = try ProjectionStore.ProjectionStoreV2
  const observer = try RunFinalizationObserver

  const finalize: RunFinalizationService["Service"]["finalize"] = effect (input): void!RunFinalizationError =>
    try withSpan(
      (effect (): void!RunFinalizationError => {
        checkpointCapture
          .execute(input) catch effect (cause) => {
            throw new RunFinalizationError({ ...input, operation: "capture-checkpoint", cause })
          }
        const projection = projections
          .getCheckpointContext(input.threadId) catch effect (cause) => {
            throw new RunFinalizationError({ ...input, operation: "refresh-workspace", cause })
          }
        const cwd = projection.checkpointScopes.find((scope) => scope.id === input.scopeId)?.cwd
        if (cwd !== undefined) {
          // Retrying a display refresh after the checkpoint is durable blocks the next turn.
          observer.refresh({ cwd, threadId: input.threadId, runId: input.runId }) catch effect (cause) => match (cause) {
            when { _tag: "RunFinalizationRefreshError" }: try Effect.logWarning(
              "Failed to refresh workspace after checkpoint capture",
              {
                ...input,
                cause,
              },
            );
          }
        }
      })(),
      "RunFinalizationService.finalize",
    )
  return RunFinalizationService.of({ finalize })
}

export const layer = Layer.effect(RunFinalizationService, make)

export const layerObserver = Layer.effect(
  RunFinalizationObserver,
  Effect.gen(function*() {
    const workspaceEntries = yield* WorkspaceEntries.WorkspaceEntries
    const vcsStatus = yield* VcsStatusBroadcaster.VcsStatusBroadcaster
    const projections = yield* ProjectionStore.ProjectionStoreV2
    const pullRequests = yield* PullRequestService.PullRequestService
    return {
      refreshAfterTurn: pullRequests.refreshAfterTurn,
      refresh: Effect.fn("RunFinalizationService.refresh")(
        function*({ cwd, threadId, runId }) {
          const [, local] = yield* Effect.all(
            [workspaceEntries.refresh(cwd), vcsStatus.refreshLocalStatus(cwd)],
            { concurrency: "unbounded" },
          )
          if (local.refName === null || local.isDefaultRef) return
          const thread = yield* projections.getThreadShell(threadId)
          if (!thread || thread.branch !== local.refName) return
          if (thread.activeRunId !== null && thread.activeRunId !== runId) return
          yield* vcsStatus.refreshPullRequestStatus(cwd)
            |> Effect.catch(
              %,
              (error) =>
                Effect.logWarning("failed to refresh pull request status after run completion", {
                  threadId,
                  cwd,
                  detail: error.message,
                }),
            )
        },
        (effect, { cwd }) =>
          effect |> Effect.mapError(%, (cause) => new RunFinalizationRefreshError({ cwd, cause })),
      ),
    }
  }),
)
