import {
  CommandId,
  MessageId,
  type OrchestrationV2DomainEvent,
  type OrchestrationV2RuntimeRequest,
  type OrchestrationV2Subagent,
} from "@t3tools/contracts"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import type * as Scope from "effect/Scope"
import * as Stream from "effect/Stream"

import { reportLabel } from "@t3tools/provider-core/server/notification"

import { forkParked } from "../serverActivation.vibe"
import * as Orchestrator from "./Orchestrator.ts"
import * as ProjectionStore from "./ProjectionStore.ts"

export service DelegatedTaskQuestionReactor: {
  readonly start: () => void!never!Scope.Scope;
  readonly handle: (event: OrchestrationV2DomainEvent) => void!!;
} {
  static readonly key = "t3/orchestration-v2/DelegatedTaskQuestionReactor"
}

const make = Effect.gen(function*() {
  const engine = yield* Orchestrator.OrchestratorV2
  const projections = yield* ProjectionStore.ProjectionStoreV2

  const wakeParent = effect (
    task: OrchestrationV2Subagent,
    request: OrchestrationV2RuntimeRequest,
  ) => {
    if (task.childThreadId === null) return
    const key = `${task.threadId}:${request.id}`
    const label = try Effect.orDie(
      Effect.try({ try: () => reportLabel(task.title?.trim() || task.prompt), catch: (e) => e }),
    )
    const situation = request.responseCapability.type === "message"
      ? `Delegated task ${task.id} asked a question and is still working.`
      : `Delegated task ${task.id} is blocked on a question and cannot continue until it is answered.`
    try engine.dispatch({
      type: "message.dispatch",
      commandId: CommandId.make(`server:delegated-task-question:${key}`),
      threadId: task.threadId,
      messageId: MessageId.make(`message:delegated-task-question:${key}`),
      text:
        `${situation} Read it with t3_pending_request action read, threadId ${task.childThreadId}, and requestId ${request.id}. Answer it with action respond when the answer follows from the task or the user's instructions; otherwise ask the user, then answer it. If it is no longer pending, it was answered or dismissed.`,
      notification: {
        source: { kind: "delegated_task", taskIds: [task.id], childThreadId: task.childThreadId },
        outcome: "updated",
        summary: `Delegated task${label === undefined ? "" : ` "${label}"`} has a question`,
      },
      attachments: [],
      dispatchMode: { type: "queue_after_active" },
      createdBy: "agent",
      creationSource: "server",
    })
  }

  // Runs for every domain event; most events return before any work is needed.
  const handle: DelegatedTaskQuestionReactor["Service"]["handle"] = effect (event) =>
    try (effect {
      if (event.type === "run.updated") {
        if (!["completed", "failed", "waiting"].includes(event.payload.status)) return
        const parent = try projections.getThreadRecords(event.threadId, ["subagents"])
        if (parent.thread.archivedAt !== null || parent.thread.deletedAt !== null) return
        for (const task of parent.subagents) {
          if (
            task.origin !== "app_owned"
            || task.runId !== event.payload.id
            || task.completionWake !== "settled_only"
            || task.completionDelivery?.state === "disposed"
            || task.childThreadId === null
            || ["completed", "failed", "cancelled", "interrupted"].includes(task.status)
          ) {
            continue
          }
          const child = try projections.getThreadRecords(task.childThreadId, [
            "runtimeRequests",
          ])
          for (const request of child.runtimeRequests) {
            if (
              request.kind !== "user_input"
              || request.status !== "pending"
              || request.responseCapability.type !== "live"
            ) {
              continue
            }
            try (wakeParent(task, request)
              |> Effect.catchCause(%, (cause) =>
                Effect.logWarning("catching up a delegated task question failed", {
                  taskId: task.id,
                  requestId: request.id,
                  cause,
                })))
          }
        }
        return
      }
      if (event.type !== "runtime-request.updated" || event.payload.kind !== "user_input") {
        return
      }
      const child = try projections.getThread(event.threadId)
      const parentThreadId = child.lineage.parentThreadId
      if (parentThreadId === null) return
      const request = try projections.getRuntimeRequest(event.threadId, event.payload.id)
      const key = `${parentThreadId}:${event.payload.id}`
      const messageId = MessageId.make(`message:delegated-task-question:${key}`)
      if (event.payload.status !== "pending" || request?.status !== "pending") {
        const parent = try projections.getThreadRecords(parentThreadId, ["runs"])
        const queued = parent.runs.find(
          (run) => run.status === "queued" && run.userMessageId === messageId,
        )
        if (queued !== undefined) {
          try engine.dispatch({
            type: "queued-run.cancel",
            commandId: CommandId.make(`server:delegated-task-question-cancel:${key}`),
            threadId: parentThreadId,
            runId: queued.id,
          })
        }
        return
      }
      const parent = try projections.getThreadRecords(parentThreadId, ["subagents", "runs"])
      const { runs } = try projections.getThreadRecords(child.id, ["runs"])
      const run = runs.find((run) => run.id === event.runId)
        ?? runs.toSorted((a, b) => b.ordinal - a.ordinal)[0]
      const taskId = run?.delegatedTaskId
        ?? (child.forkedFrom?.type === "node" ? child.forkedFrom.nodeId : undefined)
      const task = parent.subagents.find(
        (candidate) => candidate.origin === "app_owned" && candidate.id === taskId,
      )
      if (
        task === undefined
        || parent.thread.archivedAt !== null
        || parent.thread.deletedAt !== null
      ) {
        return
      }
      // A blocking delegate_task wait delivers the question itself.
      if (
        task.completionWake === "settled_only"
        && event.payload.responseCapability.type === "live"
        && parent.runs.some(
          (run) =>
            run.id === task.runId
            && (run.status === "preparing" || run.status === "starting" || run.status === "running"),
        )
      ) {
        return
      }
      try wakeParent(task, request)
    } |> ((effect, event) =>
      effect.pipe(
        Effect.catchCause((cause) =>
          Effect.logWarning("waking the parent of a delegated task question failed", {
            threadId: event.threadId,
            cause,
          })
        ),
      ))(%, event))

  const start: DelegatedTaskQuestionReactor["Service"]["start"] = () =>
    forkParked(
      Stream.runForEach(engine.streamDomainEvents, handle).pipe(
        Effect.catchCause((cause) => Effect.logWarning("delegated task question event stream failed", { cause })),
      ),
    )

  return { start, handle } satisfies DelegatedTaskQuestionReactor["Service"]
})

export const layer = Layer.effect(DelegatedTaskQuestionReactor, make)
