import type { OrchestrationV2AppThread, OrchestrationV2CheckpointScope } from "@t3tools/contracts";
import * as Effect from "effect/Effect";
import type * as FileSystem from "effect/FileSystem";
import type * as Path from "effect/Path";
import type { ProjectionStoreV2 } from "./ProjectionStore.ts";
import type * as ProjectStore from "./ProjectStore.ts";

export const SHARED_WORKSPACE_RESTORE_MESSAGE =
  "File restore requires an isolated worktree. This workspace may contain changes from another thread. Rewind the conversation without restoring files instead.";

// Check isolation at admission and rollback; checkpoints restore whole checkouts, which may become shared.
export const isCheckpointRestoreIsolated = effect (
    thread: Pick<{ readonly createdBy: "agent" | "system" | "user"; readonly creationSource: "mcp" | "mobile" | "provider" | "server" | "web"; readonly id: string & import("effect/Brand").Brand<"ThreadId">; readonly projectId: string & import("effect/Brand").Brand<"ProjectId">; readonly title: string; readonly providerInstanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">; readonly modelSelection: { readonly instanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">; readonly model: string; readonly options?: readonly { id: string; value: string | boolean; }[]; }; readonly runtimeMode: "approval-required" | "auto" | "auto-accept-edits" | "full-access"; readonly interactionMode: "default" | "plan"; readonly branch: string | null; readonly worktreePath: string | null; readonly linkedPullRequest?: { projectId: string & import("effect/Brand").Brand<"ProjectId">; repository: string; number: number; url: string; } | null | undefined; readonly pullRequests?: readonly { host: string; repository: string; number: number; readonly url: string; readonly repositoryWebUrl?: string | undefined; readonly source: "agent" | "created" | "manual" | "stack" | "stack-dismissed"; readonly linkedAt: string; readonly snapshot: { readonly state: "closed" | "merged" | "open"; readonly title: string; readonly headBranch: string; readonly baseBranch: string; readonly isDraft: boolean; readonly updatedAt: string | null; readonly syncedAt: string; readonly closedAt?: string | null | undefined; readonly mergedAt?: string | null | undefined; readonly author?: { readonly isBot?: boolean | undefined; readonly login: string; readonly name: string | null; readonly avatarUrl: string | null; } | null | undefined; readonly additions?: number | undefined; readonly deletions?: number | undefined; readonly changedFiles?: number | undefined; readonly reviewDecision?: "approved" | "changes-requested" | "review-required" | null | undefined; readonly checksState?: "failing" | "passing" | "pending" | null | undefined; readonly mergeability?: "conflicting" | "mergeable" | "unknown" | undefined; } | null; readonly stack: { kind: "native"; id: string; number: number; url: string; base: string; layers: readonly { number: number; headBranch: string; state: "closed" | "merged" | "open"; }[]; } | null; readonly watch?: { readonly startedAt: string; readonly headSha: string | null; readonly failedChecks: readonly string[]; readonly passed: boolean; readonly passedChecks: readonly string[]; readonly owedChecks?: readonly string[] | undefined; readonly remarksThrough: string; readonly remarkIds: readonly string[]; readonly conflicting: boolean; readonly wakes: number; readonly checksAwaitedSince?: string | null | undefined; } | undefined; readonly endedWatch?: { readonly startedAt: string; readonly headSha: string | null; readonly failedChecks: readonly string[]; readonly passed: boolean; readonly passedChecks: readonly string[]; readonly owedChecks?: readonly string[] | undefined; readonly remarksThrough: string; readonly remarkIds: readonly string[]; readonly conflicting: boolean; readonly wakes: number; readonly checksAwaitedSince?: string | null | undefined; } | undefined; }[] | undefined; readonly branchPullRequest?: { projectId: string & import("effect/Brand").Brand<"ProjectId">; repository: string; number: number; url: string; } | null | undefined; readonly activeProviderThreadId: (string & import("effect/Brand").Brand<"ProviderThreadId">) | null; readonly historyOrigin?: "native" | "v1_import" | undefined; readonly linkOrigin?: { readonly sessionId: string; readonly label: string; readonly access?: "approval-required" | "auto" | "auto-accept-edits" | "full-access" | "read-only" | undefined; } | undefined; readonly delegatedFrom?: { readonly environmentId: string & import("effect/Brand").Brand<"EnvironmentId">; readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; readonly title: string; } | undefined; readonly lineage: { readonly parentThreadId: (string & import("effect/Brand").Brand<"ThreadId">) | null; readonly relationshipToParent: "fork" | "subagent" | null; readonly rootThreadId: string & import("effect/Brand").Brand<"ThreadId">; }; readonly forkedFrom: { readonly type: "run"; readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; readonly runId: string & import("effect/Brand").Brand<"RunId">; } | { readonly type: "node"; readonly nodeId: string & import("effect/Brand").Brand<"NodeId">; } | { readonly type: "provider_thread"; readonly providerThreadId: string & import("effect/Brand").Brand<"ProviderThreadId">; readonly providerTurnId?: (string & import("effect/Brand").Brand<"ProviderTurnId">) | undefined; } | null; readonly createdAt: import("effect/DateTime").Utc; readonly updatedAt: import("effect/DateTime").Utc; readonly archivedAt: import("effect/DateTime").Utc | null; readonly settledOverride: "active" | "settled" | null; readonly settledAt: import("effect/DateTime").Utc | null; readonly unsettledAt?: import("effect/DateTime").Utc | null | undefined; readonly snoozedUntil?: import("effect/DateTime").Utc | null | undefined; readonly snoozedAt?: import("effect/DateTime").Utc | null | undefined; readonly lastSnoozeWakeAt?: import("effect/DateTime").Utc | null | undefined; readonly limitRecovery?: { readonly requestId?: (string & import("effect/Brand").Brand<"CommandId">) | undefined; readonly runId: string & import("effect/Brand").Brand<"RunId">; readonly resetAt: string; readonly autoResume: boolean; readonly snooze?: boolean | undefined; } | null | undefined; readonly guestShare?: { readonly id: string & import("effect/Brand").Brand<"GuestShareId">; readonly host: string; readonly createdAt: string; readonly expiresAt: string; readonly guestName: string | null; readonly messages: readonly { readonly id: string & import("effect/Brand").Brand<"GuestMessageId">; readonly text: string; readonly status: "dismissed" | "pending" | "sent"; readonly submittedAt: string; readonly attachments?: readonly ({ readonly type: string; readonly id: string; readonly name: string; readonly mimeType: string; readonly sizeBytes: number; } | { readonly type: "image"; readonly id: string; readonly name: string; readonly mimeType: string; readonly sizeBytes: number; readonly source?: { readonly kind: "snap-shot"; readonly capturedAt: string; readonly appName: string; readonly windowTitle: string; readonly accessibleText?: string | undefined; readonly accessibility?: { readonly format: "flat-text"; readonly text: string; readonly truncated: boolean; } | { readonly format: "element-tree"; readonly coordinateSpace: "captured-image"; readonly imageSize: { readonly width: number; readonly height: number; }; readonly truncated: boolean; readonly root: import("@t3tools/contracts").SnapShotAccessibilityNode; } | undefined; readonly appIdentifier?: string | undefined; readonly appIconDataUrl?: string | undefined; } | undefined; } | { readonly type: "file"; readonly id: string; readonly name: string; readonly mimeType: string; readonly sizeBytes: number; readonly source?: { readonly _tag: "pasted-text"; } | undefined; })[] | undefined; }[]; } | null | undefined; readonly pinnedAt?: import("effect/DateTime").Utc | null | undefined; readonly autoSettleDisabledAt?: import("effect/DateTime").Utc | null | undefined; readonly pinOrderKey?: string | null | undefined; readonly activeOrderKey?: string | null | undefined; readonly lastVisitedAt: import("effect/DateTime").Utc | null; readonly opens?: { readonly openedAt: number; readonly score: number; readonly picks: readonly { readonly query: string; readonly at: number; }[]; } | null | undefined; readonly titleRegeneration?: { readonly requestId: string & import("effect/Brand").Brand<"CommandId">; readonly startedAt: import("effect/DateTime").Utc; } | null | undefined; readonly rollbackRequestId?: (string & import("effect/Brand").Brand<"CommandId">) | undefined; readonly rollbackFailure?: { readonly requestId: string & import("effect/Brand").Brand<"CommandId">; readonly message: string; } | null | undefined; readonly deletedAt: import("effect/DateTime").Utc | null; }, "id" | "worktreePath">,
    scope: Pick<{ readonly id: string & import("effect/Brand").Brand<"CheckpointScopeId">; readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; readonly runId: (string & import("effect/Brand").Brand<"RunId">) | null; readonly nodeId: string & import("effect/Brand").Brand<"NodeId">; readonly parentScopeId: (string & import("effect/Brand").Brand<"CheckpointScopeId">) | null; readonly providerThreadId: (string & import("effect/Brand").Brand<"ProviderThreadId">) | null; readonly kind: "manual" | "provider_thread" | "root_run" | "subagent" | "tool"; readonly ordinalWithinParent: number; readonly advancesAppRunCount: boolean; readonly cwd: string; readonly createdAt: import("effect/DateTime").Utc; }, "cwd">,
    dependencies: { readonly fileSystem: FileSystem.FileSystem; readonly projections: ProjectionStoreV2["Service"]; readonly projects: ProjectStore.ProjectStoreV2["Service"]; readonly path: Path.Path; },
  ) => try withSpan(effect {
  const { fileSystem, projections, projects, path } = dependencies;
  const contains = (parent: string, child: string) => {
    const relative = path.relative(parent, child);
    return (
      relative === "" ||
      (!path.isAbsolute(relative) && relative !== ".." && !relative.startsWith(`..${path.sep}`))
    );
  };
  const worktreePath = thread.worktreePath;
  let shared = worktreePath == null;
  if (!shared && worktreePath !== null) {
    // Storage cleanup may have removed the worktree; rollback recreates it.
    const resolve = (target: string) =>
      fileSystem.realPath(target)
        |> catchIf(
          %, (error) => error.reason._tag === "NotFound",
          (_error) => succeed(path.resolve(target)),
        );
    const cwd = try resolve(scope.cwd);
    const worktreeCwd = try resolve(worktreePath);
    shared = cwd !== worktreeCwd;
    if (!shared) {
      const shell = try projections.getShellSnapshot();
      const checkedPaths = new Set<string>();
      for (const otherThread of [...shell.threads, ...shell.archivedThreads]) {
        if (otherThread.id === thread.id || otherThread.deletedAt !== null) continue;
        const other = try projections.getCheckpointContext(otherThread.id);
        const providerContext = try projections.getThreadProviderContext(otherThread.id);
        const paths = [
          otherThread.worktreePath,
          ...other.checkpointScopes.map((candidate) => candidate.cwd),
          // Errored sessions can still stream. Shared sessions retain another thread's opening cwd;
          // turn worktrees and project roots are already covered here.
          ...providerContext.providerSessions
            .filter(
              (session) =>
                session.status !== "stopped" &&
                !session.capabilities.sessions.supportsMultipleProviderThreadsPerSession,
            )
            .map((session) => session.cwd),
        ].filter((value): value is string => value !== null);
        if (otherThread.worktreePath === null) {
          const project = try projects.get(otherThread.projectId, { includeDeleted: true });
          if (Option.isNone(project)) return false;
          paths.push(project.value.workspaceRoot);
        }
        for (const candidate of paths) {
          if (checkedPaths.has(candidate)) continue;
          checkedPaths.add(candidate);
          const otherCwd = try (fileSystem.realPath(candidate)
            |> catchIf(
              %, (error) => error.reason._tag === "NotFound",
              (_error) => succeed(null),
            ));
          if (otherCwd !== null && (contains(cwd, otherCwd) || contains(otherCwd, cwd))) {
            shared = true;
            break;
          }
        }
        if (shared) break;
      }
    }
  }
  return !shared;
}, "orchestrationV2.isCheckpointRestoreIsolated");
