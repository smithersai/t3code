import { resolveProjectSettings } from "@t3tools/shared/projectSettings";
import {
  CommandId,
  type ChatAttachment,
  type MessageId,
  type OrchestrationV2AppThread,
  type OrchestrationV2ConversationMessage,
  type RunId,
  type ServerSettingsError,
  type ThreadId,
} from "@t3tools/contracts";
import * as Context from "effect/Context";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";

import * as ServerSettings from "../serverSettings.ts";
import * as TextGeneration from "../textGeneration/TextGeneration.ts";
import type { OrchestratorV2Error } from "./Orchestrator.ts";
import * as ProjectStore from "./ProjectStore.ts";
import * as ThreadManagementService from "./ThreadManagementService.ts";

import { formatThreadTitleContext } from "@t3tools/provider-core/server/threadTitleContext";
export { formatThreadTitleContext } from "@t3tools/provider-core/server/threadTitleContext";

export service ThreadTitleRegenerationService: {
    readonly execute: (input: {
      readonly threadId: ThreadId;
      readonly requestId: CommandId;
      readonly kind:
        | { readonly type: "initial"; readonly messageId: MessageId }
        | { readonly type: "regenerate" };
    }) => void!(| OrchestratorV2Error
      | ProjectStore.ProjectStoreV2Error
      | ServerSettingsError
      | ThreadManagementService.ThreadManagementProviderInstanceDisabledError);
  } {
  static readonly key = "t3/orchestration-v2/ThreadTitleRegenerationService"
}

const make = effect {
  const threads = try ThreadManagementService.ThreadManagementService;
  const projects = try ProjectStore.ProjectStoreV2;
  const serverSettings = try ServerSettings.ServerSettingsService;
  const textGeneration = try TextGeneration.TextGeneration;

  const complete = (input: {
    readonly threadId: ThreadId;
    readonly requestId: CommandId;
    readonly title?: string;
  }) =>
    threads
      .dispatch({
        type: "thread.title.regeneration.complete",
        commandId: CommandId.make(`${input.requestId}:title-complete`),
        threadId: input.threadId,
        requestId: input.requestId,
        ...(input.title === undefined ? {} : { title: input.title }),
      })|> asVoid(%);

  const messagesThroughRun = effect (threadId: string & import("effect/Brand").Brand<"ThreadId">, runId: string & import("effect/Brand").Brand<"RunId">) => try withSpan(effect {
    const source = try threads.getThreadRecords(threadId, ["messages", "runs"], {
      messageRoles: ["user", "assistant"],
    });
    const ordinals = new Map(
      source.runs
        .filter((run) => run.status !== "rolled_back")
        .map((run) => [run.id, run.ordinal]),
    );
    const forkOrdinal = ordinals.get(runId) ?? -1;
    const messages = source.messages.filter((message) => {
      if (message.streaming) return false;
      if (message.runId === null) return source.thread.historyOrigin === "v1_import";
      return (ordinals.get(message.runId) ?? Infinity) <= forkOrdinal;
    });
    return { thread: source.thread, messages };
  }, "ThreadTitleRegenerationService.messagesThroughRun");

  // A fork starts with no messages of its own, so its subject lives in the history it inherited.
  const forkSource = effect (
    thread: { readonly createdBy: "agent" | "system" | "user"; readonly creationSource: "mcp" | "mobile" | "provider" | "server" | "web"; readonly id: string & import("effect/Brand").Brand<"ThreadId">; readonly projectId: string & import("effect/Brand").Brand<"ProjectId">; readonly title: string; readonly providerInstanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">; readonly modelSelection: { readonly instanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">; readonly model: string; readonly options?: readonly { id: string; value: string | boolean; }[]; }; readonly runtimeMode: "approval-required" | "auto" | "auto-accept-edits" | "full-access"; readonly interactionMode: "default" | "plan"; readonly branch: string | null; readonly worktreePath: string | null; readonly linkedPullRequest?: { projectId: string & import("effect/Brand").Brand<"ProjectId">; repository: string; number: number; url: string; } | null | undefined; readonly pullRequests?: readonly { host: string; repository: string; number: number; readonly url: string; readonly repositoryWebUrl?: string | undefined; readonly source: "agent" | "created" | "manual" | "stack" | "stack-dismissed"; readonly linkedAt: string; readonly snapshot: { readonly state: "closed" | "merged" | "open"; readonly title: string; readonly headBranch: string; readonly baseBranch: string; readonly isDraft: boolean; readonly updatedAt: string | null; readonly syncedAt: string; readonly closedAt?: string | null | undefined; readonly mergedAt?: string | null | undefined; readonly author?: { readonly isBot?: boolean | undefined; readonly login: string; readonly name: string | null; readonly avatarUrl: string | null; } | null | undefined; readonly additions?: number | undefined; readonly deletions?: number | undefined; readonly changedFiles?: number | undefined; readonly reviewDecision?: "approved" | "changes-requested" | "review-required" | null | undefined; readonly checksState?: "failing" | "passing" | "pending" | null | undefined; readonly mergeability?: "conflicting" | "mergeable" | "unknown" | undefined; } | null; readonly stack: { kind: "native"; id: string; number: number; url: string; base: string; layers: readonly { number: number; headBranch: string; state: "closed" | "merged" | "open"; }[]; } | null; readonly watch?: { readonly startedAt: string; readonly headSha: string | null; readonly failedChecks: readonly string[]; readonly passed: boolean; readonly passedChecks: readonly string[]; readonly owedChecks?: readonly string[] | undefined; readonly remarksThrough: string; readonly remarkIds: readonly string[]; readonly conflicting: boolean; readonly wakes: number; readonly checksAwaitedSince?: string | null | undefined; } | undefined; readonly endedWatch?: { readonly startedAt: string; readonly headSha: string | null; readonly failedChecks: readonly string[]; readonly passed: boolean; readonly passedChecks: readonly string[]; readonly owedChecks?: readonly string[] | undefined; readonly remarksThrough: string; readonly remarkIds: readonly string[]; readonly conflicting: boolean; readonly wakes: number; readonly checksAwaitedSince?: string | null | undefined; } | undefined; }[] | undefined; readonly branchPullRequest?: { projectId: string & import("effect/Brand").Brand<"ProjectId">; repository: string; number: number; url: string; } | null | undefined; readonly activeProviderThreadId: (string & import("effect/Brand").Brand<"ProviderThreadId">) | null; readonly historyOrigin?: "native" | "v1_import" | undefined; readonly linkOrigin?: { readonly sessionId: string; readonly label: string; readonly access?: "approval-required" | "auto" | "auto-accept-edits" | "full-access" | "read-only" | undefined; } | undefined; readonly delegatedFrom?: { readonly environmentId: string & import("effect/Brand").Brand<"EnvironmentId">; readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; readonly title: string; } | undefined; readonly lineage: { readonly parentThreadId: (string & import("effect/Brand").Brand<"ThreadId">) | null; readonly relationshipToParent: "fork" | "subagent" | null; readonly rootThreadId: string & import("effect/Brand").Brand<"ThreadId">; }; readonly forkedFrom: { readonly type: "run"; readonly threadId: string & import("effect/Brand").Brand<"ThreadId">; readonly runId: string & import("effect/Brand").Brand<"RunId">; } | { readonly type: "node"; readonly nodeId: string & import("effect/Brand").Brand<"NodeId">; } | { readonly type: "provider_thread"; readonly providerThreadId: string & import("effect/Brand").Brand<"ProviderThreadId">; readonly providerTurnId?: (string & import("effect/Brand").Brand<"ProviderTurnId">) | undefined; } | null; readonly createdAt: import("effect/DateTime").Utc; readonly updatedAt: import("effect/DateTime").Utc; readonly archivedAt: import("effect/DateTime").Utc | null; readonly settledOverride: "active" | "settled" | null; readonly settledAt: import("effect/DateTime").Utc | null; readonly unsettledAt?: import("effect/DateTime").Utc | null | undefined; readonly snoozedUntil?: import("effect/DateTime").Utc | null | undefined; readonly snoozedAt?: import("effect/DateTime").Utc | null | undefined; readonly lastSnoozeWakeAt?: import("effect/DateTime").Utc | null | undefined; readonly limitRecovery?: { readonly requestId?: (string & import("effect/Brand").Brand<"CommandId">) | undefined; readonly runId: string & import("effect/Brand").Brand<"RunId">; readonly resetAt: string; readonly autoResume: boolean; readonly snooze?: boolean | undefined; } | null | undefined; readonly guestShare?: { readonly id: string & import("effect/Brand").Brand<"GuestShareId">; readonly host: string; readonly createdAt: string; readonly expiresAt: string; readonly guestName: string | null; readonly messages: readonly { readonly id: string & import("effect/Brand").Brand<"GuestMessageId">; readonly text: string; readonly status: "dismissed" | "pending" | "sent"; readonly submittedAt: string; readonly attachments?: readonly ({ readonly type: string; readonly id: string; readonly name: string; readonly mimeType: string; readonly sizeBytes: number; } | { readonly type: "image"; readonly id: string; readonly name: string; readonly mimeType: string; readonly sizeBytes: number; readonly source?: { readonly kind: "snap-shot"; readonly capturedAt: string; readonly appName: string; readonly windowTitle: string; readonly accessibleText?: string | undefined; readonly accessibility?: { readonly format: "flat-text"; readonly text: string; readonly truncated: boolean; } | { readonly format: "element-tree"; readonly coordinateSpace: "captured-image"; readonly imageSize: { readonly width: number; readonly height: number; }; readonly truncated: boolean; readonly root: import("@t3tools/contracts").SnapShotAccessibilityNode; } | undefined; readonly appIdentifier?: string | undefined; readonly appIconDataUrl?: string | undefined; } | undefined; } | { readonly type: "file"; readonly id: string; readonly name: string; readonly mimeType: string; readonly sizeBytes: number; readonly source?: { readonly _tag: "pasted-text"; } | undefined; })[] | undefined; }[]; } | null | undefined; readonly pinnedAt?: import("effect/DateTime").Utc | null | undefined; readonly autoSettleDisabledAt?: import("effect/DateTime").Utc | null | undefined; readonly pinOrderKey?: string | null | undefined; readonly activeOrderKey?: string | null | undefined; readonly lastVisitedAt: import("effect/DateTime").Utc | null; readonly opens?: { readonly openedAt: number; readonly score: number; readonly picks: readonly { readonly query: string; readonly at: number; }[]; } | null | undefined; readonly titleRegeneration?: { readonly requestId: string & import("effect/Brand").Brand<"CommandId">; readonly startedAt: import("effect/DateTime").Utc; } | null | undefined; readonly rollbackRequestId?: (string & import("effect/Brand").Brand<"CommandId">) | undefined; readonly rollbackFailure?: { readonly requestId: string & import("effect/Brand").Brand<"CommandId">; readonly message: string; } | null | undefined; readonly deletedAt: import("effect/DateTime").Utc | null; },
  ) => try withSpan(effect {
    let title: string | undefined;
    const history: Array<ReadonlyArray<OrchestrationV2ConversationMessage>> = [];
    let forkedFrom = thread.forkedFrom;
    while (forkedFrom?.type === "run") {
      const source = try messagesThroughRun(forkedFrom.threadId, forkedFrom.runId);
      history.push(source.messages);
      title ??= source.thread.title;
      forkedFrom = source.thread.forkedFrom;
    }
    const context = try orDie(Effect.try({ try: () => formatThreadTitleContext(history.reverse().flat()), catch: (error) => error }));
    return title === undefined || context.message.length === 0
      ? undefined
      : { title, history: context.message };
  }, "ThreadTitleRegenerationService.forkSource");

  const execute: ThreadTitleRegenerationService["Service"]["execute"] = effect (input) => try withSpan(effect {
    const outcome:
      | { readonly type: "stale" }
      | { readonly type: "complete"; readonly title?: string } = try ((effect {
      const projection = try threads.getThreadRecords(
        input.threadId,
        ["messages"],
        input.kind.type === "initial"
          ? { messageIds: [input.kind.messageId] }
          : { messageRoles: ["user", "assistant"] },
      );
      if (projection.thread.titleRegeneration?.requestId !== input.requestId) {
        return { type: "stale" as const };
      }

      const project = try projects.get(projection.thread.projectId);
      if (Option.isNone(project)) {
        return { type: "complete" as const };
      }

      let context: {
        readonly message: string;
        readonly attachments: ReadonlyArray<ChatAttachment>;
      };
      if (input.kind.type === "initial") {
        const messageId = input.kind.messageId;
        const message = projection.messages.find(
          (candidate) => candidate.id === messageId && !candidate.streaming,
        );
        context =
          message === undefined
            ? { message: "", attachments: [] }
            : { message: message.text, attachments: message.attachments };
      } else {
        context = (try orDie(Effect.try({ try: () => formatThreadTitleContext(
          projection.messages.filter((message) => !message.streaming),
        ), catch: (error) => error })));
      }
      if (context.message.length === 0 && context.attachments.length === 0) {
        return { type: "complete" as const };
      }

      // A deleted source should not cost the fork its title.
      const inherited = forkSource(projection.thread) catch () => undefined;
      const settings2 = try serverSettings.getSettings
      const settings = (try orDie(Effect.try({ try: () => resolveProjectSettings(
        settings2,
        projection.thread.projectId,
      ), catch: (error) => error }))).settings;
      const result = try textGeneration.generateThreadTitle({
        cwd: projection.thread.worktreePath ?? project.value.workspaceRoot,
        message: context.message,
        attachments: context.attachments,
        ...(input.kind.type === "regenerate" ? { previousTitle: projection.thread.title } : {}),
        ...(inherited === undefined ? {} : { forkSource: inherited }),
        instructions: settings.threadTitleInstructions,
        modelSelection: settings.textGenerationModelSelection,
      });
      const generatedTitle = result.title.trim();
      return generatedTitle === "New thread" ||
        (input.kind.type === "regenerate" && generatedTitle === projection.thread.title.trim())
        ? { type: "complete" as const }
        : { type: "complete" as const, title: result.title };
    })
      |> retry(%, {
        times: input.kind.type === "initial" ? 2 : 0,
        schedule: Schedule.exponential("2 seconds"),
      })
      |> catchCause(%, (cause) =>
        Cause.hasInterruptsOnly(cause)
          ? Effect.interrupt
          : (logWarning("Thread title generation failed", {
              threadId: input.threadId,
              requestId: input.requestId,
              cause,
            }) |> as(%, { type: "complete" as const })),
      ));

    if (outcome.type === "stale") {
      return;
    }
    try complete({
      ...input,
      ...(outcome.title === undefined ? {} : { title: outcome.title }),
    });
  }, "ThreadTitleRegenerationService.execute");

  return ThreadTitleRegenerationService.of({ execute });
};

export const layer = Layer.effect(ThreadTitleRegenerationService, make);
