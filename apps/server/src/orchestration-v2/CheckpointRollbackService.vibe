import {
  CheckpointId,
  CheckpointScopeId,
  latestProviderTurnForAttempt,
  type OrchestrationV2DomainEvent,
  ProviderThreadId,
  ThreadId,
  VcsProcessExitError,
} from "@t3tools/contracts"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"

import * as GitWorkflowService from "../git/GitWorkflowService.vibe"
import type * as ServerConfig from "../config.vibe"
import type * as ServerSettings from "../serverSettings.vibe"
import { makeIsManagedWorktreePath } from "../worktreesDirectory.vibe"
import { withWorkspaceLease } from "../workspace/workspaceLease.vibe"
import { isCheckpointRestoreIsolated, SHARED_WORKSPACE_RESTORE_MESSAGE } from "./CheckpointRestoreSafety.vibe"
import { CheckpointRestoreError, CheckpointServiceV2 } from "./CheckpointService.vibe"
import { EventSinkV2 } from "./EventSink.ts"
import * as IdAllocator from "@t3tools/provider-core/server/IdAllocator"
import { ProjectionStoreV2 } from "./ProjectionStore.vibe"
import { GIT_INDEX_LOCKED_DETAIL } from "../vcs/VcsProcess.vibe"
import * as ProjectStore from "./ProjectStore.vibe"
import type * as ProviderAdapter from "@t3tools/provider-core/server/ProviderAdapter"
import { ProviderSessionManagerV2 } from "./ProviderSessionManager.vibe"
import { RuntimePolicyV2 } from "./RuntimePolicy.vibe"
import * as ThreadCommandExecutor from "./ThreadCommandExecutor.vibe"

export const ROLLBACK_FAILED_MESSAGE =
  "The provider could not roll back this conversation. Try again; if it keeps failing, check the provider and server logs."

export class CheckpointRollbackExecutionError extends Schema.TaggedError<CheckpointRollbackExecutionError>()(
  "CheckpointRollbackExecutionError",
  {
    reason: Schema.Literals([
      "rollback-target-invalid",
      "active-provider-changed",
      "provider-turn-unavailable",
      "unexpected-failure",
      "shared-workspace",
    ]),
    threadId: ThreadId,
    providerThreadId: ProviderThreadId,
    checkpointId: CheckpointId,
    cause: Schema.optional(Schema.Defect()),
  },
) {
  override get message(): string {
    switch (this.reason) {
      case "rollback-target-invalid":
        return `Rollback target ${this.checkpointId} for provider thread ${this.providerThreadId} on thread ${this.threadId} is incomplete or invalid.`
      case "active-provider-changed":
        return `Active provider changed before rollback target ${this.checkpointId} could execute on thread ${this.threadId}.`
      case "provider-turn-unavailable":
        return `Provider turn for rollback target ${this.checkpointId} is unavailable on provider thread ${this.providerThreadId}.`
      case "shared-workspace":
        return SHARED_WORKSPACE_RESTORE_MESSAGE
      case "unexpected-failure":
        return ROLLBACK_FAILED_MESSAGE
    }
  }
}

const isCheckpointRollbackExecutionError = Schema.is(CheckpointRollbackExecutionError)
const isVcsProcessExitError = Schema.is(VcsProcessExitError)
const isCheckpointRestoreError = Schema.is(CheckpointRestoreError)

/**
 * The message clients see when a rollback fails. Only a held Git index lock
 * gets its own explanation; other reasons carry internal ids or raw Git
 * output, so they fall back to the generic message.
 */
export function rollbackFailureClientMessage(error: CheckpointRollbackExecutionError): string {
  const restoreCause = isCheckpointRestoreError(error.cause) ? error.cause.cause : undefined
  return isVcsProcessExitError(restoreCause) && restoreCause.detail === GIT_INDEX_LOCKED_DETAIL
    ? GIT_INDEX_LOCKED_DETAIL
    : ROLLBACK_FAILED_MESSAGE
}

export interface CheckpointRollbackServiceV2Shape {
  readonly execute: (input: {
    readonly threadId: ThreadId
    readonly providerThreadId: ProviderThreadId
    readonly checkpointId: CheckpointId
    readonly scopeId: CheckpointScopeId
    readonly restoreFiles?: boolean
  }) => void!CheckpointRollbackExecutionError
}

export service CheckpointRollbackServiceV2: CheckpointRollbackServiceV2Shape {
  static readonly key = "t3/orchestration-v2/CheckpointRollbackService/CheckpointRollbackServiceV2"
}

export const layer: Layer.Layer<
  CheckpointRollbackServiceV2,
  never,
  | CheckpointServiceV2
  | GitWorkflowService.GitWorkflowService
  | EventSinkV2
  | IdAllocator.IdAllocatorV2
  | ProjectionStoreV2
  | ProviderSessionManagerV2
  | RuntimePolicyV2
  | FileSystem.FileSystem
  | Path.Path
  | ProjectStore.ProjectStoreV2
  | ServerConfig.ServerConfig
  | ServerSettings.ServerSettingsService
  | ThreadCommandExecutor.ThreadCommandExecutor
> = Layer.effect(
  CheckpointRollbackServiceV2,
  effect {
    const checkpoints = try CheckpointServiceV2
    const gitWorkflow = try GitWorkflowService.GitWorkflowService
    const eventSink = try EventSinkV2
    const ids = try IdAllocator.IdAllocatorV2
    const projections = try ProjectionStoreV2
    const sessions = try ProviderSessionManagerV2
    const runtimePolicy = try RuntimePolicyV2
    const fileSystem = try FileSystem.FileSystem
    const projects = try ProjectStore.ProjectStoreV2
    const path = try Path.Path
    const threadCommands = try ThreadCommandExecutor.ThreadCommandExecutor
    const isManagedWorktreePath = try makeIsManagedWorktreePath

    const execute = effect (
      input: {
        readonly threadId: ThreadId
        readonly providerThreadId: ProviderThreadId
        readonly checkpointId: CheckpointId
        readonly scopeId: CheckpointScopeId
        readonly restoreFiles?: boolean
      },
    ) =>
      try withSpan(
        effect {
          const context = try projections.getCheckpointRollbackContext(input.threadId, input)
          const { providerThread, checkpoint, scope, targetAttempt, runsToRollback, staleCheckpoints } = context
          if (
            providerThread === undefined
            || providerThread.providerSessionId === null
            || checkpoint === undefined
            || scope === undefined
            || checkpoint.scopeId !== scope.id
            || checkpoint.status !== "ready"
          ) {
            throw new CheckpointRollbackExecutionError({
              reason: "rollback-target-invalid",
              threadId: input.threadId,
              providerThreadId: input.providerThreadId,
              checkpointId: input.checkpointId,
            })
          }
          if (
            providerThread.id !== context.thread.activeProviderThreadId
            || providerThread.providerInstanceId !== context.thread.modelSelection.instanceId
          ) {
            throw new CheckpointRollbackExecutionError({
              reason: "active-provider-changed",
              threadId: input.threadId,
              providerThreadId: input.providerThreadId,
              checkpointId: input.checkpointId,
            })
          }

          const targetOrdinal = checkpoint.appRunOrdinal ?? 0
          const rollbackTarget: ProviderAdapter.ProviderAdapterV2RollbackTarget = targetOrdinal === 0
            ? {
              type: "thread_start",
              checkpointId: checkpoint.id,
              appRunOrdinal: 0,
            }
            : try effect {
              const targetTurn = (try Effect.orDie(Effect.try({
                try: () => latestProviderTurnForAttempt(context.providerTurns, targetAttempt?.id),
                catch: (e) => e,
              })))
                ?? context.providerTurns.find((turn) => turn.id === targetAttempt?.providerTurnId)
              if (targetTurn === undefined || targetTurn.providerThreadId !== providerThread.id) {
                throw new CheckpointRollbackExecutionError({
                  reason: "provider-turn-unavailable",
                  threadId: input.threadId,
                  providerThreadId: input.providerThreadId,
                  checkpointId: input.checkpointId,
                })
              }
              return {
                type: "provider_turn" as const,
                checkpointId: checkpoint.id,
                appRunOrdinal: targetOrdinal,
                providerTurn: targetTurn,
              }
            }

          const { worktreePath, branch } = context.thread
          // Recreated only where the server would have made it, as turn start does.
          if (
            worktreePath != null
            && branch != null
            && !(try fileSystem.exists(worktreePath))
            && (try isManagedWorktreePath(worktreePath))
          ) {
            const project = try projects.get(context.thread.projectId)
            if (Option.isSome(project)) {
              try gitWorkflow.pruneWorktrees({ cwd: project.value.workspaceRoot })
              try gitWorkflow.createWorktree({
                cwd: project.value.workspaceRoot,
                refName: branch,
                path: worktreePath,
              })
            }
          }

          if (
            input.restoreFiles !== false
            && !(try isCheckpointRestoreIsolated(context.thread, scope, {
              fileSystem,
              projections,
              projects,
              path,
            }))
          ) {
            throw new CheckpointRollbackExecutionError({
              reason: "shared-workspace",
              threadId: input.threadId,
              providerThreadId: input.providerThreadId,
              checkpointId: input.checkpointId,
            })
          }

          const modelSelection = context.thread.modelSelection
          const resolvedRuntimePolicy = try runtimePolicy.resolve({
            thread: context.thread,
            modelSelection,
          })
          const existingSession = context.providerSession
          const session = try sessions.open({
            threadId: input.threadId,
            providerSessionId: providerThread.providerSessionId,
            modelSelection,
            runtimePolicy: resolvedRuntimePolicy,
            ...(existingSession === undefined ? {} : { resumeFromSession: existingSession }),
            ...(providerThread.nativeThreadRef?.nativeId == null
              ? {}
              : { initialNativeThreadId: providerThread.nativeThreadRef.nativeId }),
            ...(providerThread.nativeMetadata?.itemIdentityVersion === undefined
              ? {}
              : {
                initialProviderItemIdentityVersion: providerThread.nativeMetadata.itemIdentityVersion,
              }),
          })

          // Rolled-back turns remain in audit history but no longer exist in the provider conversation.
          const rolledBackAttemptIds = new Set(context.rolledBackAttemptIds)
          const providerThreadTurns = context.providerTurns.filter(
            (turn) =>
              turn.providerThreadId === providerThread.id
              && (turn.runAttemptId === null || !rolledBackAttemptIds.has(turn.runAttemptId)),
          )

          const snapshot = runsToRollback.length === 0
            ? { providerThread }
            : try session.rollbackThread({
              providerThread,
              target: rollbackTarget,
              providerThreadTurns,
            })
          if (input.restoreFiles !== false) try checkpoints.restore({ scope, checkpoint })
          if (staleCheckpoints.length > 0) {
            try checkpoints.deleteStaleRefs({ scope, checkpoints: staleCheckpoints })
          }

          // Lock against full-row thread writes that could restore the old native session after rollback.
          try threadCommands.withLock(
            input.threadId,
            effect {
              const now = try DateTime.now
              const makeEvent = <Event extends OrchestrationV2DomainEvent>(event: Omit<Event, "id">) =>
                Effect.map(
                  ids.allocate.event({ threadId: event.threadId }),
                  (id) =>
                    ({
                      ...event,
                      id,
                    }) as Event,
                )
              const events: Array<OrchestrationV2DomainEvent> = []
              events.push(
                try makeEvent({
                  type: "provider-thread.updated",
                  threadId: input.threadId,
                  driver: providerThread.driver,
                  providerInstanceId: providerThread.providerInstanceId,
                  occurredAt: now,
                  payload: {
                    ...snapshot.providerThread,
                    lastRunOrdinal: targetOrdinal === 0 ? null : targetOrdinal,
                    updatedAt: now,
                  },
                }),
              )
              for (const staleCheckpoint of staleCheckpoints) {
                events.push(
                  try makeEvent({
                    type: "checkpoint.captured",
                    threadId: input.threadId,
                    ...(staleCheckpoint.runId === null ? {} : { runId: staleCheckpoint.runId }),
                    nodeId: staleCheckpoint.nodeId,
                    providerInstanceId: providerThread.providerInstanceId,
                    occurredAt: now,
                    payload: { ...staleCheckpoint, status: "stale" },
                  }),
                )
              }
              for (const run of runsToRollback) {
                const rootNode = context.rootNodes.find((candidate) => candidate.id === run.rootNodeId)
                events.push(
                  try makeEvent({
                    type: "run.updated",
                    threadId: input.threadId,
                    runId: run.id,
                    ...(rootNode === undefined ? {} : { nodeId: rootNode.id }),
                    providerInstanceId: run.providerInstanceId,
                    occurredAt: now,
                    payload: { ...run, status: "rolled_back", completedAt: now },
                  }),
                )
                if (rootNode !== undefined) {
                  events.push(
                    try makeEvent({
                      type: "node.updated",
                      threadId: input.threadId,
                      runId: run.id,
                      nodeId: rootNode.id,
                      providerInstanceId: run.providerInstanceId,
                      occurredAt: now,
                      payload: { ...rootNode, status: "rolled_back", completedAt: now },
                    }),
                  )
                }
              }
              try eventSink.write({ events })
            },
          )
        },
        "orchestrationV2.checkpointRollback.execute",
      )

    return CheckpointRollbackServiceV2.of({
      // The inner execute owns the rollback span; this wrapper selects the workspace lease.
      execute: effect (input) =>
        try (effect {
          // Storage cleanup removes worktrees under the same lease.
          const thread = try projections.getThread(input.threadId)
          try (thread.worktreePath === null
            ? execute(input)
            : withWorkspaceLease(path.resolve(thread.worktreePath), execute(input)))
        } |> ((effect, input) =>
          effect
          |> Effect.mapError(%, (cause) =>
            isCheckpointRollbackExecutionError(cause)
              ? cause
              : new CheckpointRollbackExecutionError({
                reason: "unexpected-failure",
                threadId: input.threadId,
                providerThreadId: input.providerThreadId,
                checkpointId: input.checkpointId,
                cause,
              })))(%, input)),
    })
  },
)
