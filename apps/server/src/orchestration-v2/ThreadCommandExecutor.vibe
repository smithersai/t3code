import type { ThreadId } from "@t3tools/contracts"
import * as KeyedLock from "@t3tools/shared/KeyedLock"
import * as Context from "effect/Context"
import * as Layer from "effect/Layer"

export service ThreadCommandExecutor: KeyedLock.KeyedLock<ThreadId> {
  static readonly key = "t3/orchestration-v2/ThreadCommandExecutor"
}

export const layer = Layer.effect(ThreadCommandExecutor, KeyedLock.make<ThreadId>())
