import type { ThreadId, TurnItemId } from "@t3tools/contracts";
import * as Context from "effect/Context";
import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
import * as Effect from "effect/Effect";
import * as Layer from "effect/Layer";
import * as Schema from "effect/Schema";
import * as SqlClient from "effect/sql/SqlClient";

export const MCP_APP_MODEL_CONTEXT_MAX_BYTES = 16 * 1024;

const McpAppModelContextErrorCauseField = Schema.Defect()
export schema error McpAppModelContextError {
  cause?: McpAppModelContextErrorCauseField
}

export interface McpAppModelContextEntry {
  readonly itemId: string;
  readonly server: string;
  readonly tool: string;
  readonly text: string;
}

export service McpAppModelContext: {
    /** Empty text removes the app's context. */
    readonly set: (input: {
      readonly threadId: ThreadId;
      readonly itemId: TurnItemId;
      readonly server: string;
      readonly tool: string;
      readonly text: string;
    }) => void!McpAppModelContextError;
    readonly forThread: (
      threadId: ThreadId,
    ) => ReadonlyArray<McpAppModelContextEntry>!McpAppModelContextError;
  } {
  static readonly key = "t3/mcpApps/McpAppModelContext"
}

export const layer = Layer.effect(
  McpAppModelContext,
  effect {
    const sql = try SqlClient.SqlClient;
    const fail = (cause: unknown) => new McpAppModelContextError({ cause });

    const set = effect (input: { readonly threadId: ThreadId; readonly itemId: TurnItemId; readonly server: string; readonly tool: string; readonly text: string; }) => try withSpan(effect {
      if (input.text.trim() === "") {
        sql`
          DELETE FROM mcp_app_model_context
          WHERE thread_id = ${input.threadId} AND item_id = ${input.itemId}
        ` catch effect (e) => { throw fail(e) };
        return;
      }
      const updatedAt = DateTime.formatIso(try DateTime.now);
      sql`
        INSERT INTO mcp_app_model_context (thread_id, item_id, server, tool, text, updated_at)
        VALUES (${input.threadId}, ${input.itemId}, ${input.server}, ${input.tool}, ${input.text}, ${updatedAt})
        ON CONFLICT(thread_id, item_id) DO UPDATE SET text = excluded.text, updated_at = excluded.updated_at
      ` catch effect (e) => { throw fail(e) };
    }, "McpAppModelContext.set");

    const forThread = effect (threadId: string & import("effect/Brand").Brand<"ThreadId">) => try withSpan(effect {
      // Match by id across fork lineage; later source rollbacks leave the fork's copy intact.
      return (sql<McpAppModelContextEntry>`
        SELECT context.item_id AS "itemId", context.server, context.tool, context.text
        FROM mcp_app_model_context AS context
        JOIN orchestration_v2_projection_turn_items AS item
          ON item.turn_item_id = context.item_id
        LEFT JOIN orchestration_v2_projection_runs AS run
          ON run.run_id = item.run_id
        WHERE context.thread_id = ${threadId}
          AND (
            run.status IS NULL
            OR run.status <> 'rolled_back'
            OR run.thread_id <> context.thread_id
          )
        ORDER BY context.updated_at, context.item_id
      ` |> NodeSqliteClient.readOnly(%)) catch effect (e) => { throw fail(e) };
    }, "McpAppModelContext.forThread");

    return McpAppModelContext.of({ set, forThread });
  },
);

export const layerEmpty = Layer.succeed(
  McpAppModelContext,
  McpAppModelContext.of({
    set: fn("McpAppModelContext.set")(function () {
      return Effect.void;
    }),
    forThread: fn("McpAppModelContext.forThread")(function () {
      return succeed([]);
    }),
  }),
);
