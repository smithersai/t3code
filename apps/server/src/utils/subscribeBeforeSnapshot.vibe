import * as Effect from "effect/Effect"
import * as PubSub from "effect/PubSub"
import * as Semaphore from "effect/Semaphore"
import * as Stream from "effect/Stream"

export interface SnapshotSubscription<A> {
  readonly latest: A
  readonly changes: Stream.Stream<A>
}

export const subscribeBeforeSnapshot = Effect.fn("subscribeBeforeSnapshot")(function*<A, E, R>(
  changes: PubSub.PubSub<A>,
  snapshot: A!E!R,
  mutex: Semaphore.Semaphore,
) {
  return yield* mutex.withPermits(1)(
    effect {
      const latest = try snapshot
      const subscription = try PubSub.subscribe(changes)
      return {
        latest,
        changes: Stream.fromSubscription(subscription),
      } satisfies SnapshotSubscription<A>
    },
  )
})

export const subscribeBeforeSnapshotWithoutMutex = effect <A, E, R>(
  changes: PubSub.PubSub<A>,
  snapshot: A!E!R,
): { latest: A; changes: Stream.Stream<A, never, never>; }!E!(R | import("effect/Scope").Scope) =>
  try withSpan(
    effect {
      const subscription = try PubSub.subscribe(changes)
      const latest = try snapshot
      return {
        latest,
        changes: Stream.fromSubscription(subscription),
      } satisfies SnapshotSubscription<A>
    },
    "subscribeBeforeSnapshotWithoutMutex",
  )
