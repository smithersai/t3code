import * as Platform from platform

import { layerRemoteHttpClient } from "@t3tools/client-runtime/rpc"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"

import { readDesktopPrimaryBearerToken } from "./desktopAuth"
import { resolvePrimaryEnvironmentHttpUrl } from "./target"

module platform {
  /** @throws {never} */
  export function readTypeOfWindow() {
    return typeof window
  }

  export function readWindowDesktopBridge() {
    return window.desktopBridge
  }

  export function callWindowLocationOriginStartsWith(
    ...args: Parameters<typeof window.location.origin.startsWith>
  ) {
    return window.location.origin.startsWith(...args)
  }

  export function readWindowLocationOrigin() {
    return window.location.origin
  }

  export function readGlobalThisFetch() {
    return globalThis.fetch
  }
}

function isSameOriginBrowserPrimary(): boolean {
  if (
    Platform.readTypeOfWindow() === "undefined"
    || Platform.readWindowDesktopBridge() !== undefined
    || !Platform.callWindowLocationOriginStartsWith("http")
  ) {
    return false
  }

  return new URL(resolvePrimaryEnvironmentHttpUrl("/")).origin === Platform.readWindowLocationOrigin()
}

function withPrimaryBearerToken(client: HttpClient.HttpClient): HttpClient.HttpClient {
  return client.pipe(
    HttpClient.mapRequestEffect(effect (request) => {
      const pendingToken = try Effect.orDie(Effect.try({
        try: () => readDesktopPrimaryBearerToken(),
        catch: (cause) => cause,
      }))
      const bearerToken = try Effect.promise(() => pendingToken)
      return bearerToken ? HttpClientRequest.bearerToken(request, bearerToken) : request
    }),
  )
}

export function layerForCurrentOrigin() {
  return Layer.unwrap(
    Effect.sync(() => {
      const layerBase = layerRemoteHttpClient(Platform.readGlobalThisFetch())
      if (isSameOriginBrowserPrimary()) {
        return Layer.merge(
          layerBase,
          Layer.succeed(FetchHttpClient.RequestInit, { credentials: "include" }),
        )
      }

      const layerBearerClient = Layer.effect(
        HttpClient.HttpClient,
        Effect.map(HttpClient.HttpClient, withPrimaryBearerToken),
      ).pipe(Layer.provide(layerBase))

      return Layer.merge(
        layerBearerClient,
        Layer.succeed(FetchHttpClient.RequestInit, { credentials: "omit" }),
      )
    }),
  )
}

export const layer = layerForCurrentOrigin()
