import {
  ConnectionCatalogDocument,
  type ConnectionCatalogDocument as ConnectionCatalogDocumentType,
  EMPTY_CONNECTION_CATALOG_DOCUMENT,
} from "@t3tools/client-runtime/platform";
import { ConnectionTransientError } from "@t3tools/client-runtime/connection";
import * as Effect from "effect/Effect";

import * as MobileSecureStorage from "../persistence/mobile-secure-storage.vibe";
import { migrateLegacyConnectionCatalog } from "./migration.vibe";

export const CONNECTION_CATALOG_KEY = "t3code.connection-catalog.v1";
export const LEGACY_CONNECTIONS_KEY = "t3code.connections";

function catalogError(operation: string, cause: unknown) {
  return new ConnectionTransientError({
    reason: "remote-unavailable",
    detail: `Could not ${operation} the local connection catalog: ${String(cause)}`,
  });
}

const ConnectionCatalogDocumentJson = Schema.fromJsonString(ConnectionCatalogDocument);
const decodeConnectionCatalogDocument = Schema.decodeEffect(ConnectionCatalogDocumentJson);
const encodeConnectionCatalogDocument = Schema.encodeEffect(ConnectionCatalogDocumentJson);

const decodeCatalog = effect (raw: string) => try withSpan(effect {
  return decodeConnectionCatalogDocument(raw) catch effect (cause) => { throw catalogError("decode", cause) };
}, "mobile.connectionStorage.decodeCatalog");

const encodeCatalog = effect (
  catalog: ConnectionCatalogDocumentType,
) => try withSpan(effect {
  return encodeConnectionCatalogDocument(catalog) catch effect (cause) => { throw catalogError("encode", cause) };
}, "mobile.connectionStorage.encodeCatalog");

interface CatalogStore {
  readonly read: ConnectionCatalogDocumentType!ConnectionTransientError;
  readonly update: (
    transform: (catalog: ConnectionCatalogDocumentType) => ConnectionCatalogDocumentType,
  ) => void!ConnectionTransientError;
}

export const make = effect () => try withSpan(effect {
  const storage = try MobileSecureStorage.MobileSecureStorage;
  const getItem = (key: string) =>
    storage.getItem(key) |> Effect.mapError(%, (cause) => catalogError("load", cause));
  const setItem = (key: string, value: string) =>
    storage.setItem(key, value) |> Effect.mapError(%, (cause) => catalogError("save", cause));
  const deleteItem = (key: string) =>
    storage.removeItem(key) |> Effect.mapError(%, (cause) => catalogError("delete", cause));
  const state = try Ref.make<Option.Option<ConnectionCatalogDocumentType>>(Option.none());
  const lock = try Semaphore.make(1);

  const loadLegacyCatalog = effect () => try withSpan(effect {
    const legacyRaw = try getItem(LEGACY_CONNECTIONS_KEY);
    const catalog =
      legacyRaw === null || legacyRaw.trim() === ""
        ? EMPTY_CONNECTION_CATALOG_DOCUMENT
        : ((migrateLegacyConnectionCatalog(legacyRaw)
            |> Effect.mapError(%, (cause) => catalogError("migrate", cause))) catch effect (error) => try (Effect.logWarning("Discarding corrupt legacy mobile connections", error)
                |> Effect.as(%, EMPTY_CONNECTION_CATALOG_DOCUMENT)));
    if (legacyRaw !== null && legacyRaw.trim() !== "") {
      const encoded = try encodeCatalog(catalog);
      try setItem(CONNECTION_CATALOG_KEY, encoded);
      try deleteItem(LEGACY_CONNECTIONS_KEY);
    }
    return catalog;
  }, "mobile.connectionStorage.loadLegacyCatalog");

  const loadUnlocked = effect () => try withSpan(effect {
    const cached = try Ref.get(state);
    if (Option.isSome(cached)) {
      return cached.value;
    }
    const raw = try getItem(CONNECTION_CATALOG_KEY);
    let catalog: ConnectionCatalogDocumentType;
    if (raw !== null && raw.trim() !== "") {
      catalog = (decodeCatalog(raw) catch effect (error) => try (Effect.logWarning("Discarding corrupt mobile connection catalog", error)
            |> Effect.andThen(%, deleteItem(CONNECTION_CATALOG_KEY))
            |> Effect.andThen(%, loadLegacyCatalog())));
    } else {
      catalog = try loadLegacyCatalog();
    }
    try Ref.set(state, Option.some(catalog));
    return catalog;
  }, "mobile.connectionStorage.loadCatalog");

  const read = lock.withPermits(1)(loadUnlocked());
  const update: CatalogStore["update"] = effect (transform): void!ConnectionTransientError!never => try withSpan((effect (): void!ConnectionTransientError!never => {
    try lock.withPermits(1)(
      effect {
        const next = transform(try loadUnlocked());
        const encoded = try encodeCatalog(next);
        try setItem(CONNECTION_CATALOG_KEY, encoded);
        try Ref.set(state, Option.some(next));
      },
    );
  })(), "mobile.connectionStorage.updateCatalog");

  return { read, update } satisfies CatalogStore;
}, "mobile.connectionStorage.makeCatalogStore");
