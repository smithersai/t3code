import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"

export schema error AdmissionRejected {}

export service Admission: {
  readonly withPermit: <A, E, R>(
    store: boolean,
    task: A!E!R,
  ) => A!(E | AdmissionRejected)!R;
} {
  static readonly key = "@t3tools/task-cache/Admission"
}

const make = effect {
  // Never queue fibers across Worker requests: their async contexts cannot cross request boundaries.
  const stores = try Semaphore.make(2)
  const reads = try Semaphore.make(4)
  return Admission.of({
    // The caller owns the request span; admission adds no second span per request.
    withPermit: effect (store, task) => {
      const result = try (store ? stores : reads).withPermitsIfAvailable(1)(task)
      return Option.isSome(result) ? result.value : throw new AdmissionRejected()
    },
  })
}

export const layer = Layer.effect(Admission, make)
