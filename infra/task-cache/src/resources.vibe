import * as Alchemy from "alchemy"
import { adopt } from "alchemy/AdoptPolicy"
import * as Cloudflare from "@alchemy.run/cloudflare"
import { retain } from "alchemy/RemovalPolicy"
import * as Effect from "effect/Effect"

module platform {
  import * as NodeURL from "node:url"

  export const $NodeURL_fileURLToPath: typeof NodeURL.fileURLToPath =
    ((...args: Parameters<typeof NodeURL.fileURLToPath>) =>
      NodeURL.fileURLToPath(...args)) as typeof NodeURL.fileURLToPath
}

import { $NodeURL_fileURLToPath } from platform

const protocol = new URL("../vendor/vite-plus-remote-cache-cloudflare/", import.meta.url)
export const cacheName = effect {
  const { stage } = try Alchemy.Stack
  return stage === "prod" ? "t3-task-cache" : `t3-task-cache-${stage}`
}
export const Index = cacheName
  |> Effect.flatMap(%, (name) =>
    Cloudflare.D1.Database("Index", {
      name,
      migrations: $NodeURL_fileURLToPath(new URL("migrations", protocol)),
    }).pipe(adopt(true), retain()))
export const Artifacts = cacheName
  |> Effect.flatMap(%, (name) =>
    Cloudflare.R2.Bucket("Artifacts", {
      name,
      lifecycleRules: [
        {
          id: "remote-cache-generations",
          deleteObjectsTransition: { condition: { type: "Age", maxAge: 9 * 86400 } },
          abortMultipartUploadsTransition: { condition: { type: "Age", maxAge: 86400 } },
        },
      ],
    }).pipe(adopt(true), retain()))
// Fingerprint-keyed simulator/emulator dev clients; separate from the 9-day task-cache generations.
export const NativeClients = cacheName
  |> Effect.flatMap(%, (name) =>
    Cloudflare.R2.Bucket("NativeClients", {
      name: `${name}-native-clients`,
      lifecycleRules: [
        {
          id: "native-client-retention",
          deleteObjectsTransition: { condition: { type: "Age", maxAge: 30 * 86400 } },
          abortMultipartUploadsTransition: { condition: { type: "Age", maxAge: 86400 } },
        },
      ],
    }).pipe(retain()))
export const Savings = cacheName
  |> Effect.flatMap(%, (name) =>
    Cloudflare.D1.Database("Savings", {
      name: `${name}-savings`,
      migrations: $NodeURL_fileURLToPath(new URL("../migrations/savings", import.meta.url)),
    }).pipe(retain()))
