import * as Effect from "effect/Effect"
import * as Cache from "./Cache.ts"

export const batchSize = 256

export const run = effect () =>
  try withSpan(
    effect {
      const cache = try Cache.Cache
      // Three full batches stay below D1’s 1,000-query invocation limit.
      try Effect.all([cache.cleanup, cache.cleanup, cache.cleanup], {
        concurrency: 3,
        discard: true,
      })
    },
    "TaskCache.cleanup",
  )
