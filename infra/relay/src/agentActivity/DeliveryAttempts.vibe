import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import { and, eq, isNull } from "drizzle-orm"
import * as Crypto from "@t3tools/shared/Crypto"
import * as Schema from "effect/Schema"

import * as RelayDb from "../db.vibe"
import { relayDeliveryAttempts } from "../persistence/schema.ts"

const DeliveryAttemptRecordPersistenceErrorSourceJobIdField: Schema.NullOr<Schema.String> = Schema.NullOr(Schema.String)
const DeliveryAttemptRecordPersistenceErrorUserIdField: Schema.NullOr<Schema.String> = Schema.NullOr(Schema.String)
const DeliveryAttemptRecordPersistenceErrorEnvironmentIdField: Schema.NullOr<Schema.String> = Schema.NullOr(
  Schema.String,
)
const DeliveryAttemptRecordPersistenceErrorThreadIdField: Schema.NullOr<Schema.String> = Schema.NullOr(Schema.String)
const DeliveryAttemptRecordPersistenceErrorDeviceIdField: Schema.NullOr<Schema.String> = Schema.NullOr(Schema.String)
const DeliveryAttemptRecordPersistenceErrorKindField: Schema.NullOr<Schema.String> = Schema.NullOr(Schema.String)
const DeliveryAttemptRecordPersistenceErrorCauseField: Schema.Defect = Schema.Defect()
export schema error DeliveryAttemptRecordPersistenceError {
  readonly operation: "record" | "claim-source-job" | "complete-source-job"
  sourceJobId: DeliveryAttemptRecordPersistenceErrorSourceJobIdField
  userId: DeliveryAttemptRecordPersistenceErrorUserIdField
  environmentId: DeliveryAttemptRecordPersistenceErrorEnvironmentIdField
  threadId: DeliveryAttemptRecordPersistenceErrorThreadIdField
  deviceId: DeliveryAttemptRecordPersistenceErrorDeviceIdField
  kind: DeliveryAttemptRecordPersistenceErrorKindField
  cause: DeliveryAttemptRecordPersistenceErrorCauseField
  override get message(): string {
    return `Failed to persist APNs delivery attempt during ${this.operation}.`
  }
}

export interface DeliveryAttemptInput {
  readonly userId: string | null
  readonly environmentId: string | null
  readonly threadId: string | null
  readonly deviceId: string | null
  readonly kind: string
  readonly sourceJobId?: string | null
  readonly token: string | null
  readonly apnsStatus?: number
  readonly apnsReason?: string
  readonly apnsId?: string | null
  readonly transportError?: string
}

export interface DeliveryAttemptCompletionInput {
  readonly sourceJobId: string
  readonly apnsStatus?: number
  readonly apnsReason?: string
  readonly apnsId?: string | null
  readonly transportError?: string
}

export type DeliverySourceJobClaimResult = "claimed" | "completed" | "in_flight"

export service DeliveryAttempts: {
  readonly record: (
    input: DeliveryAttemptInput,
  ) => void!DeliveryAttemptRecordPersistenceError;
  readonly claimSourceJob: (
    input: DeliveryAttemptInput & { readonly sourceJobId: string },
  ) => DeliverySourceJobClaimResult!DeliveryAttemptRecordPersistenceError;
  readonly completeSourceJob: (
    input: DeliveryAttemptCompletionInput,
  ) => void!DeliveryAttemptRecordPersistenceError;
} {
  static readonly key = "t3code-relay/agentActivity/DeliveryAttempts"
}

const SOURCE_JOB_CLAIM_LEASE_MINUTES = 10

function insertValues(
  input: DeliveryAttemptInput,
  id: string,
  createdAt: string,
): typeof relayDeliveryAttempts.$inferInsert {
  return {
    id,
    createdAt,
    userId: input.userId,
    environmentId: input.environmentId,
    threadId: input.threadId,
    deviceId: input.deviceId,
    kind: input.kind,
    sourceJobId: input.sourceJobId ?? null,
    tokenSuffix: input.token?.slice(-8) ?? null,
    apnsStatus: input.apnsStatus ?? null,
    apnsReason: input.apnsReason ?? null,
    apnsId: input.apnsId ?? null,
    transportError: input.transportError ?? null,
  }
}

export const make = effect {
  const db = try RelayDb.RelayDb
  const crypto = try Crypto.Crypto

  const isExpiredClaim = (claimedAt: string | null, now: DateTime.DateTime) => {
    if (claimedAt === null) {
      return true
    }
    return do {
      const $optionSubject = DateTime.make(claimedAt)
      const $optionHandlers: { onNone: () => boolean; onSome: (dateTime: DateTime.Utc) => boolean } = {
        onNone: () => true,
        onSome: (dateTime) =>
          now.epochMilliseconds - dateTime.epochMilliseconds
          >= SOURCE_JOB_CLAIM_LEASE_MINUTES * 60 * 1_000,
      }
      const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
      match ($optionSubject) {
        when Option.Some(let $optionValue): $optionSome($optionValue);
        default: $optionNone();
      }
    }
  }

  return DeliveryAttempts.of({
    record: effect (input): void!DeliveryAttemptRecordPersistenceError!never =>
      try withSpan(
        (effect (): void!DeliveryAttemptRecordPersistenceError!never => {
          try Effect.annotateCurrentSpan({
            "relay.delivery.kind": input.kind,
            ...(input.sourceJobId ? { "relay.delivery.job_id": input.sourceJobId } : {}),
            ...(input.deviceId ? { "relay.mobile.device_id": input.deviceId } : {}),
            ...(input.environmentId ? { "relay.environment_id": input.environmentId } : {}),
            ...(input.threadId ? { "relay.thread_id": input.threadId } : {}),
          })
          ;(effect {
            const id = try crypto.randomUUIDv4()
            const createdAt = DateTime.formatIso(try DateTime.now)
            try (try Effect.orDie(Effect.try({ try: () => db.insert(relayDeliveryAttempts), catch: (e) => e })))
              .values(insertValues(input, id, createdAt))
          }) catch effect (cause) => {
            throw new DeliveryAttemptRecordPersistenceError({
              operation: "record",
              sourceJobId: input.sourceJobId ?? null,
              userId: input.userId,
              environmentId: input.environmentId,
              threadId: input.threadId,
              deviceId: input.deviceId,
              kind: input.kind,
              cause,
            })
          }
        })(),
        "relay.delivery_attempts.record",
      ),
    claimSourceJob: effect (input): DeliverySourceJobClaimResult!DeliveryAttemptRecordPersistenceError!never =>
      try withSpan(
        (effect (): DeliverySourceJobClaimResult!DeliveryAttemptRecordPersistenceError!never => {
          try Effect.annotateCurrentSpan({
            "relay.delivery.kind": input.kind,
            "relay.delivery.job_id": input.sourceJobId,
            ...(input.deviceId ? { "relay.mobile.device_id": input.deviceId } : {}),
            ...(input.environmentId ? { "relay.environment_id": input.environmentId } : {}),
            ...(input.threadId ? { "relay.thread_id": input.threadId } : {}),
          })
          return (effect {
            const id = try crypto.randomUUIDv4()
            const now = try DateTime.now
            const createdAt = DateTime.formatIso(now)
            const inserted = try (try Effect.orDie(Effect.try({
              try: () =>
                db
                  .insert(relayDeliveryAttempts)
                  .values(insertValues(input, id, createdAt))
                  .onConflictDoNothing({ target: relayDeliveryAttempts.sourceJobId }),
              catch: (e) => e,
            })))
              .returning({ id: relayDeliveryAttempts.id })
            if (inserted.length > 0) {
              return "claimed"
            }

            const existing = try (try Effect.orDie(Effect.try({
              try: () =>
                db
                  .select({
                    createdAt: relayDeliveryAttempts.createdAt,
                    apnsStatus: relayDeliveryAttempts.apnsStatus,
                    apnsReason: relayDeliveryAttempts.apnsReason,
                    apnsId: relayDeliveryAttempts.apnsId,
                    transportError: relayDeliveryAttempts.transportError,
                  })
                  .from(relayDeliveryAttempts)
                  .where(eq(relayDeliveryAttempts.sourceJobId, input.sourceJobId)),
              catch: (e) => e,
            })))
              .limit(1)
            const row = existing[0]
            if (!row) {
              return "in_flight"
            }
            if (
              row.apnsStatus !== null
              || row.apnsReason !== null
              || row.apnsId !== null
              || row.transportError !== null
            ) {
              return "completed"
            }
            if (!isExpiredClaim(row.createdAt, now)) {
              return "in_flight"
            }

            const reclaimed = try (try Effect.orDie(Effect.try({
              try: () =>
                db
                  .update(relayDeliveryAttempts)
                  .set({
                    createdAt,
                  })
                  .where(
                    and(
                      eq(relayDeliveryAttempts.sourceJobId, input.sourceJobId),
                      eq(relayDeliveryAttempts.createdAt, row.createdAt),
                      isNull(relayDeliveryAttempts.apnsStatus),
                      isNull(relayDeliveryAttempts.apnsReason),
                      isNull(relayDeliveryAttempts.apnsId),
                      isNull(relayDeliveryAttempts.transportError),
                    ),
                  ),
              catch: (e) => e,
            })))
              .returning({ id: relayDeliveryAttempts.id })
            return reclaimed.length > 0 ? "claimed" : "in_flight"
          }) catch effect (cause) => {
            throw new DeliveryAttemptRecordPersistenceError({
              operation: "claim-source-job",
              sourceJobId: input.sourceJobId,
              userId: input.userId,
              environmentId: input.environmentId,
              threadId: input.threadId,
              deviceId: input.deviceId,
              kind: input.kind,
              cause,
            })
          }
        })(),
        "relay.delivery_attempts.claim_source_job",
      ),
    completeSourceJob: effect (input): void!DeliveryAttemptRecordPersistenceError!never =>
      try withSpan(
        (effect (): void!DeliveryAttemptRecordPersistenceError!never => {
          try Effect.annotateCurrentSpan({ "relay.delivery.job_id": input.sourceJobId })
          const completedAt = DateTime.formatIso(try DateTime.now)
          ;(try Effect.orDie(Effect.try({
            try: () =>
              db
                .update(relayDeliveryAttempts)
                .set({
                  createdAt: completedAt,
                  apnsStatus: input.apnsStatus ?? null,
                  apnsReason: input.apnsReason ?? null,
                  apnsId: input.apnsId ?? null,
                  transportError: input.transportError ?? null,
                }),
            catch: (e) => e,
          })))
            .where(
              try Effect.orDie(
                Effect.try({ try: () => eq(relayDeliveryAttempts.sourceJobId, input.sourceJobId), catch: (e) => e }),
              ),
            ) catch effect (cause) => {
              throw new DeliveryAttemptRecordPersistenceError({
                operation: "complete-source-job",
                sourceJobId: input.sourceJobId,
                userId: null,
                environmentId: null,
                threadId: null,
                deviceId: null,
                kind: null,
                cause,
              })
            }
        })(),
        "relay.delivery_attempts.complete_source_job",
      ),
  })
}

export const layer = Layer.effect(DeliveryAttempts, make)
