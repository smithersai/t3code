import * as Context from "effect/Context"
import * as Crypto from "@t3tools/shared/Crypto"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Option from "effect/Option"
import * as Schema from "effect/Schema"
import { and, eq, exists, isNull, ne, notExists } from "drizzle-orm"
import { QueryBuilder } from "drizzle-orm/pg-core"

import * as RelayDb from "../db.vibe"
import { relayEnvironmentCredentials, relayEnvironmentLinks } from "../persistence/schema.ts"

export class EnvironmentCredentialCreatePersistenceError
  extends Schema.TaggedError<EnvironmentCredentialCreatePersistenceError>()(
    "EnvironmentCredentialCreatePersistenceError",
    {
      stage: Schema.Literals([
        "generate-credential",
        "hash-token",
        "insert-credential",
        "revoke-previous-credentials",
      ]),
      environmentId: Schema.String,
      credentialId: Schema.optionalKey(Schema.String),
      cause: Schema.Defect(),
    },
  )
{
  override get message(): string {
    return `Environment credential creation failed during '${this.stage}' for environment '${this.environmentId}'${
      this.credentialId === undefined ? "" : `, credential '${this.credentialId}'`
    }`
  }
}

const EnvironmentCredentialAuthenticatePersistenceErrorCauseField: Schema.Defect = Schema.Defect()
export schema error EnvironmentCredentialAuthenticatePersistenceError {
  readonly stage: "hash-token" | "lookup-credential"
  cause: EnvironmentCredentialAuthenticatePersistenceErrorCauseField
  override get message(): string {
    return `Environment credential authentication failed during '${this.stage}'`
  }
}

const EnvironmentCredentialRevokePersistenceErrorCauseField: Schema.Defect = Schema.Defect()
export schema error EnvironmentCredentialRevokePersistenceError {
  readonly environmentId: string
  cause: EnvironmentCredentialRevokePersistenceErrorCauseField
  override get message(): string {
    return `Failed to revoke credentials for environment '${this.environmentId}'`
  }
}

export interface EnvironmentCredentialPrincipal {
  readonly credentialId: string
  readonly environmentId: string
  readonly environmentPublicKey: string
}

export service EnvironmentCredentials: {
  readonly create: (input: {
    readonly environmentId: string;
    readonly environmentPublicKey: string;
  }) => string!EnvironmentCredentialCreatePersistenceError;
  readonly authenticate: (
    token: string,
  ) => Effect.Effect<
    Option.Option<EnvironmentCredentialPrincipal>,
    EnvironmentCredentialAuthenticatePersistenceError
  >;
  readonly revokeForEnvironmentPublicKey: (input: {
    readonly environmentId: string;
    readonly environmentPublicKey: string;
  }) => boolean!EnvironmentCredentialRevokePersistenceError;
} {
  static readonly key = "t3code-relay/environments/EnvironmentCredentials"
}

const make = effect {
  const db = try RelayDb.RelayDb
  const crypto = try Crypto.Crypto
  const hashToken = (token: string) =>
    crypto.digest("SHA-256", new TextEncoder().encode(token)) |> Effect.map(%, Base64Url.encode)
  const randomTokenPart = (segments: number) =>
    Effect.map(
      Effect.all(Array.from({ length: segments }, () => crypto.randomUUIDv4())),
      (values) => values.join("").replaceAll("-", ""),
    )
  const makeCredential = effect () => {
    const credentialId = try randomTokenPart(2)
    const secret = try randomTokenPart(3)
    return {
      credentialId,
      token: `t3env_${credentialId}_${secret}`,
    }
  }

  return EnvironmentCredentials.of({
    create: effect (input): string!EnvironmentCredentialCreatePersistenceError =>
      try withSpan(
        (effect (): string!EnvironmentCredentialCreatePersistenceError => {
          try Effect.annotateCurrentSpan({ "relay.environment_id": input.environmentId })
          const credential = makeCredential() catch effect (cause) => {
            throw new EnvironmentCredentialCreatePersistenceError({
              stage: "generate-credential",
              environmentId: input.environmentId,
              cause,
            })
          }
          const credentialHash = hashToken(credential.token) catch effect (cause) => {
            throw new EnvironmentCredentialCreatePersistenceError({
              stage: "hash-token",
              environmentId: input.environmentId,
              credentialId: credential.credentialId,
              cause,
            })
          }
          const now = DateTime.formatIso(try DateTime.now)
          ;(try Effect.orDie(Effect.try({
            try: () =>
              db
                .insert(relayEnvironmentCredentials),
            catch: (e) => e,
          })))
            .values({
              credentialId: credential.credentialId,
              environmentId: input.environmentId,
              environmentPublicKey: input.environmentPublicKey,
              credentialHash,
              revokedAt: null,
              createdAt: now,
              updatedAt: now,
            }) catch effect (cause) => {
              throw new EnvironmentCredentialCreatePersistenceError({
                stage: "insert-credential",
                environmentId: input.environmentId,
                credentialId: credential.credentialId,
                cause,
              })
            }
          ;(try Effect.orDie(Effect.try({
            try: () =>
              db
                .update(relayEnvironmentCredentials)
                .set({
                  revokedAt: now,
                  updatedAt: now,
                }),
            catch: (e) => e,
          })))
            .where(
              try Effect.orDie(Effect.try({
                try: () =>
                  and(
                    eq(relayEnvironmentCredentials.environmentId, input.environmentId),
                    eq(relayEnvironmentCredentials.environmentPublicKey, input.environmentPublicKey),
                    ne(relayEnvironmentCredentials.credentialId, credential.credentialId),
                    isNull(relayEnvironmentCredentials.revokedAt),
                  ),
                catch: (e) => e,
              })),
            ) catch effect (cause) => {
              throw new EnvironmentCredentialCreatePersistenceError({
                stage: "revoke-previous-credentials",
                environmentId: input.environmentId,
                credentialId: credential.credentialId,
                cause,
              })
            }
          return credential.token
        })(),
        "relay.environment_credentials.create",
      ),

    authenticate: effect (
      token,
    ): Option.Option<EnvironmentCredentialPrincipal>!EnvironmentCredentialAuthenticatePersistenceError =>
      try withSpan(
        (effect (): Option.Option<EnvironmentCredentialPrincipal>!EnvironmentCredentialAuthenticatePersistenceError => {
          const credentialHash = hashToken(token) catch effect (cause) => {
            throw new EnvironmentCredentialAuthenticatePersistenceError({
              stage: "hash-token",
              cause,
            })
          }
          const rows = (try Effect.orDie(Effect.try({
            try: () =>
              db
                .select({
                  credentialId: relayEnvironmentCredentials.credentialId,
                  environmentId: relayEnvironmentCredentials.environmentId,
                  environmentPublicKey: relayEnvironmentCredentials.environmentPublicKey,
                })
                .from(relayEnvironmentCredentials)
                .where(
                  and(
                    eq(relayEnvironmentCredentials.credentialHash, credentialHash),
                    isNull(relayEnvironmentCredentials.revokedAt),
                    exists(
                      new QueryBuilder()
                        .select({ userId: relayEnvironmentLinks.userId })
                        .from(relayEnvironmentLinks)
                        .where(
                          and(
                            eq(
                              relayEnvironmentLinks.environmentId,
                              relayEnvironmentCredentials.environmentId,
                            ),
                            eq(
                              relayEnvironmentLinks.environmentPublicKey,
                              relayEnvironmentCredentials.environmentPublicKey,
                            ),
                            isNull(relayEnvironmentLinks.revokedAt),
                          ),
                        ),
                    ),
                  ),
                ),
            catch: (e) => e,
          })))
            .limit(1) catch effect (cause) => {
              throw new EnvironmentCredentialAuthenticatePersistenceError({
                stage: "lookup-credential",
                cause,
              })
            }
          const row = rows[0]
          if (row) {
            try Effect.annotateCurrentSpan({ "relay.environment_id": row.environmentId })
          }
          return row
            ? Option.some({
              credentialId: row.credentialId,
              environmentId: row.environmentId,
              environmentPublicKey: row.environmentPublicKey,
            })
            : Option.none()
        })(),
        "relay.environment_credentials.authenticate",
      ),

    revokeForEnvironmentPublicKey: effect (input): boolean!EnvironmentCredentialRevokePersistenceError =>
      try withSpan(
        (effect (): boolean!EnvironmentCredentialRevokePersistenceError => {
          try Effect.annotateCurrentSpan({ "relay.environment_id": input.environmentId })
          const revokedAt = DateTime.formatIso(try DateTime.now)
          const rows = (try Effect.orDie(Effect.try({
            try: () =>
              db
                .update(relayEnvironmentCredentials)
                .set({
                  revokedAt,
                  updatedAt: revokedAt,
                })
                .where(
                  and(
                    eq(relayEnvironmentCredentials.environmentId, input.environmentId),
                    eq(relayEnvironmentCredentials.environmentPublicKey, input.environmentPublicKey),
                    isNull(relayEnvironmentCredentials.revokedAt),
                    notExists(
                      new QueryBuilder()
                        .select({ userId: relayEnvironmentLinks.userId })
                        .from(relayEnvironmentLinks)
                        .where(
                          and(
                            eq(relayEnvironmentLinks.environmentId, input.environmentId),
                            eq(relayEnvironmentLinks.environmentPublicKey, input.environmentPublicKey),
                            isNull(relayEnvironmentLinks.revokedAt),
                          ),
                        ),
                    ),
                  ),
                ),
            catch: (e) => e,
          })))
            .returning({
              credentialId: relayEnvironmentCredentials.credentialId,
            }) catch effect (cause) => {
              throw new EnvironmentCredentialRevokePersistenceError({
                environmentId: input.environmentId,
                cause,
              })
            }
          return rows.length > 0
        })(),
        "relay.environment_credentials.revoke_for_environment_public_key",
      ),
  })
}

export const layer = Layer.effect(EnvironmentCredentials, make)
