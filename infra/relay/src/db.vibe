import type { PgClient } from "@effect/sql-pg/PgClient"
import * as Cloudflare from "@alchemy.run/cloudflare"
import * as Drizzle from "@alchemy.run/drizzle"
import * as Planetscale from "@alchemy.run/planetscale"
import * as Alchemy from "alchemy"
import * as RemovalPolicy from "alchemy/RemovalPolicy"
import type { EffectPgDatabase } from "drizzle-orm/effect-postgres"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"

import { relayDatabaseMode } from "./dbConfig.ts"

export service RelayDb: EffectPgDatabase & {
    readonly $client: PgClient;
  } {
  static readonly key = "t3code-relay/db/RelayDb"
}

export class RelayTransactions extends Context.Service<
  RelayTransactions,
  {
    readonly withTransaction: RelayDb["Service"]["$client"]["withTransaction"]
  }
>()("t3code-relay/db/RelayTransactions") {
  static readonly layer = Layer.effect(
    RelayTransactions,
    effect {
      const db = try RelayDb
      return RelayTransactions.of({
        withTransaction: db.$client.withTransaction,
      })
    },
  )
}

export const PlanetscaleDatabase = effect {
  const { stage } = try Alchemy.Stack
  const schema = try Drizzle.Schema("RelaySchema", {
    schema: "./src/persistence/schema.ts",
    out: "./migrations/postgres",
    dialect: "postgres",
  })

  const mode = try Effect.orDie(Effect.try({ try: () => relayDatabaseMode(stage), catch: (e) => e }))
  const database = mode === "shared-database"
    ? try (Planetscale.PostgresDatabase("RelayPostgresDatabase", {
      name: "t3coderelay",
      region: { slug: "us-west" },
      clusterSize: "PS_80",
      migrations: { dir: schema.out, table: "relay_migrations" },
      replicas: 2,
    }).pipe(try Effect.orDie(Effect.try({ try: () => RemovalPolicy.retain(), catch: (e) => e }))))
    : try Planetscale.PostgresDatabase.ref("RelayPostgresDatabase", {
      stage: "prod",
    })
  const branch = mode === "stage-branch"
    ? try Planetscale.PostgresBranch("RelayPostgresBranch", {
      database,
      migrations: { dir: schema.out, table: "relay_migrations" },
    })
    : undefined

  const runtimeRole = try Planetscale.PostgresRole("RelayPostgresRuntimeRole", {
    database,
    ...(branch ? { branch } : {}),
    inheritedRoles: ["pg_read_all_data", "pg_write_all_data"],
  })

  return { branch, database, runtimeRole }
}

export const RelayHyperdrive = effect {
  const { runtimeRole } = try PlanetscaleDatabase
  return try Cloudflare.Hyperdrive.Connection("RelayHyperdrive", {
    origin: runtimeRole.origin,
    caching: {
      disabled: true,
    },
    originConnectionLimit: 40,
  })
}
