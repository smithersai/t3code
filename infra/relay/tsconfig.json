{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": [
    "alchemy.run.ts",
    "alchemy.run.vibe",
    "scripts/**/*.ts",
    "scripts/**/*.vibe",
    "src/**/*.ts",
    "src/**/*.vibe"
  ],
  "vibelang": { "trustedPackages": ["@t3tools/*"] }
}
