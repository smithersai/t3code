export const editQueuedRun = effect (
  input: EditQueuedRunInput,
) => try withSpan(effect {
  const attachments = input.edit === undefined
    ? undefined
    : try persistAttachments(input.threadId, input.edit.messageId, input.edit.attachments)
  return try dispatch({
    type: "queued-run.edit",
    commandId: try allocateCommandId(input),
    threadId: input.threadId,
    runId: input.runId,
    text: input.text,
    ...(attachments === undefined ? {} : { attachments }),
    ...(try Effect.orDie(Effect.try({ try: () => input.edit?.context && attachments
      ? {
        context: remapComposerContextAttachments(
          input.edit.context,
          input.edit.attachments,
          attachments,
        ),
      }
      : {}, catch: (e) => e }))),
  })
}, "EnvironmentCommands.editQueuedRun")

