    "EnvironmentCommands.deleteProject",
  )

export const createThread = effect (
  input: CreateThreadInput,
) =>
  try withSpan(
    effect {
      return try dispatch({
        type: "thread.create",
        commandId: try allocateCommandId(input),
        createdBy: "user",
        creationSource: input.creationSource ?? "web",
        threadId: input.threadId,
        projectId: input.projectId,
        title: input.title,
        modelSelection: input.modelSelection,
        runtimeMode: input.runtimeMode,
        interactionMode: input.interactionMode,
        branch: input.branch,
        worktreePath: input.worktreePath,
      })
    },
    "EnvironmentCommands.createThread",
  )

function simpleThreadCommand(
  type:
    | "thread.delete"
    | "thread.archive"
    | "thread.unarchive"
    | "thread.settle"
    | "thread.pin"
    | "thread.unpin"
    | "thread.guest-share.close",
  input: ThreadCommandInput,
) {
  return allocateCommandId(input)
    |> Effect.flatMap(%, (commandId) => dispatch({ type, commandId, threadId: input.threadId }))
}

export const deleteThread = effect (
  input: ThreadCommandInput,
) =>
  try withSpan(
    effect {
      return try simpleThreadCommand("thread.delete", input)
    },
    "EnvironmentCommands.deleteThread",
  )

export type CloseGuestShareInput = ThreadCommandInput
export const closeGuestShare = effect (
