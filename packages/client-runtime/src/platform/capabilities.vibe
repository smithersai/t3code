import {
  type AuthClientPresentationMetadata,
  type DesktopSshEnvironmentBootstrap,
  type DesktopSshEnvironmentTarget,
  EnvironmentId,
} from "@t3tools/contracts"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import type * as Option from "effect/Option"

import type { ConnectionAttemptError } from "../connection/model.vibe"

export interface PreparedSshEnvironment {
  readonly bootstrap: DesktopSshEnvironmentBootstrap
  readonly bearerToken: string
}

export interface ProvisionedSshEnvironment extends PreparedSshEnvironment {
  readonly environmentId: EnvironmentId
  readonly label: string
}

/** Stable for one signed-in session, including same-account token refreshes. */
export interface CloudSessionIdentity {
  readonly accountId: string
}

export service CloudSession: {
    readonly identity: Option.Option<CloudSessionIdentity>!!;
    readonly clerkToken: string!ConnectionAttemptError;
  } {
  static override readonly key = "@t3tools/client-runtime/platform/capabilities/CloudSession"
}

export service RelayDeviceIdentity: {
    readonly deviceId: Option.Option<string>!ConnectionAttemptError;
  } {
  static override readonly key = "@t3tools/client-runtime/platform/capabilities/RelayDeviceIdentity"
}

/**
 * A random id this client keeps across launches. Environments it connects to
 * record its hash, so two environments opened from one device share an owner
 * in analytics even when nobody is signed in.
 */
export class AnalyticsDevice extends Context.Reference<{
  readonly id: Option.Option<string>!!
}>("@t3tools/client-runtime/platform/capabilities/AnalyticsDevice", {
  defaultValue: () => ({ id: Effect.succeedNone }),
}) {}

export service ClientPresentation: {
    readonly metadata: AuthClientPresentationMetadata;
  } {
  static override readonly key = "@t3tools/client-runtime/platform/capabilities/ClientPresentation"
}

export service PrimaryEnvironmentAuth: {
    readonly bearerToken: Option.Option<string>!ConnectionAttemptError;
  } {
  static override readonly key = "@t3tools/client-runtime/platform/capabilities/PrimaryEnvironmentAuth"
}

export service SshEnvironmentGateway: {
    /**
     * With `expectedEnvironmentId`, a server that is a different machine fails
     * before its one-time pairing credential is spent.
     */
    readonly provision: (
      target: DesktopSshEnvironmentTarget,
      expectedEnvironmentId?: EnvironmentId,
    ) => ProvisionedSshEnvironment!ConnectionAttemptError;
    /**
     * Starts or reuses the remote server for a saved connection. Returns
     * `bearerToken`, the token this client saved from an earlier pairing, while
     * the host still accepts it with the standard scopes, and pairs again only
     * when it does not, so a reconnect adds no session on the host.
     */
    readonly prepare: (input: {
      readonly connectionId: string;
      readonly expectedEnvironmentId: EnvironmentId;
      readonly target: DesktopSshEnvironmentTarget;
      readonly bearerToken?: string;
    }) => PreparedSshEnvironment!ConnectionAttemptError;
    readonly disconnect: (
      target: DesktopSshEnvironmentTarget,
    ) => void!ConnectionAttemptError;
  } {
  static override readonly key = "@t3tools/client-runtime/platform/capabilities/SshEnvironmentGateway"
}
