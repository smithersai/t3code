import {
  ORCHESTRATION_V2_WS_METHODS,
  type EnvironmentId,
  type OrchestrationV2ShellSnapshot,
  type OrchestrationV2ShellStreamItem,
  type OrchestrationV2ThreadShell,
  type ServerConfig,
  type ThreadId,
  type ThreadPullRequestLink,
} from "@t3tools/contracts"
import * as Cause from "effect/Cause"
import * as Effect from "effect/Effect"
import * as Option from "effect/Option"
import * as SubscriptionRef from "effect/SubscriptionRef"
import { AsyncResult, Atom } from "effect/reactivity"

import * as EnvironmentRegistry from "../connection/registry.vibe"
import { connectionProjectionPhase } from "../connection/model.vibe"
import * as EnvironmentSupervisor from "../connection/supervisor.ts"
import * as ConnectionWakeups from "../connection/wakeups.vibe"
import { safeErrorLogAttributes } from "../errors/safeLog.ts"
import * as Persistence from "../platform/persistence.vibe"
import { runCachePersistence } from "./cachePersistence.vibe"
import { subscribeDynamic } from "../rpc/client.vibe"
import type { RpcSession } from "../rpc/session.vibe"
import * as ShellSnapshotLoader from "./shellSnapshotHttp.vibe"
import type { DeferredShellSnapshot } from "./shellPullRequests.vibe"
import {
  applyShellStreamEvent,
  mergeShellSnapshotProjects,
  reuseUnchangedThreadShells,
  sameThreadPullRequests,
} from "./shellReducer.vibe"
import { type EnvironmentCatalogState, enabledEnvironmentIds } from "./connections.vibe"
import { followStreamInEnvironment } from "./runtime.ts"

export type EnvironmentShellStatus = "empty" | "cached" | "synchronizing" | "live"

export interface EnvironmentShellState {
  readonly snapshot: Option.Option<OrchestrationV2ShellSnapshot>
  readonly status: EnvironmentShellStatus
  readonly error: Option.Option<string>
  /**
   * Changes with each authoritative snapshot (not enrichment refreshes); 0 until the first one.
   * Thread families read for an older generation may miss changes from before the latest snapshot,
   * so they are read again.
   */
  readonly generation: number
  /** Sequences of the thread removals applied since the latest authoritative snapshot. */
  readonly removedAt: ReadonlyMap<ThreadId, number>
}

const EMPTY_REMOVALS: ReadonlyMap<ThreadId, number> = new Map()
// Shared by every shell state, so a rebuilt one never reuses a generation another already used.
let lastShellGeneration = 0

export const EMPTY_SHELL_STATE: EnvironmentShellState = {
  snapshot: Option.none(),
  status: "empty",
  error: Option.none(),
  generation: 0,
  removedAt: EMPTY_REMOVALS,
}

function shellStatusForSnapshot(
  snapshot: Option.Option<OrchestrationV2ShellSnapshot>,
): EnvironmentShellStatus {
  return Option.isSome(snapshot) ? "cached" : "empty"
}

function withoutDeferredPullRequests(value: DeferredShellSnapshot): OrchestrationV2ShellSnapshot {
  if (value.loadPullRequests === undefined) return value
  const { loadPullRequests: _deferred, ...snapshot } = value
  return snapshot
}

const SHELL_SYNCHRONIZATION_ERROR_MESSAGE = "Could not synchronize environment data."

export const makeEnvironmentShellState = effect () =>
  try withSpan(
    effect {
      const supervisor = try EnvironmentSupervisor.EnvironmentSupervisor
      const cache = try Persistence.EnvironmentCacheStore
      const snapshotLoader = try ShellSnapshotLoader.ShellSnapshotLoader
      const wakeups = try Effect.serviceOption(ConnectionWakeups.ConnectionWakeups)
      const environmentId = supervisor.target.environmentId
      const cached = try (cache.loadShell(environmentId)
        |> Effect.catch(%, (error) =>
          Effect.logWarning("Could not load cached environment shell.")
          |> Effect.annotateLogs({
            environmentId,
            ...safeErrorLogAttributes(error),
          })(%)
          |> Effect.as(%, Option.none<DeferredShellSnapshot>())))
      const cachedSnapshot = Option.map(cached, withoutDeferredPullRequests)
      const state = try SubscriptionRef.make<EnvironmentShellState>({
        ...EMPTY_SHELL_STATE,
        snapshot: cachedSnapshot,
        status: shellStatusForSnapshot(cachedSnapshot),
      })
      const awaitingCompletion = try Ref.make(false)
      const lastAuthoritativeSession = try Ref.make<RpcSession | null>(null)
      const activeSubscriptionSession = try Ref.make<RpcSession | null>(null)
      const latestLiveSnapshot = try Ref.make<Option.Option<OrchestrationV2ShellSnapshot>>(
        Option.none(),
      )
      const persistence = try Queue.sliding<OrchestrationV2ShellSnapshot>(1)

      const persistenceLock = try Semaphore.make(1)
      let lastPersisted: OrchestrationV2ShellSnapshot | undefined
      // Rows still waiting for their deferred pull request links, which must not be saved:
      // the cache would keep them without links until the next server refresh.
      let pendingLinkRows: ReadonlySet<OrchestrationV2ThreadShell> = new Set()
      const persistLatest = effect (
        flush: boolean,
      ) =>
        try withSpan(
          effect {
            while (true) {
              const latest = try Ref.get(latestLiveSnapshot)
              if (Option.isNone(latest) || latest.value === lastPersisted) return
              if (latest.value.threads.some((thread) => pendingLinkRows.has(thread))) return
              const snapshot = latest.value
              if (
                lastPersisted !== undefined
                && snapshot.snapshotSequence >= lastPersisted.snapshotSequence
                && snapshot.schemaVersion === lastPersisted.schemaVersion
                && snapshot.projects === lastPersisted.projects
                && snapshot.threads === lastPersisted.threads
                && snapshot.archivedThreads === lastPersisted.archivedThreads
              ) {
                // Keep the live cursor without rewriting the rows. Remember it here too so a
                // later authoritative reset to a lower sequence still reaches the cache.
                lastPersisted = snapshot
                return
              }
              const saved = try (cache.saveShell(environmentId, snapshot)
                |> Effect.as(%, true)
                |> Effect.catch(%, (error) =>
                  Effect.logWarning("Could not persist environment shell cache.")
                  |> Effect.annotateLogs({ environmentId, ...safeErrorLogAttributes(error) })(%)
                  |> Effect.as(%, false)))
              if (!saved) return
              lastPersisted = snapshot
              if (!flush) return
            }
          } |> persistenceLock.withPermit(%),
          "EnvironmentShellState.persistLatest",
        )
      const persist = () => persistLatest(false)
      const flushLiveShellSnapshot = persistLatest(true)

      // Register before scoped worker fibers so reverse finalizer order interrupts
      // those fibers first and this flush sees a stable latestLiveSnapshot.
      try Effect.addFinalizer(() => flushLiveShellSnapshot)

      try (runCachePersistence(persistence, persist) |> Effect.forkScoped(%))

      const setDisconnected = Ref.set(awaitingCompletion, false)
        |> Effect.andThen(
          %,
          SubscriptionRef.update(state, (current) => ({
            ...current,
            status: shellStatusForSnapshot(current.snapshot),
          })),
        )
        |> Effect.andThen(%, flushLiveShellSnapshot |> Effect.forkScoped(%))
        |> Effect.asVoid(%)
      const setSynchronizing = SubscriptionRef.update(state, (current) => ({
        ...current,
        status: "synchronizing" as const,
        error: Option.none(),
      }))
      const setReady = SubscriptionRef.update(state, (current) =>
        current.status === "live"
          ? current
          : {
            ...current,
            status: "synchronizing" as const,
            error: Option.none(),
          })
      const setStreamError = (error: unknown) =>
        Ref.set(awaitingCompletion, false)
        |> Effect.andThen(%, Effect.logWarning("Could not synchronize the environment shell."))
        |> Effect.annotateLogs({
          environmentId,
          ...safeErrorLogAttributes(error),
        })(%)
        |> Effect.andThen(
          %,
          SubscriptionRef.update(state, (current) => ({
            ...current,
            status: shellStatusForSnapshot(current.snapshot),
            error: Option.some(SHELL_SYNCHRONIZATION_ERROR_MESSAGE),
          })),
        )

      // Server items and deferred link fills both read the snapshot and write it back; one at a
      // time, so neither can overwrite what the other wrote in between.
      const snapshotWriteLock = try Semaphore.make(1)

      const applyItems = effect (
        items: ReadonlyArray<OrchestrationV2ShellStreamItem>,
        pendingLinkIds?: (ReadonlySet<ThreadId>) | undefined,
      ) =>
        try withSpan(
          effect {
            const initial = try SubscriptionRef.get(state)
            let waiting = try Ref.get(awaitingCompletion)
            /* oxlint-disable oxc/no-accumulating-spread -- This copies a fixed-shape state record, not a growing collection. */
            let next = initial
            let receivedSnapshot = false
            for (const item of items) {
              if (item.kind === "synchronized") {
                waiting = false
                if (Option.isSome(next.snapshot)) {
                  next = { ...next, status: "live", error: Option.none() }
                }
                continue
              }
              const authoritative = item.kind === "snapshot" && item.resolvedRepositoryIdentityRoots === undefined
              const nextSnapshot = item.kind === "snapshot"
                ? mergeShellSnapshotProjects(
                  Option.getOrNull(next.snapshot),
                  item.snapshot,
                  item.resolvedRepositoryIdentityRoots === undefined
                    ? undefined
                    : {
                      resolvedRepositoryIdentityRoots: item.resolvedRepositoryIdentityRoots,
                    },
                )
                : do {
                  const $optionSubject = next.snapshot
                  const $optionHandlers: {
                    onNone: () => null
                    onSome: (
                      snapshot: {
                        readonly schemaVersion: number
                        readonly snapshotSequence: number
                        readonly threads: readonly {
                          readonly createdBy: "agent" | "system" | "user"
                          readonly creationSource: "mcp" | "mobile" | "provider" | "server" | "web"
                          readonly id: string & import("effect/Brand").Brand<"ThreadId">
                          readonly projectId: string & import("effect/Brand").Brand<"ProjectId">
                          readonly title: string
                          readonly providerInstanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">
                          readonly modelSelection: {
                            readonly instanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">
                            readonly model: string
                            readonly options?: readonly { readonly id: string; readonly value: string | boolean }[]
                          }
                          readonly runtimeMode: "approval-required" | "auto" | "auto-accept-edits" | "full-access"
                          readonly interactionMode: "default" | "plan"
                          readonly branch: string | null
                          readonly worktreePath: string | null
                          readonly linkedPullRequest?:
                            | {
                              readonly projectId: string & import("effect/Brand").Brand<"ProjectId">
                              readonly repository: string
                              readonly number: number
                              readonly url: string
                            }
                            | null
                            | undefined
                          readonly pullRequests?:
                            | readonly {
                              readonly host: string
                              readonly repository: string
                              readonly number: number
                              readonly url: string
                              readonly repositoryWebUrl?: string | undefined
                              readonly source: "agent" | "created" | "manual" | "stack" | "stack-dismissed"
                              readonly linkedAt: string
                              readonly snapshot: {
                                readonly state: "closed" | "merged" | "open"
                                readonly title: string
                                readonly headBranch: string
                                readonly baseBranch: string
                                readonly isDraft: boolean
                                readonly updatedAt: string | null
                                readonly syncedAt: string
                                readonly closedAt?: string | null | undefined
                                readonly mergedAt?: string | null | undefined
                                readonly author?:
                                  | {
                                    readonly isBot?: boolean | undefined
                                    readonly login: string
                                    readonly name: string | null
                                    readonly avatarUrl: string | null
                                  }
                                  | null
                                  | undefined
                                readonly additions?: number | undefined
                                readonly deletions?: number | undefined
                                readonly changedFiles?: number | undefined
                                readonly reviewDecision?:
                                  | "approved"
                                  | "changes-requested"
                                  | "review-required"
                                  | null
                                  | undefined
                                readonly checksState?: "failing" | "passing" | "pending" | null | undefined
                                readonly mergeability?: "conflicting" | "mergeable" | "unknown" | undefined
                              } | null
                              readonly stack: {
                                readonly kind: "native"
                                readonly id: string
                                readonly number: number
                                readonly url: string
                                readonly base: string
                                readonly layers: readonly {
                                  readonly number: number
                                  readonly headBranch: string
                                  readonly state: "closed" | "merged" | "open"
                                }[]
                              } | null
                              readonly watch?: {
                                readonly startedAt: string
                                readonly headSha: string | null
                                readonly failedChecks: readonly string[]
                                readonly passed: boolean
                                readonly passedChecks: readonly string[]
                                readonly owedChecks?: readonly string[] | undefined
                                readonly remarksThrough: string
                                readonly remarkIds: readonly string[]
                                readonly conflicting: boolean
                                readonly wakes: number
                                readonly checksAwaitedSince?: string | null | undefined
                              } | undefined
                              readonly endedWatch?: {
                                readonly startedAt: string
                                readonly headSha: string | null
                                readonly failedChecks: readonly string[]
                                readonly passed: boolean
                                readonly passedChecks: readonly string[]
                                readonly owedChecks?: readonly string[] | undefined
                                readonly remarksThrough: string
                                readonly remarkIds: readonly string[]
                                readonly conflicting: boolean
                                readonly wakes: number
                                readonly checksAwaitedSince?: string | null | undefined
                              } | undefined
                            }[]
                            | undefined
                          readonly branchPullRequest?:
                            | {
                              readonly projectId: string & import("effect/Brand").Brand<"ProjectId">
                              readonly repository: string
                              readonly number: number
                              readonly url: string
                            }
                            | null
                            | undefined
                          readonly lineage: {
                            readonly parentThreadId: (string & import("effect/Brand").Brand<"ThreadId">) | null
                            readonly relationshipToParent: "fork" | "subagent" | null
                            readonly rootThreadId: string & import("effect/Brand").Brand<"ThreadId">
                          }
                          readonly forkedFrom: {
                            readonly type: "run"
                            readonly threadId: string & import("effect/Brand").Brand<"ThreadId">
                            readonly runId: string & import("effect/Brand").Brand<"RunId">
                          } | {
                            readonly type: "node"
                            readonly nodeId: string & import("effect/Brand").Brand<"NodeId">
                          } | {
                            readonly type: "provider_thread"
                            readonly providerThreadId: string & import("effect/Brand").Brand<"ProviderThreadId">
                            readonly providerTurnId?:
                              | (string & import("effect/Brand").Brand<"ProviderTurnId">)
                              | undefined
                          } | null
                          readonly activeProviderThreadId:
                            | (string & import("effect/Brand").Brand<"ProviderThreadId">)
                            | null
                          readonly historyOrigin?: "native" | "v1_import" | undefined
                          readonly linkOrigin?: {
                            readonly sessionId: string
                            readonly label: string
                            readonly access?:
                              | "approval-required"
                              | "auto"
                              | "auto-accept-edits"
                              | "full-access"
                              | "read-only"
                              | undefined
                          } | undefined
                          readonly delegatedFrom?: {
                            readonly environmentId: string & import("effect/Brand").Brand<"EnvironmentId">
                            readonly threadId: string & import("effect/Brand").Brand<"ThreadId">
                            readonly title: string
                          } | undefined
                          readonly latestRunId: (string & import("effect/Brand").Brand<"RunId">) | null
                          readonly latestRunRequestedAt?: import("effect/DateTime").Utc | null | undefined
                          readonly latestRunStartedAt?: import("effect/DateTime").Utc | null | undefined
                          readonly latestRunCompletedAt?: import("effect/DateTime").Utc | null | undefined
                          readonly latestRunStopRequested?: boolean | undefined
                          readonly activeRunId: (string & import("effect/Brand").Brand<"RunId">) | null
                          readonly activityRunStartedAt?: import("effect/DateTime").Utc | null | undefined
                          readonly activityRunStatus?:
                            | "preparing"
                            | "running"
                            | "starting"
                            | "waiting"
                            | null
                            | undefined
                          readonly blockedOnThreadWait?: boolean | undefined
                          readonly status:
                            | "cancelled"
                            | "completed"
                            | "failed"
                            | "idle"
                            | "interrupted"
                            | "preparing"
                            | "queued"
                            | "rolled_back"
                            | "running"
                            | "starting"
                            | "waiting"
                          readonly lastError?: string | null | undefined
                          readonly lastErrorClass?:
                            | "permission_error"
                            | "provider_error"
                            | "transport_error"
                            | "unknown"
                            | "usage_limit"
                            | "validation_error"
                            | null
                            | undefined
                          readonly lastErrorCode?: string | null | undefined
                          readonly usageLimitResetAt?: string | null | undefined
                          readonly pendingRuntimeRequest: {
                            readonly id: string & import("effect/Brand").Brand<"RuntimeRequestId">
                            readonly kind:
                              | "auth_refresh"
                              | "command"
                              | "dynamic_tool_call"
                              | "file-change"
                              | "file-read"
                              | "mcp-elicitation"
                              | "permission"
                              | "user_input"
                            readonly createdAt: import("effect/DateTime").Utc
                            readonly blocking?: boolean | undefined
                          } | null
                          readonly pendingGuestMessageCount?: number | undefined
                          readonly latestVisibleMessage: {
                            readonly id: string & import("effect/Brand").Brand<"MessageId">
                            readonly role: "assistant" | "system" | "user"
                            readonly text: string
                            readonly updatedAt: import("effect/DateTime").Utc
                          } | null
                          readonly latestUserMessageAt: import("effect/DateTime").Utc | null
                          readonly latestUserAuthoredMessageAt?: import("effect/DateTime").Utc | null | undefined
                          readonly hasActionableProposedPlan: boolean
                          readonly pendingBackgroundTasks?:
                            | readonly ({
                              readonly taskId: string
                              readonly description?: string | undefined
                              readonly parentTaskId?: string | undefined
                              readonly awaited?: true | undefined
                              readonly kind: "subagent"
                              readonly providerInstanceId?:
                                | (string & import("effect/Brand").Brand<"ProviderInstanceId">)
                                | undefined
                              readonly childThreadId?: (string & import("effect/Brand").Brand<"ThreadId">) | undefined
                            } | {
                              readonly taskId: string
                              readonly description?: string | undefined
                              readonly parentTaskId?: string | undefined
                              readonly awaited?: true | undefined
                              readonly kind: "command"
                            } | {
                              readonly taskId: string
                              readonly description?: string | undefined
                              readonly parentTaskId?: string | undefined
                              readonly awaited?: true | undefined
                              readonly kind: "monitor"
                            } | {
                              readonly taskId: string
                              readonly description?: string | undefined
                              readonly parentTaskId?: string | undefined
                              readonly awaited?: true | undefined
                              readonly kind: "background_task"
                            })[]
                            | undefined
                          readonly providerInstanceHistory?:
                            | readonly (string & import("effect/Brand").Brand<"ProviderInstanceId">)[]
                            | undefined
                          readonly goal?:
                            | {
                              readonly objective: string
                              readonly status:
                                | "active"
                                | "blocked"
                                | "budget_limited"
                                | "complete"
                                | "paused"
                                | "usage_limited"
                              readonly tokensUsed?: number | undefined
                              readonly tokenBudget?: number | null | undefined
                              readonly timeUsedSeconds?: number | undefined
                              readonly checks?: number | undefined
                              readonly lastCheck?: string | undefined
                            }
                            | null
                            | undefined
                          readonly itemCount: number
                          readonly visibleItemCount: number
                          readonly createdAt: import("effect/DateTime").Utc
                          readonly updatedAt: import("effect/DateTime").Utc
                          readonly archivedAt: import("effect/DateTime").Utc | null
                          readonly settledOverride: "active" | "settled" | null
                          readonly settledAt: import("effect/DateTime").Utc | null
                          readonly unsettledAt?: import("effect/DateTime").Utc | null | undefined
                          readonly snoozedUntil?: import("effect/DateTime").Utc | null | undefined
                          readonly snoozedAt?: import("effect/DateTime").Utc | null | undefined
                          readonly limitRecovery?:
                            | {
                              readonly requestId?: (string & import("effect/Brand").Brand<"CommandId">) | undefined
                              readonly runId: string & import("effect/Brand").Brand<"RunId">
                              readonly resetAt: string
                              readonly autoResume: boolean
                              readonly snooze?: boolean | undefined
                            }
                            | null
                            | undefined
                          readonly pinnedAt?: import("effect/DateTime").Utc | null | undefined
                          readonly autoSettleDisabledAt?: import("effect/DateTime").Utc | null | undefined
                          readonly pinOrderKey?: string | null | undefined
                          readonly activeOrderKey?: string | null | undefined
                          readonly lastVisitedAt?: import("effect/DateTime").Utc | null | undefined
                          readonly opens?:
                            | {
                              readonly openedAt: number
                              readonly score: number
                              readonly picks: readonly { readonly query: string; readonly at: number }[]
                            }
                            | null
                            | undefined
                          readonly titleRegeneration?:
                            | {
                              readonly requestId: string & import("effect/Brand").Brand<"CommandId">
                              readonly startedAt: import("effect/DateTime").Utc
                            }
                            | null
                            | undefined
                          readonly deletedAt: import("effect/DateTime").Utc | null
                        }[]
                        readonly archivedThreads: readonly {
                          readonly createdBy: "agent" | "system" | "user"
                          readonly creationSource: "mcp" | "mobile" | "provider" | "server" | "web"
                          readonly id: string & import("effect/Brand").Brand<"ThreadId">
                          readonly projectId: string & import("effect/Brand").Brand<"ProjectId">
                          readonly title: string
                          readonly providerInstanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">
                          readonly modelSelection: {
                            readonly instanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">
                            readonly model: string
                            readonly options?: readonly { readonly id: string; readonly value: string | boolean }[]
                          }
                          readonly runtimeMode: "approval-required" | "auto" | "auto-accept-edits" | "full-access"
                          readonly interactionMode: "default" | "plan"
                          readonly branch: string | null
                          readonly worktreePath: string | null
                          readonly linkedPullRequest?:
                            | {
                              readonly projectId: string & import("effect/Brand").Brand<"ProjectId">
                              readonly repository: string
                              readonly number: number
                              readonly url: string
                            }
                            | null
                            | undefined
                          readonly pullRequests?:
                            | readonly {
                              readonly host: string
                              readonly repository: string
                              readonly number: number
                              readonly url: string
                              readonly repositoryWebUrl?: string | undefined
                              readonly source: "agent" | "created" | "manual" | "stack" | "stack-dismissed"
                              readonly linkedAt: string
                              readonly snapshot: {
                                readonly state: "closed" | "merged" | "open"
                                readonly title: string
                                readonly headBranch: string
                                readonly baseBranch: string
                                readonly isDraft: boolean
                                readonly updatedAt: string | null
                                readonly syncedAt: string
                                readonly closedAt?: string | null | undefined
                                readonly mergedAt?: string | null | undefined
                                readonly author?:
                                  | {
                                    readonly isBot?: boolean | undefined
                                    readonly login: string
                                    readonly name: string | null
                                    readonly avatarUrl: string | null
                                  }
                                  | null
                                  | undefined
                                readonly additions?: number | undefined
                                readonly deletions?: number | undefined
                                readonly changedFiles?: number | undefined
                                readonly reviewDecision?:
                                  | "approved"
                                  | "changes-requested"
                                  | "review-required"
                                  | null
                                  | undefined
                                readonly checksState?: "failing" | "passing" | "pending" | null | undefined
                                readonly mergeability?: "conflicting" | "mergeable" | "unknown" | undefined
                              } | null
                              readonly stack: {
                                readonly kind: "native"
                                readonly id: string
                                readonly number: number
                                readonly url: string
                                readonly base: string
                                readonly layers: readonly {
                                  readonly number: number
                                  readonly headBranch: string
                                  readonly state: "closed" | "merged" | "open"
                                }[]
                              } | null
                              readonly watch?: {
                                readonly startedAt: string
                                readonly headSha: string | null
                                readonly failedChecks: readonly string[]
                                readonly passed: boolean
                                readonly passedChecks: readonly string[]
                                readonly owedChecks?: readonly string[] | undefined
                                readonly remarksThrough: string
                                readonly remarkIds: readonly string[]
                                readonly conflicting: boolean
                                readonly wakes: number
                                readonly checksAwaitedSince?: string | null | undefined
                              } | undefined
                              readonly endedWatch?: {
                                readonly startedAt: string
                                readonly headSha: string | null
                                readonly failedChecks: readonly string[]
                                readonly passed: boolean
                                readonly passedChecks: readonly string[]
                                readonly owedChecks?: readonly string[] | undefined
                                readonly remarksThrough: string
                                readonly remarkIds: readonly string[]
                                readonly conflicting: boolean
                                readonly wakes: number
