                          | "waiting"
                        readonly lastError?: string | null | undefined
                        readonly lastErrorClass?:
                          | "permission_error"
                          | "provider_error"
                          | "transport_error"
                          | "unknown"
                          | "usage_limit"
                          | "validation_error"
                          | null
                          | undefined
                        readonly lastErrorCode?: string | null | undefined
                        readonly usageLimitResetAt?: string | null | undefined
                        readonly pendingRuntimeRequest: {
                          readonly id: string & import("effect/Brand").Brand<"RuntimeRequestId">
                          readonly kind:
                            | "auth_refresh"
                            | "command"
                            | "dynamic_tool_call"
                            | "file-change"
                            | "file-read"
                            | "mcp-elicitation"
                            | "permission"
                            | "user_input"
                          readonly createdAt: import("effect/DateTime").Utc
                          readonly blocking?: boolean | undefined
                        } | null
                        readonly pendingGuestMessageCount?: number | undefined
                        readonly latestVisibleMessage: {
                          readonly id: string & import("effect/Brand").Brand<"MessageId">
                          readonly role: "assistant" | "system" | "user"
                          readonly text: string
                          readonly updatedAt: import("effect/DateTime").Utc
                        } | null
                        readonly latestUserMessageAt: import("effect/DateTime").Utc | null
                        readonly latestUserAuthoredMessageAt?: import("effect/DateTime").Utc | null | undefined
                        readonly hasActionableProposedPlan: boolean
                        readonly pendingBackgroundTasks?:
                          | readonly ({
                            readonly taskId: string
                            readonly description?: string | undefined
                            readonly parentTaskId?: string | undefined
                            readonly awaited?: true | undefined
                            readonly kind: "subagent"
                            readonly providerInstanceId?:
                              | (string & import("effect/Brand").Brand<"ProviderInstanceId">)
                              | undefined
                            readonly childThreadId?: (string & import("effect/Brand").Brand<"ThreadId">) | undefined
                          } | {
                            readonly taskId: string
                            readonly description?: string | undefined
                            readonly parentTaskId?: string | undefined
                            readonly awaited?: true | undefined
                            readonly kind: "command"
                          } | {
                            readonly taskId: string
                            readonly description?: string | undefined
                            readonly parentTaskId?: string | undefined
                            readonly awaited?: true | undefined
                            readonly kind: "monitor"
                          } | {
                            readonly taskId: string
                            readonly description?: string | undefined
                            readonly parentTaskId?: string | undefined
                            readonly awaited?: true | undefined
                            readonly kind: "background_task"
                          })[]
                          | undefined
                        readonly providerInstanceHistory?:
                          | readonly (string & import("effect/Brand").Brand<"ProviderInstanceId">)[]
                          | undefined
                        readonly goal?:
                          | {
                            readonly objective: string
                            readonly status:
                              | "active"
                              | "blocked"
                              | "budget_limited"
                              | "complete"
                              | "paused"
                              | "usage_limited"
                            readonly tokensUsed?: number | undefined
                            readonly tokenBudget?: number | null | undefined
                            readonly timeUsedSeconds?: number | undefined
                            readonly checks?: number | undefined
                            readonly lastCheck?: string | undefined
                          }
                          | null
                          | undefined
                        readonly itemCount: number
                        readonly visibleItemCount: number
                        readonly createdAt: import("effect/DateTime").Utc
                        readonly updatedAt: import("effect/DateTime").Utc
                        readonly archivedAt: import("effect/DateTime").Utc | null
                        readonly settledOverride: "active" | "settled" | null
                        readonly settledAt: import("effect/DateTime").Utc | null
                        readonly unsettledAt?: import("effect/DateTime").Utc | null | undefined
                        readonly snoozedUntil?: import("effect/DateTime").Utc | null | undefined
                        readonly snoozedAt?: import("effect/DateTime").Utc | null | undefined
                        readonly limitRecovery?:
                          | {
                            readonly requestId?: (string & import("effect/Brand").Brand<"CommandId">) | undefined
                            readonly runId: string & import("effect/Brand").Brand<"RunId">
                            readonly resetAt: string
                            readonly autoResume: boolean
                            readonly snooze?: boolean | undefined
                          }
                          | null
                          | undefined
                        readonly pinnedAt?: import("effect/DateTime").Utc | null | undefined
                        readonly autoSettleDisabledAt?: import("effect/DateTime").Utc | null | undefined
                        readonly pinOrderKey?: string | null | undefined
                        readonly activeOrderKey?: string | null | undefined
                        readonly lastVisitedAt?: import("effect/DateTime").Utc | null | undefined
                        readonly opens?:
                          | {
                            readonly openedAt: number
                            readonly score: number
                            readonly picks: readonly { readonly query: string; readonly at: number }[]
                          }
                          | null
                          | undefined
                        readonly titleRegeneration?:
                          | {
                            readonly requestId: string & import("effect/Brand").Brand<"CommandId">
                            readonly startedAt: import("effect/DateTime").Utc
                          }
                          | null
                          | undefined
                        readonly deletedAt: import("effect/DateTime").Utc | null
                      }[]
                      readonly projects: readonly {
                        readonly id: string & import("effect/Brand").Brand<"ProjectId">
                        readonly title: string
                        readonly workspaceRoot: string
                        readonly repositoryIdentity?:
                          | {
                            readonly canonicalKey: string
                            readonly locator: {
                              readonly source: "git-remote"
                              readonly remoteName: string
                              readonly remoteUrl: string
                            }
                            readonly webUrl?: string
                            readonly rootPath?: string
                            readonly displayName?: string
                            readonly provider?: string & import("effect/Brand").Brand<"SourceControlProviderKind">
                            readonly owner?: string
                            readonly name?: string
                            readonly origin?: {
                              readonly canonicalKey: string
                              readonly remoteUrl?: string
                              readonly displayName?: string
                            }
                          }
                          | null
                          | undefined
                        readonly defaultModelSelection: {
                          readonly instanceId: string & import("effect/Brand").Brand<"ProviderInstanceId">
                          readonly model: string
                          readonly options?: readonly { readonly id: string; readonly value: string | boolean }[]
                        } | null
                        readonly defaultThreadEnvMode?: "local" | "worktree" | null | undefined
                        readonly autoPull?: boolean | undefined
                        readonly faviconPath?: string | null | undefined
                        readonly projectIcon?:
                          | {
                            readonly kind: "lucide"
                            readonly name: string
                            readonly color:
                              | "amber"
                              | "blue"
                              | "cyan"
                              | "emerald"
                              | "fuchsia"
                              | "gray"
                              | "green"
                              | "indigo"
                              | "lime"
                              | "orange"
                              | "pink"
                              | "purple"
                              | "red"
                              | "rose"
                              | "sky"
                              | "teal"
                              | "violet"
                              | "yellow"
                          }
                          | { readonly kind: "emoji"; readonly emoji: string }
                          | {
                            readonly kind: "monogram"
                            readonly text: string
                            readonly color:
                              | "amber"
                              | "blue"
                              | "cyan"
                              | "emerald"
                              | "fuchsia"
                              | "gray"
                              | "green"
                              | "indigo"
                              | "lime"
                              | "orange"
                              | "pink"
                              | "purple"
                              | "red"
                              | "rose"
                              | "sky"
                              | "teal"
                              | "violet"
                              | "yellow"
                          }
                          | null
                          | undefined
                        readonly scripts: readonly {
                          readonly id: string
                          readonly name: string
                          readonly command: string
                          readonly icon: "build" | "configure" | "debug" | "lint" | "play" | "test"
                          readonly runOnWorktreeCreate: boolean
                          readonly runOnSettle?: boolean | undefined
                          readonly async?: boolean | undefined
                          readonly previewUrl?: string | undefined
                          readonly autoOpenPreview?: boolean | undefined
                        }[]
                        readonly createdAt: string
                        readonly updatedAt: string
                      }[]
                      readonly olderSettled?: {
                        readonly before: string
                        readonly asOfSequence: number
                        readonly counts: readonly {
                          readonly projectId: string & import("effect/Brand").Brand<"ProjectId">
                          readonly count: number
                        }[]
                      }
                    }
                  } = {
                    onNone: () => null,
                    onSome: (snapshot) =>
                      item.sequence > snapshot.snapshotSequence
                        ? applyShellStreamEvent(snapshot, item)
                        : snapshot,
                  }
                  const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
                  match ($optionSubject) {
                    when Option.Some(let $optionValue): $optionSome($optionValue);
                    default: $optionNone();
                  }
                }
              if (nextSnapshot === null) continue
              receivedSnapshot ||= item.kind === "snapshot"
              const removal = item.kind === "thread.removed"
                  && Option.exists(next.snapshot, (snapshot) => item.sequence > snapshot.snapshotSequence)
                ? item
                : null
              next = {
                snapshot: Option.some(nextSnapshot),
                status: waiting ? "synchronizing" : "live",
                error: Option.none(),
                generation: authoritative ? ++lastShellGeneration : next.generation,
                removedAt: authoritative
                  ? EMPTY_REMOVALS
                  : removal === null
                  ? next.removedAt
                  : new Map(next.removedAt).set(removal.threadId, removal.sequence),
              }
            }
            /* oxlint-enable oxc/no-accumulating-spread */
            try Ref.set(awaitingCompletion, waiting)
            if (next === initial) return
            if (pendingLinkIds !== undefined && Option.isSome(next.snapshot)) {
              pendingLinkRows = new Set(
                next.snapshot.value.threads.filter((thread) => pendingLinkIds.has(thread.id)),
              )
            }
            if (Option.isSome(next.snapshot)) {
              try Ref.set(latestLiveSnapshot, next.snapshot)
            }
            try SubscriptionRef.set(state, next)
            if (receivedSnapshot) {
              const session = try Ref.get(activeSubscriptionSession)
              if (session !== null) {
                try Ref.set(lastAuthoritativeSession, session)
              }
            }
            if (next.snapshot !== initial.snapshot && Option.isSome(next.snapshot)) {
              try Queue.offer(persistence, next.snapshot.value)
            }
          } |> snapshotWriteLock.withPermit(%),
          "EnvironmentShellState.applyItems",
        )

      const stateScope = try Effect.scope
      // Each full snapshot supersedes the previous one's fill; links from an older snapshot must
      // not land on rows a newer snapshot reused.

      let activeFill: Fiber.Fiber<void> | undefined
      const cancelActiveFill = Effect.suspend(() => {
        const fill = activeFill
        activeFill = undefined
        return fill === undefined ? Effect.void : Fiber.interrupt(fill)
      })
      const fillDeferredPullRequests = effect (
        source: DeferredShellSnapshot,
        applied: OrchestrationV2ShellSnapshot,
      ) => {
        try cancelActiveFill
        if (source.loadPullRequests === undefined) return
        const arrivedRows = new Set(applied.threads)
        const arrivedIds = new Set(source.threads.map((thread) => thread.id))
        pendingLinkRows = new Set(applied.threads.filter((thread) => arrivedIds.has(thread.id)))
        activeFill = try (source.loadPullRequests
          |> Effect.flatMap(%, (linksByThreadId) => writeFilledLinks(linksByThreadId, arrivedRows, arrivedIds))
          |> Effect.forkIn(%, stateScope))
      }
      const writeFilledLinks = effect (
        linksByThreadId: ReadonlyMap<ThreadId, ReadonlyArray<ThreadPullRequestLink>>,
        arrivedRows: ReadonlySet<OrchestrationV2ThreadShell>,
        arrivedIds: ReadonlySet<ThreadId>,
      ) =>
        try (effect {
          const filled = try SubscriptionRef.modify(
            state,
            (current): [Option.Option<OrchestrationV2ShellSnapshot>, EnvironmentShellState] => {
              if (Option.isNone(current.snapshot)) return [Option.none(), current]
              const snapshot = current.snapshot.value
              let changed = false
              const threads = snapshot.threads.map((thread) => {
                if (!arrivedRows.has(thread) || !arrivedIds.has(thread.id)) return thread
                const links = linksByThreadId.get(thread.id)
                if (sameThreadPullRequests(thread.pullRequests, links)) return thread
                changed = true
                if (links === undefined) {
                  const { pullRequests: _previous, ...row } = thread
                  return row
                }
                return { ...thread, pullRequests: links }
              })
              if (!changed) return [Option.none(), current]
              const next = { ...snapshot, threads }
              return [Option.some(next), { ...current, snapshot: Option.some(next) }]
            },
          )
          pendingLinkRows = new Set()
          const live = try Ref.get(latestLiveSnapshot)
          if (Option.isNone(live)) return
          const latest = Option.isSome(filled) ? filled : live
          try Ref.set(latestLiveSnapshot, latest)
          try Queue.offer(persistence, latest.value)
        } |> ((effect) => snapshotWriteLock.withPermit(effect))(%))
      if (Option.isSome(cached) && Option.isSome(cachedSnapshot)) {
        try fillDeferredPullRequests(cached.value, cachedSnapshot.value)
      }

      const foregroundResubscriptions = do {
        const $optionSubject = wakeups
        const $optionHandlers: {
          onNone: () => Stream.Stream<never, never, never>
          onSome: (
            service: { readonly changes: Stream.Stream<ConnectionWakeups.ConnectionWakeup> },
          ) => Stream.Stream<ConnectionWakeups.ConnectionWakeup, never, never>
        } = {
          onNone: () => Stream.never,
          onSome: (service) => service.changes.pipe(Stream.filter(ConnectionWakeups.shouldResubscribeAfterWakeup)),
        }
        const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
        match ($optionSubject) {
          when Option.Some(let $optionValue): $optionSome($optionValue);
          default: $optionNone();
        }
      }

      try setSynchronizing
      try Effect.forkScoped(
        subscribeDynamic(
          ORCHESTRATION_V2_WS_METHODS.subscribeShell,
          effect (
            session,
          ): { readonly afterSequence?: number; readonly requestCompletionMarker?: boolean; readonly omitIdleSubagents?: boolean; readonly omitOlderSettled?: boolean; }!never!never =>
            try withSpan(
              (effect (): { readonly afterSequence?: number; readonly requestCompletionMarker?: boolean; readonly omitIdleSubagents?: boolean; readonly omitOlderSettled?: boolean; }!never!never => {
                try Ref.set(activeSubscriptionSession, session)
                const { supportsCompletionMarker, omitIdleSubagents, omitOlderSettled } = (session.initialConfig
                  |> Effect.map(%, (config) => ({
                    supportsCompletionMarker: config.shellResumeCompletionMarker === true,
                    omitIdleSubagents: config.shellThreadFamilies === true,
                    omitOlderSettled: config.shellOlderSettled === true && config.shellThreadFamilies === true,
                  }))) catch () => ({
                    supportsCompletionMarker: false,
                    omitIdleSubagents: false,
                    omitOlderSettled: false,
                  })
                try Ref.set(awaitingCompletion, supportsCompletionMarker)
                try setSynchronizing

                // Foreground resubscriptions on the same live session can resume from
                // the in-memory cursor. A new session reloads the authoritative HTTP
                // snapshot so a valid cursor cannot preserve incomplete cached data.
                const hasAuthoritativeSnapshot = (try Ref.get(lastAuthoritativeSession)) === session
                let canResume = hasAuthoritativeSnapshot
                let current = try SubscriptionRef.get(state)
                if (!hasAuthoritativeSnapshot || Option.isNone(current.snapshot)) {
                  const prepared = try (SubscriptionRef.get(supervisor.prepared)
                    |> Effect.flatMap(
                      %,
                      Option.match({
                        onSome: (value) => Effect.succeed(value),
                        onNone: () =>
                          SubscriptionRef.changes(supervisor.prepared).pipe(
                            Stream.filter(Option.isSome),
                            Stream.map((value) => value.value),
                            Stream.runHead,
                            Effect.map(Option.getOrThrow),
                          ),
                      }),
                    ))
                  // HTTP and the socket must agree, or omitted children would return through the socket.
                  const httpSnapshot = try snapshotLoader.load(prepared, {
                    omitIdleSubagents,
                    omitOlderSettled,
                  })
                  if (Option.isSome(httpSnapshot)) {
                    try cancelActiveFill
                    const previous = try SubscriptionRef.get(state)
                    const snapshot = reuseUnchangedThreadShells(
                      Option.getOrNull(previous.snapshot),
                      withoutDeferredPullRequests(httpSnapshot.value),
                    )
                    const pendingLinkIds = new Set(
                      httpSnapshot.value.loadPullRequests === undefined
                        ? []
                        : httpSnapshot.value.threads.map((thread) => thread.id),
                    )
                    try applyItems([{ kind: "snapshot", snapshot }], pendingLinkIds)
                    canResume = true
                    current = try SubscriptionRef.get(state)
                    if (Option.isSome(current.snapshot)) {
                      try fillDeferredPullRequests(httpSnapshot.value, current.snapshot.value)
                    }
                  }
                }

                const omission = {
                  ...(omitIdleSubagents ? { omitIdleSubagents: true as const } : {}),
                  ...(omitOlderSettled ? { omitOlderSettled: true as const } : {}),
                }
                if (!canResume || Option.isNone(current.snapshot)) {
                  return {
                    ...omission,
                    ...(supportsCompletionMarker ? { requestCompletionMarker: true as const } : {}),
                  }
                }
                if (!supportsCompletionMarker) {
                  try SubscriptionRef.update(state, (value) => ({
                    ...value,
                    status: "live" as const,
                    error: Option.none(),
                  }))
                }
                return {
                  afterSequence: current.snapshot.value.snapshotSequence,
                  ...omission,
                  ...(supportsCompletionMarker ? { requestCompletionMarker: true as const } : {}),
                }
              })(),
              "EnvironmentShellState.makeSubscribeInput",
            ),
          {
            onExpectedFailure: (cause) => setStreamError(Cause.squash(cause)),
            retryExpectedFailureAfter: "250 millis",
            resubscribe: foregroundResubscriptions,
          },
        ).pipe(Stream.runForEachArray((items) => applyItems(items))),
      )
      try (SubscriptionRef.changes(supervisor.state).pipe(
        Stream.runForEach((connectionState) => {
          switch (connectionProjectionPhase(connectionState)) {
            case "synchronizing":
              return setSynchronizing
            case "disconnected":
              return setDisconnected
            case "ready":
              return setReady
          }
        }),
        Effect.forkScoped,
      ))

      return state
    },
    "EnvironmentShellState.make",
  )

function shellStateChanges(environmentId: EnvironmentId) {
  return followStreamInEnvironment(
    environmentId,
    Stream.unwrap(makeEnvironmentShellState() |> Effect.map(%, SubscriptionRef.changes)),
  )
}

export interface EnvironmentShellSummary {
  readonly hasSnapshot: boolean
  readonly hasSynchronizingShell: boolean
  readonly hasCachedShell: boolean
  readonly hasLiveShell: boolean
  readonly firstError: string | null
}

const EMPTY_ENVIRONMENT_SHELL_SUMMARY: EnvironmentShellSummary = Object.freeze({
  hasSnapshot: false,
  hasSynchronizingShell: false,
  hasCachedShell: false,
  hasLiveShell: false,
  firstError: null,
})

const EMPTY_SERVER_CONFIGS: ReadonlyMap<EnvironmentId, ServerConfig> = new Map()

function shellSummariesEqual(
  left: EnvironmentShellSummary,
  right: EnvironmentShellSummary,
): boolean {
  return (
    left.hasSnapshot === right.hasSnapshot
    && left.hasSynchronizingShell === right.hasSynchronizingShell
    && left.hasCachedShell === right.hasCachedShell
    && left.hasLiveShell === right.hasLiveShell
    && left.firstError === right.firstError
  )
}

function mapsEqual<K, V>(left: ReadonlyMap<K, V>, right: ReadonlyMap<K, V>): boolean {
  if (left.size !== right.size) {
    return false
  }
  for (const [key, value] of left) {
    if (right.get(key) !== value) {
      return false
    }
  }
  return true
}

export function createEnvironmentShellSummaryAtom(input: {
  readonly catalogValueAtom: Atom.Atom<EnvironmentCatalogState>
  readonly shellStateValueAtom: (environmentId: EnvironmentId) => Atom.Atom<EnvironmentShellState>
}) {
  let previousSummary = EMPTY_ENVIRONMENT_SHELL_SUMMARY
  return Atom.make((get) => {
    let hasSnapshot = false
    let hasSynchronizingShell = false
    let hasCachedShell = false
    let hasLiveShell = false
    let firstError: string | null = null

    for (const environmentId of enabledEnvironmentIds(get(input.catalogValueAtom))) {
      const state = get(input.shellStateValueAtom(environmentId))
      hasSynchronizingShell ||= state.status === "synchronizing"
      hasCachedShell ||= state.status === "cached"
      hasLiveShell ||= state.status === "live"
      if (firstError === null) {
        firstError = Option.getOrNull(state.error)
      }
      if (Option.isNone(state.snapshot)) {
        continue
      }
      hasSnapshot = true
    }

    const next: EnvironmentShellSummary = {
      hasSnapshot,
      hasSynchronizingShell,
      hasCachedShell,
      hasLiveShell,
      firstError,
    }
    if (shellSummariesEqual(previousSummary, next)) {
      return previousSummary
    }
    previousSummary = next
    return previousSummary
  }).pipe(Atom.withLabel("environment-shell-summary"))
}

export function createEnvironmentServerConfigsAtom(input: {
  readonly catalogValueAtom: Atom.Atom<EnvironmentCatalogState>
  readonly serverConfigValueAtom: (environmentId: EnvironmentId) => Atom.Atom<ServerConfig | null>
}) {
  let previousServerConfigs = EMPTY_SERVER_CONFIGS
  return Atom.make((get) => {
    const next = new Map<EnvironmentId, ServerConfig>()
    for (const environmentId of enabledEnvironmentIds(get(input.catalogValueAtom))) {
      const config = get(input.serverConfigValueAtom(environmentId))
      if (config !== null) {
        next.set(environmentId, config)
      }
    }
    if (mapsEqual(previousServerConfigs, next)) {
      return previousServerConfigs
    }
    previousServerConfigs = next
    return previousServerConfigs
  }).pipe(Atom.withLabel("environment-server-configs"))
}

/**
 * Every shell push replaces the state, so views that gate on load progress read these
 * primitives instead and stay put while threads stream.
 */
function createEnvironmentShellProgressAtoms(
  stateValueAtom: (environmentId: EnvironmentId) => Atom.Atom<EnvironmentShellState>,
) {
  return {
    statusAtom: Atom.family((environmentId: EnvironmentId) =>
      Atom.make((get) => get(stateValueAtom(environmentId)).status).pipe(
        Atom.withLabel(`environment-shell-status:${environmentId}`),
      )
    ),
    hasSnapshotAtom: Atom.family((environmentId: EnvironmentId) =>
      Atom.make((get) => Option.isSome(get(stateValueAtom(environmentId)).snapshot)).pipe(
        Atom.withLabel(`environment-shell-has-snapshot:${environmentId}`),
      )
    ),
  }
}

export function createEnvironmentShellAtoms<R, E>(
  runtime: Atom.AtomRuntime<
    | EnvironmentRegistry.EnvironmentRegistry
    | Persistence.EnvironmentCacheStore
    | ShellSnapshotLoader.ShellSnapshotLoader
    | R,
    E
  >,
) {
  const stateAtom = Atom.family((environmentId: EnvironmentId) =>
    runtime.atom(shellStateChanges(environmentId), {
      initialValue: EMPTY_SHELL_STATE,
    })
  )

  const stateValueAtom = Atom.family((environmentId: EnvironmentId) =>
    Atom.make((get) => Option.getOrElse(AsyncResult.value(get(stateAtom(environmentId))), () => EMPTY_SHELL_STATE))
      .pipe(Atom.withLabel(`environment-shell-state-value:${environmentId}`))
  )

  const { statusAtom, hasSnapshotAtom } = createEnvironmentShellProgressAtoms(stateValueAtom)

  return {
    stateAtom,
    stateValueAtom,
    statusAtom,
    hasSnapshotAtom,
  }
}

