import type { EnvironmentId } from "@t3tools/contracts"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Option from "effect/Option"
import * as Schema from "effect/Schema"

export class EnvironmentQueryStore extends Context.Reference<
  {
    readonly load: (
      environmentId: EnvironmentId,
      key: string,
    ) => Option.Option<string>!!
    readonly save: (
      environmentId: EnvironmentId,
      key: string,
      payload: string,
    ) => void!!
  } | null
>("@t3tools/client-runtime/EnvironmentQueryStore", {
  defaultValue: () => null,
}) {}

export interface QueryPersistence<A> {
  readonly load: (environmentId: EnvironmentId, key: string) => Option.Option<A>!!
  readonly save: (environmentId: EnvironmentId, key: string, value: A) => void!!
}

export function persistQuery<A, I>(schema: Schema.Codec<A, I>): QueryPersistence<A> {
  const codec = Schema.fromJsonString(Schema.toCodecJson(schema))
  return {
    load: effect (environmentId, key) =>
      try withSpan(
        effect {
          const store = try EnvironmentQueryStore()
          if (store === null) return Option.none<A>()
          const stored = try store.load(environmentId, key)
          if (Option.isNone(stored)) return Option.none<A>()
          return Effect.asSome(Schema.decodeEffect(codec)(stored.value)) catch Effect.succeedNone()
        },
        "queryPersistence.load",
      ),
    save: effect (environmentId, key, value) =>
      try withSpan(
        effect {
          return ((effect () => {
            const store = try EnvironmentQueryStore()
            if (store === null) return
            const payload = try Schema.encodeEffect(codec)(value)
            try store.save(environmentId, key, payload)
          })()) catch Effect.logWarning("Offline query cache save failed")
        },
        "queryPersistence.save",
      ),
  }
}
