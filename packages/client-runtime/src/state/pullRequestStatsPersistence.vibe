import {
  PullRequestDiffStat,
  PullRequestListStatsInput,
  type PullRequestListStatsResult,
  type PullRequestRef,
} from "@t3tools/contracts"
import { persistQuery, type QueryPersistence } from "./queryPersistence.vibe"

const requestKey = Schema.fromJsonString(Schema.Tuple([Schema.String, PullRequestListStatsInput]))
const statKey = (ref: PullRequestRef): string =>
  JSON.stringify(["pull-request-stat", ref.projectId, ref.host ?? "", ref.repository, ref.number])

export function persistPullRequestStats(): QueryPersistence<PullRequestListStatsResult> {
  const row = persistQuery(PullRequestDiffStat)
  return {
    load: effect (environmentId, key) =>
      withSpan(
        effect {
          const [, input] = try Schema.decodeEffect(requestKey)(key)
          const rows = try Effect.forEach(input.refs, effect (ref) => try row.load(environmentId, statKey(ref)))
          const stats = rows.flatMap((value) => (Option.isSome(value) ? [value.value] : []))
          return stats.length ? Option.some({ stats }) : Option.none()
        } catch effect () => Option.none(),
        "pullRequestStatsPersistence.load",
      ),
    save: effect (environmentId, key, result) =>
      withSpan(
        Effect.ignore(effect {
          const [, input] = try Schema.decodeEffect(requestKey)(key)
          try Effect.forEach(result.stats, effect (stat) => {
            const ref = input.refs.find(
              (ref) =>
                ref.projectId === stat.projectId
                && ref.repository === stat.repository
                && ref.number === stat.number,
            )
            if (ref) try row.save(environmentId, statKey(ref), stat)
          })
        }),
        "pullRequestStatsPersistence.save",
      ),
  }
}
