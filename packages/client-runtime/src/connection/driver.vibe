import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Scope from "effect/Scope"

import type { ConnectionCatalogEntry, ConnectionRoute } from "./catalog.vibe"
import type { ConnectionAttemptError, ConnectionAttemptStage, PreparedConnection } from "./model.vibe"
import { ConnectionTransientError } from "#vibelang/emitted/src/connection/model"
import * as ConnectionResolver from "./resolver.vibe"
import {
  connectionRoutes,
  routeEntry,
  routeHttpBaseUrl,
  sendsTokenInClear,
  usableRoutes,
} from "#vibelang/emitted/src/connection/routes"
import * as RpcSession from "#vibelang/emitted/src/rpc/session"
import { fetchRemoteEnvironmentDescriptor } from "#vibelang/emitted/src/environment/descriptor"

export type ConnectionDriverProgress =
  | {
    readonly stage: "preparing"
  }
  | {
    readonly stage: Exclude<ConnectionAttemptStage, "preparing">
    readonly prepared: PreparedConnection
  }

export interface EnvironmentConnectionLease {
  readonly prepared: PreparedConnection
  readonly session: RpcSession.RpcSession
}

export type RouteCheck = "answered" | "silent" | "unchecked"

const ROUTE_CHECK_TIMEOUT_MS = 2_500
// Preferred direct routes share one head start, so a relay connection does not
// wait the full probe timeout for a LAN the device has already left. A route
// that misses it connects over relay, then upgrades with a second reconnect.
const ROUTE_CHECK_HEAD_START_MS = 500

export service ConnectionDriver: {
  readonly connect: (
    entry: ConnectionCatalogEntry,
    reportProgress: (progress: ConnectionDriverProgress) => void!!,
  ) => EnvironmentConnectionLease!ConnectionAttemptError!Scope.Scope;
  readonly checkRoute: (
    entry: ConnectionCatalogEntry,
    route: ConnectionRoute,
  ) => RouteCheck!!;
  readonly preflight: (
    entry: ConnectionCatalogEntry,
    route: ConnectionRoute,
  ) => boolean!!;
  /** Asks the host behind a live session to answer a fresh request on the session's own origin. */
  readonly checkHost: (prepared: PreparedConnection) => RouteCheck!!;
} {
  static readonly key = "@t3tools/client-runtime/connection/driver/ConnectionDriver"
}

export const connectOverRoutes = effect <R>(
  entry: ConnectionCatalogEntry,
  checkRoute: (route: ConnectionRoute) => RouteCheck!!,
  connectRoute: (
    route: ConnectionRoute,
  ) => Effect.Effect<EnvironmentConnectionLease, ConnectionAttemptError, (R | Scope.Scope)>,
): EnvironmentConnectionLease!(import("./model.vibe").ConnectionBlockedError | ConnectionTransientError)!(Scope.Scope | Exclude<R, Scope.Scope>) =>
  try withSpan(
    effect {
      const routes = usableRoutes(entry)
      const checks = routes.length === 1
        ? []
        : try Effect.forEach(routes, (route) => Effect.forkChild(checkRoute(route)))
      const headStart = try Effect.forkChild(Effect.sleep(ROUTE_CHECK_HEAD_START_MS))
      const attemptScope = try Scope.Scope
      let transient: ConnectionAttemptError | undefined
      let blocked: ConnectionAttemptError | undefined
      // Each route gets its own scope so a half-open session closes before the next try.
      const attempt = effect (route: ConnectionRoute) => {
        const routeScope = try Scope.fork(attemptScope)
        const result = try (connectRoute(route)
          |> Scope.provide(%, routeScope)
          |> Effect.onExit(%, (exit) => (Exit.isSuccess(exit) ? Effect.void : Scope.close(routeScope, exit)))
          |> Effect.result(%))
        if (result._tag === "Failure") {
          if (result.failure._tag === "ConnectionTransientError") transient ??= result.failure
          else blocked ??= result.failure
        }
        return result
      }
      const silent: Array<{ readonly route: ConnectionRoute; readonly index: number }> = []
      for (const [index, route] of routes.entries()) {
        const check = checks.length === 0
          ? "unchecked"
          : try Effect.raceFirst(
            Fiber.join(checks[index]!),
            Fiber.join(headStart) |> Effect.as<RouteCheck>("silent")(%),
          )
        if (check === "silent") {
          silent.push({ route, index })
          continue
        }
        const result = try attempt(route)
        if (result._tag === "Success") return result.success
        // An incompatible server is the same server on every route.
        if (result.failure.reason === "unsupported") throw result.failure
      }
      // A slow route that answered after the head start goes before one that is
      // still dead, which can hold an attempt open far longer than its probe.
      const late = try Effect.forEach(silent, ({ index }) => Fiber.join(checks[index]!), {
        concurrency: "unbounded",
      })
      const retry = [
        ...silent.filter((_, position) => late[position] !== "silent"),
        ...silent.filter((_, position) => late[position] === "silent"),
      ]
      for (const { route } of retry) {
        const result = try attempt(route)
        if (result._tag === "Success") return result.success
        if (result.failure.reason === "unsupported") throw result.failure
      }
      throw (
        transient
          ?? blocked
          ?? new ConnectionTransientError({
            reason: "endpoint-unavailable",
            detail: `${entry.target.label} did not answer on any saved route.`,
          })
      )
    },
    "ConnectionDriver.connectOverRoutes",
  )

/** @public */
export const make = effect {
  const resolver = try ConnectionResolver.ConnectionResolver
  const sessions = try RpcSession.RpcSessionFactory
  const httpClient = try HttpClient.HttpClient

  // The descriptor is public, so this sends no credential to whatever
  // answers at a saved LAN address on a different network.
  const checkDescriptor = (httpBaseUrl: string, environmentId: string) =>
    fetchRemoteEnvironmentDescriptor({
      httpBaseUrl,
      timeoutMs: ROUTE_CHECK_TIMEOUT_MS,
    })
    |> Effect.map(%, (descriptor): RouteCheck => descriptor.environmentId === environmentId ? "answered" : "silent")
    |> Effect.orElseSucceed(%, (): RouteCheck => "silent")
    // A cached descriptor would answer for a host that cannot be reached.
    |> Effect.provideService(%, FetchHttpClient.RequestInit, { cache: "no-store" })
    |> Effect.provideService(%, HttpClient.HttpClient, httpClient)

  const checkRoute = (entry: ConnectionCatalogEntry, route: ConnectionRoute) => {
    const httpBaseUrl = routeHttpBaseUrl(route)
    if (httpBaseUrl === null) return Effect.succeed<RouteCheck>("unchecked")
    return (() => {
      const pipe$program = checkDescriptor(httpBaseUrl, entry.target.environmentId)
      return pipe$program |> withSpan(%, "ConnectionDriver.checkRoute", {
        attributes: { "connection.target.kind": route.target._tag },
      })
    })()
  }

  const checkHost = (prepared: PreparedConnection) =>
    (() => {
      const pipe$program = checkDescriptor(prepared.httpBaseUrl, prepared.environmentId)
      return pipe$program |> withSpan(%, "ConnectionDriver.checkHost", {
        attributes: { "connection.target.kind": prepared.target._tag },
      })
    })()

  const connect = effect (
    entry: ConnectionCatalogEntry,
    reportProgress: (progress: ConnectionDriverProgress) => void!!,
  ) =>
    try withSpan(
      effect {
        const target = entry.target
        try Effect.annotateCurrentSpan({
          "connection.environment.id": target.environmentId,
          "connection.target.kind": target._tag,
          "connection.route.count": connectionRoutes(entry).length,
        })
        try reportProgress({ stage: "preparing" })
        return try connectOverRoutes(
          entry,
          (route) => checkRoute(entry, route),
          effect (route) => {
            const prepared = try resolver.prepare(routeEntry(entry, route))
            try reportProgress({ stage: "opening", prepared })
            const session = try sessions.connect(prepared)
            try reportProgress({ stage: "synchronizing", prepared })
            try session.ready
            return { prepared, session } satisfies EnvironmentConnectionLease
          },
        )
      },
      "ConnectionDriver.connect",
    )

  const preflight = (entry: ConnectionCatalogEntry, route: ConnectionRoute) =>
    (sendsTokenInClear(connectionRoutes(entry), route)
      ? Effect.succeed("silent" as const)
      : checkRoute(entry, route))
    |> Effect.flatMap(%, (check) =>
      check === "answered"
        ? (resolver.prepare(routeEntry(entry, route))
          |> Effect.as(%, true)
          |> Effect.orElseSucceed(%, () => false))
        : Effect.succeed(false))
    |> withSpan(%, "ConnectionDriver.preflight")

  return ConnectionDriver.of({ connect, checkRoute, preflight, checkHost })
}

export const layer = Layer.effect(ConnectionDriver, make)
