import {
  ORCHESTRATION_PROTOCOL_VERSION,
  type EnvironmentId,
  type ExecutionEnvironmentDescriptor,
  type ServerSelfUpdateInput,
  type ServerSelfUpdateResult,
  WS_METHODS,
} from "@t3tools/contracts"
import * as Effect from "effect/Effect"
import * as Schema from "effect/Schema"
import * as HttpClient from "effect/http/HttpClient"
import * as Socket from "effect/socket/Socket"

import { fetchRemoteEnvironmentDescriptor } from "../environment/descriptor.vibe"
import { makeWsRpcProtocolClient, PING_TIMEOUT } from "../rpc/protocol.ts"
import { isLegacyUpdateHandoffLoss, resolveServerUpdateProgressResult } from "../state/server.vibe"
import * as RelayEnvironmentDiscovery from "../relay/discovery.vibe"
import * as ConnectionResolver from "./resolver.vibe"
import * as EnvironmentRegistry from "./registry.vibe"
import { connectionRoutes, hasRelayRoute, routeEntry, routeHttpBaseUrl, usableRoutes } from "./routes.vibe"

// A v1 host restarting into v2 runs migrations before its descriptor answers again.
const OUTDATED_HOST_RESTART_TIMEOUT = Duration.minutes(4)
const SOCKET_OPEN_TIMEOUT = "15 seconds"

export schema error OutdatedHostUpdateError {
  readonly environmentId: string
  readonly message: string
}

export type OutdatedHostUpdateStage = "downloading" | "installing" | "resuming"

const reachOutdatedHost = effect (
  environmentId: EnvironmentId,
) =>
  try withSpan(
    effect {
      const registry = try EnvironmentRegistry.EnvironmentRegistry
      const resolver = try ConnectionResolver.ConnectionResolver
      const entry = (try SubscriptionRef.get(registry.entries)).get(environmentId)
      if (entry === undefined) {
        throw new EnvironmentRegistry.EnvironmentNotRegisteredError({ environmentId })
      }
      const { prepared, descriptor } = try Effect.firstSuccessOf(
        usableRoutes(entry).map((route) => resolver.prepareForUpdate(routeEntry(entry, route))),
      )
      return { entry, prepared, descriptor }
    },
    "clientRuntime.connection.reachOutdatedHost",
  )

// The normal session cannot read config from a host behind the protocol gate.
export const describeOutdatedHost = (environmentId: EnvironmentId) =>
  reachOutdatedHost(environmentId) |> Effect.map(%, ({ descriptor }) => descriptor)

/**
 * The normal session refuses to open against such a host, so this opens a bare
 * socket and calls only the self-update RPCs, whose wire shape has not changed
 * across protocol versions.
 */
export const updateOutdatedHost = effect (
  environmentId: EnvironmentId,
  input: { readonly targetVersion: string; readonly continueRunningThreads?: boolean },
  onStage: (stage: OutdatedHostUpdateStage) => void!!,
) =>
  try withSpan(
    effect {
      const registry = try EnvironmentRegistry.EnvironmentRegistry
      const webSocketConstructor = try Socket.WebSocketConstructor
      const httpClient = try HttpClient.HttpClient
      const { entry, prepared, descriptor } = try reachOutdatedHost(environmentId)
      // Discovery still holds the old relay descriptor and would re-block the
      // environment from it, so replace that before clearing the block.
      const switchBackOn = effect {
        if (hasRelayRoute(entry)) {
          const discovery = try RelayEnvironmentDiscovery.RelayEnvironmentDiscovery
          try discovery.refresh
        }
        try registry.setCompatibility(environmentId, null)
        try registry.setEnabled(environmentId, true)
      }

      // A host updated by hand is already compatible, and a bare socket would be
      // rejected with 426, so there is nothing to update.
      if (isCompatibleDescriptor(descriptor)) {
        try switchBackOn
        return { targetVersion: descriptor.serverVersion }
      }

      const capabilities = descriptor.capabilities
      if (
        capabilities.serverSelfUpdate === undefined
        || (capabilities.serverSelfUpdate === "desktop-managed"
          && capabilities.desktopAppUpdate !== true)
      ) {
        throw new OutdatedHostUpdateError({
          environmentId,
          message: `Update T3 Code on ${descriptor.label} manually; it cannot update itself.`,
        })
      }

      const result = try Effect.scoped(
        effect {
          const protocolContext = try Layer.build(
            Layer.effect(
              RpcClient.Protocol,
              RpcClient.makeProtocolSocket({
                pingTimeout: PING_TIMEOUT,
                retryTransientErrors: false,
                retryPolicy: Schedule.recurs(0),
              }),
            ).pipe(
              Layer.provide(
                Layer.mergeAll(
                  Socket.layerWebSocket(prepared.socketUrl, {
                    openTimeout: SOCKET_OPEN_TIMEOUT,
                  }).pipe(
                    Layer.provide(Layer.succeed(Socket.WebSocketConstructor, webSocketConstructor)),
                  ),
                  RpcSerialization.layerJson,
                ),
              ),
            ),
          )
          const client = try effect {
            provide protocolContext {
              return try makeWsRpcProtocolClient
            }
          }

          const updateResult: ServerSelfUpdateResult = capabilities.serverSelfUpdateProgress === true
            ? try effect {
              const terminal = try Ref.make(Option.none<ServerSelfUpdateResult>())
              const streamExit = try (client[WS_METHODS.serverUpdateServerWithProgress](
                input,
              )
                |> Stream.runForEach(%, (event) =>
                  event.type === "complete"
                    ? Ref.set(terminal, Option.some(event.result))
                    : onStage(event.stage))
                |> Effect.exit(%))
              return try resolveServerUpdateProgressResult(
                input.targetVersion,
                try Ref.get(terminal),
                streamExit,
              )
            }
            : try (client[WS_METHODS.serverUpdateServer](input)
              // Older servers can drop the socket before acknowledging the restart.
              |> Effect.catchCauseIf(
                %,
                (cause) =>
                  (capabilities.serverSelfUpdate === "boot-service"
                    || capabilities.serverSelfUpdate === "respawn")
                  && isLegacyUpdateHandoffLoss(cause),
                () =>
                  Effect.succeed(
                    {
                      targetVersion: input.targetVersion,
                      method: capabilities.serverSelfUpdate as "boot-service" | "respawn",
                    } satisfies ServerSelfUpdateResult,
                  ),
              ))

          if (
            updateResult.method === "desktop-app"
            && updateResult.desktopUpdateToken !== undefined
          ) {
            // The commit relaunches the desktop app, so a dropped socket is success.
            try (client[WS_METHODS.serverCommitDesktopUpdate]({
              requestId: updateResult.desktopUpdateToken,
            })
              |> Effect.catchCauseIf(
                %,
                (cause) => isLegacyUpdateHandoffLoss(cause),
                () => Effect.void,
              ))
          }
          return updateResult
        },
      )

      try onStage("resuming")
      const pollUrls = [
        prepared.httpBaseUrl,
        ...connectionRoutes(entry).flatMap((route) => routeHttpBaseUrl(route) ?? []),
      ].filter((url, index, all) => all.indexOf(url) === index)
      const resumed = try (Effect.firstSuccessOf(
        pollUrls.map((httpBaseUrl) =>
          fetchRemoteEnvironmentDescriptor({ httpBaseUrl }).pipe(
            Effect.filterOrFail(
              (descriptor) => descriptor.environmentId === environmentId && isCompatibleDescriptor(descriptor),
              () => "not-ready" as const,
            ),
          )
        ),
      ).pipe(
        Effect.provideService(HttpClient.HttpClient, httpClient),
        Effect.option,
        Effect.repeat({
          schedule: Schedule.spaced(Duration.seconds(1)),
          until: (current) => Option.exists(current, isCompatibleDescriptor),
        }),
        Effect.timeoutOption(OUTDATED_HOST_RESTART_TIMEOUT),
        Effect.map(Option.flatten),
      ))
      if (Option.isNone(resumed)) {
        throw new OutdatedHostUpdateError({
          environmentId,
          message: `${descriptor.label} did not come back on a compatible T3 Code version.`,
        })
      }

      try switchBackOn
      return { ...result, targetVersion: resumed.value.serverVersion }
    },
    "clientRuntime.connection.updateOutdatedHost",
  )

function isCompatibleDescriptor(descriptor: ExecutionEnvironmentDescriptor): boolean {
  return (descriptor.orchestrationProtocolVersion ?? 1) === ORCHESTRATION_PROTOCOL_VERSION
}
