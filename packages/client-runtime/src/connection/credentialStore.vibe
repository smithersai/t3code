import * as Context from "effect/Context"
import type * as Effect from "effect/Effect"
import type * as Option from "effect/Option"

import type { ConnectionCredential } from "./catalog.vibe"
import type { ConnectionAttemptError } from "./model.vibe"

export service ConnectionCredentialStore: {
    readonly get: (
      connectionId: string,
    ) => Option.Option<ConnectionCredential>!ConnectionAttemptError;
    readonly put: (
      connectionId: string,
      credential: ConnectionCredential,
    ) => void!ConnectionAttemptError;
    readonly remove: (connectionId: string) => void!ConnectionAttemptError;
  } {
  static override readonly key = "@t3tools/client-runtime/connection/credentialStore/ConnectionCredentialStore"
}

export const make = (service: ConnectionCredentialStore["Service"]): infer _ => ConnectionCredentialStore.of(service)
