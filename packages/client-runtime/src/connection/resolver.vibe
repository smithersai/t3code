import type { AuthClientPresentationMetadata, ExecutionEnvironmentDescriptor } from "@t3tools/contracts"
import { withRelayClientTracing } from "@t3tools/shared/relayTracing"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as HttpClient from "effect/http/HttpClient"

import {
  appendClientConnectionParams,
  type ClientOwnerParams,
  readClientOwnerParams,
} from "#vibelang/emitted/src/authorization/remote"
import * as RemoteEnvironmentAuthorization from "../authorization/service.vibe"
import * as ClientCapabilities from "#vibelang/emitted/src/platform/capabilities"
import {
  BearerConnectionCredential,
  BearerConnectionProfile,
  type ConnectionCatalogEntry,
  SshConnectionProfile,
} from "#vibelang/emitted/src/connection/catalog"
import * as ConnectionCredentialStore from "#vibelang/emitted/src/connection/credentialStore"
import {
  credentialMissingError,
  environmentMismatchError,
  mapRemoteEnvironmentError,
  profileMissingError,
} from "./errors.ts"
import {
  PullRequestRoutingPermissions,
  pullRequestRoutingConnectionKey,
} from "#vibelang/emitted/src/connection/pullRequestRoutingPermissions"
import type {
  BearerConnectionTarget,
  ConnectionTarget,
  PreparedConnection,
  PrimaryConnectionTarget,
  RelayConnectionTarget,
  SshConnectionTarget,
} from "./model.vibe"
import { ConnectionBlockedError, type ConnectionAttemptError } from "#vibelang/emitted/src/connection/model"
import * as ConnectionProfileStore from "#vibelang/emitted/src/connection/profileStore"
import { appendOrchestrationProtocol, orchestrationProtocolCompatibilityError } from "./compatibility.ts"
import { credentialConnectionId } from "#vibelang/emitted/src/connection/routes"
import { fetchRemoteEnvironmentDescriptor } from "#vibelang/emitted/src/environment/descriptor"

export class ConnectionResolver extends Context.Service<
  ConnectionResolver,
  {
    readonly prepare: (
      entry: ConnectionCatalogEntry,
    ) => PreparedConnection!ConnectionAttemptError
    /**
     * Authorizes a socket without the orchestration protocol gate, for hosts
     * too old to connect normally. Only update RPCs may run over it.
     */
    readonly prepareForUpdate: (entry: ConnectionCatalogEntry) => {
        readonly prepared: PreparedConnection;
        readonly descriptor: ExecutionEnvironmentDescriptor;
      }!ConnectionAttemptError
  }
>()("@t3tools/client-runtime/connection/resolver/ConnectionResolver") {}

const isBearerProfile = Schema.is(BearerConnectionProfile)
const isSshProfile = Schema.is(SshConnectionProfile)
const isBearerCredential = Schema.is(BearerConnectionCredential)

function primarySocketUrl(
  target: PrimaryConnectionTarget,
  clientMetadata: AuthClientPresentationMetadata | undefined,
  owners: ClientOwnerParams,
): string {
  const url = new URL(target.wsBaseUrl)
  if (url.pathname === "" || url.pathname === "/") {
    url.pathname = "/ws"
  }
  appendClientConnectionParams(url, clientMetadata, "direct", owners)
  return url.toString()
}

const makePrimaryBroker = effect () =>
  try withSpan(
    effect {
      const auth = try ClientCapabilities.PrimaryEnvironmentAuth
      const presentation = try ClientCapabilities.ClientPresentation
      const remote = try RemoteEnvironmentAuthorization.RemoteEnvironmentAuthorization

      return effect (
        target: PrimaryConnectionTarget,
      ): ({ environmentId: string & import("effect/Brand").Brand<"EnvironmentId">; label: string; httpBaseUrl: string; socketUrl: string; httpAuthorization: null; target: PrimaryConnectionTarget; } | { environmentId: import("@t3tools/contracts").EnvironmentId; label: string; httpBaseUrl: string; socketUrl: string; httpAuthorization: import("./model.vibe").PreparedHttpAuthorization; target: PrimaryConnectionTarget; })!ConnectionAttemptError!never =>
        try withSpan(
          (effect (): ({ environmentId: string & import("effect/Brand").Brand<"EnvironmentId">; label: string; httpBaseUrl: string; socketUrl: string; httpAuthorization: null; target: PrimaryConnectionTarget; } | { environmentId: import("@t3tools/contracts").EnvironmentId; label: string; httpBaseUrl: string; socketUrl: string; httpAuthorization: import("./model.vibe").PreparedHttpAuthorization; target: PrimaryConnectionTarget; })!ConnectionAttemptError!never => {
            const bearerToken = try auth.bearerToken
            if (Option.isNone(bearerToken)) {
              return {
                environmentId: target.environmentId,
                label: target.label,
                httpBaseUrl: target.httpBaseUrl,
                socketUrl: primarySocketUrl(target, presentation.metadata, try readClientOwnerParams),
                httpAuthorization: null,
                target,
              } satisfies PreparedConnection
            }

            const authorized = try remote.authorizeBearer({
              expectedEnvironmentId: target.environmentId,
              httpBaseUrl: target.httpBaseUrl,
              wsBaseUrl: target.wsBaseUrl,
              bearerToken: bearerToken.value,
              connectionMethod: "direct",
            })
            return {
              ...authorized,
              target,
            } satisfies PreparedConnection
          })(),
          "clientRuntime.connection.broker.primary",
        )
    },
    "clientRuntime.connection.broker.makePrimary",
  )

const makeBearerBroker = effect () =>
  try withSpan(
    effect {
      const credentials = try ConnectionCredentialStore.ConnectionCredentialStore
      const remote = try RemoteEnvironmentAuthorization.RemoteEnvironmentAuthorization

      return effect (
        entry: ConnectionCatalogEntry & { readonly target: BearerConnectionTarget },
      ): { environmentId: import("@t3tools/contracts").EnvironmentId; label: string; httpBaseUrl: string; socketUrl: string; httpAuthorization: import("./model.vibe").PreparedHttpAuthorization; target: BearerConnectionTarget; }!ConnectionAttemptError =>
        try withSpan(
          (effect (): { environmentId: import("@t3tools/contracts").EnvironmentId; label: string; httpBaseUrl: string; socketUrl: string; httpAuthorization: import("./model.vibe").PreparedHttpAuthorization; target: BearerConnectionTarget; }!ConnectionAttemptError => {
            const target = entry.target
            const profile = try Effect.fromOption(entry.profile, () => profileMissingError(target.connectionId))
            if (!isBearerProfile(profile)) {
              throw new ConnectionBlockedError({
                reason: "configuration",
                detail: `Connection profile ${target.connectionId} is not a bearer connection.`,
              })
            }
            if (profile.environmentId !== target.environmentId) {
              throw environmentMismatchError({
                expected: target.environmentId,
                actual: profile.environmentId,
              })
            }
            if (profile.authorization === "t3-connect") {
              const authorized = try remote.authorizeDpop({
                expectedEnvironmentId: target.environmentId,
                directEndpoint: { httpBaseUrl: profile.httpBaseUrl, wsBaseUrl: profile.wsBaseUrl },
              })
              return { ...authorized, target } satisfies PreparedConnection
            }
            const credential = try (credentials.get(credentialConnectionId(target.connectionId))
              |> Effect.flatMap(
                %,
                Option.match({
                  onNone: () => Effect.fail(credentialMissingError(target.connectionId)),
                  onSome: (value) => Effect.succeed(value),
                }),
              ))
            if (!isBearerCredential(credential)) {
              throw credentialMissingError(target.connectionId)
            }
            const authorized = try remote.authorizeBearer({
              expectedEnvironmentId: target.environmentId,
              httpBaseUrl: profile.httpBaseUrl,
              wsBaseUrl: profile.wsBaseUrl,
              bearerToken: credential.token,
              connectionMethod: "direct",
            })
            return {
              environmentId: authorized.environmentId,
              label: authorized.label,
              httpBaseUrl: authorized.httpBaseUrl,
              socketUrl: authorized.socketUrl,
              httpAuthorization: authorized.httpAuthorization,
              target,
            } satisfies PreparedConnection
          })(),
          "clientRuntime.connection.broker.bearer",
        )
    },
    "clientRuntime.connection.broker.makeBearer",
  )

const makeRelayBroker = effect () =>
  try withSpan(
    effect {
      const remote = try RemoteEnvironmentAuthorization.RemoteEnvironmentAuthorization

      return effect (target: RelayConnectionTarget) =>
        try (effect {
          const authorized = try remote.authorizeDpop({
            expectedEnvironmentId: target.environmentId,
          })
          return {
            environmentId: authorized.environmentId,
            label: authorized.label,
            httpBaseUrl: authorized.httpBaseUrl,
            socketUrl: authorized.socketUrl,
            httpAuthorization: authorized.httpAuthorization,
            target,
          } satisfies PreparedConnection
        } |> withSpan(%, "clientRuntime.connection.broker.relay") |> withRelayClientTracing(%))
    },
    "clientRuntime.connection.broker.makeRelay",
  )

const makeSshBroker = effect () =>
  try withSpan(
    effect {
      const profiles = try ConnectionProfileStore.ConnectionProfileStore
      const credentials = try ConnectionCredentialStore.ConnectionCredentialStore
      const ssh = try ClientCapabilities.SshEnvironmentGateway
      const remote = try RemoteEnvironmentAuthorization.RemoteEnvironmentAuthorization

      return effect (
        entry: ConnectionCatalogEntry & { readonly target: SshConnectionTarget },
      ): { environmentId: string & import("effect/Brand").Brand<"EnvironmentId">; label: string; httpBaseUrl: string; socketUrl: string; httpAuthorization: import("./model.vibe").PreparedHttpAuthorization; target: SshConnectionTarget; }!ConnectionAttemptError =>
        try withSpan(
          (effect (): { environmentId: string & import("effect/Brand").Brand<"EnvironmentId">; label: string; httpBaseUrl: string; socketUrl: string; httpAuthorization: import("./model.vibe").PreparedHttpAuthorization; target: SshConnectionTarget; }!ConnectionAttemptError => {
            const target = entry.target
            const profile = try Effect.fromOption(entry.profile, () => profileMissingError(target.connectionId))
            if (!isSshProfile(profile)) {
              throw new ConnectionBlockedError({
                reason: "configuration",
                detail: `Connection profile ${target.connectionId} is not an SSH connection.`,
              })
            }
            if (profile.environmentId !== target.environmentId) {
              throw environmentMismatchError({
                expected: target.environmentId,
                actual: profile.environmentId,
              })
            }
            // Each pairing adds a session on the host, so connects reuse the saved token.
            const saved = Option.getOrUndefined(try credentials.get(target.connectionId))
            const savedToken = saved !== undefined && isBearerCredential(saved) ? saved.token : undefined
            const prepared = try ssh.prepare({
              connectionId: target.connectionId,
              expectedEnvironmentId: target.environmentId,
              target: profile.target,
              ...(savedToken === undefined ? {} : { bearerToken: savedToken }),
            })
            if (prepared.bearerToken !== savedToken) {
              try credentials.put(
                target.connectionId,
                new BearerConnectionCredential({ token: prepared.bearerToken }),
              )
            }
            const preparedProfile = new SshConnectionProfile({
              connectionId: profile.connectionId,
              environmentId: profile.environmentId,
              label: profile.label,
              target: prepared.bootstrap.target,
            })
            if (
              pullRequestRoutingConnectionKey(entry)
                !== pullRequestRoutingConnectionKey({ ...entry, profile: Option.some(preparedProfile) })
            ) {
              const permissions = try PullRequestRoutingPermissions
              try permissions.forget(target.environmentId)
            }
            try profiles.put(preparedProfile)
            const authorized = try remote.authorizeBearer({
              expectedEnvironmentId: target.environmentId,
              httpBaseUrl: prepared.bootstrap.httpBaseUrl,
              wsBaseUrl: prepared.bootstrap.wsBaseUrl,
              bearerToken: prepared.bearerToken,
              connectionMethod: "ssh",
            })
            return {
              environmentId: authorized.environmentId,
              label: authorized.label,
              httpBaseUrl: authorized.httpBaseUrl,
              socketUrl: authorized.socketUrl,
              httpAuthorization: authorized.httpAuthorization,
              target,
            } satisfies PreparedConnection
          })(),
          "clientRuntime.connection.broker.ssh",
        )
    },
    "clientRuntime.connection.broker.makeSsh",
  )

/** @public */
export const make = effect {
  const primary = try makePrimaryBroker()
  const bearer = try makeBearerBroker()
  const relay = try makeRelayBroker()
  const ssh = try makeSshBroker()
  const httpClient = try HttpClient.HttpClient

  const authorize = effect (
    entry: ConnectionCatalogEntry,
  ) =>
    try withSpan(
      effect {
        const target: ConnectionTarget = entry.target
        try Effect.annotateCurrentSpan({
          "connection.environment.id": target.environmentId,
          "connection.target.kind": target._tag,
        })
        const prepared = try (() => {
          switch (target._tag) {
            case "PrimaryConnectionTarget":
              return primary(target)
            case "BearerConnectionTarget":
              return bearer({ ...entry, target })
            case "RelayConnectionTarget":
              return relay(target)
            case "SshConnectionTarget":
              return ssh({ ...entry, target })
          }
        })()
        const descriptor = try effect {
          provide HttpClient.HttpClient = httpClient {
            return fetchRemoteEnvironmentDescriptor({
              httpBaseUrl: prepared.httpBaseUrl,
            }) catch effect (e) => {
              throw mapRemoteEnvironmentError(e)
            }
          }
        }
        if (descriptor.environmentId !== target.environmentId) {
          throw environmentMismatchError({
            expected: target.environmentId,
            actual: descriptor.environmentId,
          })
        }
        return { prepared, descriptor }
      },
      "clientRuntime.connection.broker.authorize",
    )

  const prepare = effect (
    entry: ConnectionCatalogEntry,
  ) =>
    try withSpan(
      effect {
        const { prepared, descriptor } = try authorize(entry)
        const compatibilityError = try Effect.orDie(
          Effect.try({ try: () => orchestrationProtocolCompatibilityError(descriptor), catch: (e) => e }),
        )
        if (compatibilityError !== null) {
          throw compatibilityError
        }
        return {
          ...prepared,
          socketUrl: try Effect.orDie(
            Effect.try({ try: () => appendOrchestrationProtocol(prepared.socketUrl), catch: (e) => e }),
          ),
        }
      },
      "clientRuntime.connection.broker.prepare",
    )

  return ConnectionResolver.of({ prepare, prepareForUpdate: authorize })
}

export const layer = Layer.effect(ConnectionResolver, make)
