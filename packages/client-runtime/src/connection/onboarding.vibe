import type { DesktopSshEnvironmentTarget, EnvironmentId } from "@t3tools/contracts"
import { resolveRemotePairingTarget } from "@t3tools/shared/remote"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Option from "effect/Option"
import * as HttpClient from "effect/http/HttpClient"

import { bootstrapRemoteBearerSession } from "#vibelang/emitted/src/authorization/remote"
import { deriveWsBaseUrl, normalizeHttpBaseUrl } from "../environment/endpoint.ts"
import { fetchRemoteEnvironmentDescriptor } from "#vibelang/emitted/src/environment/descriptor"
import * as ClientCapabilities from "#vibelang/emitted/src/platform/capabilities"
import {
  BearerConnectionCredential,
  BearerConnectionProfile,
  BearerConnectionRegistration,
  type ConnectionCatalogEntry,
  type ConnectionCredential,
  SshConnectionProfile,
  SshConnectionRegistration,
} from "#vibelang/emitted/src/connection/catalog"
import * as ConnectionCredentialStore from "#vibelang/emitted/src/connection/credentialStore"
import { mapRemoteEnvironmentError } from "./errors.ts"
import {
  BearerConnectionTarget,
  ConnectionBlockedError,
  SshConnectionTarget,
  type ConnectionAttemptError,
} from "#vibelang/emitted/src/connection/model"
import * as Persistence from "#vibelang/emitted/src/platform/persistence"
import * as EnvironmentRegistry from "#vibelang/emitted/src/connection/registry"
import { orchestrationProtocolCompatibilityError } from "./compatibility.ts"
import { connectionRoutes, routeEntry, sshTargetKey } from "#vibelang/emitted/src/connection/routes"

export interface PairingConnectionInput {
  readonly pairingUrl?: string
  readonly host?: string
  readonly pairingCode?: string
  readonly expectedEnvironmentId?: EnvironmentId
}

export interface SshConnectionInput {
  readonly target: DesktopSshEnvironmentTarget
  readonly label?: string
  readonly expectedEnvironmentId?: EnvironmentId
}

export interface BearerConnectionUpdateInput {
  readonly environmentId: EnvironmentId
  readonly label: string
  readonly httpBaseUrl: string
}

export service ConnectionOnboarding: {
  readonly registerPairing: (
    input: PairingConnectionInput,
  ) => EnvironmentId!(ConnectionAttemptError | Persistence.ConnectionPersistenceError);
  readonly registerSsh: (
    input: SshConnectionInput,
  ) => EnvironmentId!(ConnectionAttemptError | Persistence.ConnectionPersistenceError);
  readonly updateBearer: (
    input: BearerConnectionUpdateInput,
  ) => void!(ConnectionAttemptError | Persistence.ConnectionPersistenceError);
} {
  static readonly key = "@t3tools/client-runtime/connection/onboarding/ConnectionOnboarding"
}

const resolvePairingTarget = effect (input: PairingConnectionInput) =>
  try withSpan(
    effect {
      return try Effect.try({
        try: () => resolveRemotePairingTarget(input),
        catch: (cause) =>
          new ConnectionBlockedError({
            reason: "configuration",
            detail: cause instanceof Error ? cause.message : "The pairing details are invalid.",
          }),
      })
    },
    "clientRuntime.connection.onboarding.resolvePairingTarget",
  )

function bearerConnectionId(environmentId: EnvironmentId, httpBaseUrl: string): string {
  return `bearer:${environmentId}:${new URL(httpBaseUrl).origin}`
}

function differentMachineError(label: string) {
  return new ConnectionBlockedError({
    reason: "configuration",
    detail: `That address reaches ${label}, a different machine. Add it as its own environment instead.`,
  })
}

export const preparePairingRegistration = effect (input: PairingConnectionInput) =>
  try withSpan(
    effect {
      const target = try resolvePairingTarget(input)
      const presentation = try ClientCapabilities.ClientPresentation
      const descriptor = fetchRemoteEnvironmentDescriptor({
        httpBaseUrl: target.httpBaseUrl,
      }) catch effect (e) => {
        throw mapRemoteEnvironmentError(e)
      }
      // Checked before redeeming the one-time code, so a wrong link is not spent.
      if (
        input.expectedEnvironmentId !== undefined
        && descriptor.environmentId !== input.expectedEnvironmentId
      ) {
        throw differentMachineError(descriptor.label)
      }
      const compatibilityError = try Effect.orDie(
        Effect.try({ try: () => orchestrationProtocolCompatibilityError(descriptor), catch: (e) => e }),
      )
      // An outdated server is still saved so it can be updated from this client.
      if (compatibilityError !== null && compatibilityError.serverUpdateRequired !== true) {
        throw compatibilityError
      }
      const access = bootstrapRemoteBearerSession({
        httpBaseUrl: target.httpBaseUrl,
        credential: target.credential,
        clientMetadata: presentation.metadata,
      }) catch effect (e) => {
        throw mapRemoteEnvironmentError(e)
      }
      const connectionId = bearerConnectionId(descriptor.environmentId, target.httpBaseUrl)

      return new BearerConnectionRegistration({
        target: new BearerConnectionTarget({
          environmentId: descriptor.environmentId,
          label: descriptor.label,
          connectionId,
        }),
        profile: new BearerConnectionProfile({
          connectionId,
          environmentId: descriptor.environmentId,
          label: descriptor.label,
          httpBaseUrl: target.httpBaseUrl,
          wsBaseUrl: target.wsBaseUrl,
        }),
        credential: new BearerConnectionCredential({
          token: access.access_token,
        }),
      })
    },
    "clientRuntime.connection.onboarding.preparePairingRegistration",
  )

const registerPairingConnection = effect (input: PairingConnectionInput) =>
  try withSpan(
    effect {
      const registration = try preparePairingRegistration(input)
      const registry = try EnvironmentRegistry.EnvironmentRegistry
      if (!(try registry.register(registration))) return registration.target.environmentId
      try registry.setCompatibility(registration.target.environmentId, null)
      registry
        .setEnabled(registration.target.environmentId, true) catch effect (e) => match (e) {
          when { _tag: "EnvironmentNotRegisteredError" }: undefined as void;
          default: throw e;
        }
      return registration.target.environmentId
    },
    "clientRuntime.connection.onboarding.registerPairingConnection",
  )

const isBearerCredential = Schema.is(BearerConnectionCredential)
const isBearerProfile = Schema.is(BearerConnectionProfile)

const updateBearerConnection = effect (input: BearerConnectionUpdateInput) =>
  try withSpan(
    effect {
      const registry = try EnvironmentRegistry.EnvironmentRegistry
      const credentials = try ConnectionCredentialStore.ConnectionCredentialStore
      const saved = (try SubscriptionRef.get(registry.entries)).get(input.environmentId)
      const route = saved === undefined
        ? undefined
        : connectionRoutes(saved).find(
          (candidate) => candidate.target._tag === "BearerConnectionTarget",
        )
      const entry = saved === undefined || route === undefined ? saved : routeEntry(saved, route)
      const credential = entry?.target._tag === "BearerConnectionTarget"
        ? try credentials.get(entry.target.connectionId)
        : Option.none()
      const registration = try prepareBearerConnectionUpdate({
        input,
        entry: Option.fromUndefinedOr(entry),
        credential,
      })
      try registry.register(registration)
    },
    "clientRuntime.connection.onboarding.updateBearerConnection",
  )

export const prepareBearerConnectionUpdate = effect (
  options: {
    readonly input: BearerConnectionUpdateInput
    readonly entry: Option.Option<ConnectionCatalogEntry>
    readonly credential: Option.Option<ConnectionCredential>
  },
) =>
  try withSpan(
    effect {
      const entry = Option.getOrNull(options.entry)
      if (
        entry === undefined
        || entry === null
        || entry.target._tag !== "BearerConnectionTarget"
        || Option.isNone(entry.profile)
        || !isBearerProfile(entry.profile.value)
      ) {
        throw new ConnectionBlockedError({
          reason: "configuration",
          detail: "Only saved bearer environments can be edited.",
        })
      }

      const credential = options.credential
      if (Option.isNone(credential) || !isBearerCredential(credential.value)) {
        throw new ConnectionBlockedError({
          reason: "authentication",
          detail: "The saved bearer credential is unavailable.",
        })
      }

      const label = options.input.label.trim()
      if (label === "") {
        throw new ConnectionBlockedError({
          reason: "configuration",
          detail: "Environment label cannot be empty.",
        })
      }
      const httpBaseUrl = try Effect.try({
        try: () => normalizeHttpBaseUrl(options.input.httpBaseUrl),
        catch: (cause) =>
          new ConnectionBlockedError({
            reason: "configuration",
            detail: cause instanceof Error ? cause.message : "The environment URL is invalid.",
          }),
      })
      const connectionId = entry.target.connectionId
      return new BearerConnectionRegistration({
        target: new BearerConnectionTarget({
          environmentId: options.input.environmentId,
          label,
          connectionId,
        }),
        profile: new BearerConnectionProfile({
          connectionId,
          environmentId: options.input.environmentId,
          label,
          httpBaseUrl,
          wsBaseUrl: try Effect.orDie(Effect.try({ try: () => deriveWsBaseUrl(httpBaseUrl), catch: (e) => e })),
        }),
        credential: credential.value,
      })
    },
    "clientRuntime.connection.onboarding.prepareBearerConnectionUpdate",
  )

export const prepareSshRegistration = effect (input: SshConnectionInput) =>
  try withSpan(
    effect {
      const gateway = try ClientCapabilities.SshEnvironmentGateway
      const provisioned = try gateway.provision(input.target, input.expectedEnvironmentId)
      const connectionId = `ssh:${provisioned.environmentId}:${sshTargetKey(provisioned.bootstrap.target)}`
      const label = input.label?.trim() || provisioned.label || provisioned.bootstrap.target.alias

      return new SshConnectionRegistration({
        target: new SshConnectionTarget({
          environmentId: provisioned.environmentId,
          label,
          connectionId,
        }),
        profile: new SshConnectionProfile({
          connectionId,
          environmentId: provisioned.environmentId,
          label,
          target: provisioned.bootstrap.target,
        }),
        credential: new BearerConnectionCredential({ token: provisioned.bearerToken }),
      })
    },
    "clientRuntime.connection.onboarding.prepareSshRegistration",
  )

const registerSshConnection = effect (input: SshConnectionInput) =>
  try withSpan(
    effect {
      const registration = try prepareSshRegistration(input)
      if (
        input.expectedEnvironmentId !== undefined
        && registration.target.environmentId !== input.expectedEnvironmentId
      ) {
        throw differentMachineError(registration.target.label)
      }
      const registry = try EnvironmentRegistry.EnvironmentRegistry
      try registry.register(registration)
      return registration.target.environmentId
    },
    "clientRuntime.connection.onboarding.registerSshConnection",
  )

/** @public */
export const make = effect {
  const registry = try EnvironmentRegistry.EnvironmentRegistry
  const presentation = try ClientCapabilities.ClientPresentation
  const httpClient = try HttpClient.HttpClient
  const ssh = try ClientCapabilities.SshEnvironmentGateway
  const credentials = try ConnectionCredentialStore.ConnectionCredentialStore

  // Provisioning retains the delegated onboarding operation spans.
  return ConnectionOnboarding.of({
    registerPairing: effect (input) =>
      try effect {
        provide HttpClient.HttpClient = httpClient {
          return try effect {
            provide ClientCapabilities.ClientPresentation = presentation {
              return try effect {
                provide EnvironmentRegistry.EnvironmentRegistry = registry {
                  return try (effect {
                    return try registerPairingConnection(input)
                  })
                }
              }
            }
          }
        }
      },
    registerSsh: effect (input) =>
      try effect {
        provide ClientCapabilities.SshEnvironmentGateway = ssh {
          return try effect {
            provide EnvironmentRegistry.EnvironmentRegistry = registry {
              return try (effect {
                return try registerSshConnection(input)
              })
            }
          }
        }
      },
    updateBearer: effect (input) =>
      try effect {
        provide ConnectionCredentialStore.ConnectionCredentialStore = credentials {
          return try effect {
            provide EnvironmentRegistry.EnvironmentRegistry = registry {
              return try (effect {
                return try updateBearerConnection(input)
              })
            }
          }
        }
      },
  })
}

export const layer = Layer.effect(ConnectionOnboarding, make)
