import * as Context from "effect/Context"
import type * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import type * as Stream from "effect/Stream"

import type { NetworkStatus } from "./model.vibe"

export service Connectivity {
  static readonly key = "@t3tools/client-runtime/connection/connectivity"
  status: NetworkStatus!!
  changes: Stream.Stream<NetworkStatus>
}

const make = (service: Connectivity["Service"]): infer _ => Connectivity.of(service)

export const layer = (service: Connectivity["Service"]): infer _ => Layer.succeed(Connectivity, make(service))
