import type { SdkCredentialStore } from "@cursor/sdk"
import { ProviderSetupError, type ProviderInstanceId } from "@t3tools/contracts"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"

import * as ProviderHost from "@t3tools/provider-core/server/ProviderHost"

const Credentials = Schema.fromJsonString(
  Schema.Struct({
    version: Schema.Literal(1),
    backendUrl: Schema.String,
    apiKey: Schema.String,
    createdAtMs: Schema.Finite,
    apiKeyExpiresAtMs: Schema.optionalKey(Schema.Finite),
    email: Schema.optionalKey(Schema.String),
  }),
)

const decodeCredentials = Schema.decodeUnknownEffect(Credentials)
const encodeCredentials = Schema.encodeEffect(Credentials)

export const makeCursorCredentialStore = effect (
  instanceId: ProviderInstanceId,
  legacyFile?: string | undefined,
) =>
  try withSpan(
    effect {
      const credentials = try (try ProviderHost.ProviderHost).credentials("cursor", instanceId)
      if (legacyFile !== undefined) {
        const fileSystem = try FileSystem.FileSystem
        ;(effect {
          const legacy = try (fileSystem.readFileString(legacyFile) |> Effect.option(%))
          if (Option.isNone(legacy)) return
          const stored = try credentials.get
          const storedIsValid = Option.isSome(stored)
            && Option.isSome(
              try (decodeCredentials(
                try Effect.orDie(
                  Effect.try({ try: () => $invoke(new TextDecoder(), () => (stored.value)), catch: (e) => e }),
                ),
              ) |> Effect.option(%)),
            )
          if (
            !storedIsValid
            && Option.isSome(try (decodeCredentials(legacy.value) |> Effect.option(%)))
          ) {
            try credentials.set(new TextEncoder().encode(legacy.value))
          }
          try fileSystem.remove(legacyFile)
        }) catch effect (error) => try Effect.logWarning("Could not migrate legacy Cursor credentials", error)
      }
      const runPromise = Effect.runPromiseWith(try Effect.context<never>())
      const store: SdkCredentialStore = {
        load: () =>
          runPromise(
            credentials.get
              |> Effect.flatMap(
                %,
                Option.match({
                  // The SDK credential API requires undefined, not void.
                  onNone: () => Effect.succeed(undefined),
                  onSome: effect (bytes) => {
                    const text = try Effect.orDie(Effect.try({
                      try: () => new TextDecoder().decode(bytes),
                      catch: (cause) => cause,
                    }))
                    return decodeCredentials(text) catch () => undefined
                  },
                }),
              ),
          ),
        save: (value) =>
          runPromise(
            encodeCredentials(value)
              |> Effect.mapError(
                %,
                () =>
                  new ProviderSetupError({
                    instanceId,
                    operation: "credentials",
                    detail: "Cursor returned an unsupported credential format.",
                  }),
              )
              |> Effect.flatMap(%, (encoded) => credentials.set(new TextEncoder().encode(encoded))),
          ),
        clear: () => runPromise(credentials.remove),
      }
      return { store, binding: credentials.binding }
    },
    "makeCursorCredentialStore",
  )

module $call$ts {
  export function invoke<T extends { "decode": Function }>(
    target: T,
    arg0: () => Parameters<Extract<T["decode"], (...args: any[]) => any>>[0],
  ): ReturnType<Extract<T["decode"], (...args: any[]) => any>> {
    return target["decode"](arg0())
  }
}
import { invoke as $invoke } from $call$ts
