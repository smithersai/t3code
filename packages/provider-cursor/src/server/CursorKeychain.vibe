import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"
import { requireForKeyring as requireForKeyring$platform } from "./CursorKeychain.platform.ts"

const CACHE_MS = 5 * 60_000
const DEFAULT_TIMEOUT = Duration.seconds(30)
const requireForKeyring = requireForKeyring$platform
export schema error CursorKeychainTimeoutError {
  override get message(): string {
    return "Timed out waiting for Keychain access."
  }
}
export const isCursorKeychainTimeoutError = Schema.is(CursorKeychainTimeoutError)
const CursorKeychainReadErrorCauseField: Schema.Defect = Schema.Defect()
export schema error CursorKeychainReadError {
  cause: CursorKeychainReadErrorCauseField
  override get message(): string {
    return "Cursor Keychain credentials could not be read."
  }
}
export service CursorKeychain: {
  readonly accessToken: (string | null)!(CursorKeychainTimeoutError | CursorKeychainReadError);
} {
  static readonly key = "@t3tools/provider-cursor/server/CursorKeychain"
}
const readKeychainEntry = Effect.tryPromise({
  try: async () => {
    const { AsyncEntry } = requireForKeyring(
      "@napi-rs/keyring",
    ) as typeof import("@napi-rs/keyring")
    return (await new AsyncEntry("cursor-access-token", "cursor-user").getPassword()) ?? null
  },
  catch: (cause) => new CursorKeychainReadError({ cause }),
})
const make = (
  read: (string | null)!CursorKeychainReadError = readKeychainEntry,
  timeout: Duration.Input = DEFAULT_TIMEOUT,
): CursorKeychain["Service"] => {
  let cached: { readonly token: string; readonly untilMs: number } | null = null
  let pending: Deferred.Deferred<string | null, CursorKeychainReadError> | null = null

  const startRead = Effect.uninterruptible(
    effect {
      if (pending !== null) return pending
      const done = Deferred.makeUnsafe<string | null, CursorKeychainReadError>()
      pending = done
      try (read
        |> Effect.tap(%, (token) =>
          Clock.currentTimeMillis
          |> Effect.map(%, (nowMs) => {
            cached = token ? { token, untilMs: nowMs + CACHE_MS } : null
          }))
        |> Effect.onExit(%, (exit) =>
          Effect.suspend(() => {
            pending = null
            return Deferred.done(done, exit)
          }))
        |> Effect.forkDetach(%))
      return done
    },
  )

  const accessToken = effect {
    const nowMs = try Clock.currentTimeMillis
    if (cached !== null && cached.untilMs > nowMs) return cached.token
    const done = try startRead
    const token = try (Deferred.await(done) |> Effect.timeoutOption(%, timeout))
    if (Option.isNone(token)) throw new CursorKeychainTimeoutError()
    return token.value
  }

  return CursorKeychain.of({ accessToken })
}
export const layer = Layer.sync(CursorKeychain, () => make())
