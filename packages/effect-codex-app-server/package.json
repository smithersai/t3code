{
  "name": "effect-codex-app-server",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.d.vibe.ts",
      "import": {
        "vibelang-source": "./src/client.vibe",
        "default": "./.vibelang/js/src/client.js"
      }
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./src/rpc.ts"
    },
    "./protocol": {
      "types": "./src/protocol.d.vibe.ts",
      "import": {
        "vibelang-source": "./src/protocol.vibe",
        "default": "./.vibelang/js/src/protocol.js"
      }
    },
    "./replay": {
      "types": "./src/replay.d.vibe.ts",
      "import": {
        "vibelang-source": "./src/replay.vibe",
        "default": "./.vibelang/js/src/replay.js"
      }
    },
    "./errors": {
      "types": "./src/errors.vibe",
      "import": "./src/errors.vibe"
    }
  },
  "scripts": {
    "typecheck": "vibelang --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir .",
    "generate": "node --import vibelang/register scripts/generate.vibe",
    "probe": "node --import vibelang/register test/examples/codex-app-server-probe.ts"
  },
  "dependencies": {
    "effect": "catalog:",
    "vibelang-runtime": "0.0.12"
  },
  "devDependencies": {
    "@effect/openapi-generator": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vibelang": "0.0.12",
    "vibelang-vite": "0.0.12",
    "vite-plus": "catalog:"
  }
}
