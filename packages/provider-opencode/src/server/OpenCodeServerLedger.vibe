import * as HostProcess from "@t3tools/shared/HostProcess"
import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Layer from "effect/Layer"
import * as Path from "effect/Path"
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner"
import { writeFileStringAtomically } from "@t3tools/shared/atomicWrite"
import { ExperimentalNodeProcess } from "vibelang-runtime/experimental/platform-node"
import * as Process from "vibelang-runtime/experimental/Process"
import type * as PlatformError from "effect/PlatformError"
schema ProcessIdentity { pid: Schema.Int; startTime: string }

schema OpenCodeServerEntry {
  version: 1
  pgid: Schema.Int
  pid: Schema.Int
  startTime: string
  command: string
  port: Schema.Int
  stateDir: string
  owner: ProcessIdentity
}
const OpenCodeServerEntryJson = Schema.fromJsonString(OpenCodeServerEntry)
const decodeEntry = Schema.decodeUnknownOption(OpenCodeServerEntryJson)
const encodeEntry = Schema.encodeEffect(OpenCodeServerEntryJson)

export service OpenCodeServerLedger {
  static readonly key = "@t3tools/provider-opencode/server/OpenCodeServerLedger"
  track: (server: {
    readonly pid: number
    readonly port: number
    readonly args: ReadonlyArray<string>
  }) => (void!!)!!
}

const ENTRY_DIRECTORY = "opencode-servers"
const ENTRY_FILE = /^\d+\.json$/
const STOP_POLL_INTERVAL = "50 millis"
const STOP_POLL_ATTEMPTS = 40

interface ObservedProcess {
  readonly pid: number
  readonly pgid: number
  readonly startTime: string
  readonly command: string
  readonly zombie: boolean
}

// ps lstart needs C locale and UTC for stable parsing.
const DARWIN_PS_LINE = /^\s*(\d+)\s+(\d+)\s+(\S+)\s+(\w{3} \w{3} +\d{1,2} \d{2}:\d{2}:\d{2} \d{4})\s+(.*)$/

const parseDarwinPs = (output: string): ReadonlyArray<ObservedProcess> =>
  output.split("\n").flatMap((line) => {
    const match = DARWIN_PS_LINE.exec(line)
    if (match === null) return []
    return [
      {
        pid: Number(match[1]),
        pgid: Number(match[2]),
        zombie: match[3]!.startsWith("Z"),
        startTime: match[4]!,
        command: match[5]!.trimEnd(),
      },
    ]
  })

export const make = effect (input: {
  readonly stateDir: string
  readonly ownerPid?: number
}) =>
  try withSpan(
    effect {
      provide ExperimentalNodeProcess.layer {
        const fs = try FileSystem.FileSystem
        const path = try Path.Path
        const spawner = try ChildProcessSpawner.ChildProcessSpawner
        const platform = try HostProcess.Platform
        const process = try Process.Process
        const directory = path.join(input.stateDir, ENTRY_DIRECTORY)
        const recordable = platform === "linux" || platform === "darwin"
        // Keep the existing guard: group0 is this process's group, and group1 must never be signalled.
        const signalGroup = effect (pgid: number, signal: NodeJS.Signals): void!! => {
          if (!Number.isSafeInteger(pgid) || pgid <= 1) return
          process.kill(pgid, { killSignal: signal, group: true }) catch () => undefined
        }
        const groupExists = effect (pgid: number): boolean!! => {
          if (!Number.isSafeInteger(pgid) || pgid <= 1) return false
          return process.isRunning(pgid, { group: true }) catch () => true
        }
        // No span per process: a group scan visits every /proc entry.
        const observeLinux = effect (pid: number, group?: number) => {
          const stat = try fs.readFileString(`/proc/${pid}/stat`)
          const fields = stat.slice(stat.lastIndexOf(")") + 2).trim().split(/\s+/)
          const pgid = Number(fields[2])
          const startTime = fields[19]
          if (!Number.isSafeInteger(pgid) || startTime === undefined) return undefined
          if (group !== undefined && pgid !== group) return undefined
          const cmdline = try fs.readFileString(`/proc/${pid}/cmdline`)
          return {
            pid,
            pgid,
            startTime,
            command: cmdline.replace(/\0$/, "").replaceAll("\0", " "),
            zombie: fields[0] === "Z",
          } satisfies ObservedProcess
        }
        const psDarwin = effect (selection: ReadonlyArray<string>) => {
          const output = try timeout(
            spawner.string(ChildProcess.make(
              "/bin/ps",
              ["-ww", "-o", "pid=,pgid=,stat=,lstart=,args=", ...selection],
              { env: { LC_ALL: "C", TZ: "UTC" }, extendEnv: true, stdin: "ignore", stderr: "ignore" },
            )),
            "5 seconds",
          )
          return parseDarwinPs(output)
        }
        const observe = effect (pid: number): ObservedProcess | undefined!! => {
          if (platform === "linux") return observeLinux(pid) catch () => undefined
          if (platform === "darwin") {
            return effect {
              const found = try psDarwin(["-p", String(pid)])
              return found.find((candidate) => candidate.pid === pid)
            } catch () => undefined
          }
          return undefined
        }
        const observeGroup = effect (pgid: number): ReadonlyArray<ObservedProcess>!! => {
          if (platform === "linux") {
            return effect {
              const names = (try fs.readDirectory("/proc")).filter((name) => /^\d+$/.test(name))
              const found: Array<ObservedProcess | undefined> = new Array(names.length)
              // Preserve the old input order as well as its concurrency limit.
              for concurrent(16) (const [index, name] of names.entries()) {
                found[index] = observeLinux(Number(name), pgid) catch () => undefined
              }
              return found.filter((candidate) => candidate !== undefined)
            } catch () => []
          }
          if (platform === "darwin") {
            return effect {
              const found = try psDarwin(["-A"])
              return found.filter((candidate) => candidate.pgid === pgid)
            } catch () => []
          }
          return []
        }
        const isRunning = effect (identity: ProcessIdentity) => {
          const observed = try observe(identity.pid)
          return observed !== undefined && !observed.zombie && observed.startTime === identity.startTime
        }
        const ownerPid = input.ownerPid ?? (try process.pid)
        const ownerProcess = try observe(ownerPid)
        const owner = ownerProcess === undefined
          ? undefined
          : { pid: ownerPid, startTime: ownerProcess.startTime }

        const track: OpenCodeServerLedger["Service"]["track"] = effect (server): (void!!)!! => {
          const run = effect (): (void!!)!PlatformError.PlatformError | Schema.SchemaError! => {
            if (!recordable) return Effect.void
            const pgid = server.pid
            const leader = try observe(pgid)
            const members = leader !== undefined && !leader.zombie && leader.pgid === pgid
              ? [leader]
              : (try observeGroup(pgid)).filter((candidate) => !candidate.zombie)
            const member = members.find((candidate) => candidate.command.endsWith(` ${server.args.join(" ")}`))
              ?? members[0]
            if (owner === undefined || member === undefined) {
              if (try groupExists(pgid)) {
                try logWarning("Could not record an OpenCode server; it will keep running if this server crashes", {
                  pid: pgid,
                  port: server.port,
                })
              }
              return Effect.void
            }
            const entryPath = path.join(directory, `${pgid}.json`)
            const entry: OpenCodeServerEntry = {
              version: 1,
              pgid,
              pid: member.pid,
              startTime: member.startTime,
              command: member.command,
              port: server.port,
              stateDir: input.stateDir,
              owner,
            }
            provide FileSystem.FileSystem = fs, Path.Path = path {
              try writeFileStringAtomically({ filePath: entryPath, contents: try encodeEntry(entry) })
            }
            return effect {
              try Effect.catchCause(fs.remove(entryPath, { force: true }), effect (cause) => {
                try logWarning("Could not forget a stopped OpenCode server", { cause })
              })
            }
          }
          return try withSpan(
            Effect.catchCause(run(), effect (cause): (void!!)!! => {
              try logWarning("Could not record an OpenCode server process", { cause })
              return Effect.void
            }),
            "OpenCodeServerLedger.track",
          )
        }

        // Identity, group and full command must still match before any signal is sent.
        const stopOrphan = effect (entry: OpenCodeServerEntry) =>
          try withSpan(
            effect {
              const observed = try observe(entry.pid)
              if (
                observed === undefined || observed.zombie || observed.startTime !== entry.startTime
                || observed.pgid !== entry.pgid || observed.command !== entry.command
              ) return
              try logInfo("Stopping an OpenCode server left by a previous T3 Code server", {
                pid: entry.pgid,
                port: entry.port,
              })
              try signalGroup(entry.pgid, "SIGTERM")
              for (let attempt = 0; attempt < STOP_POLL_ATTEMPTS && (try groupExists(entry.pgid)); attempt++) {
                try sleep(STOP_POLL_INTERVAL)
              }
              if (try groupExists(entry.pgid)) try signalGroup(entry.pgid, "SIGKILL")
            },
            "OpenCodeServerLedger.stopOrphan",
          )

        const reapEntry = effect (entryPath: string) =>
          try withSpan(
            Effect.catchCause(
              effect {
                const entry = decodeEntry(try fs.readFileString(entryPath))
                if (Option.isSome(entry) && entry.value.stateDir === input.stateDir) {
                  if (try isRunning(entry.value.owner)) return
                  try stopOrphan(entry.value)
                }
                try fs.remove(entryPath, { force: true })
              },
              effect (cause) => {
                try logWarning("Could not clean up a recorded OpenCode server", { entryPath, cause })
              },
            ),
            "OpenCodeServerLedger.reapEntry",
          )

        const reapOrphans = effect {
          const names = fs.readDirectory(directory) catch () => []
          for concurrent (const name of names.filter((name) => ENTRY_FILE.test(name))) {
            try reapEntry(path.join(directory, name))
          }
        }
        return { track, reapOrphans }
      }
    },
    "OpenCodeServerLedger.make",
  )

export const layer = (input: { readonly stateDir: string }): infer _ =>
  Layer.effect(
    OpenCodeServerLedger,
    effect {
      const ledger = try make(input)
      try Effect.forkScoped(ledger.reapOrphans)
      return OpenCodeServerLedger.of({ track: ledger.track })
    },
  )

const noOpTrack = effect (): (void!!)!! => {
  return Effect.void
}
export const layerTest = Layer.succeed(
  OpenCodeServerLedger,
  OpenCodeServerLedger.of({
    track: effect (): (void!!)!! => try withSpan(noOpTrack(), "OpenCodeServerLedger.track"),
  }),
)
