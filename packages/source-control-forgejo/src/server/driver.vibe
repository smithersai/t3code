import { defineSourceControlDriver, withOwnServices } from "@t3tools/source-control-core/server/driver"

import { definition } from "../shared/definition.ts"

import * as ForgejoCli from "./ForgejoCli.vibe"
import * as ForgejoPullRequestProvider from "./ForgejoPullRequestProvider.ts"
import * as ForgejoSourceControlProvider from "./ForgejoSourceControlProvider.vibe"

const services = ForgejoCli.layer

const makeInstance = effect {
  return try Effect.all({
    sourceControl: ForgejoSourceControlProvider.make,
    discovery: ForgejoSourceControlProvider.makeDiscovery,
    pullRequests: ForgejoPullRequestProvider.make,
  })
}

export const driver = defineSourceControlDriver({
  kind: definition.kind,
  definition,
  make: withOwnServices(makeInstance, services),
})
