import { resolvePullRequestAuthorFilter, SourceControlProviderKind } from "@t3tools/contracts"
import * as Effect from "effect/Effect"
import type { PullRequestCapabilities, PullRequestViewerPermissions } from "@t3tools/contracts"
import { decodeJsonResult } from "@t3tools/shared/schemaJson"
import * as ForgejoCli from "./ForgejoCli.vibe"
import { parseDiffFileRevisions } from "@t3tools/source-control-core/server/diffFileRevisions"
import {
  PullRequestProviderError,
  type ProviderChangeRequestDetail,
  type ProviderRepositoryRef,
  type PullRequestProviderApi,
} from "@t3tools/source-control-core/server/PullRequestProvider"
import {
  ForgejoPullRequest,
  ForgejoRepository,
  ForgejoUser,
  ForgejoComment,
  ForgejoReview,
  ForgejoReviewComment,
  ForgejoCommit,
  ForgejoStatus,
  ForgejoLabel,
  ForgejoReaction,
  FORGEJO_REACTIONS,
  forgejoChangeRequest,
  forgejoActor,
  forgejoComment,
  forgejoReview,
  forgejoReviewThread,
  forgejoCommit,
  forgejoChecks,
  forgejoReactions,
} from "./forgejoPullRequestJson.vibe"
import { ForgejoBranchStatusChecks, markRequiredForgejoChecks } from "./forgejoRequiredChecks.vibe"
import { definition } from "../shared/definition.ts"

module platform {
  export const $Buffer_from: typeof Buffer.from =
    ((...args: Parameters<typeof Buffer.from>) => Buffer.from(...args)) as typeof Buffer.from
}

import { $Buffer_from } from platform

const isForgejoCliError = Schema.is(ForgejoCli.ForgejoCliError)
const CAPABILITIES: PullRequestCapabilities = {
  diff: true,
  viewedFiles: "environment",
  comment: true,
  actions: [...definition.changeRequestActions],
  mergeMethods: ["merge", "squash", "rebase"],
  updateMethods: ["merge", "rebase"],
  search: false,
  reactions: true,
  labels: true,
  // Forgejo's public API has no thread replies/resolution or draft conversion endpoint.
  review: {
    inlineComment: true,
    reply: false,
    resolve: false,
    verdicts: ["comment", "approve", "request-changes"],
  },
  reviewers: { request: true, listCandidates: true },
  edit: { changeRequest: true, comment: true },
}
const USER_SEARCH_LIMIT = 50
const ForgejoUserSearch = Schema.Struct({
  data: Schema.optional(Schema.NullOr(Schema.Array(ForgejoUser))),
})
const UNAVAILABLE_REQUIREMENT = {
  missing:
    "Install Forgejo CLI (`fj` 0.6 or later) from https://codeberg.org/forgejo-contrib/forgejo-cli or Gitea CLI (`tea` 0.16 or later) from https://gitea.com/gitea/tea to browse Forgejo pull requests.",
  unauthenticated:
    "Authenticate your Forgejo or Gitea server with `fj --host <server-url> auth add-token` on the T3 Code server. If fj is missing or unconfigured for that server, use `tea login add`. A configured fj account must be repaired with fj.",
}
const repoPath = (input: ProviderRepositoryRef) =>
  `repos/${input.repository.split("/").map(encodeURIComponent).join("/")}`
const pullPath = (input: ProviderRepositoryRef & { readonly number: number }) =>
  `${repoPath(input)}/pulls/${input.number}`
const issuePath = (input: ProviderRepositoryRef & { readonly number: number }) =>
  `${repoPath(input)}/issues/${input.number}`
// Review IDs differ from the issue-comment IDs used by Forgejo's reactions API.
const reviewCommentId = (review: typeof ForgejoReview.Type) =>
  /#issuecomment-([1-9]\d*)$/.exec(review.html_url ?? "")?.[1]
export const make = effect {
  const cli = try ForgejoCli.ForgejoCli
  const failure = (operation: string, detail: string, cause?: unknown) =>
    new PullRequestProviderError({
      provider: SourceControlProviderKind.make("forgejo"),
      operation,
      reason: "failed",
      detail,
      ...(cause === undefined ? {} : { cause }),
    })
  const request = (input: ForgejoCli.ForgejoApiInput) =>
    cli.api(input)
    |> Effect.mapError(
      %,
      (error) =>
        new PullRequestProviderError({
          provider: SourceControlProviderKind.make("forgejo"),
          operation: input.path,
          detail: error.detail,
          cause: error,
          reason: error.reason === "missing-cli"
            ? "missing-tool"
            : error.reason === "authentication"
            ? "unauthenticated"
            : error.reason === "rate-limit"
            ? "rate-limited"
            : error.reason === "not-found"
            ? "not-found"
            : "failed",
        }),
    )
  /** A response, and whether its `link` header points at a further page. */
  const readLinked = effect <A>(
    input: ForgejoCli.ForgejoApiInput,
    schema: Schema.Codec<A, unknown, never, never>,
  ) =>
    try withSpan(
      effect {
        const result = try request(input)
        if (result.stdoutTruncated) {
          throw failure(input.path, "Forgejo response exceeded the output limit.")
        }
        const decoded = decodeJsonResult(schema)(result.stdout)
        if (Result.isFailure(decoded)) {
          throw failure(input.path, "Forgejo returned an invalid response.", decoded.failure)
        }
        const links = /^link:\s*(.*)$/im.exec(result.stderr)?.[1]
        return { value: decoded.success, next: links !== undefined && /rel="?next"?/i.test(links) }
      },
      "ForgejoPullRequestProvider.readLinked",
    )
  const read = <A>(
    input: ForgejoCli.ForgejoApiInput,
    schema: Schema.Codec<A, unknown, never, never>,
  ) => readLinked(input, schema) |> Effect.map(%, ({ value }) => value)
  const readArray = <A>(
    input: ForgejoCli.ForgejoApiInput,
    schema: Schema.Codec<A, unknown, never, never>,
  ) => read(input, Schema.NullOr(Schema.Array(schema))) |> Effect.map(%, (rows) => rows ?? [])
  const readPage = effect <A>(
    input: ForgejoCli.ForgejoApiInput,
    schema: Schema.Codec<A, unknown, never, never>,
    index: number,
  ) =>
    try withSpan(
      effect {
        const result = try request({
          ...input,
          path: `${input.path}${input.path.includes("?") ? "&" : "?"}limit=50&page=${index}`,
        })
        if (result.stdoutTruncated) {
          throw failure(input.path, "Forgejo response exceeded the output limit.")
        }
        const decoded = decodeJsonResult(Schema.NullOr(Schema.Array(schema)))(result.stdout)
        if (Result.isFailure(decoded)) {
          throw failure(input.path, "Forgejo returned an invalid response.", decoded.failure)
        }
        const rows = decoded.success ?? []
        const links = /^link:\s*(.*)$/im.exec(result.stderr)?.[1]
        return {
          rows,
          more: rows.length > 0 && (links === undefined || /rel="?next"?/i.test(links)),
        }
      },
      "ForgejoPullRequestProvider.readPage",
    )
  // Forgejo's default page limit is 50.
  const page = effect <A>(
    input: ForgejoCli.ForgejoApiInput,
    schema: Schema.Codec<A, unknown, never, never>,
    limit = 500,
  ) =>
    try withSpan(
      effect {
        const items: A[] = []
        for (let index = 1; items.length < limit; index++) {
          const { rows, more } = try readPage(input, schema, index)
          items.push(...rows)
          if (!more) return { items, truncated: false }
        }
        return { items, truncated: true }
      },
      "ForgejoPullRequestProvider.page",
    )
  const write = (input: ForgejoCli.ForgejoApiInput) => request(input) |> Effect.asVoid(%)
  const getPull = (input: ProviderRepositoryRef & { readonly number: number }) =>
    read(
      {
        cwd: input.cwd,
        repository: input.repository,
        host: input.host,
        path: pullPath(input),
      },
      ForgejoPullRequest,
    )
  const getRepo = (input: ProviderRepositoryRef) => read({ ...input, path: repoPath(input) }, ForgejoRepository)
  const getViewer = (input: {
    readonly cwd: string
    readonly repository?: string
    readonly host?: string
  }) => read({ ...input, path: "user" }, ForgejoUser) |> Effect.map(%, (user) => user.login)
  const permissions = (
    repo: typeof ForgejoRepository.Type,
    pr: typeof ForgejoPullRequest.Type,
    viewer: string,
  ): PullRequestViewerPermissions => {
    const canWrite = repo.permissions?.push ?? false
    const canEdit = canWrite || pr.user?.login === viewer
    const active = !repo.archived
    return {
      actions: active
        ? CAPABILITIES.actions.filter((action) => action === "merge" || action === "update-branch" ? canWrite : canEdit)
        : [],
      comment: active && (!pr.is_locked || canWrite),
      resolve: false,
      verdicts: active
        ? pr.user?.login === viewer
          ? ["comment"]
          : CAPABILITIES.review.verdicts
        : [],
      requestReviewers: active && canEdit,
      labels: active && canWrite,
      updateMethods: active && canWrite ? (repo.allow_rebase_update ? ["merge", "rebase"] : ["merge"]) : [],
    }
  }
  const getPermissions = effect (
    input: ProviderRepositoryRef & { readonly number: number },
  ) =>
    try withSpan(
      effect {
        const [repo, pr, viewer] = try Effect.all(
          [getRepo(input), getPull(input), getViewer(input)],
          { concurrency: 3 },
        )
        return permissions(repo, pr, viewer)
      },
      "ForgejoPullRequestProvider.getPermissions",
    )
  const readChecks = effect (
    input: ProviderRepositoryRef,
    pr: {
      readonly number: number
      readonly title: string
      readonly body: string | null
      readonly html_url: string
      readonly user: {
        readonly login: string
        readonly full_name?: string | null | undefined
        readonly avatar_url?: string | null | undefined
      } | null
      readonly state: string
      readonly draft?: boolean | undefined
      readonly merged: boolean
      readonly mergeable?: boolean | undefined
      readonly is_locked?: boolean | undefined
      readonly head: {
        readonly ref: string
        readonly sha: string
        readonly repo: {
          readonly full_name: string
          readonly permissions?: { readonly push: boolean; readonly admin: boolean } | undefined
          readonly archived?: boolean | undefined
          readonly allow_merge_commits?: boolean | undefined
          readonly allow_squash_merge?: boolean | undefined
          readonly allow_rebase?: boolean | undefined
          readonly allow_rebase_update?: boolean | undefined
          readonly default_delete_branch_after_merge?: boolean | undefined
        } | null
      }
      readonly base: {
        readonly ref: string
        readonly sha: string
        readonly repo: {
          readonly full_name: string
          readonly permissions?: { readonly push: boolean; readonly admin: boolean } | undefined
          readonly archived?: boolean | undefined
          readonly allow_merge_commits?: boolean | undefined
          readonly allow_squash_merge?: boolean | undefined
          readonly allow_rebase?: boolean | undefined
          readonly allow_rebase_update?: boolean | undefined
          readonly default_delete_branch_after_merge?: boolean | undefined
        } | null
      }
      readonly merge_base?: string | undefined
      readonly created_at: string
      readonly updated_at: string
      readonly closed_at: string | null
      readonly merged_at: string | null
      readonly additions?: number | null | undefined
      readonly deletions?: number | null | undefined
      readonly changed_files?: number | null | undefined
      readonly comments?: number | undefined
      readonly labels:
        | readonly {
          readonly id: number
          readonly name: string
          readonly color?: string | null | undefined
          readonly description?: string | null | undefined
        }[]
        | null
      readonly requested_reviewers?:
        | readonly {
          readonly login: string
          readonly full_name?: string | null | undefined
          readonly avatar_url?: string | null | undefined
        }[]
        | null
        | undefined
    },
  ) =>
    try withSpan(
      effect {
        const branch = read(
          {
            ...input,
            path: `${repoPath(input)}/branches/${pr.base.ref.split("/").map(encodeURIComponent).join("/")}`,
          },
          ForgejoBranchStatusChecks,
        )
          |> Effect.catchTags(%, {
            PullRequestProviderError: (error) => {
              if (
                isForgejoCliError(error.cause)
                && (error.cause.reason === "forbidden" || error.cause.reason === "not-found")
              ) {
                return Effect.succeed({})
              }
              return Effect.fail(error)
            },
          })
        const [statuses, policy] = try Effect.all(
          [
            page(
              {
                ...input,
                path: `${repoPath(input)}/statuses/${encodeURIComponent(pr.head.sha)}?sort=recentupdate`,
              },
              ForgejoStatus,
            ),
            branch,
          ],
          { concurrency: 2 },
        )
        return markRequiredForgejoChecks(forgejoChecks(statuses.items, pr.html_url), policy)
      },
      "ForgejoPullRequestProvider.readChecks",
    )
  const unsupported = (operation: string) =>
    Effect.fail(failure(operation, `Forgejo does not expose ${operation} through its API.`))
  const provider: PullRequestProviderApi = {
    kind: SourceControlProviderKind.make("forgejo"),
    capabilities: CAPABILITIES,
    unavailableRequirement: UNAVAILABLE_REQUIREMENT,
    readsPublicHostWithoutCheckout: true,
    getViewer,
    listChangeRequests: effect (
      input,
    ): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderChangeRequestPage!PullRequestProviderError!never =>
      try withSpan(
        (effect (): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderChangeRequestPage!PullRequestProviderError!never => {
          const offset = input.cursor?.delivered ?? 0
          const items: ReturnType<typeof forgejoChangeRequest>[] = []
          const state = input.state === "merged" ? "closed" : input.state
          const params = new URLSearchParams({ state, sort: "recentupdate" })
          const filters = input.filters
          // Several `labels` match a pull request holding any of them but list it once per label it
          // holds, which would throw the row offset off, so one required label is all Forgejo is
          // asked for. The service narrows the rest.
          const single = filters?.labels?.find((group) => group.length === 1)?.[0]
          if (single !== undefined) {
            const labels = try page({ ...input, path: `${repoPath(input)}/labels` }, ForgejoLabel)
            const label = labels.items.find(
              (candidate) => candidate.name.toLowerCase() === single.trim().toLowerCase(),
            )
            if (label !== undefined) params.set("labels", String(label.id))
          }
          if (filters?.author !== undefined) {
            params.set("poster", resolvePullRequestAuthorFilter(filters.author, input.viewer))
          }
          const query = { ...input, path: `${repoPath(input)}/pulls?${params}` }
          // Self-hosted servers may cap pages below 50. Establish their actual page size before
          // translating the service's row offset into an API page number.
          const first = try (readPage(query, Schema.NullOr(ForgejoPullRequest), 1)
            |> Effect.catchTags(%, {
              // Forgejo answers a `poster` naming no account with a 400: nobody to list for.
              PullRequestProviderError: (error) =>
                params.has("poster")
                  && isForgejoCliError(error.cause)
                  && error.cause.httpStatus === 400
                  ? Effect.succeed(null)
                  : Effect.fail(error),
            }))
          if (first === null) return { items: [], truncated: false, continues: false }
          const pageSize = first.rows.length || 50
          const firstIndex = Math.floor(offset / pageSize) + 1
          let consumed = 0
          let more = true
          for (let index = firstIndex; more && consumed < input.limit; index++) {
            const result = index === 1 ? first : try readPage(query, Schema.NullOr(ForgejoPullRequest), index)
            const rows = result.rows
            const start = index === firstIndex ? offset % pageSize : 0
            const countBefore = consumed
            for (const row of rows.slice(start)) {
              if (consumed >= input.limit) break
              consumed++
              if (row) items.push(forgejoChangeRequest(row))
            }
            more = result.more || rows.length - start > consumed - countBefore
          }
          return { items, truncated: more, continues: true, cursorAdvance: consumed }
        })(),
        "ForgejoPullRequestProvider.listChangeRequests",
      ),
    getChangeRequestPreview: (input) => getPull(input) |> Effect.map(%, forgejoChangeRequest),
    getChangeRequestSummary: (input) => getPull(input) |> Effect.map(%, forgejoChangeRequest),
    getChangeRequestChecks: effect (
      input,
    ): Pick<{ readonly observedAt?: number | undefined; readonly state: "closed" | "merged" | "open"; readonly checks: readonly { readonly name: string; readonly status: "action-required" | "cancelled" | "failure" | "neutral" | "pending" | "skipped" | "success"; readonly description: string | null; readonly url: string | null; readonly required?: boolean | undefined; }[]; }, "checks" | "state">!PullRequestProviderError!never =>
      try withSpan(
        (effect (): Pick<{ readonly observedAt?: number | undefined; readonly state: "closed" | "merged" | "open"; readonly checks: readonly { readonly name: string; readonly status: "action-required" | "cancelled" | "failure" | "neutral" | "pending" | "skipped" | "success"; readonly description: string | null; readonly url: string | null; readonly required?: boolean | undefined; }[]; }, "checks" | "state">!PullRequestProviderError!never => {
          const pr = try getPull(input)
          return { state: forgejoChangeRequest(pr).state, checks: try readChecks(input, pr) }
        })(),
        "ForgejoPullRequestProvider.getChangeRequestChecks",
      ),
    getChangeRequest: effect (input): ProviderChangeRequestDetail!PullRequestProviderError!never =>
      try withSpan(
        (effect (): ProviderChangeRequestDetail!PullRequestProviderError!never => {
          const [pr, repo, viewer] = try Effect.all(
            [getPull(input), getRepo(input), getViewer(input)],
            { concurrency: 3 },
          )
          const checks = try readChecks(input, pr)
          return {
            ...forgejoChangeRequest(pr),
            headSha: pr.head.sha,
            body: pr.body ?? "",
            changedFiles: pr.changed_files ?? 0,
            reviewers: (pr.requested_reviewers ?? []).flatMap((user) => {
              const actor = forgejoActor(user)
              return actor ? [actor] : []
            }),
            checks,
            baseComparison: !pr.merge_base
              ? "unknown"
              : pr.merge_base === pr.base.sha
              ? "up-to-date"
              : "behind",
            viewerPermissions: permissions(repo, pr, viewer),
            mergeCapabilities: {
              merge: repo.allow_merge_commits ?? true,
              squash: repo.allow_squash_merge ?? true,
              rebase: repo.allow_rebase ?? true,
            },
          } satisfies ProviderChangeRequestDetail
        })(),
        "ForgejoPullRequestProvider.getChangeRequest",
      ),
    getViewerPermissions: getPermissions,
    getChangeRequestActivity: effect (
      input,
    ): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderChangeRequestActivity!PullRequestProviderError!never =>
      try withSpan(
        (effect (): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderChangeRequestActivity!PullRequestProviderError!never => {
          const [comments, reviews, commits, reactions, viewer] = try Effect.all(
            [
              // Issue comments ignore page/limit; fetch this unpaginated endpoint once.
              readArray({ ...input, path: `${issuePath(input)}/comments` }, ForgejoComment)
              |> Effect.map(%, (items) => ({
                items: items.slice(0, 500),
                truncated: items.length > 500,
              })),
              page({ ...input, path: `${pullPath(input)}/reviews` }, ForgejoReview),
              // Commit file lists can exceed the output limit on large merges.
              page(
                { ...input, path: `${pullPath(input)}/commits?files=false&verification=false` },
                ForgejoCommit,
              ),
              page({ ...input, path: `${issuePath(input)}/reactions` }, ForgejoReaction),
              getViewer(input),
            ],
            { concurrency: 5 },
          )
          const reviewComments = try Effect.forEach(
            reviews.items.filter((review) => review.comments_count > 0 && review.state !== "PENDING"),
            (review) =>
              readArray(
                { ...input, path: `${pullPath(input)}/reviews/${review.id}/comments` },
                ForgejoReviewComment,
              ),
            { concurrency: 4 },
          )
          const allInline = reviewComments.flat()
          const inline = allInline.slice(0, 500)
          const entries = [
            ...comments.items.map((comment) => ({
              comment: forgejoComment(comment),
              reactionId: String(comment.id),
            })),
            ...reviews.items
              .filter((review) => review.state !== "PENDING" && review.state !== "REQUEST_REVIEW")
              .map((review) => ({
                comment: forgejoReview(review),
                reactionId: reviewCommentId(review),
              })),
            ...inline.map((comment) => ({
              comment: {
                ...forgejoComment(comment),
                kind: "review-comment" as const,
                path: comment.path,
              },
              reactionId: String(comment.id),
            })),
          ]
          const enriched = try Effect.forEach(
            entries,
            ({ comment, reactionId }) =>
              (reactionId === undefined
                ? Effect.succeed([])
                : readArray(
                  { ...input, path: `${repoPath(input)}/issues/comments/${reactionId}/reactions` },
                  ForgejoReaction,
                ))
              |> Effect.map(%, (rows) => ({ ...comment, reactions: forgejoReactions(rows, viewer) })),
            { concurrency: 4 },
          )
          const byId = new Map(enriched.map((comment) => [comment.id, comment]))
          const timeline = enriched.toSorted((a, b) => a.createdAt.localeCompare(b.createdAt))
          return {
            comments: timeline,
            commentCount: timeline.length,
            commentsTruncated: comments.truncated || reviews.truncated || allInline.length > inline.length,
            reviewThreads: inline.map((comment) => ({
              ...forgejoReviewThread(comment),
              comments: [byId.get(String(comment.id)) ?? forgejoComment(comment)],
            })),
            commits: commits.items.map(forgejoCommit),
            reactions: forgejoReactions(reactions.items, viewer),
          }
        })(),
        "ForgejoPullRequestProvider.getChangeRequestActivity",
      ),
    getFileRevisions: effect (
      input,
    ): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderFileRevisions!PullRequestProviderError!never =>
      try withSpan(
        (effect (): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderFileRevisions!PullRequestProviderError!never => {
          const result = try request({ ...input, path: `${pullPath(input)}.diff` })
          if (result.stdoutTruncated) {
            throw failure("getFileRevisions", "Forgejo diff exceeded the output limit.")
          }
          const revisions = new Map(
            try Effect.orDie(Effect.try({
              try: () => parseDiffFileRevisions(result.stdout),
              catch: (e) => e,
            })),
          )
          for (const path of input.paths) {
            if (!revisions.has(path)) revisions.set(path, "")
          }
          return { revisions, complete: true }
        })(),
        "ForgejoPullRequestProvider.getFileRevisions",
      ),
    getDiff: (input) =>
      request({
        ...input,
        path: input.commit
          ? `${repoPath(input)}/git/commits/${encodeURIComponent(input.commit)}.diff`
          : `${pullPath(input)}.diff`,
      })
      |> Effect.map(%, (result) => ({
        patch: result.stdout,
        truncated: result.stdoutTruncated,
        nextCursor: null,
      })),
    getDiffFileContents: effect (
      input,
    ): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderDiffFileContents!PullRequestProviderError!never =>
      try withSpan(
        (effect (): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderDiffFileContents!PullRequestProviderError!never => {
          const pr = try getPull(input)
          const commit = input.commit
            ? try read(
              {
                ...input,
                path: `${repoPath(input)}/git/commits/${
                  encodeURIComponent(input.commit)
                }?files=false&verification=false`,
              },
              ForgejoCommit,
            )
            : null
          const oldRef = commit ? commit.parents[0]?.sha : pr.merge_base || pr.base.sha
          const newRef = input.commit ?? pr.head.sha
          const content = (repository: string, ref: string, path: string) =>
            read(
              {
                ...input,
                repository,
                path: `${repoPath({ ...input, repository })}/contents/${
                  path.split("/").map(encodeURIComponent).join("/")
                }?ref=${encodeURIComponent(ref)}`,
              },
              Schema.Struct({ content: Schema.String, encoding: Schema.Literal("base64") }),
            ) |> Effect.map(%, (file) => $Buffer_from(file.content, "base64").toString("utf8"))
          const [oldContents, newContents] = try Effect.all(
            [
              input.changeType === "new" || !oldRef
                ? Effect.succeed("")
                : content(input.repository, oldRef, input.oldPath),
              input.changeType === "deleted"
                ? Effect.succeed("")
                : content(pr.head.repo?.full_name ?? input.repository, newRef, input.newPath),
            ],
            { concurrency: 2 },
          )
          return { oldContents, newContents }
        })(),
        "ForgejoPullRequestProvider.getDiffFileContents",
      ),
    runAction: (input) => {
      switch (input.action) {
        case "merge":
          return effect {
            const deleteBranch = (try getRepo(input)).default_delete_branch_after_merge ?? false
            try (write({
              ...input,
              path: `${pullPath(input)}/merge`,
              method: "POST",
              body: { Do: input.mergeMethod ?? "merge", delete_branch_after_merge: deleteBranch },
            })
              |> Effect.catchTags(%, {
                // Forgejo merges before deleting the branch, so a refused deletion still merged.
                PullRequestProviderError: (error) =>
                  deleteBranch
                    ? (getPull(input)
                      |> Effect.mapError(%, () => error)
                      |> Effect.flatMap(%, (pr) => (pr.merged ? Effect.void : Effect.fail(error))))
                    : Effect.fail(error),
              }))
          }
        case "close":
        case "reopen":
          return write({
            ...input,
            path: pullPath(input),
            method: "PATCH",
            body: { state: input.action === "close" ? "closed" : "open" },
          })
        case "update-branch":
          return write({
            ...input,
            path: `${pullPath(input)}/update?style=${input.updateMethod ?? "merge"}`,
            method: "POST",
          })
        default:
          return unsupported(input.action)
      }
    },
    updateChangeRequest: (input) =>
      write({
        ...input,
        path: pullPath(input),
        method: "PATCH",
        body: {
          ...(input.title === undefined ? {} : { title: input.title }),
          ...(input.body === undefined ? {} : { body: input.body }),
        },
      }),
    comment: (input) =>
      write({
        ...input,
        path: `${issuePath(input)}/comments`,
        method: "POST",
        body: { body: input.body },
      }),
    updateComment: (input) =>
      write({
        ...input,
        path: `${repoPath(input)}/issues/comments/${encodeURIComponent(input.commentId)}`,
        method: "PATCH",
        body: { body: input.body },
      }),
    submitReview: effect (input): void!PullRequestProviderError!never =>
      try withSpan(
        (effect (): void!PullRequestProviderError!never => {
          const pr = try getPull(input)
          try write({
            ...input,
            path: `${pullPath(input)}/reviews`,
            method: "POST",
            body: {
              event: input.verdict === "approve"
                ? "APPROVED"
                : input.verdict === "request-changes"
                ? "REQUEST_CHANGES"
                : "COMMENT",
              body: input.body,
              commit_id: pr.head.sha,
              comments: input.comments.map((comment) => {
                const position = comment.position
                const old = position.kind === "deleted"
                  || (position.kind === "context" && position.side === "left")
                return {
                  path: old ? (comment.oldPath ?? comment.path) : comment.path,
                  body: comment.body,
                  old_position: old ? position.oldLine : 0,
                  new_position: old ? 0 : position.newLine,
                }
              }),
            },
          })
        })(),
        "ForgejoPullRequestProvider.submitReview",
      ),
    listReviewerCandidates: effect (
      input,
    ): { readonly candidates: readonly { readonly isBot?: boolean | undefined; readonly login: string; readonly name: string | null; readonly avatarUrl: string | null; readonly id: string; readonly kind: "team" | "user"; readonly isRequested: boolean; }[]; readonly truncated: boolean; }!PullRequestProviderError!never =>
      try withSpan(
        (effect (): { readonly candidates: readonly { readonly isBot?: boolean | undefined; readonly login: string; readonly name: string | null; readonly avatarUrl: string | null; readonly id: string; readonly kind: "team" | "user"; readonly isRequested: boolean; }[]; readonly truncated: boolean; }!PullRequestProviderError!never => {
          const [pr, users] = try Effect.all(
            [getPull(input), page({ ...input, path: `${repoPath(input)}/assignees` }, ForgejoUser)],
            { concurrency: 2 },
          )
          return {
            candidates: users.items
              .filter((user) => user.login !== pr.user?.login)
              .flatMap((user) => {
                const actor = forgejoActor(user)
                return actor
                  ? [
                    {
                      ...actor,
                      id: user.login,
                      kind: "user" as const,
                      isRequested: pr.requested_reviewers?.some((reviewer) => reviewer.login === user.login)
                        ?? false,
                    },
                  ]
                  : []
              }),
            truncated: users.truncated,
          }
        })(),
        "ForgejoPullRequestProvider.listReviewerCandidates",
      ),
    setReviewerRequest: (input) =>
      write({
        ...input,
        path: `${pullPath(input)}/requested_reviewers`,
        method: input.requested ? "POST" : "DELETE",
        body: { reviewers: input.reviewers.map((reviewer) => reviewer.id) },
      }),
    listLabelCandidates: effect (
      input,
    ): { readonly candidates: readonly { readonly name: string; readonly color: string | null; readonly description: string | null; readonly isApplied: boolean; }[]; readonly truncated: boolean; }!PullRequestProviderError!never =>
      try withSpan(
        (effect (): { readonly candidates: readonly { readonly name: string; readonly color: string | null; readonly description: string | null; readonly isApplied: boolean; }[]; readonly truncated: boolean; }!PullRequestProviderError!never => {
          const [pr, labels] = try Effect.all(
            [getPull(input), page({ ...input, path: `${repoPath(input)}/labels` }, ForgejoLabel)],
            { concurrency: 2 },
          )
          return {
            candidates: labels.items.map((label) => ({
              name: label.name,
              color: label.color ?? null,
              description: label.description ?? null,
              isApplied: pr.labels?.some((applied) => applied.id === label.id) ?? false,
            })),
            truncated: labels.truncated,
          }
        })(),
        "ForgejoPullRequestProvider.listLabelCandidates",
      ),
    listRepositoryLabels: effect (
      input,
    ): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderFilterOptionPage<{ readonly name: string; readonly color: string | null; }>!PullRequestProviderError!never =>
      try withSpan(
        (effect (): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderFilterOptionPage<{ readonly name: string; readonly color: string | null; }>!PullRequestProviderError!never => {
          const labels = try page({ ...input, path: `${repoPath(input)}/labels` }, ForgejoLabel)
          return {
            items: labels.items.map((label) => ({ name: label.name, color: label.color ?? null })),
            truncated: labels.truncated,
          }
        })(),
        "ForgejoPullRequestProvider.listRepositoryLabels",
      ),
    searchRepositoryAuthors: effect (
      input,
    ): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderFilterOptionPage<{ readonly isBot?: boolean | undefined; readonly login: string; readonly name: string | null; readonly avatarUrl: string | null; }>!PullRequestProviderError!never =>
      try withSpan(
        (effect (): import("@t3tools/source-control-core/server/PullRequestProvider").ProviderFilterOptionPage<{ readonly isBot?: boolean | undefined; readonly login: string; readonly name: string | null; readonly avatarUrl: string | null; }>!PullRequestProviderError!never => {
          const query = input.query?.trim() ?? ""
          const actors = (users: ReadonlyArray<typeof ForgejoUser.Type>) =>
            users.flatMap((user) => {
              const actor = forgejoActor(user)
              return actor ? [actor] : []
            })
          // Before anything is typed the repository's own people stand in; a search reaches
          // contributors from forks, who are never assignable.
          if (query.length === 0) {
            const users = try page(
              { ...input, path: `${repoPath(input)}/assignees` },
              ForgejoUser,
              100,
            )
            return { items: actors(users.items), truncated: users.truncated }
          }
          const found = try readLinked(
            {
              ...input,
              path: `users/search?${new URLSearchParams({ q: query, limit: String(USER_SEARCH_LIMIT) })}`,
            },
            ForgejoUserSearch,
          )
          const users = found.value.data ?? []
          // A server may cap pages below the limit asked for; its `link` header still says more.
          return {
            items: actors(users),
            truncated: found.next || users.length >= USER_SEARCH_LIMIT,
          }
        })(),
        "ForgejoPullRequestProvider.searchRepositoryAuthors",
      ),
    setLabels: effect (input): void!PullRequestProviderError!never =>
      try withSpan(
        (effect (): void!PullRequestProviderError!never => {
          const labels = try page({ ...input, path: `${repoPath(input)}/labels` }, ForgejoLabel)
          const selected = labels.items.filter((label) => input.labels.includes(label.name))
          if (selected.length !== input.labels.length) {
            throw failure("setLabels", "One or more requested labels could not be found.")
          }
          if (input.applied) {
            try write({
              ...input,
              path: `${issuePath(input)}/labels`,
              method: "POST",
              body: { labels: selected.map((label) => label.id) },
            })
          } else {
            try Effect.forEach(
              selected,
              (label) => write({ ...input, path: `${issuePath(input)}/labels/${label.id}`, method: "DELETE" }),
              { concurrency: 1 },
            )
          }
        })(),
        "ForgejoPullRequestProvider.setLabels",
      ),
    setReaction: effect (input): void!PullRequestProviderError!never =>
      try withSpan(
        (effect (): void!PullRequestProviderError!never => {
          let commentId = input.subjectId
          if (commentId?.startsWith("review:")) {
            const reviewId = /^review:([1-9]\d*)$/.exec(commentId)?.[1]
            if (!reviewId) throw failure("setReaction", "Invalid Forgejo review ID.")
            const review = try read(
              { ...input, path: `${pullPath(input)}/reviews/${reviewId}` },
              ForgejoReview,
            )
            commentId = reviewCommentId(review)
            if (!commentId) {
              throw failure(
                "setReaction",
                "Forgejo did not return a comment ID for this review.",
              )
            }
          }
          if (commentId && !/^[1-9]\d*$/.test(commentId)) {
            throw failure("setReaction", "Invalid Forgejo comment ID.")
          }
          try write({
            ...input,
            path: commentId
              ? `${repoPath(input)}/issues/comments/${commentId}/reactions`
              : `${issuePath(input)}/reactions`,
            method: input.reacted ? "POST" : "DELETE",
            body: { content: FORGEJO_REACTIONS[input.content] },
          })
        })(),
        "ForgejoPullRequestProvider.setReaction",
      ),
    replyToThread: () => unsupported("thread replies"),
    setThreadResolution: () => unsupported("thread resolution"),
  }
  return provider
}
