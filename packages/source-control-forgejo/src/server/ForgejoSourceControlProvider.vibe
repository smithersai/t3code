import { SourceControlProviderKind } from "@t3tools/contracts"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import { SourceControlProviderError } from "@t3tools/contracts"
import * as SourceControlHost from "@t3tools/source-control-core/server/SourceControlHost"
import * as ForgejoCli from "./ForgejoCli.ts"
import * as SourceControlProvider from "@t3tools/source-control-core/server/SourceControlProvider"
import {
  isMissingExecutable,
  providerAuth,
  probeSourceControlProvider,
  type SourceControlCliDiscoverySpec,
  type SourceControlManagedCliDiscoverySpec,
} from "@t3tools/source-control-core/server/discovery"
import { ForgejoPullRequestSchema, toForgejoChangeRequest } from "./forgejoPullRequests.vibe"

const isForgejoCliError = Schema.is(ForgejoCli.ForgejoCliError)

export const discovery = {
  type: "cli",
  kind: SourceControlProviderKind.make("forgejo"),
  label: "Forgejo / Gitea",
  executable: "tea",
  versionArgs: ["--version"],
  authArgs: ["login", "status", "--output", "json"],
  remoteRefinementArgs: () => ["login", "list", "--output", "json"],
  parseAuth: (input) => {
    const logins = ForgejoCli.parseForgejoLogins(input.stdout)
    const login = logins.find((entry) => entry.default === "true") ?? logins[0]
    return login
      ? providerAuth({
        status: login.valid === "true" ? "authenticated" : "unauthenticated",
        account: login.user,
        host: ForgejoCli.parseForgejoRemote(login.url)?.host,
      })
      : providerAuth({
        status: "unauthenticated",
        detail: "Run `tea login add` to authenticate a Forgejo or Gitea server.",
      })
  },
  refineUnknownRemote: (input) => {
    const remote = ForgejoCli.parseForgejoRemote(input.context.remoteUrl)
    const login = remote
      && ForgejoCli.matchForgejoLogin(
        ForgejoCli.parseForgejoLogins(input.auth.stdout),
        remote,
        input.context.requestedHost,
      )
    return login
      ? {
        kind: SourceControlProviderKind.make("forgejo"),
        name: "Forgejo / Gitea",
        baseUrl: login.url,
      }
      : null
  },
  installHint:
    "Install `fj` 0.6 or later from https://codeberg.org/forgejo-contrib/forgejo-cli and run `fj --host <server-url> auth add-token`, or install `tea` 0.16 or later from https://gitea.com/gitea/tea and run `tea login add` for each Forgejo or Gitea server.",
} satisfies SourceControlCliDiscoverySpec

export const makeDiscovery = effect {
  const cli = try ForgejoCli.ForgejoCli
  const { process } = try SourceControlHost.SourceControlHost
  const listLogins = cli.listLogins
  if (!listLogins) return discovery
  return {
    type: "managed-cli",
    kind: SourceControlProviderKind.make("forgejo"),
    label: discovery.label,
    installHint: discovery.installHint,
    probe: effect (
      cwd: string,
    ): { readonly label: string; readonly executable?: string | undefined; readonly status: "available" | "missing"; readonly version: import("effect/Option").Option<string>; readonly installHint: string; readonly detail: import("effect/Option").Option<string>; readonly kind: string & import("effect/Brand").Brand<"SourceControlProviderKind">; readonly auth: { readonly status: "authenticated" | "unauthenticated" | "unknown"; readonly account: import("effect/Option").Option<string>; readonly host: import("effect/Option").Option<string>; readonly detail: import("effect/Option").Option<string>; readonly accounts?: readonly { readonly host: string; readonly account: string; readonly active: boolean; readonly authenticated: boolean; readonly error?: string; readonly environmentVariable?: string; }[]; }; }!never!never =>
      try withSpan(
        (effect (): { readonly label: string; readonly executable?: string | undefined; readonly status: "available" | "missing"; readonly version: import("effect/Option").Option<string>; readonly installHint: string; readonly detail: import("effect/Option").Option<string>; readonly kind: string & import("effect/Brand").Brand<"SourceControlProviderKind">; readonly auth: { readonly status: "authenticated" | "unauthenticated" | "unknown"; readonly account: import("effect/Option").Option<string>; readonly host: import("effect/Option").Option<string>; readonly detail: import("effect/Option").Option<string>; readonly accounts?: readonly { readonly host: string; readonly account: string; readonly active: boolean; readonly authenticated: boolean; readonly error?: string; readonly environmentVariable?: string; }[]; }; }!never!never => {
          const remoteUrl = (process
            .run({
              operation: "source-control.discovery.remote",
              command: "git",
              args: ["remote", "get-url", "origin"],
              cwd,
              allowNonZeroExit: true,
              timeoutMs: 5_000,
              maxOutputBytes: 8_000,
            })
            |> Effect.map(%, (result) => result.stdout.trim())) catch () => ""
          const credentials = try Effect.result(listLogins({ cwd, command: "fj", remoteUrl }))
          const logins = Result.isSuccess(credentials) ? credentials.success : []
          const remote = try Effect.orDie(
            Effect.try({ try: () => (ForgejoCli.parseForgejoRemote(remoteUrl)), catch: (error) => error }),
          )
          const login = (remote
            && (try Effect.orDie(
              Effect.try({ try: () => (ForgejoCli.matchForgejoLogin(logins, remote)), catch: (error) => error }),
            )))
            || logins.find((entry) => entry.default === "true")
            || logins[0]
          const fj = try probeSourceControlProvider({
            cwd,
            process,
            spec: {
              ...discovery,
              executable: "fj",
              versionArgs: ["version"],
              authArgs: login ? ["--host", login.url, "whoami"] : ["auth", "list"],
              parseAuth: (result) =>
                Result.isFailure(credentials)
                  ? providerAuth({
                    status: "unknown",
                    detail: "Could not read fj authentication storage. Authenticate again with fj.",
                  })
                  : login && result.exitCode === 0
                  ? providerAuth({
                    status: "authenticated",
                    account: login.user,
                    host: ForgejoCli.parseForgejoRemote(login.url)?.host,
                  })
                  : providerAuth({
                    status: "unauthenticated",
                    detail: "Authenticate this server with `fj --host <server-url> auth add-token`.",
                  }),
            },
          })
          if (fj.status === "available" && (login || Result.isFailure(credentials))) {
            if (login && fj.auth.status === "authenticated" && cli.getAccount) {
              const account = try (cli.getAccount({ cwd, baseUrl: login.url }) |> Effect.result(%))
              return {
                ...fj,
                auth: Result.isSuccess(account)
                  ? providerAuth({
                    status: "authenticated",
                    account: account.success,
                    host: (try Effect.orDie(
                      Effect.try({ try: () => (ForgejoCli.parseForgejoRemote(login.url)), catch: (error) => error }),
                    ))?.host,
                  })
                  : providerAuth({
                    status: "unknown",
                    detail: account.failure.detail,
                    host: (try Effect.orDie(
                      Effect.try({ try: () => (ForgejoCli.parseForgejoRemote(login.url)), catch: (error) => error }),
                    ))?.host,
                  }),
              }
            }
            return fj
          }
          const tea = try probeSourceControlProvider({ cwd, process, spec: discovery })
          return tea.status === "available" || fj.status === "missing" ? tea : fj
        })(),
        "ForgejoSourceControlProvider.discovery",
      ),
    refineUnknownRemote: effect (
      input: { readonly cwd: string; readonly context: SourceControlProvider.SourceControlProviderContext },
    ): ({ readonly kind: string & import("effect/Brand").Brand<"SourceControlProviderKind">; readonly name: string; readonly baseUrl: string; } | null)!import("effect/Cause").YieldableError!never =>
      try withSpan(
        (effect (): ({ readonly kind: string & import("effect/Brand").Brand<"SourceControlProviderKind">; readonly name: string; readonly baseUrl: string; } | null)!import("effect/Cause").YieldableError!never => {
          const remote = try Effect.orDie(
            Effect.try({
              try: () => (ForgejoCli.parseForgejoRemote(input.context.remoteUrl)),
              catch: (error) => error,
            }),
          )
          if (!remote) return null
          let failure: ForgejoCli.ForgejoCliError | undefined
          for (const command of ["fj", "tea"] as const) {
            const logins = try (listLogins({
              cwd: input.cwd,
              command,
              remoteUrl: input.context.remoteUrl,
            })
              |> Effect.catchIf(
                %,
                (error) => isMissingExecutable(error.cause),
                () => Effect.succeed([]),
              )
              |> Effect.result(%))
            if (Result.isFailure(logins)) {
              failure ??= logins.failure
              continue
            }
            const login = try Effect.orDie(Effect.try({
              try: () => (ForgejoCli.matchForgejoLogin(
                logins.success,
                remote,
                input.context.requestedHost,
              )),
              catch: (error) => error,
            }))
            if (login) {
              return {
                kind: SourceControlProviderKind.make("forgejo"),
                name: discovery.label,
                baseUrl: login.url,
              }
            }
          }
          if (failure) throw failure
          return null
        })(),
        "ForgejoSourceControlProvider.refineUnknownRemote",
      ),
  } satisfies SourceControlManagedCliDiscoverySpec
}

export function repositoryNameFromRemoteUrl(url: string): string | null {
  const path = SourceControlProvider.repositoryPathFromRemoteUrl(url)
  return path === null || !/^https?:\/\//iu.test(url.trim())
    ? path
    : path.split("/").slice(-2).join("/")
}

// Resolve browser URLs from the serving login to handle SSH aliases and mounts.
const refineRepositoryIdentity: NonNullable<
  SourceControlProvider.SourceControlProvider["Service"]["refineRepositoryIdentity"]
> = Effect.fn("ForgejoSourceControlProvider.refineRepositoryIdentity")(function*({
  identity,
  resolveContext,
}) {
  const remote = ForgejoCli.parseForgejoRemote(identity.locator.remoteUrl)
  if (
    !remote
    || !identity.rootPath
    || (identity.provider !== undefined
      && identity.provider !== "unknown"
      && identity.provider !== "forgejo")
  ) {
    return identity
  }
  const context = yield* resolveContext({
    cwd: identity.rootPath,
    context: {
      provider: { kind: SourceControlProviderKind.make("unknown"), name: "Unknown", baseUrl: "" },
      remoteName: identity.locator.remoteName,
      remoteUrl: identity.locator.remoteUrl,
    },
  })
  if (context?.provider.kind !== "forgejo") return identity
  const baseUrl = context.provider.baseUrl.replace(/\/+$/, "")
  const basePath = new URL(baseUrl).pathname.replace(/^\/+|\/+$/g, "")
  const path = !remote.ssh && basePath && remote.path.startsWith(`${basePath}/`)
    ? remote.path.slice(basePath.length + 1)
    : remote.path
  return {
    ...identity,
    provider: SourceControlProviderKind.make("forgejo"),
    webUrl: `${baseUrl}/${path}`,
  }
})

// An SSH remote names an alias rather than the web server, so the login that serves it says which.
const resolveRemoteWebHost: NonNullable<
  SourceControlProvider.SourceControlProvider["Service"]["resolveRemoteWebHost"]
> = Effect.fn("ForgejoSourceControlProvider.resolveRemoteWebHost")(function*({
  cwd,
  context,
  resolveContext,
}) {
  if (!ForgejoCli.parseForgejoRemote(context.remoteUrl)?.ssh) return null
  const resolved = yield* resolveContext({
    cwd,
    context: {
      ...context,
      provider: { kind: SourceControlProviderKind.make("unknown"), name: "Unknown", baseUrl: "" },
    },
  })
  return resolved?.provider.kind === "forgejo"
    ? new URL(resolved.provider.baseUrl).host.toLowerCase()
    : null
})

const RepositorySchema = Schema.Struct({
  full_name: Schema.String,
  clone_url: Schema.String,
  ssh_url: Schema.String,
  default_branch: Schema.optional(Schema.NullOr(Schema.String)),
})
const cloneUrls = (raw: typeof RepositorySchema.Type) => ({
  nameWithOwner: raw.full_name,
  url: raw.clone_url,
  sshUrl: raw.ssh_url,
})
const repositoryPath = (repository: string) => `repos/${repository.split("/").map(encodeURIComponent).join("/")}`

export const make = effect {
  const cli = try ForgejoCli.ForgejoCli
  const fs = try FileSystem.FileSystem
  const { process } = try SourceControlHost.SourceControlHost
  const request = <S extends Schema.Codec<unknown, unknown, never, never>>(
    input: ForgejoCli.ForgejoApiInput,
    schema: S,
  ) =>
    cli.api(input)
    |> Effect.flatMap(%, (result) =>
      Schema.decodeEffect(Schema.fromJsonString(schema))(result.stdout)
      |> Effect.mapError(
        %,
        (cause) =>
          new ForgejoCli.ForgejoCliError({
            command: "tea",
            cwd: input.cwd,
            detail: "Forgejo API returned an invalid response.",
            reason: "invalid-response",
            cause,
          }),
      ))
  const mapError = (operation: string, cwd: string) =>
    Effect.mapError(
      (cause: unknown) =>
        new SourceControlProviderError({
          provider: SourceControlProviderKind.make("forgejo"),
          operation,
          cwd,
          ...(isForgejoCliError(cause) ? { command: cause.command } : {}),
          detail: isForgejoCliError(cause) ? cause.detail : "Forgejo operation failed.",
          cause,
        }),
    )
  const getPull = effect (
    input: {
      readonly cwd: string
      readonly context?: SourceControlProvider.SourceControlProviderContext
      readonly reference: string
    },
  ) =>
    try withSpan(
      effect {
        const repo = try cli.resolveRepository(input)
        const number = /(?:^#?|\/pulls\/)(\d+)(?:\/[^?#]*)?(?:[?#].*)?$/.exec(input.reference)?.[1]
        if (!number) {
          throw new ForgejoCli.ForgejoCliError({
            command: "tea",
            cwd: input.cwd,
            detail: "Specify a pull request number or Forgejo pull request URL.",
          })
        }
        return try request(
          { ...input, path: `${repositoryPath(repo.repository)}/pulls/${number}` },
          ForgejoPullRequestSchema,
        )
      },
      "ForgejoSourceControlProvider.getPull",
    )
  return SourceControlProvider.SourceControlProvider.of({
    kind: SourceControlProviderKind.make("forgejo"),
    repositoryNameFromRemoteUrl,
    refineRepositoryIdentity,
    resolveRemoteWebHost,
    listChangeRequests: effect (input) =>
      try withSpan(
        effect {
          const repo = try cli.resolveRepository(input)
          const source = SourceControlProvider.sourceControlRefFromInput(input)
          const branch = SourceControlProvider.sourceBranch(input)
          const results: ReturnType<typeof toForgejoChangeRequest>[] = []
          const limit = input.limit ?? 20
          for (let page = 1; results.length < limit; page++) {
            const items = try request(
              {
                ...input,
                path: `${repositoryPath(repo.repository)}/pulls?state=${
                  input.state === "merged" ? "closed" : input.state
                }&head=${encodeURIComponent(branch)}&sort=recentupdate&limit=50&page=${page}`,
              },
              Schema.Array(ForgejoPullRequestSchema),
            )
            for (const item of items) {
              if (
                item.head.ref !== branch
                || (source?.repository && item.head.repo?.full_name !== source.repository)
                || (source?.owner && item.head.repo?.owner.login !== source.owner)
              ) {
                continue
              }
              const normalized = toForgejoChangeRequest(item)
              if (input.state === "all" || normalized.state === input.state) results.push(normalized)
            }
            if (items.length === 0) break
          }
          return results.slice(0, limit)
        } |> ((effect, input) => effect.pipe(mapError("listChangeRequests", input.cwd)))(%, input),
        "ForgejoSourceControlProvider.listChangeRequests",
      ),
    getChangeRequest: Effect.fn("ForgejoSourceControlProvider.getChangeRequest")(function(input) {
      return getPull(input).pipe(
        Effect.map(toForgejoChangeRequest),
        mapError("getChangeRequest", input.cwd),
      )
    }),
    createChangeRequest: effect (input) =>
      try withSpan(
        effect {
          const repo = try cli.resolveRepository(input)
          const source = SourceControlProvider.sourceControlRefFromInput(input)
          const owner = source?.owner ?? source?.repository?.split("/")[0]
          const head = SourceControlProvider.sourceBranch(input)
          try cli.api({
            ...input,
            path: `${repositoryPath(input.target?.repository ?? repo.repository)}/pulls`,
            method: "POST",
            body: {
              base: input.target?.refName ?? input.baseRefName,
              head: owner ? `${owner}:${head}` : head,
              title: input.title,
              body: try fs.readFileString(input.bodyFile),
            },
          })
        } |> ((effect, input) => effect.pipe(mapError("createChangeRequest", input.cwd)))(%, input),
        "ForgejoSourceControlProvider.createChangeRequest",
      ),
    getRepositoryCloneUrls: effect (input) =>
      try withSpan(
        effect {
          const repo = try cli.resolveRepository(input)
          return cloneUrls(
            try request({ ...input, path: repositoryPath(repo.repository) }, RepositorySchema),
          )
        } |> ((effect, input) => effect.pipe(mapError("getRepositoryCloneUrls", input.cwd)))(%, input),
        "ForgejoSourceControlProvider.getRepositoryCloneUrls",
      ),
    createRepository: effect (input) =>
      try withSpan(
        effect {
          const repo = try cli.resolveRepository(input)
          const user = try request(
            { ...input, path: "user" },
            Schema.Struct({ login: Schema.String }),
          )
          const [owner, name] = repo.repository.split("/")
          return cloneUrls(
            try request(
              {
                ...input,
                path: owner === user.login
                  ? "user/repos"
                  : `orgs/${encodeURIComponent(owner ?? "")}/repos`,
                method: "POST",
                body: { name, private: input.visibility === "private", auto_init: false },
              },
              RepositorySchema,
            ),
          )
        } |> ((effect, input) => effect.pipe(mapError("createRepository", input.cwd)))(%, input),
        "ForgejoSourceControlProvider.createRepository",
      ),
    getDefaultBranch: effect (input) =>
      try withSpan(
        effect {
          const repo = try cli.resolveRepository(input)
          return (
            (try request({ ...input, path: repositoryPath(repo.repository) }, RepositorySchema))
              .default_branch ?? null
          )
        } |> ((effect, input) => effect.pipe(mapError("getDefaultBranch", input.cwd)))(%, input),
        "ForgejoSourceControlProvider.getDefaultBranch",
      ),
    checkoutChangeRequest: effect (input) =>
      try withSpan(
        effect {
          const repo = try cli.resolveRepository(input)
          const pull = try getPull(input)
          if (repo.command === "fj") {
            // fj checkout cannot target a repository outside the local remotes.
            const urls = try request(
              { ...input, path: repositoryPath(repo.repository) },
              RepositorySchema,
            )
            const remote = input.context?.remoteUrl
            const useSsh = remote
              && (try Effect.orDie(
                Effect.try({ try: () => (ForgejoCli.parseForgejoRemote(remote)), catch: (error) => error }),
              ))?.ssh
            try process.run({
              operation: "ForgejoSourceControlProvider.checkoutChangeRequest",
              command: "git",
              cwd: input.cwd,
              args: [
                "fetch",
                "--",
                useSsh ? urls.ssh_url : urls.clone_url,
                `refs/pull/${pull.number}/head`,
              ],
            })
            const branch = `pulls/${pull.number}`
            const existing = try process.run({
              operation: "ForgejoSourceControlProvider.checkoutChangeRequest",
              command: "git",
              cwd: input.cwd,
              args: ["show-ref", "--verify", "--quiet", `refs/heads/${branch}`],
              allowNonZeroExit: true,
            })
            try process.run({
              operation: "ForgejoSourceControlProvider.checkoutChangeRequest",
              command: "git",
              cwd: input.cwd,
              args: existing.exitCode === 0
                ? ["checkout", branch]
                : ["checkout", "-b", branch, "FETCH_HEAD"],
            })
          } else {
            try cli.execute({
              cwd: input.cwd,
              args: [
                "pulls",
                "checkout",
                "--login",
                repo.login,
                "--repo",
                repo.repository,
                "--branch",
                String(pull.number),
              ],
            })
          }
          if (input.force) {
            // Non-commit server input could become git options.
            if (!/^[0-9a-f]{7,64}$/i.test(pull.head.sha)) {
              throw new ForgejoCli.ForgejoCliError({
                command: repo.command ?? "tea",
                cwd: input.cwd,
                detail: "Forgejo reported a pull request head that is not a commit.",
                reason: "invalid-response",
              })
            }
            // tea leaves PR branches stale; `--keep` updates them without discarding dirty files.
            try process.run({
              operation: "ForgejoSourceControlProvider.checkoutChangeRequest",
              command: "git",
              cwd: input.cwd,
              args: ["reset", "--keep", pull.head.sha],
            })
          }
        } |> ((effect, input) => effect.pipe(mapError("checkoutChangeRequest", input.cwd)))(%, input),
        "ForgejoSourceControlProvider.checkoutChangeRequest",
      ),
  })
}
