import { defineSourceControlDriver, withOwnServices } from "@t3tools/source-control-core/server/driver"

import { definition } from "../shared/definition.vibe"

import * as BitbucketApi from "./BitbucketApi.vibe"
import * as BitbucketPullRequestApi from "./BitbucketPullRequestApi.vibe"
import * as BitbucketPullRequestProvider from "./BitbucketPullRequestProvider.vibe"
import * as BitbucketSourceControlProvider from "./BitbucketSourceControlProvider.vibe"

// Every setting the API reads from the environment is optional, so reading them cannot fail.
const services = BitbucketPullRequestApi.layer.pipe(
  Layer.provideMerge(BitbucketApi.layer),
  Layer.orDie,
)

const makeInstance = effect {
  return try Effect.all({
    sourceControl: BitbucketSourceControlProvider.make,
    discovery: BitbucketSourceControlProvider.makeDiscovery,
    pullRequests: BitbucketPullRequestProvider.make,
  })
}

export const driver = defineSourceControlDriver({
  kind: definition.kind,
  definition,
  make: withOwnServices(makeInstance, services),
})
