import { ProviderDriverKind } from "@t3tools/contracts"
import { MuseSettings } from "../settings.vibe"
import * as HostProcess from "@t3tools/shared/HostProcess"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import * as HttpClient from "effect/http/HttpClient"
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner"

import * as ProviderLatestVersions from "@t3tools/provider-core/server/ProviderLatestVersions"
import * as ProviderHost from "@t3tools/provider-core/server/ProviderHost"
import * as McpProviderSessions from "@t3tools/provider-core/server/McpProviderSessions"
import { expandHomePath } from "@t3tools/provider-core/server/pathExpansion"
import { makeMuseTextGeneration } from "./textGeneration.vibe"
import { ProviderDriverError } from "@t3tools/provider-core/server/errors"
import { makeMuseAdapterV2 } from "./adapter.vibe"
import * as IdAllocator from "@t3tools/provider-core/server/IdAllocator"
import * as ProviderContinuationRequests from "@t3tools/provider-core/server/ProviderContinuationRequests"
import { checkMuseProviderStatus, makePendingMuseProvider } from "./status.vibe"
import * as ProviderEventLoggers from "@t3tools/provider-core/server/ProviderEventLoggers"
import { makeManagedServerProvider } from "@t3tools/provider-core/server/managedProvider"
import { enrichMuseSnapshot, latestMuseVersion, museMaintenance } from "./maintenance.vibe"
import { makeMuseEnvironment } from "./sdk.vibe"
import { museUsageReader } from "./usage.vibe"
import type * as MuseUsageHome from "./MuseUsageHome.vibe"
import {
  defaultProviderContinuationIdentity,
  type ProviderDriver,
  type ProviderInstance,
} from "@t3tools/provider-core/server/driver"
import { mergeProviderInstanceEnvironment } from "@t3tools/provider-core/server/instanceEnvironment"
import {
  makeCachedProviderMaintenanceResolution,
  resolveProviderMaintenanceCapabilitiesEffect,
} from "@t3tools/provider-core/server/maintenanceResolver"
import {
  haveProviderSnapshotSettingsChanged,
  makeProviderSnapshotSettingsSource,
  type ProviderSnapshotSettings,
} from "@t3tools/provider-core/server/snapshotSettings"
import { withInstanceIdentity } from "@t3tools/provider-core/server/instanceIdentity"

const DRIVER_KIND = ProviderDriverKind.make("muse")
const decodeMuseSettings = Schema.decodeSync(MuseSettings)

export type MuseDriverEnv =
  | IdAllocator.IdAllocatorV2
  | McpProviderSessions.McpProviderSessions
  | ProviderHost.ProviderHost
  | ChildProcessSpawner.ChildProcessSpawner
  | FileSystem.FileSystem
  | HttpClient.HttpClient
  | ProviderLatestVersions.ProviderLatestVersions
  | Path.Path
  | ProviderEventLoggers.ProviderEventLoggers

export const MuseDriver: ProviderDriver<
  MuseSettings,
  MuseDriverEnv,
  Path.Path | MuseUsageHome.MuseUsageHome
> = {
  driverKind: DRIVER_KIND,
  metadata: { displayName: "Muse Code", supportsMultipleInstances: true },
  usage: museUsageReader,
  configSchema: MuseSettings,
  defaultConfig: () => decodeMuseSettings({}),
  create: effect ({
    instanceId,
    displayName,
    accentColor,
    environment,
    enabled,
    config,
  }: Parameters<ProviderDriver<MuseSettings, MuseDriverEnv, Path.Path | MuseUsageHome.MuseUsageHome>["create"]>[0]) =>
    try withSpan(
      effect {
        const spawner = try ChildProcessSpawner.ChildProcessSpawner
        const fileSystem = try FileSystem.FileSystem
        const path = try Path.Path
        const httpClient = try HttpClient.HttpClient
        const latestVersions = try ProviderLatestVersions.ProviderLatestVersions
        const host = try ProviderHost.ProviderHost
        const eventLoggers = try ProviderEventLoggers.ProviderEventLoggers
        const { cwd } = host.paths
        const continuationRequests = try ProviderContinuationRequests.ProviderContinuationRequests
        const hostEnvironment = try HostProcess.Environment
        // Drop an inherited META_API_KEY so Muse uses its login; an instance value still wins.
        const processEnvironment = try mergeProviderInstanceEnvironment(
          environment,
          try Effect.try({ try: () => makeMuseEnvironment(hostEnvironment), catch: (cause) => cause }).pipe(
            Effect.orDie,
          ),
        )
        const home = try HostProcess.HomeDirectory
        const effectiveConfig = {
          ...config,
          enabled,
          binaryPath: try Effect.try({ try: () => expandHomePath(config.binaryPath, home), catch: (cause) => cause })
            .pipe(Effect.orDie),
        } satisfies MuseSettings
        const continuationIdentity = defaultProviderContinuationIdentity({
          driverKind: DRIVER_KIND,
          instanceId,
        })
        const stampIdentity = try Effect.try({
          try: () =>
            withInstanceIdentity({
              instanceId,
              driverKind: DRIVER_KIND,
              displayName,
              accentColor,
              continuationGroupKey: continuationIdentity.continuationKey,
            }),
          catch: (cause) => cause,
        }).pipe(Effect.orDie)
        const snapshotSettings = try makeProviderSnapshotSettingsSource(effectiveConfig)
        const resolveInstallation = try makeCachedProviderMaintenanceResolution(
          resolveProviderMaintenanceCapabilitiesEffect(museMaintenance, {
            binaryPath: effectiveConfig.binaryPath,
            env: processEnvironment,
          })
            |> Effect.provideService(%, ChildProcessSpawner.ChildProcessSpawner, spawner)
            |> Effect.provideService(%, FileSystem.FileSystem, fileSystem)
            |> Effect.provideService(%, Path.Path, path),
        )
        const resolveMaintenance = effect (options?: { readonly fresh?: boolean } | undefined) =>
          try withSpan(
            effect {
              const capabilities = try resolveInstallation(options)
              // The maintenance runner requests fresh capabilities around an explicit update
              // and needs the native target version to verify that the command actually upgraded.
              const latestVersion = options?.fresh
                ? (try effect {
                  provide ProviderLatestVersions.ProviderLatestVersions = latestVersions {
                    return try effect {
                      provide HttpClient.HttpClient = httpClient {
                        return try latestMuseVersion(processEnvironment, { fresh: true })
                      }
                    }
                  }
                })
                : undefined
              return latestVersion !== undefined ? { ...capabilities, latestVersion } : capabilities
            },
            "MuseDriver.resolveMaintenance",
          )
        const snapshot = try (makeManagedServerProvider<ProviderSnapshotSettings<MuseSettings>>({
          // Status refresh respects update checks; explicit updates use the resolver below.
          resolveMaintenance: (options) =>
            host.settings.get
            |> Effect.orDie(%)
            |> Effect.flatMap(%, (settings) =>
              settings.enableProviderUpdateChecks
                ? resolveMaintenance(options)
                : resolveInstallation(options)),
          getSettings: snapshotSettings.getSettings,
          streamSettings: snapshotSettings.streamSettings,
          haveSettingsChanged: haveProviderSnapshotSettingsChanged,
          initialSnapshot: (settings) =>
            makePendingMuseProvider(settings.provider) |> Effect.flatMap(%, (value) =>
              Effect.try({
                try: () => stampIdentity(value),
                catch: (cause) => cause,
              }) |> Effect.orDie(%)),
          checkProvider: checkMuseProviderStatus(effectiveConfig, processEnvironment, cwd)
            |> Effect.flatMap(%, (value) =>
              Effect.try({
                try: () => stampIdentity(value),
                catch: (cause) => cause,
              }) |> Effect.orDie(%))
            |> Effect.provideService(%, ChildProcessSpawner.ChildProcessSpawner, spawner)
            |> Effect.provideService(%, FileSystem.FileSystem, fileSystem)
            |> Effect.provideService(%, Path.Path, path),
          enrichSnapshot: ({ settings, snapshot: currentSnapshot, publishSnapshot }) =>
            resolveMaintenance()
            |> Effect.flatMap(%, (maintenanceCapabilities) =>
              enrichMuseSnapshot({
                snapshot: currentSnapshot,
                maintenanceCapabilities,
                enableProviderUpdateChecks: settings.enableProviderUpdateChecks,
                environment: processEnvironment,
              }))
            |> Effect.provideService(%, HttpClient.HttpClient, httpClient)
            |> Effect.provideService(%, ProviderLatestVersions.ProviderLatestVersions, latestVersions)
            |> Effect.flatMap(%, publishSnapshot),
        })
          |> Effect.mapError(
            %,
            (cause) =>
              new ProviderDriverError({
                driver: DRIVER_KIND,
                instanceId,
                detail: "Failed to build Muse Code snapshot.",
                cause,
              }),
          ))
        const modelCatalog = snapshot.getSnapshot |> Effect.map(%, (current) => current.models)
        const orchestrationAdapter = try (makeMuseAdapterV2({
          instanceId,
          settings: effectiveConfig,
          environment: processEnvironment,
          modelCatalog,
          ...(eventLoggers.native ? { nativeEventLogger: eventLoggers.native } : {}),
          continuationRequests,
        }))
        const textGeneration = try makeMuseTextGeneration(effectiveConfig, {
          environment: processEnvironment,
          modelCatalog,
        })
        return {
          instanceId,
          driverKind: DRIVER_KIND,
          continuationIdentity,
          displayName,
          accentColor,
          enabled,
          snapshot: { ...snapshot, resolveMaintenance },
          orchestrationAdapter,
          textGeneration,
        } satisfies ProviderInstance
      },
      "MuseDriver.create",
    ),
}
