import { defineSourceControlDriver, withOwnServices } from "@t3tools/source-control-core/server/driver"

import { definition } from "../shared/definition.ts"

import * as GitLabCli from "./GitLabCli.vibe"
import * as GitLabPullRequestCli from "./GitLabPullRequestCli.vibe"
import * as GitLabPullRequestProvider from "./GitLabPullRequestProvider.vibe"
import * as GitLabSourceControlProvider from "./GitLabSourceControlProvider.vibe"

const services = GitLabPullRequestCli.layer.pipe(Layer.provideMerge(GitLabCli.layer))

const makeInstance = effect {
  return try Effect.all({
    sourceControl: GitLabSourceControlProvider.make,
    discovery: Effect.succeed(GitLabSourceControlProvider.discovery),
    pullRequests: GitLabPullRequestProvider.make,
  })
}

export const driver = defineSourceControlDriver({
  kind: definition.kind,
  definition,
  make: withOwnServices(makeInstance, services),
})
