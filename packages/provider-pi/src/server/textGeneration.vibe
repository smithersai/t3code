import * as Effect from "effect/Effect"
import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner"
import { TextGenerationError } from "@t3tools/contracts"
import type { PiSettings } from "../settings.vibe"
import { makePiRpcConnection, parsePiModelSlug } from "./rpc.vibe"
import { buildPiRpcLaunch, resolvePiLaunchArgs } from "./mcpInjection.vibe"
import * as TextGenerationOperations from "@t3tools/provider-core/server/textGenerationOperations"

module platform {
  /** @throws {never} */
  export function $process_env() {
    return process.env
  }
}

import { $process_env } from platform

const PI_TIMEOUT_MS = 180_000
const isTextGenerationError = Schema.is(TextGenerationError)
export const makePiTextGeneration = effect (
  piSettings: {
    readonly enabled: boolean
    readonly binaryPath: string
    readonly launchArgs: string
    readonly customModels: readonly (string | {
      readonly slug: string
      readonly name?: string | undefined
      readonly capabilities?: {
        readonly optionDescriptors?:
          | readonly ({
            readonly id: string
            readonly label: string
            readonly description?: string | undefined
            readonly type: "select"
            readonly options: readonly {
              readonly id: string
              readonly label: string
              readonly description?: string | undefined
              readonly isDefault?: boolean | undefined
            }[]
            readonly currentValue?: string | undefined
            readonly promptInjectedValues?: readonly string[] | undefined
          } | {
            readonly id: string
            readonly label: string
            readonly description?: string | undefined
            readonly type: "boolean"
            readonly currentValue?: boolean | undefined
          })[]
          | undefined
      } | undefined
    })[]
  },
  environment: NodeJS.ProcessEnv | undefined = undefined,
) =>
  try withSpan(
    effect {
      const resolvedEnvironment = environment === undefined ? $process_env() : environment
      const spawner = try ChildProcessSpawner.ChildProcessSpawner

      const runPiJson: TextGenerationOperations.Runner = effect (request) =>
        try withSpan(
          effect {
            const { operation, cwd, prompt, modelSelection } = request

            const resolvedLaunchArgs = resolvePiLaunchArgs(piSettings.launchArgs)
            if (!resolvedLaunchArgs.ok) {
              throw new TextGenerationError({
                operation,
                detail: resolvedLaunchArgs.message,
              })
            }
            const launch = buildPiRpcLaunch({
              launchArgs: resolvedLaunchArgs.args,
              environment: resolvedEnvironment,
              mcpSession: undefined,
              extensionPath: undefined,
              ephemeral: true,
              disableExtensions: true,
              // Background naming/content helpers must never mutate the workspace.
              disableTools: true,
            })
            const connection = try effect {
              provide ChildProcessSpawner.ChildProcessSpawner = spawner {
                return try makePiRpcConnection({
                  command: piSettings.binaryPath || "pi",
                  args: launch.args,
                  cwd,
                  env: launch.env,
                })
              }
            }

            if (modelSelection.model !== "default") {
              // Reject unusable custom slugs; silently using Pi's default would misreport the requested model.
              const parsed = parsePiModelSlug(modelSelection.model)
              if (parsed === null) {
                throw new TextGenerationError({
                  operation,
                  detail: `Pi model '${modelSelection.model}' must use provider/model format.`,
                })
              }
              try (connection
                .request({ type: "set_model", provider: parsed.provider, modelId: parsed.modelId })
                // Model discovery loads extensions that this background helper disables.
                |> Effect.mapError(%, (error) =>
                  error._tag === "PiRpcError" && error.operation === "set_model"
                    ? new TextGenerationError({
                      operation,
                      detail: `Pi rejected model '${modelSelection.model}': ${error.detail ?? "unknown error"}. `
                        + "If the model comes from a Pi extension or package, text generation cannot use it "
                        + "because it runs Pi with --no-extensions. Pick a built-in Pi model or one defined "
                        + "in Pi's models.json.",
                      cause: error,
                    })
                    : error))
            }

            try connection.request({ type: "prompt", message: prompt })
            try effect {
              while (true) {
                const event = try Queue.take(connection.events)
                if (event["type"] === "agent_settled") return
              }
            }
            const data = try connection.request({ type: "get_last_assistant_text" })
            const text = typeof data === "object"
                && data !== null
                && typeof (data as { text?: unknown }).text === "string"
              ? (data as { text: string }).text.trim()
              : ""
            if (!text) {
              throw new TextGenerationError({
                operation,
                detail: "Pi returned empty output.",
              })
            }
            return try TextGenerationOperations.decodeJsonReply(request, "Pi", text)
          } |> ((effect, request) => {
            const { operation } = request
            return effect
              |> Effect.timeoutOption(%, PI_TIMEOUT_MS)
              |> Effect.flatMap(
                %,
                Option.match({
                  onNone: () => Effect.fail(new TextGenerationError({ operation, detail: "Pi request timed out." })),
                  onSome: (value) => Effect.succeed(value),
                }),
              )
              |> Effect.mapError(%, (cause) =>
                isTextGenerationError(cause)
                  ? cause
                  : new TextGenerationError({
                    operation,
                    detail: "Pi text generation failed.",
                    cause,
                  }))
              |> Effect.scoped(%)
          })(%, request),
          "PiTextGeneration.runPiJson",
        )

      return TextGenerationOperations.fromRunner(
        "PiTextGeneration",
        TextGenerationOperations.withoutInvestigation("Pi", runPiJson),
      )
    },
    "makePiTextGeneration",
  )
