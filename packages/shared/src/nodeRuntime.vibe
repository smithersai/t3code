import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import * as Path from "effect/Path"
import * as Schema from "effect/Schema"

import * as HostProcess from "./HostProcess.vibe"
import { CommandResolutionCache, resolveCommandPath } from "./shell.vibe"

const NodeRuntimeFeature = Schema.Literals([
  "Local device support",
  "Device automation",
  "Antigravity",
  "Antigravity sign-in",
])

export const nodeRuntimeUnavailableMessage = (feature: typeof NodeRuntimeFeature.Type): string =>
  `${feature} requires Node.js. Install Node.js and make sure node is on PATH, then retry.`

export class NodeRuntimeUnavailableError extends Schema.TaggedError<NodeRuntimeUnavailableError>()(
  "NodeRuntimeUnavailableError",
  { feature: NodeRuntimeFeature, cause: Schema.optional(Schema.Defect()) },
) {
  override get message(): string {
    return nodeRuntimeUnavailableMessage(this.feature)
  }
}

export interface SelfInvocation {
  readonly command: string
  /** Absolute script entrypoint; undefined for packaged binaries, which dispatch subcommands from argv[2]. */
  readonly entrypoint: string | undefined
}

/** Packaged binaries repeat the binary at argv[1]; callers must not assemble execPath/argv[1] themselves. */
export const resolveSelfInvocation = effect () =>
  try withSpan(
    effect {
      const command = try HostProcess.ExecutablePath
      if (try HostProcess.IsExecutable) {
        return { command, entrypoint: undefined } satisfies SelfInvocation
      }
      const path = try Path.Path
      const entry = (try HostProcess.Arguments)[1]
      // Children spawn from their own working directory, so the script path must be absolute.
      return {
        command,
        entrypoint: entry === undefined ? undefined : path.resolve(entry),
      } satisfies SelfInvocation
    },
    "nodeRuntime.resolveSelfInvocation",
  )

export const selfInvocationArgs = (
  invocation: SelfInvocation,
  args: ReadonlyArray<string>,
): ReadonlyArray<string> => invocation.entrypoint === undefined ? args : [invocation.entrypoint, ...args]

export const resolveNodeExecutable = effect (
  feature: "Antigravity" | "Antigravity sign-in" | "Device automation" | "Local device support",
  environment?: NodeJS.ProcessEnv | undefined,
) =>
  try withSpan(
    effect {
      const executablePath = try HostProcess.ExecutablePath
      if (!(try HostProcess.IsExecutable)) return executablePath

      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const platform = try HostProcess.Platform
      const env = environment ?? (try HostProcess.Environment)
      const resolvedNodePath = try effect {
        provide CommandResolutionCache = new Map() {
          return try resolveCommandPath(platform === "win32" ? "node.exe" : "node", {
            env: platform === "win32" ? { ...env, PATHEXT: ".EXE" } : env,
          })
        }
      }
      if (resolvedNodePath === null) throw new NodeRuntimeUnavailableError({ feature })
      const nodePath = path.resolve(resolvedNodePath)
      const resolvedPath = fs
        .realPath(nodePath) catch effect (cause) => {
          throw new NodeRuntimeUnavailableError({ feature, cause })
        }
      if (resolvedPath === executablePath) throw new NodeRuntimeUnavailableError({ feature })
      const [hostInfo, nodeInfo] = try Effect.all([
        fs.stat(executablePath) |> Effect.option(%),
        fs.stat(nodePath) |> Effect.option(%),
      ])
      if (
        Option.isSome(hostInfo)
        && Option.isSome(nodeInfo)
        && hostInfo.value.dev === nodeInfo.value.dev
        && Option.isSome(hostInfo.value.ino)
        && Option.isSome(nodeInfo.value.ino)
        && hostInfo.value.ino.value > 0n
        && hostInfo.value.ino.value === nodeInfo.value.ino.value
      ) {
        throw new NodeRuntimeUnavailableError({ feature })
      }
      // Launchers such as Vite+ dispatch by argv[0]; keep the node name intact.
      return nodePath
    },
    "nodeRuntime.resolveNodeExecutable",
  )
