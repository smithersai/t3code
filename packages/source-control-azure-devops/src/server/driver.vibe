import { defineSourceControlDriver, withOwnServices } from "@t3tools/source-control-core/server/driver"

import { definition } from "../shared/definition.ts"

import * as AzureDevOpsCli from "./AzureDevOpsCli.vibe"
import * as AzureDevOpsPullRequestCli from "./AzureDevOpsPullRequestCli.vibe"
import * as AzureDevOpsPullRequestProvider from "./AzureDevOpsPullRequestProvider.vibe"
import * as AzureDevOpsSourceControlProvider from "./AzureDevOpsSourceControlProvider.vibe"

const services = AzureDevOpsPullRequestCli.layer.pipe(Layer.provideMerge(AzureDevOpsCli.layer))

const makeInstance = effect {
  return try Effect.all({
    sourceControl: AzureDevOpsSourceControlProvider.make,
    discovery: Effect.succeed(AzureDevOpsSourceControlProvider.discovery),
    pullRequests: AzureDevOpsPullRequestProvider.make,
  })
}

export const driver = defineSourceControlDriver({
  kind: definition.kind,
  definition,
  make: withOwnServices(makeInstance, services),
})
