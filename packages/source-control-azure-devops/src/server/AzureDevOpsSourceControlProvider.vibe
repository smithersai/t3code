import { SourceControlProviderKind } from "@t3tools/contracts"
import * as Effect from "effect/Effect"
import { type ChangeRequest, SourceControlProviderError } from "@t3tools/contracts"

import * as AzureDevOpsCli from "./AzureDevOpsCli.ts"
import type { NormalizedAzureDevOpsPullRequestRecord } from "./azureDevOpsPullRequests.ts"
import * as SourceControlProvider from "@t3tools/source-control-core/server/SourceControlProvider"
import {
  combinedAuthOutput,
  firstSafeAuthLine,
  providerAuth,
  type SourceControlAuthProbeInput,
  type SourceControlCliDiscoverySpec,
} from "@t3tools/source-control-core/server/discovery"

function parseAzureAuth(input: SourceControlAuthProbeInput): infer _ {
  const account = input.stdout.trim().split(/\r?\n/)[0]?.trim()

  if (input.exitCode !== 0) {
    return providerAuth({
      status: "unauthenticated",
      detail: firstSafeAuthLine(combinedAuthOutput(input)) ?? "Run `az login` to authenticate Azure CLI.",
    })
  }

  if (account !== undefined && account.length > 0) {
    return providerAuth({
      status: "authenticated",
      account,
      host: "dev.azure.com",
    })
  }

  return providerAuth({
    status: "unknown",
    host: "dev.azure.com",
    detail: "Azure CLI account status could not be parsed.",
  })
}

export const discovery = {
  type: "cli",
  kind: SourceControlProviderKind.make("azure-devops"),
  label: "Azure DevOps",
  executable: "az",
  versionArgs: ["--version"],
  authArgs: ["account", "show", "--query", "user.name", "-o", "tsv"],
  // `az --version` starts Python and takes ~6s on Windows, exceeding the default probe timeout.
  probeTimeoutMs: 20_000,
  parseAuth: parseAzureAuth,
  installHint:
    "Install the Azure command-line tools (`az`), then enable Azure DevOps support with `az extension add --name azure-devops`.",
} satisfies SourceControlCliDiscoverySpec

function toChangeRequest(summary: NormalizedAzureDevOpsPullRequestRecord): ChangeRequest {
  return {
    provider: SourceControlProviderKind.make("azure-devops"),
    number: summary.number,
    title: summary.title,
    url: summary.url,
    baseRefName: summary.baseRefName,
    headRefName: summary.headRefName,
    ...(summary.headSha !== undefined ? { headSha: summary.headSha } : {}),
    state: summary.state,
    ...(summary.isDraft === true ? { isDraft: true } : {}),
    closedAt: summary.closedAt ?? null,
    mergedAt: summary.mergedAt ?? null,
    updatedAt: summary.updatedAt,
    isCrossRepository: summary.isCrossRepository,
  }
}

export const make = effect {
  const azure = try AzureDevOpsCli.AzureDevOpsCli()

  return SourceControlProvider.SourceControlProvider.of({
    kind: SourceControlProviderKind.make("azure-devops"),
    listChangeRequests: effect (input) =>
      try withSpan(
        effect {
          const source = SourceControlProvider.sourceControlRefFromInput(input)
          return try Effect.mapError(
            Effect.map(
              azure
                .listPullRequests({
                  cwd: input.cwd,
                  headSelector: input.headSelector,
                  ...(source !== undefined ? { source } : {}),
                  state: input.state,
                  ...(input.limit !== undefined ? { limit: input.limit } : {}),
                }),
              (items) => items.map(toChangeRequest),
            ),
            (error) =>
              new SourceControlProviderError({
                provider: SourceControlProviderKind.make("azure-devops"),
                operation: "listChangeRequests",
                command: error.command,
                cwd: input.cwd,
                reference: SourceControlProvider.transportSafeSourceControlErrorValue(
                  input.headSelector,
                ),
                detail: error.detail,
                cause: error,
              }),
          )
        },
        "AzureDevOpsSourceControlProvider.listChangeRequests",
      ),
    getChangeRequest: effect (input) =>
      try withSpan(
        Effect.mapError(Effect.map(azure.getPullRequest(input), toChangeRequest), (error) =>
          new SourceControlProviderError({
            provider: SourceControlProviderKind.make("azure-devops"),
            operation: "getChangeRequest",
            command: error.command,
            cwd: input.cwd,
            reference: SourceControlProvider.transportSafeSourceControlErrorValue(
              input.reference,
            ),
            detail: error.detail,
            cause: error,
          })),
        "AzureDevOpsSourceControlProvider.getChangeRequest",
      ),
    createChangeRequest: effect (input) =>
      try withSpan(
        effect {
          const source = SourceControlProvider.sourceControlRefFromInput(input)
          return try Effect.mapError(
            azure
              .createPullRequest({
                cwd: input.cwd,
                baseBranch: input.baseRefName,
                headSelector: input.headSelector,
                ...(source !== undefined ? { source } : {}),
                ...(input.target !== undefined ? { target: input.target } : {}),
                title: input.title,
                bodyFile: input.bodyFile,
              }),
            (error) =>
              new SourceControlProviderError({
                provider: SourceControlProviderKind.make("azure-devops"),
                operation: "createChangeRequest",
                command: error.command,
                cwd: input.cwd,
                reference: SourceControlProvider.transportSafeSourceControlErrorValue(
                  input.headSelector,
                ),
                detail: error.detail,
                cause: error,
              }),
          )
        },
        "AzureDevOpsSourceControlProvider.createChangeRequest",
      ),
    getRepositoryCloneUrls: effect (input) =>
      try withSpan(
        Effect.mapError(azure.getRepositoryCloneUrls(input), (error) =>
          new SourceControlProviderError({
            provider: SourceControlProviderKind.make("azure-devops"),
            operation: "getRepositoryCloneUrls",
            command: error.command,
            cwd: input.cwd,
            repository: SourceControlProvider.transportSafeSourceControlErrorValue(
              input.repository,
            ),
            detail: error.detail,
            cause: error,
          })),
        "AzureDevOpsSourceControlProvider.getRepositoryCloneUrls",
      ),
    createRepository: effect (input) =>
      try withSpan(
        Effect.mapError(azure.createRepository(input), (error) =>
          new SourceControlProviderError({
            provider: SourceControlProviderKind.make("azure-devops"),
            operation: "createRepository",
            command: error.command,
            cwd: input.cwd,
            repository: SourceControlProvider.transportSafeSourceControlErrorValue(
              input.repository,
            ),
            detail: error.detail,
            cause: error,
          })),
        "AzureDevOpsSourceControlProvider.createRepository",
      ),
    getDefaultBranch: effect (input) =>
      try withSpan(
        Effect.mapError(azure.getDefaultBranch({ cwd: input.cwd }), (error) =>
          new SourceControlProviderError({
            provider: SourceControlProviderKind.make("azure-devops"),
            operation: "getDefaultBranch",
            command: error.command,
            cwd: input.cwd,
            detail: error.detail,
            cause: error,
          })),
        "AzureDevOpsSourceControlProvider.getDefaultBranch",
      ),
    checkoutChangeRequest: effect (input) =>
      try withSpan(
        Effect.mapError(
          azure
            .checkoutPullRequest({
              cwd: input.cwd,
              reference: input.reference,
              ...(input.context !== undefined ? { remoteName: input.context.remoteName } : {}),
            }),
          (error) =>
            new SourceControlProviderError({
              provider: SourceControlProviderKind.make("azure-devops"),
              operation: "checkoutChangeRequest",
              command: error.command,
              cwd: input.cwd,
              reference: SourceControlProvider.transportSafeSourceControlErrorValue(
                input.reference,
              ),
              detail: error.detail,
              cause: error,
            }),
        ),
        "AzureDevOpsSourceControlProvider.checkoutChangeRequest",
      ),
  })
}
