// @effect-diagnostics preferSchemaOverJson:off
import * as Effect from "effect/Effect"
import type * as AcpSchema from "effect-acp/compat"

import { responsePayloads } from "@t3tools/shared/mcpResponsePayloads"

const MAX_CONNECTIONS = 16
const MAX_MESSAGE_BYTES = 8 * 1024 * 1024

interface JsonRpcEnvelope {
  readonly id?: unknown
  readonly method?: unknown
  readonly error?: unknown
  readonly result?: unknown
}

interface Connection {
  readonly mutex: Semaphore.Semaphore
  sessionId: string | null
  protocolVersion: string | null
  nextRequestId: number
}

export class AcpMcpOverAcpError extends Error {
  readonly _tag = "AcpMcpOverAcpError"
  override readonly name = "AcpMcpOverAcpError"
}

const bridgeError = (cause: unknown): AcpMcpOverAcpError =>
  cause instanceof AcpMcpOverAcpError
    ? cause
    : new AcpMcpOverAcpError(cause instanceof Error ? cause.message : String(cause), { cause })

const asEnvelope = (value: unknown): JsonRpcEnvelope | null =>
  typeof value === "object" && value !== null && !Array.isArray(value)
    ? (value as JsonRpcEnvelope)
    : null

function protocolVersionOf(payload: unknown): string | null {
  const result = asEnvelope(payload)?.result
  if (typeof result !== "object" || result === null || Array.isArray(result)) return null
  const protocolVersion = (result as { readonly protocolVersion?: unknown }).protocolVersion
  return typeof protocolVersion === "string" && protocolVersion.length > 0 ? protocolVersion : null
}

function errorMessage(error: unknown): string {
  if (typeof error !== "object" || error === null || Array.isArray(error)) {
    return "The MCP server returned an error."
  }
  const message = (error as { readonly message?: unknown }).message
  return typeof message === "string" && message.length > 0
    ? message
    : "The MCP server returned an error."
}

export interface AcpMcpOverAcpBridgeOptions {
  readonly endpoint: string
  readonly authorization: string
  readonly allocateConnectionId: string!!
  readonly fetchImplementation?: (url: string, init?: RequestInit) => Promise<Response>
}

export interface AcpMcpOverAcpBridge {
  readonly connect: (
    request: AcpSchema.ConnectMcpRequest,
  ) => AcpSchema.ConnectMcpResponse!AcpMcpOverAcpError
  readonly message: (
    request: AcpSchema.MessageMcpRequest,
  ) => AcpSchema.MessageMcpResponse!AcpMcpOverAcpError
  readonly notification: (
    request: AcpSchema.MessageMcpNotification,
  ) => void!AcpMcpOverAcpError
  readonly disconnect: (
    request: AcpSchema.DisconnectMcpRequest,
  ) => AcpSchema.DisconnectMcpResponse!AcpMcpOverAcpError
  readonly dispose: void!!
}

export const makeAcpMcpOverAcpBridge = effect (
  options: AcpMcpOverAcpBridgeOptions,
): AcpMcpOverAcpBridge!! =>
  try withSpan(
    (effect (): AcpMcpOverAcpBridge!! => {
      const fetchImplementation = options.fetchImplementation ?? globalFetch()
      const connections = new Map<string, Connection>()

      const connectionFor = (connectionId: string): Connection!AcpMcpOverAcpError =>
        Effect.suspend(() => {
          const connection = connections.get(connectionId)
          return connection === undefined
            ? Effect.fail(new AcpMcpOverAcpError(`Unknown MCP-over-ACP connection "${connectionId}".`))
            : Effect.succeed(connection)
        })

      const send = (
        connection: Connection,
        message: unknown,
      ): ReadonlyArray<unknown>!AcpMcpOverAcpError =>
        connection.mutex.withPermits(1)(
          effect {
            const body = JSON.stringify(message)
            if (new TextEncoder().encode(body).length > MAX_MESSAGE_BYTES) {
              throw new AcpMcpOverAcpError("MCP-over-ACP message exceeds 8 MiB.")
            }
            const response = try Effect.tryPromise({
              try: (signal) =>
                fetchImplementation(options.endpoint, {
                  method: "POST",
                  signal,
                  headers: {
                    "content-type": "application/json",
                    accept: "application/json, text/event-stream",
                    authorization: options.authorization,
                    ...(connection.sessionId === null
                      ? {}
                      : { "mcp-session-id": connection.sessionId }),
                    ...(connection.protocolVersion === null
                      ? {}
                      : { "mcp-protocol-version": connection.protocolVersion }),
                  },
                  body,
                }),
              catch: bridgeError,
            })
            connection.sessionId = response.headers.get("mcp-session-id") ?? connection.sessionId
            if (!response.ok) {
              try Effect.promise(
                () => response.body?.cancel().catch(() => undefined) ?? Promise.resolve(),
              )
              throw new AcpMcpOverAcpError(`T3 Code MCP endpoint responded with HTTP ${response.status}.`)
            }
            const payloads = [...(try Stream.runCollect(responsePayloads(response, bridgeError)))]
            for (const payload of payloads) {
              connection.protocolVersion = protocolVersionOf(payload) ?? connection.protocolVersion
            }
            return payloads
          } |> Effect.mapError(%, bridgeError),
        )

      const disconnect = effect (
        request: AcpSchema.DisconnectMcpRequest,
      ): AcpSchema.DisconnectMcpResponse!AcpMcpOverAcpError =>
        try withSpan(
          (effect (): AcpSchema.DisconnectMcpResponse!AcpMcpOverAcpError => {
            const connection = try connectionFor(request.connectionId)
            connections.delete(request.connectionId)
            const sessionId = connection.sessionId
            if (sessionId !== null) {
              const response = try Effect.tryPromise({
                try: (signal) =>
                  fetchImplementation(options.endpoint, {
                    method: "DELETE",
                    signal,
                    headers: {
                      authorization: options.authorization,
                      "mcp-session-id": sessionId,
                      ...(connection.protocolVersion === null
                        ? {}
                        : { "mcp-protocol-version": connection.protocolVersion }),
                    },
                  }),
                catch: bridgeError,
              })
              if (!response.ok && response.status !== 404) {
                throw new AcpMcpOverAcpError(
                  `T3 Code MCP endpoint rejected disconnect with HTTP ${response.status}.`,
                )
              }
              try Effect.promise(
                () => response.body?.cancel().catch(() => undefined) ?? Promise.resolve(),
              )
            }
            return {}
          })(),
          "mcpOverAcpBridge.disconnect",
        )

      return {
        connect: effect (request): import("effect-acp/schema").ConnectMcpResponse!AcpMcpOverAcpError!never =>
          try withSpan(
            (effect (): import("effect-acp/schema").ConnectMcpResponse!AcpMcpOverAcpError!never => {
              if (request.serverId !== "t3-code") {
                throw new AcpMcpOverAcpError(`Unknown ACP MCP server "${request.serverId}".`)
              }
              if (connections.size >= MAX_CONNECTIONS) {
                throw new AcpMcpOverAcpError("Too many MCP-over-ACP connections.")
              }
              const connectionId = try options.allocateConnectionId
              connections.set(connectionId, {
                mutex: try Semaphore.make(1),
                sessionId: null,
                protocolVersion: null,
                nextRequestId: 0,
              })
              return { connectionId }
            })(),
            "mcpOverAcpBridge.connect",
          ),
        message: effect (request): import("effect/Schema").Json!AcpMcpOverAcpError!never =>
          try withSpan(
            (effect (): import("effect/Schema").Json!AcpMcpOverAcpError!never => {
              const connection = try connectionFor(request.connectionId)
              const id = ++connection.nextRequestId
              const payloads = try send(connection, {
                jsonrpc: "2.0",
                id,
                method: request.method,
                ...(request.params == null ? {} : { params: request.params }),
              })
              const response = payloads.find((payload) => asEnvelope(payload)?.id === id)
              const envelope = asEnvelope(response)
              if (envelope === null) {
                throw new AcpMcpOverAcpError("MCP server did not return a matching response.")
              }
              if (envelope.error !== undefined) {
                throw new AcpMcpOverAcpError(errorMessage(envelope.error))
              }
              return (envelope.result ?? null) as AcpSchema.MessageMcpResponse
            })(),
            "mcpOverAcpBridge.message",
          ),
        notification: effect (request): void!AcpMcpOverAcpError!never =>
          try withSpan(
            (effect (): void!AcpMcpOverAcpError!never => {
              const connection = try connectionFor(request.connectionId)
              try send(connection, {
                jsonrpc: "2.0",
                method: request.method,
                ...(request.params == null ? {} : { params: request.params }),
              })
            })(),
            "mcpOverAcpBridge.notification",
          ),
        disconnect,
        dispose: effect {
          return try Effect.forEach(
            [...connections.keys()],
            (connectionId) => disconnect({ connectionId }) |> Effect.ignore(%),
            { discard: true },
          )
        },
      }
    })(),
    "AcpMcpOverAcpBridge.make",
  )

module host {
  /**
   * Returns the global fetch at call time.
   * @throws {never}
   */
  export function globalFetch(): (url: string, init?: RequestInit) => Promise<Response> {
    return fetch
  }
}
import { globalFetch } from host
