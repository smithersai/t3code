import { ChatFileAttachment, ChatImageAttachment, PROVIDER_SEND_TURN_MAX_ATTACHMENTS } from "./chatAttachment.vibe"
import * as Schema from "effect/Schema"

import { TrimmedNonEmptyString } from "./baseSchemas.vibe"

export schema ProviderApprovalPolicy = "untrusted" | "on-failure" | "on-request" | "never"

export schema ProviderSandboxMode = "read-only" | "workspace-write" | "danger-full-access"

export schema RuntimeMode = "approval-required" | "auto-accept-edits" | "auto" | "full-access"
export const DEFAULT_RUNTIME_MODE: RuntimeMode = "full-access"

export schema ProviderInteractionMode = "default" | "plan"
export const DEFAULT_PROVIDER_INTERACTION_MODE: ProviderInteractionMode = "default"

export schema ProviderRequestKind = "command" | "file-read" | "file-change" | "mcp-elicitation" | "permission"

export schema AssistantDeliveryMode = "buffered" | "streaming"

export schema ProviderApprovalDecision = "accept" | "acceptForSession" | "acceptAlways" | "decline" | "cancel"

// Why an approval reached the user although the thread runs with full access:
// the user's own ask rule, or a check the provider enforces even when bypassed.
export schema ProviderApprovalFullAccessOverride = "ask_rule" | "provider_check"

export schema ProviderApprovalOption {
  readonly decision: ProviderApprovalDecision
  readonly label: TrimmedNonEmptyString
  readonly warning?: TrimmedNonEmptyString | undefined
}

export schema ProviderUserInputAnswers = Readonly<Record<string, Schema.Unknown>>

export const UserInputAttachments = Schema.Record(
  Schema.String,
  Schema.Array(Schema.Union([ChatImageAttachment, ChatFileAttachment])).pipe(
    Schema.check(Schema.isMaxLength(PROVIDER_SEND_TURN_MAX_ATTACHMENTS)),
  ),
)
export type UserInputAttachments = typeof UserInputAttachments.Type

export schema UserInputAttachmentAnswerPayload {
  readonly requestId: TrimmedNonEmptyString
  readonly questionTextById?: Readonly<Record<string, string>> | undefined
  readonly answers: ProviderUserInputAnswers
  readonly attachmentsByQuestionId: UserInputAttachments
}
