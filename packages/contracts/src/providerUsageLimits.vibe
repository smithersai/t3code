import * as Schema from "effect/Schema"

import { ForwardCompatibleArray, IsoDateTime, NonNegativeInt, TrimmedNonEmptyString } from "./baseSchemas.ts"
import { ProviderDriverKind, ProviderInstanceId } from "./providerInstance.vibe"
import { UsageLimitSourceId } from "./usageLimitSourceId.vibe"

/** Stable per-provider ids let sparse updates merge with full probes. */
export const ServerProviderUsageWindow = Schema.Struct({
  id: TrimmedNonEmptyString,
  kind: Schema.Literals(["session", "weekly", "monthly", "other"]),
  label: TrimmedNonEmptyString,
  usedPercent: Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 100 })),
  resetsAt: Schema.optional(IsoDateTime),
  windowDurationMins: Schema.optional(NonNegativeInt),
})
export type ServerProviderUsageWindow = typeof ServerProviderUsageWindow.Type

export const ServerProviderResetCredits = Schema.Struct({
  availableCount: NonNegativeInt,
  nextExpiresAt: Schema.optional(IsoDateTime),
  /** Pins hub redemption to the displayed credit, including retries from another client. */
  nextCreditId: Schema.optional(TrimmedNonEmptyString),
})
export type ServerProviderResetCredits = typeof ServerProviderResetCredits.Type

/** Clear bars for unavailable accounts; retain last good bars after a failed probe. */
export const ServerProviderUsageLimits = Schema.Struct({
  checkedAt: IsoDateTime,
  windows: ForwardCompatibleArray(ServerProviderUsageWindow),
  credentialFingerprint: Schema.optional(TrimmedNonEmptyString),
  resetCredits: Schema.optional(ServerProviderResetCredits),
  externalUsage: Schema.optional(
    Schema.Struct({
      label: TrimmedNonEmptyString,
      url: TrimmedNonEmptyString,
    }),
  ),
  unavailable: Schema.optional(
    Schema.Struct({
      reason: Schema.Literals(["unsupported", "probeFailed"]),
      message: Schema.optional(TrimmedNonEmptyString),
    }),
  ),
})
export type ServerProviderUsageLimits = typeof ServerProviderUsageLimits.Type

/** Partial updates merge windows by id; omitted windows remain unchanged. */
export schema ProviderUsageLimitsUpdate {
  readonly windows: ReadonlyArray<ServerProviderUsageWindow>
}

export schema UsageLimitSourceAccount {
  readonly id: TrimmedNonEmptyString
  readonly driver: ProviderDriverKind
  readonly email?: TrimmedNonEmptyString | undefined
  readonly plan?: TrimmedNonEmptyString | undefined
  readonly workspaceId?: TrimmedNonEmptyString | undefined
  readonly usageLimits: ServerProviderUsageLimits
}

export const UsageLimitSourceSnapshot = Schema.Struct({
  id: UsageLimitSourceId,
  kind: Schema.Literal("cliproxy"),
  label: TrimmedNonEmptyString,
  checkedAt: IsoDateTime,
  accounts: ForwardCompatibleArray(UsageLimitSourceAccount),
  error: Schema.optional(TrimmedNonEmptyString),
})
export type UsageLimitSourceSnapshot = typeof UsageLimitSourceSnapshot.Type

export const UsageLimitSourceSnapshots = ForwardCompatibleArray(UsageLimitSourceSnapshot)
export type UsageLimitSourceSnapshots = typeof UsageLimitSourceSnapshots.Type

export schema UsageLimitSourceConsumeResetCreditInput {
  readonly sourceId: UsageLimitSourceId
  readonly accountId: TrimmedNonEmptyString
  readonly creditId: TrimmedNonEmptyString
}

export schema ProviderConsumeResetCreditInput =
  | { readonly instanceId: ProviderInstanceId }
  | UsageLimitSourceConsumeResetCreditInput

export schema error UsageLimitSourceError {
  readonly detail: string
  override get message(): string {
    return this.detail
  }
}

export schema ProviderConsumeResetCreditOutcome = "reset" | "nothingToReset" | "noCredit" | "alreadyRedeemed"

export schema ProviderConsumeResetCreditResult {
  readonly outcome: ProviderConsumeResetCreditOutcome
  readonly warning?: TrimmedNonEmptyString | undefined
}

export schema UsageLimitsReport {
  readonly createdAt: IsoDateTime
  readonly accounts: ReadonlyArray<{
    readonly id: TrimmedNonEmptyString
    readonly driver: ProviderDriverKind
    readonly label: TrimmedNonEmptyString
    readonly plan?: TrimmedNonEmptyString | undefined
    readonly email?: TrimmedNonEmptyString | undefined
    readonly sourceLabel?: TrimmedNonEmptyString | undefined
    readonly instanceId?: ProviderInstanceId | undefined
    readonly resetCreditInput?: ProviderConsumeResetCreditInput | undefined
    readonly displayName?: string | undefined
    readonly accentColor?: string | undefined
    readonly limits: ServerProviderUsageLimits
  }>
  readonly notices: ReadonlyArray<string>
}
