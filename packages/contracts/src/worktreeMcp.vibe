import * as Schema from "effect/Schema"

import { TrimmedNonEmptyString } from "./baseSchemas.vibe"

/** Uses the managed worktree folder; handoff detaches the provider, ending this turn and resuming there next run. */
export const WorktreeMcpHandoffInput = Schema.Struct({
  branch: TrimmedNonEmptyString,
  baseRef: Schema.optional(
    TrimmedNonEmptyString.annotate({
      description: "Default: checked-out branch.",
    }),
  ),
  startFromOrigin: Schema.optional(
    Schema.Boolean.annotate({
      description: "True: fetch, start from the remote ref; check `startedFromOrigin`. Default: server setting.",
    }),
  ),
  runSetupScript: Schema.optional(
    Schema.Boolean.annotate({
      description: "Default true.",
    }),
  ),
  continuationPrompt: Schema.optional(
    TrimmedNonEmptyString.check(Schema.isMaxLength(120_000)).annotate({
      description: "Work to resume in the worktree next turn. Omitted: thread waits.",
    }),
  ),
})
export type WorktreeMcpHandoffInput = typeof WorktreeMcpHandoffInput.Type

export schema WorktreeMcpSetupScriptStatus = {
  readonly status: "started"
  readonly scriptName: TrimmedNonEmptyString
  readonly terminalId: TrimmedNonEmptyString
} | {
  readonly status: "no-script"
} | {
  readonly status: "skipped"
} | {
  readonly status: "failed"
  readonly detail: string
}

export schema WorktreeMcpContinuationStatus = {
  readonly status: "scheduled"
  readonly delivery: "started" | "queued" | "steered" | "restarted"
} | {
  readonly status: "skipped"
} | {
  readonly status: "failed"
  readonly detail: string
}

export schema WorktreeMcpHandoffResult {
  readonly worktreePath: TrimmedNonEmptyString
  readonly branch: TrimmedNonEmptyString
  readonly baseRef: TrimmedNonEmptyString
  readonly startedFromOrigin: boolean
  readonly setupScript: WorktreeMcpSetupScriptStatus
  readonly continuation: WorktreeMcpContinuationStatus
  readonly note: string
}

export const WorktreeMcpStatusResult = Schema.Struct({
  attached: Schema.Boolean,
  worktreePath: Schema.NullOr(TrimmedNonEmptyString),
  branch: Schema.NullOr(TrimmedNonEmptyString),
  projectWorkspaceRoot: TrimmedNonEmptyString,
  defaultStartFromOrigin: Schema.Boolean.annotate({
    description: "`startFromOrigin` default for `t3_worktree_handoff`.",
  }),
})
export type WorktreeMcpStatusResult = typeof WorktreeMcpStatusResult.Type

const WorktreeMcpFailureCodeField = Schema.Literals([
  "capability_denied",
  "thread_not_found",
  "project_not_found",
  "already_in_worktree",
  "handoff_in_progress",
  "invalid_request",
  "operation_failed",
  "thread_credential_required",
])
export schema error WorktreeMcpFailure {
  code: WorktreeMcpFailureCodeField
  message: string
}
