export const PreviewAnnotationStrokeTargetSchema: Schema.Codec<PreviewAnnotationStrokeTarget> = Schema.Struct({
  id: Schema.String,
  color: Schema.String,
  width: Schema.Number,
  points: Schema.Array(PreviewAnnotationPointSchema),
  bounds: PreviewAnnotationRectSchema,
})

export interface PreviewAnnotationStyleChange {
  mutable targetId: string
  mutable selector: string | null
  mutable property: string
  mutable previousValue: string
  mutable value: string
}

export const PreviewAnnotationStyleChangeSchema: Schema.Codec<PreviewAnnotationStyleChange> = Schema.Struct({
  targetId: Schema.String,
  selector: Schema.NullOr(Schema.String),
  property: Schema.String,
  previousValue: Schema.String,
  value: Schema.String,
})

export interface PreviewAnnotationScreenshot {
  mutable dataUrl: string
  mutable width: number
  mutable height: number
  mutable cropRect: PreviewAnnotationRect
}

export const PreviewAnnotationScreenshotSchema: Schema.Codec<PreviewAnnotationScreenshot> = Schema.Struct({
  dataUrl: Schema.String,
  width: Schema.Number,
  height: Schema.Number,
  cropRect: PreviewAnnotationRectSchema,
})

export interface PreviewAnnotationPayload {
  mutable id: string
  mutable pageUrl: string
  mutable pageTitle: string | null
  mutable comment: string
  mutable elements: ReadonlyArray<PreviewAnnotationElementTarget>
  mutable regions: ReadonlyArray<PreviewAnnotationRegionTarget>
  mutable strokes: ReadonlyArray<PreviewAnnotationStrokeTarget>
  mutable styleChanges: ReadonlyArray<PreviewAnnotationStyleChange>
  mutable screenshot: PreviewAnnotationScreenshot | null
  mutable createdAt: string
}

export const PreviewAnnotationPayloadSchema: Schema.Codec<PreviewAnnotationPayload> = Schema.Struct(
  {
    id: Schema.String,
    pageUrl: Schema.String,
    pageTitle: Schema.NullOr(Schema.String),
    comment: Schema.String,
    elements: Schema.Array(PreviewAnnotationElementTargetSchema),
    regions: Schema.Array(PreviewAnnotationRegionTargetSchema),
    strokes: Schema.Array(PreviewAnnotationStrokeTargetSchema),
    styleChanges: Schema.Array(PreviewAnnotationStyleChangeSchema),
    screenshot: Schema.NullOr(PreviewAnnotationScreenshotSchema),
    createdAt: Schema.String,
  },
)

export type PreviewAnnotationSubmission = "attach" | "send"
export const PreviewAnnotationSubmissionSchema: Schema.Codec<PreviewAnnotationSubmission> = Schema.Literals([
  "attach",
  "send",
])

export interface PreviewAnnotationSubmissionResult {
  mutable annotation: PreviewAnnotationPayload
  mutable submission: PreviewAnnotationSubmission
  mutable screenshotFailed?: boolean
}
export const PreviewAnnotationSubmissionResultSchema: Schema.Codec<PreviewAnnotationSubmissionResult> = Schema.Struct({
  annotation: PreviewAnnotationPayloadSchema,
  submission: PreviewAnnotationSubmissionSchema,
  screenshotFailed: Schema.optionalKey(Schema.Boolean),
})

export const DesktopPreviewTabInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
})

/** Apply zoom and color scheme at creation to avoid flashing browser defaults. */
export const DesktopPreviewCreateTabInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
  zoomFactor: Schema.optional(Schema.Number.check(Schema.isGreaterThan(0))),
  colorScheme: Schema.optional(DesktopPreviewColorSchemeSchema),
  serverTab: Schema.optional(
    Schema.Struct({ threadId: TrimmedNonEmptyString, tabId: TrimmedNonEmptyString }),
  ),
})

export interface DesktopPreviewTabDefaults {
  readonly zoomFactor?: number | undefined
  readonly colorScheme?: DesktopPreviewColorScheme | undefined
  readonly serverTab?: { readonly threadId: string; readonly tabId: string } | undefined
}

export const DesktopPreviewRegisterWebviewInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
  webContentsId: Schema.Int.check(Schema.isGreaterThan(0)),
})

export const DesktopPreviewNavigateInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
  url: Schema.String,
})

export const DesktopPreviewConfigInputSchema = Schema.Struct({
  environmentId: EnvironmentId,
  /** Main must derive the partition to ensure its session has UA rewrites and permission handlers. */
  profileId: Schema.optional(BrowserProfileId),
})

export const DesktopPreviewClearDataInputSchema = Schema.Struct({
  environmentId: EnvironmentId,
  /** Omit to clear every profile; otherwise only this profile's partition. */
  profileId: Schema.optional(BrowserProfileId),
})

export const DesktopPreviewSetColorSchemeInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
  colorScheme: DesktopPreviewColorSchemeSchema,
})

export const DesktopPreviewSetZoomFactorInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
  zoomFactor: Schema.Number.check(Schema.isGreaterThan(0)),
})

export const DesktopPreviewSetAudioMutedInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
  audioMuted: Schema.Boolean,
})

export const DesktopPreviewAnnotationThemeInputSchema = Schema.Struct({
  theme: DesktopPreviewAnnotationThemeSchema,
})

export const DesktopPreviewAnnotationSendEnabledInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
  enabled: Schema.Boolean,
})

export const DesktopPreviewArtifactInputSchema = Schema.Struct({
  path: Schema.String.check(Schema.isTrimmed()).check(Schema.isNonEmpty()),
})

export const DesktopPreviewRecordingSaveInputSchema = Schema.Struct({
  tabId: DesktopPreviewTabIdSchema,
  mimeType: Schema.String.check(Schema.isTrimmed()).check(Schema.isNonEmpty()),
  data: Schema.Uint8Array,
})

export const SystemSettingsPaneSchema = Schema.Literals(["full-disk-access"])
export type SystemSettingsPane = typeof SystemSettingsPaneSchema.Type

export interface DesktopBridge {
  mutable getAppBranding: () => DesktopAppBranding | null
  mutable getRelayTelemetryEnabled?: () => boolean
  mutable getPathForFile?: (file: File) => string
  mutable getClientPlatform?: () => string
  mutable setNotificationBadge?: (badge: { mutable count: number; mutable image: string | null }) => Promise<void>
  mutable onNotificationBadgeClear?: (listener: () => void) => () => void
  mutable onTrackpadScrollEnd?: (listener: () => void) => () => void
  /**
   * Renderer `window.focus()` cannot raise an Electron window, and on Wayland
   * only the main process can spend a notification click's activation token.
   */
  mutable revealWindow?: () => Promise<void>
  /**
   * The OS locale as a BCP-47 tag, which the renderer cannot read for itself:
   * the packaged app ships only the `en-US` Chromium locale pak, so
   * `navigator.language` and the default `Intl` locale are pinned to `en-US`
   * regardless of OS settings.
   */
  mutable getSystemLocale?: () => string | null
  mutable getLocalEnvironmentBootstraps: () => readonly DesktopEnvironmentBootstrap[]
  mutable getLocalEnvironmentEnabled?: () => boolean
  mutable setLocalEnvironmentEnabled?: (enabled: boolean) => Promise<void>
  mutable getLocalEnvironmentBearerToken: () => Promise<string>
  mutable getClientSettings: () => Promise<ClientSettings | null>
  mutable setClientSettings: (settings: ClientSettings) => Promise<void>
  mutable getConnectionCatalog?: () => Promise<string | null>
  mutable setConnectionCatalog?: (catalog: string) => Promise<boolean>
  mutable clearConnectionCatalog?: () => Promise<void>
  mutable discoverSshHosts: () => Promise<readonly DesktopDiscoveredSshHost[]>
  mutable resolveSshHost: (alias: string) => Promise<DesktopSshEnvironmentTarget>
  mutable requestSnapShotPermissions?: (includeAccessibility: boolean) => Promise<void>
  mutable getSnapShotState?: () => Promise<DesktopSnapShotState>
  mutable setupSnapShot?: (action: DesktopSnapShotSetupAction) => Promise<void>
  mutable previewSnapShotConfig?: (
    request: DesktopCaptureConfigRequest,
  ) => Promise<DesktopCaptureConfigPreview | null>
  mutable applySnapShotConfig?: (previewId: string) => Promise<DesktopCaptureConfigApplied>
  mutable checkSnapShotShortcut?: (
    shortcut: SnapShotShortcut,
  ) => Promise<DesktopSnapShotShortcutAvailability>
  mutable setSnapShotShortcutSuppressed?: (suppressed: boolean) => Promise<void>
  mutable listPendingSnapShots?: () => Promise<readonly DesktopPendingSnapShot[]>
  mutable readSnapShot?: (id: string) => Promise<DesktopSnapShot>
  mutable setSnapShotAnimationDestination?: (
    destination: DesktopSnapShotAnimationDestination,
  ) => Promise<void>
  mutable dismissSnapShotAnimation?: (id: DesktopSnapShotId) => Promise<void>
  mutable acknowledgeSnapShot?: (id: string) => Promise<void>
  mutable ensureSshEnvironment: (
    target: DesktopSshEnvironmentTarget,
    options?: { mutable issuePairingToken?: boolean },
  ) => Promise<DesktopSshEnvironmentBootstrap>
  mutable disconnectSshEnvironment: (target: DesktopSshEnvironmentTarget) => Promise<void>
  mutable fetchSshEnvironmentDescriptor: (httpBaseUrl: string) => Promise<ExecutionEnvironmentDescriptor>
  mutable bootstrapSshBearerSession: (
    httpBaseUrl: string,
    credential: string,
  ) => Promise<AuthAccessTokenResult>
  mutable fetchSshSessionState: (httpBaseUrl: string, bearerToken: string) => Promise<AuthSessionState>
  mutable issueSshWebSocketTicket: (
    httpBaseUrl: string,
    bearerToken: string,
  ) => Promise<AuthWebSocketTicketResult>
  mutable onSshPasswordPrompt: (listener: (request: DesktopSshPasswordPromptRequest) => void) => () => void
  mutable resolveSshPasswordPrompt: (requestId: string, password: string | null) => Promise<void>
  mutable getServerExposureState: () => Promise<DesktopServerExposureState>
  mutable setServerExposureMode: (mode: DesktopServerExposureMode) => Promise<DesktopServerExposureState>
  mutable setTailscaleServeEnabled: (input: {
    readonly enabled: boolean
    readonly port?: number
  }) => Promise<DesktopServerExposureState>
  mutable getAdvertisedEndpoints: () => Promise<readonly AdvertisedEndpoint[]>
  mutable getWslState: () => Promise<DesktopWslState>
  mutable setWslBackendEnabled: (enabled: boolean) => Promise<DesktopWslState>
  mutable setWslDistro: (distro: string | null) => Promise<DesktopWslState>
  mutable setWslOnly: (enabled: boolean) => Promise<DesktopWslState>
  mutable pickFolder: (options?: PickFolderOptions) => Promise<string | null>
  mutable pickProjectFavicon?: (initialPath?: string) => Promise<string | null>
  mutable pickThemeFiles?: () => Promise<readonly PickedThemeFile[] | null>
  mutable setTheme: (theme: DesktopTheme) => Promise<void>
  mutable showContextMenu: <T extends string>(
    items: readonly ContextMenuItem<T>[],
    position?: { mutable x: number; mutable y: number },
  ) => Promise<T | null>
  mutable receiveProviderAuthCallback?: (authorizationUrl: string) => Promise<string>
  mutable cancelProviderAuthCallback?: (authorizationUrl: string) => Promise<void>
  mutable openExternal: (url: string) => Promise<boolean>
  mutable openSystemSettings?: (pane: SystemSettingsPane) => Promise<boolean>
  mutable checkSystemPermission?: (pane: SystemSettingsPane) => Promise<boolean>
  /** Older builds lack this; fall back to VS Code only. */
  mutable probeRemoteEditors?: () => Promise<readonly EditorId[]>
  mutable pasteAsText?: () => Promise<void>
  mutable onMenuAction: (listener: (action: string) => void) => () => void
  mutable onSnapShotEvent?: (listener: (event: DesktopSnapShotEvent) => void) => () => void
  mutable onQuitShortcut?: (listener: (event: QuitShortcutHintEvent) => void) => () => void
  mutable getWindowFullscreenState: () => boolean
  mutable onWindowFullscreenStateChange: (listener: (fullscreen: boolean) => void) => () => void
  /** App window zoom; older desktop shells omit this method. */
  mutable getWindowZoomFactor?: () => number
  mutable getUpdateState: () => Promise<DesktopUpdateState>
  mutable setUpdateChannel: (channel: DesktopUpdateChannel) => Promise<DesktopUpdateState>
  mutable checkForUpdate: () => Promise<DesktopUpdateCheckResult>
  mutable downloadUpdate: () => Promise<DesktopUpdateActionResult>
  mutable installUpdate: () => Promise<DesktopUpdateActionResult>
  mutable onUpdateState: (listener: (state: DesktopUpdateState) => void) => () => void
  mutable cliCommand?: {
    mutable getState: () => Promise<DesktopCliCommandState>
    mutable install: () => Promise<DesktopCliCommandState>
    mutable uninstall: () => Promise<DesktopCliCommandState>
  }
  mutable webLinks?: {
    mutable setReady: (ready: boolean) => Promise<void>
    mutable onOpen: (listener: (url: string) => void) => () => void
  }
  mutable appActivation?: {
    mutable setReady: (ready: boolean) => Promise<void>
    mutable complete: (response: DesktopAppActivationResponse) => Promise<void>
    mutable onRequest: (listener: (request: DesktopAppActivationRequest) => void) => () => void
  }
  mutable preview?: DesktopPreviewBridge
}

/** Renderer callback invoked by Electron with a fresh user gesture before display-media capture. */
export const DESKTOP_PREVIEW_RECORDING_CAPTURE_TRIGGER = "__t3DesktopPreviewRecordingCapture"

export interface DesktopPreviewBridge {
  mutable setForwardedShortcuts?: (shortcuts: ReadonlyArray<PreviewForwardedShortcut>) => Promise<void>
  mutable createTab: (tabId: string, defaults?: DesktopPreviewTabDefaults) => Promise<void>
  mutable closeTab: (tabId: string) => Promise<void>
  mutable registerWebview: (tabId: string, webContentsId: number) => Promise<void>
  mutable navigate: (tabId: string, url: string) => Promise<void>
  mutable goBack: (tabId: string) => Promise<void>
  mutable goForward: (tabId: string) => Promise<void>
  mutable refresh: (tabId: string) => Promise<void>
  mutable zoomIn: (tabId: string) => Promise<void>
  mutable zoomOut: (tabId: string) => Promise<void>
  mutable resetZoom: (tabId: string) => Promise<void>
  mutable setZoomFactor: (tabId: string, zoomFactor: number) => Promise<void>
  mutable hardReload: (tabId: string) => Promise<void>
  mutable setColorScheme: (tabId: string, colorScheme: DesktopPreviewColorScheme) => Promise<void>
  mutable setAudioMuted: (tabId: string, audioMuted: boolean) => Promise<void>
  mutable openDevTools: (tabId: string) => Promise<void>
  mutable clearCookies: (environmentId: EnvironmentId, profileId?: string) => Promise<void>
  mutable clearCache: (environmentId: EnvironmentId, profileId?: string) => Promise<void>
  mutable getPreviewConfig: (
    environmentId: EnvironmentId,
    profileId?: string,
  ) => Promise<DesktopPreviewWebviewConfig>
  mutable listBrowserImportSources: () => Promise<ReadonlyArray<BrowserImportSource>>
  mutable importBrowserCookies: (input: {
    readonly environmentId: EnvironmentId
    readonly sourceId: BrowserImportSourceId
    readonly sourceProfileDirectory: string
    readonly targetProfileId: string
  }) => Promise<BrowserImportResult>
  mutable setAnnotationTheme: (theme: DesktopPreviewAnnotationTheme) => Promise<void>
  mutable setAnnotationSendEnabled: (tabId: string, enabled: boolean) => Promise<void>
  /** Resolves with the annotation and attach/send intent, or null on cancellation. Rejects if activation fails. */
  mutable pickElement: (tabId: string) => Promise<PreviewAnnotationSubmissionResult | null>
  mutable cancelPickElement: (tabId: string) => Promise<void>
  mutable captureScreenshot: (
    tabId: string,
  ) => Promise<DesktopPreviewScreenshotArtifact | PreviewCaptureFailureEncoded>
  mutable revealArtifact: (path: string) => Promise<void>
  mutable copyArtifactToClipboard: (path: string) => Promise<void>
  mutable pictureInPicture: {
    mutable open: (tabId: string) => Promise<void>
    mutable close: (tabId: string) => Promise<void>
  }
  mutable recording: {
    mutable onInput: (listener: (event: DesktopPreviewRecordingInputEvent) => void) => () => void
    mutable startScreencast: (tabId: string) => Promise<void | PreviewCaptureFailureEncoded>
    mutable stopScreencast: (tabId: string) => Promise<void>
    mutable save: (
      tabId: string,
      mimeType: string,
      data: Uint8Array,
    ) => Promise<DesktopPreviewRecordingArtifact>
    mutable onFrame: (listener: (frame: DesktopPreviewRecordingFrame) => void) => () => void
  }
  mutable onStateChange: (listener: (tabId: string, state: DesktopPreviewTabState) => void) => () => void
  mutable onPointerEvent: (listener: (event: DesktopPreviewPointerEvent) => void) => () => void
  mutable onOpenLink: (listener: (event: DesktopPreviewOpenLinkEvent) => void) => () => void
}

export type ConfirmDialogVariant = "default" | "destructive"

export interface ConfirmDialogOptions {
  readonly variant?: ConfirmDialogVariant
}

export interface LocalApi {
  mutable dialogs: {
    mutable pickFolder: (options?: PickFolderOptions) => Promise<string | null>
    mutable confirm: (message: string, options?: ConfirmDialogOptions) => Promise<boolean>
  }
  mutable shell: {
    mutable openExternal: (url: string) => Promise<void>
    mutable openSystemSettings: (pane: SystemSettingsPane) => Promise<void>
  }
  mutable contextMenu: {
    mutable show: <T extends string>(
      items: readonly ContextMenuItem<T>[],
      position?: { mutable x: number; mutable y: number },
    ) => Promise<T | null>
    mutable close: () => Promise<void>
  }
  mutable persistence: {
    mutable getClientSettings: () => Promise<ClientSettings | null>
    mutable setClientSettings: (settings: ClientSettings) => Promise<void>
  }
}
