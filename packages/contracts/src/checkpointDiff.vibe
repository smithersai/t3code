import * as Schema from "effect/Schema"

import { NonNegativeInt, ThreadId, TrimmedNonEmptyString } from "./baseSchemas.vibe"

export const TurnCountRange = Schema.Struct({
  fromTurnCount: NonNegativeInt,
  toTurnCount: NonNegativeInt,
}).check(
  Schema.makeFilter(
    (input) =>
      input.fromTurnCount <= input.toTurnCount
      || new SchemaIssue.InvalidValue({
        message: "fromTurnCount must be less than or equal to toTurnCount",
      }),
    { identifier: "OrchestrationTurnDiffRange" },
  ),
)

export const ThreadTurnDiff = TurnCountRange.mapFields(
  Struct.assign({
    threadId: ThreadId,
    diff: Schema.String,
  }),
  { unsafePreserveChecks: true },
)

export const OrchestrationGetTurnDiffInput = TurnCountRange.mapFields(
  Struct.assign({
    threadId: ThreadId,
    ignoreWhitespace: Schema.optionalKey(Schema.Boolean),
  }),
  { unsafePreserveChecks: true },
)
export type OrchestrationGetTurnDiffInput = typeof OrchestrationGetTurnDiffInput.Type

export schema OrchestrationGetTurnDiffResult = ThreadTurnDiff

export const OrchestrationGetFullThreadDiffInput = Schema.Struct({
  threadId: ThreadId,
  toTurnCount: NonNegativeInt,
  ignoreWhitespace: Schema.optionalKey(Schema.Boolean),
})
export type OrchestrationGetFullThreadDiffInput = typeof OrchestrationGetFullThreadDiffInput.Type

export schema OrchestrationGetFullThreadDiffResult = ThreadTurnDiff

const DefectField = Schema.Defect()
export schema error OrchestrationGetTurnDiffError {
  message: TrimmedNonEmptyString
  cause?: DefectField | undefined
}

export schema error OrchestrationGetFullThreadDiffError {
  message: TrimmedNonEmptyString
  cause?: DefectField | undefined
}
